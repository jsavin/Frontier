// Test script for Frontier CLI
// This script tests basic UserTalk functionality

local (x = 5)
local (y = 10)
local (result = x + y)

// Test string operations
local (message = "Hello from Frontier CLI!")
local (greeting = message & " Result: " & result)

// Test conditional logic
if (result > 10) then
    local (status = "Success: Result is greater than 10")
    status
else
    local (status = "Warning: Result is 10 or less")
    status
end if
