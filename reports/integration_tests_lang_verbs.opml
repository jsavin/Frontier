        <outline text="Metadata">
          <outline text="expected_result: fixd"/>
        </outline>
        <outline text="Script">
          <outline text="typeof(lang.fixed(-50.75))"/>
        </outline>
      </outline>
      <outline text="lang.direction - string 'up' - Convert string 'up' to direction">
        <outline text="Metadata">
          <outline text="expected_result: up"/>
