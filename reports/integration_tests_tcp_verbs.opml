<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Tcp Verbs (tcp_verbs)</title>
    <dateCreated>Tue, 20 Jan 2026 08:32:54 GMT</dateCreated>
  </head>
  <body>
    <outline text="tcp.countConnections - initial state - Verify no active connections at start">
      <outline text="Metadata">
        <outline text="expected_result: 0"/>
      </outline>
      <outline text="Script">
        <outline text="return tcp.countConnections()"/>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - invalid address format - Test error handling for invalid stream">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(stream = tcp.openAddrStream(0, 80))"/>
          <outline text="return false"/>
        </outline>
        <outline text="} else">
          <outline text="return true  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - connection refused - Test connection to closed port">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="/* Connect to localhost port that should be closed */"/>
          <outline text="local(localhostAddr = tcp.addressEncode(&quot;127.0.0.1&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(localhostAddr, 9))"/>
          <outline text="return &quot;false&quot;  /* Should not reach here */"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected connection refused */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.closeStream - invalid stream ID - Test error handling for invalid stream">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.closeStream(999)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.closeStream - stream ID zero - Test error handling for zero stream ID">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.closeStream(0)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.abortStream - invalid stream ID - Test abort with invalid stream">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.abortStream(999)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - invalid stream ID - Test read from invalid stream">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(data = tcp.readStream(999, 1024))"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.writeStream - invalid stream ID - Test write to invalid stream">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.writeStream(999, &quot;test data&quot;)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.addressEncode - valid IPv4 - Encode dotted decimal IP to long">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(addr = tcp.addressEncode(&quot;192.168.1.1&quot;))"/>
        <outline text="return (addr &gt; 0)"/>
      </outline>
    </outline>
    <outline text="tcp.addressEncode - localhost - Encode 127.0.0.1 to verify host byte order">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(addr = tcp.addressEncode(&quot;127.0.0.1&quot;))"/>
        <outline text="/* 127.0.0.1 in host byte order = 0x7F000001 = 2130706433 */"/>
        <outline text="return (addr == 2130706433)"/>
      </outline>
    </outline>
    <outline text="tcp.addressDecode - valid address - Decode long address back to dotted decimal">
      <outline text="Metadata">
        <outline text="expected_result: 192.168.1.1"/>
      </outline>
      <outline text="Script">
        <outline text="local(encoded = tcp.addressEncode(&quot;192.168.1.1&quot;))"/>
        <outline text="local(decoded = tcp.addressDecode(encoded))"/>
        <outline text="return decoded"/>
      </outline>
    </outline>
    <outline text="tcp.addressDecode - localhost round trip - Verify encode/decode round trip">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(original = &quot;127.0.0.1&quot;)"/>
        <outline text="local(encoded = tcp.addressEncode(original))"/>
        <outline text="local(decoded = tcp.addressDecode(encoded))"/>
        <outline text="return (decoded == original)"/>
      </outline>
    </outline>
    <outline text="tcp.addressEncode - invalid format - Test error handling for invalid IP string">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;not.an.ip.address&quot;))"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;true&quot;  /* Expected to fail */"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - connect to example.com port 80 - Test real HTTP connection via IP address">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="/* example.com = 93.184.216.34 */"/>
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &gt; 0)">
            <outline text="tcp.closeStream(stream)"/>
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="/* Network unavailable - acceptable failure */"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp connection lifecycle - open and close - Test complete stream lifecycle">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="/* Connect to example.com:80 */"/>
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;  /* Connection failed */"/>
          </outline>
          <outline text="/* Verify connection count increased */"/>
          <outline text="local(count1 = tcp.countConnections())"/>
          <outline text="if (count1 == 0)">
            <outline text="tcp.closeStream(stream)"/>
            <outline text="return &quot;false&quot;  /* Count should be &gt; 0 */"/>
          </outline>
          <outline text="/* Close connection */"/>
          <outline text="local(ok = tcp.closeStream(stream))"/>
          <outline text="if (not ok)">
            <outline text="return &quot;false&quot;  /* Close failed */"/>
          </outline>
          <outline text="/* Note: Count may not immediately decrease due to TIME_WAIT */"/>
          <outline text="return &quot;true&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="/* Network unavailable */"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - empty read non-blocking - Test non-blocking read returns empty when no data">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Try to read immediately (no data sent yet) */"/>
          <outline text="local(data = tcp.readStream(stream, 1024))"/>
          <outline text="/* Non-blocking read should return empty string */"/>
          <outline text="local(isEmpty = (string.length(data) == 0))"/>
          <outline text="tcp.closeStream(stream)"/>
          <outline text="if (isEmpty)">
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;false&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.writeStream and readStream - HTTP request - Test write and read with real HTTP server">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Send minimal HTTP request */"/>
          <outline text="local(crlf = char(13) + char(10))"/>
          <outline text="local(request = &quot;GET / HTTP/1.0&quot; + crlf + crlf)"/>
          <outline text="local(writeOk = tcp.writeStream(stream, request))"/>
          <outline text="if (not writeOk)">
            <outline text="tcp.closeStream(stream)"/>
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Read response (may need small delay for server response) */"/>
          <outline text="/* Note: First read might return empty if server hasn't responded yet */"/>
          <outline text="local(response = tcp.readStream(stream, 1024))"/>
          <outline text="tcp.closeStream(stream)"/>
          <outline text="/* Accept either empty (too fast) or HTTP response */"/>
          <outline text="if ((string.length(response) == 0) or (string.contains(response, &quot;HTTP&quot;, false)))">
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;false&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.abortStream - immediate close - Test RST close vs graceful close">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Abort immediately (send RST) */"/>
          <outline text="local(ok = tcp.abortStream(stream))"/>
          <outline text="if (ok)">
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;false&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.countConnections - multiple connections - Test connection counting with multiple streams">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="/* Open multiple connections */"/>
          <outline text="local(stream1 = tcp.openAddrStream(addr, 80))"/>
          <outline text="local(stream2 = tcp.openAddrStream(addr, 80))"/>
          <outline text="local(stream3 = tcp.openAddrStream(addr, 80))"/>
          <outline text="if ((stream1 &lt;= 0) or (stream2 &lt;= 0) or (stream3 &lt;= 0))">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Check count */"/>
          <outline text="local(count = tcp.countConnections())"/>
          <outline text="local(hasMultiple = (count &gt;= 3))"/>
          <outline text="/* Clean up */"/>
          <outline text="tcp.closeStream(stream1)"/>
          <outline text="tcp.closeStream(stream2)"/>
          <outline text="tcp.closeStream(stream3)"/>
          <outline text="if (hasMultiple)">
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;false&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.closeStream - double close - Test closing already-closed stream">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Close once */"/>
          <outline text="tcp.closeStream(stream)"/>
          <outline text="/* Try to close again - should fail */"/>
          <outline text="try">
            <outline text="tcp.closeStream(stream)"/>
            <outline text="return &quot;false&quot;  /* Should not succeed */"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;true&quot;  /* Expected failure on double close */"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - read from closed stream - Test read after stream closed">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="tcp.closeStream(stream)"/>
          <outline text="/* Try to read after close - should fail */"/>
          <outline text="try">
            <outline text="local(data = tcp.readStream(stream, 1024))"/>
            <outline text="return &quot;false&quot;  /* Should not succeed */"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;true&quot;  /* Expected failure */"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.writeStream - empty data - Test write with zero-length data">
      <outline text="Metadata">
        <outline text="skip_if_unavailable: True"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(addr = tcp.addressEncode(&quot;93.184.216.34&quot;))"/>
          <outline text="local(stream = tcp.openAddrStream(addr, 80))"/>
          <outline text="if (stream &lt;= 0)">
            <outline text="return &quot;false&quot;"/>
          </outline>
          <outline text="/* Write empty string - should succeed (no-op) */"/>
          <outline text="local(ok = tcp.writeStream(stream, &quot;&quot;))"/>
          <outline text="tcp.closeStream(stream)"/>
          <outline text="if (ok)">
            <outline text="return &quot;true&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;false&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="return &quot;false&quot;"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
