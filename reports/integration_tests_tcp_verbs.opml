<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Tcp Verbs (tcp_verbs)</title>
    <dateCreated>Wed, 21 Jan 2026 07:09:57 GMT</dateCreated>
  </head>
  <body>
    <outline text="tcp.countConnections - initial state - Verify countConnections returns a number (should be &gt;= 0)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(count = tcp.countConnections())"/>
        <outline text="return typeof(count) == longType"/>
      </outline>
    </outline>
    <outline text="tcp.countConnections - return type - Verify countConnections returns long type">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(count = tcp.countConnections())"/>
        <outline text="return typeof(count) == longType"/>
      </outline>
    </outline>
    <outline text="tcp.closeStream - invalid stream ID (negative) - Closing negative stream ID should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.closeStream(-1)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.closeStream - invalid stream ID (zero) - Stream ID 0 is invalid (reserved)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.closeStream(0)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.closeStream - invalid stream ID (large) - Large invalid stream ID should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.closeStream(999999)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.abortStream - invalid stream ID (negative) - Aborting negative stream ID should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.abortStream(-1)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.abortStream - invalid stream ID (zero) - Stream ID 0 is invalid for abort">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.abortStream(0)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - invalid stream ID (negative) - Reading from negative stream ID should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.readStream(-1, 1024)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - invalid stream ID (zero) - Reading from stream ID 0 should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.readStream(0, 1024)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.writeStream - invalid stream ID (negative) - Writing to negative stream ID should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.writeStream(-1, &quot;test data&quot;)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.writeStream - invalid stream ID (zero) - Writing to stream ID 0 should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.writeStream(0, &quot;test data&quot;)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - invalid byte count (negative) - Negative byte count should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.readStream(1, -1)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - invalid byte count (zero) - Zero byte count should raise error (must be positive)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.readStream(1, 0)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openNameStream - invalid port (negative) - Negative port number should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.openNameStream(&quot;localhost&quot;, -1)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openNameStream - invalid port (zero) - Port 0 should raise error for client connections">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.openNameStream(&quot;localhost&quot;, 0)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openNameStream - invalid port (too large) - Port &gt; 65535 should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.openNameStream(&quot;localhost&quot;, 70000)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openNameStream - empty hostname - Empty hostname should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.openNameStream(&quot;&quot;, 80)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - invalid port (negative) - Negative port number should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(localhost = 0x7F000001)"/>
          <outline text="tcp.openAddrStream(localhost, -1)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - invalid port (too large) - Port &gt; 65535 should raise error">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="local(localhost = 0x7F000001)"/>
          <outline text="tcp.openAddrStream(localhost, 70000)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - invalid address (zero) - Address 0.0.0.0 is invalid for client connect (Phase 1A)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="try">
          <outline text="tcp.openAddrStream(0, 80)"/>
          <outline text="return &quot;false&quot;"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;true&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="tcp.readStream - non-blocking behavior spec - Spec: readStream returns empty string when no data available (non-blocking)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.readStream is NON-BLOCKING."/>
        <outline text="// When called on a valid stream with no data available, it returns"/>
        <outline text="// empty string immediately (does not block, does not raise error)."/>
        <outline text="// This cannot be tested without actual network connection."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.writeStream - blocking behavior spec - Spec: writeStream blocks until all data is sent">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.writeStream is BLOCKING."/>
        <outline text="// It does not return until all data has been written to the socket,"/>
        <outline text="// or an error occurs (connection lost, timeout, etc.)."/>
        <outline text="// This cannot be tested without actual network connection."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.closeStream - graceful shutdown spec - Spec: closeStream sends FIN (graceful shutdown)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.closeStream performs graceful shutdown."/>
        <outline text="// It sends TCP FIN and waits for remote acknowledgment before"/>
        <outline text="// deallocating the stream ID. Safe to call multiple times (idempotent)."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.abortStream - immediate close spec - Spec: abortStream sends RST (immediate close)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.abortStream performs immediate close."/>
        <outline text="// It sends TCP RST (reset) and does NOT wait for remote acknowledgment."/>
        <outline text="// Use when connection is hung or needs immediate termination."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.openNameStream - blocking DNS spec - Spec: openNameStream performs blocking DNS lookup + connect">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.openNameStream is BLOCKING."/>
        <outline text="// It performs DNS resolution (if hostname not IP) and TCP connect."/>
        <outline text="// Does not return until connection established or error."/>
        <outline text="// Phase 1A uses blocking DNS; Phase 1B may add async."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - no DNS lookup spec - Spec: openAddrStream uses IP address directly (no DNS)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.openAddrStream bypasses DNS."/>
        <outline text="// Address parameter is a 4-byte encoded IP in host byte order."/>
        <outline text="// Faster than openNameStream when IP is already known."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.readStream - return type spec - Spec: readStream returns string (binary data as stringType)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.readStream returns stringType ('TEXT')."/>
        <outline text="// UserTalk strings can contain binary data, including null bytes."/>
        <outline text="// The return type is always stringType, not a specialized binary type."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.openAddrStream - return type spec - Spec: openAddrStream returns positive long (stream ID)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.openAddrStream returns longType."/>
        <outline text="// Stream ID is always a positive integer (&gt; 0)."/>
        <outline text="// Zero is reserved as invalid stream ID."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.writeStream - return type spec - Spec: writeStream returns boolean true on success">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.writeStream returns booleanType."/>
        <outline text="// Always returns true on success (all data sent)."/>
        <outline text="// Raises error on failure (does not return false)."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
    <outline text="tcp.closeStream - return type spec - Spec: closeStream returns boolean true">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Behavioral specification: tcp.closeStream returns booleanType."/>
        <outline text="// Always returns true (even if stream already closed - idempotent)."/>
        <outline text="// This test documents the expected behavior."/>
        <outline text="return true"/>
      </outline>
    </outline>
  </body>
</opml>
