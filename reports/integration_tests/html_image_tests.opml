    <outline text="html - image dimension workflow - Read dimensions and use in page table">
      <outline text="Metadata">
        <outline text="skip: Need sample image fixtures"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(testDir = &quot;{FRONTIER_TEST_TMP_DIR}&quot;)"/>
        <outline text="local(gifPath = testDir + &quot;/sample_100x50.gif&quot;)"/>
        <outline text="local(jpegPath = testDir + &quot;/sample_200x200.jpg&quot;)"/>
        <outline text="local(gifDims = html.getgifheightwidth(gifPath))"/>
        <outline text="local(jpegDims = html.getjpegheightwidth(jpegPath))"/>
        <outline text="# Verify both work correctly"/>
        <outline text="local(gifOK = (gifDims[1] == 50) and (gifDims[2] == 100))"/>
        <outline text="local(jpegOK = (jpegDims[1] == 200) and (jpegDims[2] == 200))"/>
        <outline text="return gifOK and jpegOK"/>
      </outline>
    </outline>
    <outline text="html - generate image tag with dimensions - Use image dimensions to generate complete img tags">
      <outline text="Metadata">
        <outline text="skip: Need sample image fixtures"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(testDir = &quot;{FRONTIER_TEST_TMP_DIR}&quot;)"/>
        <outline text="local(imagePath = testDir + &quot;/sample_100x50.gif&quot;)"/>
        <outline text="local(dimensions = html.getgifheightwidth(imagePath))"/>
        <outline text="local(imgTag = &quot;&lt;img src=\&quot;sample.gif\&quot;&quot;)"/>
        <outline text="imgTag = imgTag + &quot; width=\&quot;&quot; + dimensions[2] + &quot;\&quot;&quot;"/>
        <outline text="imgTag = imgTag + &quot; height=\&quot;&quot; + dimensions[1] + &quot;\&quot;&gt;&quot;"/>
        <outline text="return string.contains(imgTag, &quot;width=\&quot;100\&quot;&quot;) and string.contains(imgTag, &quot;height=\&quot;50\&quot;&quot;)"/>
      </outline>
    </outline>
