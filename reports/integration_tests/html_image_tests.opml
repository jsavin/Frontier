    <outline text="html.getgifheightwidth - basic GIF file - Read dimensions from valid GIF file">
      <outline text="Metadata">
        <outline text="skip: Need sample GIF test fixture"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(testDir = &quot;{FRONTIER_TEST_TMP_DIR}&quot;)"/>
        <outline text="local(gifPath = testDir + &quot;/sample_100x50.gif&quot;)"/>
        <outline text="local(dimensions = html.getgifheightwidth(gifPath))"/>
        <outline text="return (dimensions[1] == 50) and (dimensions[2] == 100)"/>
      </outline>
    </outline>
