<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Bigstring Boundary Tests (bigstring_boundary_tests) - 28 tests: 28 pass (100%)</title>
    <dateCreated>Sat, 21 Mar 2026 04:19:56 GMT</dateCreated>
  </head>
  <body>
    <outline text="bigstring boundary - string of exactly 254 bytes - Create and verify a string of exactly 254 bytes (one below bigstring limit)">
      <outline text="Metadata">
        <outline text="expected_result: 254"/>
        <outline text="notes: 254 bytes is one below the lenbigstring limit - should work everywhere"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;A&quot;, 254))"/>
        <outline text="return string.length(s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string of exactly 255 bytes - Create and verify a string of exactly 255 bytes (at bigstring limit)">
      <outline text="Metadata">
        <outline text="expected_result: 255"/>
        <outline text="notes: 255 bytes is the exact lenbigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;B&quot;, 255))"/>
        <outline text="return string.length(s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string of exactly 256 bytes - Create and verify a string of exactly 256 bytes (one above bigstring limit)">
      <outline text="Metadata">
        <outline text="expected_result: 256"/>
        <outline text="notes: 256 bytes exceeds lenbigstring but UserTalk strings are heap-allocated, so no truncation"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;C&quot;, 256))"/>
        <outline text="return string.length(s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string of 1000 bytes - Create and verify a string well beyond bigstring limit">
      <outline text="Metadata">
        <outline text="expected_result: 1000"/>
        <outline text="notes: UserTalk strings are heap-allocated — no 255 limit for string variables"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;D&quot;, 1000))"/>
        <outline text="return string.length(s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - concatenation reaching exactly 255 - Concatenate two strings to reach exactly 255 bytes">
      <outline text="Metadata">
        <outline text="expected_result: 255"/>
        <outline text="notes: Concatenation to exactly 255 bytes"/>
      </outline>
      <outline text="Script">
        <outline text="local(a = string.filledString(&quot;X&quot;, 200))"/>
        <outline text="local(b = string.filledString(&quot;Y&quot;, 55))"/>
        <outline text="local(c = a + b)"/>
        <outline text="return string.length(c)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - concatenation crossing 255 boundary - Concatenate two strings to cross the 255 boundary">
      <outline text="Metadata">
        <outline text="expected_result: 300"/>
        <outline text="notes: Concatenation crossing 255-byte boundary produces 300-byte string"/>
      </outline>
      <outline text="Script">
        <outline text="local(a = string.filledString(&quot;X&quot;, 200))"/>
        <outline text="local(b = string.filledString(&quot;Y&quot;, 100))"/>
        <outline text="local(c = a + b)"/>
        <outline text="return string.length(c)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - repeated concatenation past 255 - Build up a string past 255 bytes by repeated concatenation">
      <outline text="Metadata">
        <outline text="expected_result: 300"/>
        <outline text="notes: 30 iterations of 10-char append = 300 bytes, well past bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = &quot;&quot;)"/>
        <outline text="local(i)"/>
        <outline text="for i = 1 to 30">
          <outline text="s = s + &quot;0123456789&quot;"/>
        </outline>
        <outline text="return string.length(s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - content intact at 254 bytes - Verify first and last characters of 254-byte string are correct">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Verify no data corruption at boundary - 1"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = &quot;A&quot; + string.filledString(&quot;.&quot;, 252) + &quot;Z&quot;)"/>
        <outline text="return (string.length(s) == 254) and (string.nthCharacter(s, 1) == &quot;A&quot;) and (string.nthCharacter(s, 254) == &quot;Z&quot;)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - content intact at 255 bytes - Verify first and last characters of 255-byte string are correct">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Verify no data corruption at boundary"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = &quot;A&quot; + string.filledString(&quot;.&quot;, 253) + &quot;Z&quot;)"/>
        <outline text="return (string.length(s) == 255) and (string.nthCharacter(s, 1) == &quot;A&quot;) and (string.nthCharacter(s, 255) == &quot;Z&quot;)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - content intact at 256 bytes - Verify first and last characters of 256-byte string are correct">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Verify no data corruption past bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = &quot;A&quot; + string.filledString(&quot;.&quot;, 254) + &quot;Z&quot;)"/>
        <outline text="return (string.length(s) == 256) and (string.nthCharacter(s, 1) == &quot;A&quot;) and (string.nthCharacter(s, 256) == &quot;Z&quot;)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - ODB store/retrieve 254 bytes - Store and retrieve a 254-byte string via ODB">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: ODB round-trip at 254 bytes (below bigstring limit)"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;A&quot;, 254))"/>
        <outline text="system.temp.bs254 = s"/>
        <outline text="local(retrieved = system.temp.bs254)"/>
        <outline text="local(ok = string.length(retrieved) == 254)"/>
        <outline text="delete(@system.temp.bs254)"/>
        <outline text="return ok"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - ODB store/retrieve 255 bytes - Store and retrieve a 255-byte string via ODB">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: ODB round-trip at exactly 255 bytes (bigstring limit)"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;B&quot;, 255))"/>
        <outline text="system.temp.bs255 = s"/>
        <outline text="local(retrieved = system.temp.bs255)"/>
        <outline text="local(ok = string.length(retrieved) == 255)"/>
        <outline text="delete(@system.temp.bs255)"/>
        <outline text="return ok"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - ODB store/retrieve 256 bytes - Store and retrieve a 256-byte string via ODB">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: ODB round-trip at 256 bytes (past bigstring limit) - ODB uses handles, not bigstring"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;C&quot;, 256))"/>
        <outline text="system.temp.bs256 = s"/>
        <outline text="local(retrieved = system.temp.bs256)"/>
        <outline text="local(ok = string.length(retrieved) == 256)"/>
        <outline text="delete(@system.temp.bs256)"/>
        <outline text="return ok"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - ODB store/retrieve 1000 bytes - Store and retrieve a 1000-byte string via ODB">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: ODB handles store strings well beyond 255 bytes"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;D&quot;, 1000))"/>
        <outline text="system.temp.bs1000 = s"/>
        <outline text="local(retrieved = system.temp.bs1000)"/>
        <outline text="local(ok = string.length(retrieved) == 1000)"/>
        <outline text="delete(@system.temp.bs1000)"/>
        <outline text="return ok"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - ODB content integrity at 256 bytes - Verify stored string content is not corrupted past 255">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Verify no data corruption in ODB round-trip near boundary"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = &quot;START&quot; + string.filledString(&quot;.&quot;, 248) + &quot;END&quot;)"/>
        <outline text="system.temp.bsIntegrity = s"/>
        <outline text="local(retrieved = system.temp.bsIntegrity)"/>
        <outline text="local(lenOK = string.length(retrieved) == 256)"/>
        <outline text="local(startOK = string.mid(retrieved, 1, 5) == &quot;START&quot;)"/>
        <outline text="local(endOK = string.mid(retrieved, 254, 3) == &quot;END&quot;)"/>
        <outline text="delete(@system.temp.bsIntegrity)"/>
        <outline text="return lenOK and startOK and endOK"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - equality comparison at 255 - Two 255-byte strings with same content should be equal">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: String comparison at exactly bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(a = string.filledString(&quot;X&quot;, 255))"/>
        <outline text="local(b = string.filledString(&quot;X&quot;, 255))"/>
        <outline text="return a == b"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - equality comparison at 256 - Two 256-byte strings with same content should be equal">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: String comparison past bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(a = string.filledString(&quot;X&quot;, 256))"/>
        <outline text="local(b = string.filledString(&quot;X&quot;, 256))"/>
        <outline text="return a == b"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - inequality at 256 (different last byte) - Two 256-byte strings differing only in last byte should not be equal">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Ensures comparison looks past byte 255"/>
      </outline>
      <outline text="Script">
        <outline text="local(a = string.filledString(&quot;X&quot;, 255) + &quot;A&quot;)"/>
        <outline text="local(b = string.filledString(&quot;X&quot;, 255) + &quot;B&quot;)"/>
        <outline text="return a != b"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - sizeOf matches string.length at 255 - sizeOf and string.length agree for 255-byte string">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Both measurement functions should agree at the boundary"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;X&quot;, 255))"/>
        <outline text="return (sizeOf(s) == 255) and (string.length(s) == 255) and (sizeOf(s) == string.length(s))"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - sizeOf matches string.length at 256 - sizeOf and string.length agree for 256-byte string">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Both measurement functions should agree past the boundary"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;X&quot;, 256))"/>
        <outline text="return (sizeOf(s) == 256) and (string.length(s) == 256) and (sizeOf(s) == string.length(s))"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - file path at 254 chars works - File path under 255 chars should work without truncation">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: File path construction at 254 chars - within bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(dir = &quot;/tmp&quot;)"/>
        <outline text="local(padding = string.filledString(&quot;a&quot;, 249))"/>
        <outline text="local(path = dir + &quot;/&quot; + padding)"/>
        <outline text="return string.length(path) == 254"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - file path at 255 chars - File path at exactly 255 chars - at bigstring limit">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: File path at exactly 255 - this is the max bigstring can hold"/>
      </outline>
      <outline text="Script">
        <outline text="local(dir = &quot;/tmp&quot;)"/>
        <outline text="local(padding = string.filledString(&quot;a&quot;, 250))"/>
        <outline text="local(path = dir + &quot;/&quot; + padding)"/>
        <outline text="return string.length(path) == 255"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - file.exists with short path - file.exists works with path under 255 chars">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Baseline: file.exists works with short paths"/>
      </outline>
      <outline text="Script">
        <outline text="return typeof(file.exists(&quot;/tmp&quot;)) == booleanType"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string.mid spanning byte 255 - Extract substring that spans the 255-byte boundary">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Substring extraction spanning byte 254-255 - should work on heap strings"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;A&quot;, 253) + &quot;XY&quot; + string.filledString(&quot;B&quot;, 5))"/>
        <outline text="local(sub = string.mid(s, 254, 2))"/>
        <outline text="return sub == &quot;XY&quot;"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string.mid past byte 255 - Extract substring entirely past the 255-byte boundary">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Substring extraction past byte 255 - heap strings have no boundary"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;A&quot;, 256) + &quot;HELLO&quot;)"/>
        <outline text="local(sub = string.mid(s, 257, 5))"/>
        <outline text="return sub == &quot;HELLO&quot;"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - string.patternMatch past byte 255 - Find pattern located past byte 255 in string">
      <outline text="Metadata">
        <outline text="expected_result: 261"/>
        <outline text="notes: Pattern matching works past byte 255 on heap strings"/>
      </outline>
      <outline text="Script">
        <outline text="local(s = string.filledString(&quot;.&quot;, 260) + &quot;NEEDLE&quot;)"/>
        <outline text="return string.patternMatch(&quot;NEEDLE&quot;, s)"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - env var value at 255 bytes - Set and get environment variable with 255-byte value">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="notes: Environment variable at exactly bigstring limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(val = string.filledString(&quot;V&quot;, 255))"/>
        <outline text="sys.setenvironmentvariable(&quot;FRONTIER_BS_TEST&quot;, val)"/>
        <outline text="local(result = sys.getenvironmentvariable(&quot;FRONTIER_BS_TEST&quot;))"/>
        <outline text="local(ok = string.length(result) == 255)"/>
        <outline text="sys.setenvironmentvariable(&quot;FRONTIER_BS_TEST&quot;, &quot;&quot;)"/>
        <outline text="return ok"/>
      </outline>
    </outline>
    <outline text="bigstring boundary - env var value at 256 bytes (beyond bigstring limit) - Environment variable get/set passes through C bigstring buffers.&#10;This test documents behavior at 256 bytes — if truncation occurs,&#10;the returned value will be shorter than what was set.&#10;See issues #475, #423, #380 for bigstring limit context.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: truncated:255_from_256"/>
        <outline text="notes: Documents whether env var set/get truncates at the bigstring 255 limit"/>
      </outline>
      <outline text="Script">
        <outline text="local(val = string.filledString(&quot;E&quot;, 256))"/>
        <outline text="sys.setenvironmentvariable(&quot;FRONTIER_TEST_BS256&quot;, val)"/>
        <outline text="local(got = sys.getenvironmentvariable(&quot;FRONTIER_TEST_BS256&quot;))"/>
        <outline text="local(setLen = string.length(val))"/>
        <outline text="local(gotLen = string.length(got))"/>
        <outline text="sys.setenvironmentvariable(&quot;FRONTIER_TEST_BS256&quot;, &quot;&quot;)"/>
        <outline text="if gotLen == setLen">
          <outline text="return &quot;no_truncation:&quot; + string(setLen)}"/>
        </outline>
        <outline text="else">
          <outline text="return &quot;truncated:&quot; + string(gotLen) + &quot;_from_&quot; + string(setLen)}"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
