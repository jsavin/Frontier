      </outline>
    </outline>
    <outline text="guest db externals - script text readable from mainResponder - Open mainResponder.root and read script text via string().&#10;The init script should begin with 'on init'.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (sysdir = file.folderFromPath(Frontier.getFilePath()))"/>
        <outline text="local (guestpath = sysdir + &quot;Guest Databases/apps/mainResponder.root&quot;)"/>
        <outline text="if not file.exists(guestpath)">
          <outline text="return &quot;skip&quot;}"/>
