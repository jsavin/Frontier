    <outline text="guest db externals - deep table access in mainResponder - Open mainResponder.root and access a nested table value.&#10;TEXT values stored in guest database subtables should be readable.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
