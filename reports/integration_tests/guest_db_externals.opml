    <outline text="guest db externals - table navigation and sizeOf - Open StartupTasks.root and verify table navigation works.&#10;sizeOf() requires the table to be materialized from the guest DB.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
