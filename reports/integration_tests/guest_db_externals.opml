<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Guest Db Externals (guest_db_externals) - 11 tests: 11 pass (100%)</title>
    <dateCreated>Wed, 18 Feb 2026 20:10:33 GMT</dateCreated>
  </head>
  <body>
    <outline text="guest db externals - script typeof from StartupTasks - Open StartupTasks.root as guest database and verify script type resolution.&#10;typeOf() on a script entry should return 'scpt'.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: scpt"/>
      </outline>
      <outline text="Script">
        <outline text="local (sysdir = file.folderFromPath(Frontier.getFilePath()))"/>
        <outline text="local (guestpath = sysdir + &quot;StartupTasks.root&quot;)"/>
        <outline text="if not file.exists(guestpath)">
          <outline text="return &quot;skip&quot;}"/>
        </outline>
        <outline text="fileMenu.open(guestpath, true)"/>
        <outline text="return typeOf(StartupTasksSuite.main)"/>
      </outline>
    </outline>
    <outline text="guest db externals - script text readable from StartupTasks - Open StartupTasks.root and read script text via string().&#10;Verifies that opverbinmemory can unpack the outline from the guest DB file.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (sysdir = file.folderFromPath(Frontier.getFilePath()))"/>
        <outline text="local (guestpath = sysdir + &quot;StartupTasks.root&quot;)"/>
        <outline text="if not file.exists(guestpath)">
          <outline text="return &quot;skip&quot;}"/>
        </outline>
        <outline text="fileMenu.open(guestpath, true)"/>
        <outline text="local (s = string(StartupTasksSuite.main))"/>
        <outline text="return string.length(s) &gt; 0"/>
      </outline>
    </outline>
    <outline text="guest db externals - script defined() from StartupTasks - Open StartupTasks.root and verify defined() resolves scripts.&#10;defined() triggers name resolution + compilation, exercising the full&#10;external loading chain.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (sysdir = file.folderFromPath(Frontier.getFilePath()))"/>
        <outline text="local (guestpath = sysdir + &quot;StartupTasks.root&quot;)"/>
        <outline text="if not file.exists(guestpath)">
