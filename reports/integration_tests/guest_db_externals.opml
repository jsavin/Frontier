        <outline text="return defined(StartupTasksSuite.main)"/>
      </outline>
    </outline>
    <outline text="guest db externals - script typeof from mainResponder - Open mainResponder.root as guest database and verify script type.&#10;Uses a different guest database to confirm the fix is not DB-specific.&#10;">
      <outline text="Metadata">
        <outline text="expected_result: scpt"/>
      </outline>
      <outline text="Script">
        <outline text="local (sysdir = file.folderFromPath(Frontier.getFilePath()))"/>
