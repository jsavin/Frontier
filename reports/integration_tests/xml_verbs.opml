          <outline text="local(personAddr = xml.getAddress(rootAddr, &quot;person&quot;))"/>
          <outline text="local(nameAddr = xml.getAddress(personAddr, &quot;name&quot;))"/>
          <outline text="return nameAddr^"/>
        </outline>
      </outline>
    </outline>
