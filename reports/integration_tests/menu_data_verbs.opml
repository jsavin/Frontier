    <outline text="menu.deleteMenuCommand - verify item is actually removed - After deletion, adding same item again should work">
      <outline text="Metadata">
        <outline text="skip: False"/>
        <outline text="skip_reason: "/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
