        <outline text="interactive_steps: [{'expect': '\\[root\\]&gt;', 'send': 'dialog.threeway(&quot;Choose&quot;, &quot;One&quot;, &quot;Two&quot;, &quot;Three&quot;)'}, {'expect': 'Choose', 'send': '1'}, {'expect': '\\[root\\]&gt;', 'send': '/exit'}]"/>
