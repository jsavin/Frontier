<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Webserver Http Roundtrip Tests (webserver_http_roundtrip_tests) - 9 tests: 7 pass (77%) 2 skip (22%)</title>
    <dateCreated>Sat, 21 Mar 2026 00:12:43 GMT</dateCreated>
  </head>
  <body>
    <outline text="HTTP round-trip - GET request and response via TCP - Send HTTP GET, receive HTTP response via raw TCP server callback">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates full HTTP GET round-trip over TCP transport layer"/>
      </outline>
      <outline text="Script">
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: close\r\n\r\nHello, World!&quot;)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49200, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49200))"/>
          <outline text="tcp.writeStream(clientStream, &quot;GET /test HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="return (response contains &quot;200 OK&quot;) and (response contains &quot;Hello, World!&quot;)"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - response contains correct Content-Type header - Verify HTTP response headers are received intact">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates HTTP headers and HTML body are received correctly"/>
      </outline>
      <outline text="Script">
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 26\r\nConnection: close\r\n\r\n&lt;html&gt;Hello World!&lt;/html&gt;&quot;)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49201, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49201))"/>
          <outline text="tcp.writeStream(clientStream, &quot;GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="return (response contains &quot;Content-Type: text/html&quot;) and (response contains &quot;&lt;html&gt;Hello World!&lt;/html&gt;&quot;)"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - POST request with body - Send HTTP POST with body, verify server receives it">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates HTTP POST body is received correctly by the server callback"/>
      </outline>
      <outline text="Script">
        <outline text="new(tableType, @system.temp.httpTest)"/>
        <outline text="system.temp.httpTest.receivedBody = &quot;&quot;"/>
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="local(bodyStart = string.patternMatch(&quot;\r\n\r\n&quot;, request))"/>
          <outline text="if bodyStart &gt; 0">
            <outline text="system.temp.httpTest.receivedBody = string.mid(request, bodyStart + 4, sizeOf(request) - bodyStart - 3)"/>
          </outline>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK&quot;)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49202, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49202))"/>
          <outline text="local(body = &quot;name=test&amp;value=hello&quot;)"/>
          <outline text="local(httpRequest = &quot;POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Length: &quot; + sizeOf(body) + &quot;\r\nConnection: close\r\n\r\n&quot; + body)"/>
          <outline text="tcp.writeStream(clientStream, httpRequest)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="local(bodyReceived = system.temp.httpTest.receivedBody == body)"/>
          <outline text="local(responseOK = response contains &quot;200 OK&quot;)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="return bodyReceived and responseOK"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - request path extraction - Verify server callback can extract the request path from GET request">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates HTTP request line parsing - path extraction is core to webserver dispatch"/>
      </outline>
      <outline text="Script">
        <outline text="new(tableType, @system.temp.httpTest)"/>
        <outline text="system.temp.httpTest.requestPath = &quot;&quot;"/>
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="local(firstLine = string.nthField(request, &quot;\r\n&quot;, 1))"/>
          <outline text="local(path = string.nthField(firstLine, &quot; &quot;, 2))"/>
          <outline text="system.temp.httpTest.requestPath = path"/>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK&quot;)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49203, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49203))"/>
          <outline text="tcp.writeStream(clientStream, &quot;GET /helloworld HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="local(pathCorrect = system.temp.httpTest.requestPath == &quot;/helloworld&quot;)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="return pathCorrect"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - multiple sequential requests on same port - Send multiple HTTP requests sequentially to the same server">
      <outline text="Metadata">
        <outline text="timeout: 20"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates server handles multiple sequential HTTP connections correctly"/>
      </outline>
      <outline text="Script">
        <outline text="new(tableType, @system.temp.httpTest)"/>
        <outline text="system.temp.httpTest.requestCount = 0"/>
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="system.temp.httpTest.requestCount = system.temp.httpTest.requestCount + 1"/>
          <outline text="local(body = &quot;Request #&quot; + system.temp.httpTest.requestCount)"/>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Length: &quot; + sizeOf(body) + &quot;\r\nConnection: close\r\n\r\n&quot; + body)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49204, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(allOK = true)"/>
          <outline text="local(i)"/>
          <outline text="for i = 1 to 3">
            <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49204))"/>
            <outline text="tcp.writeStream(clientStream, &quot;GET /req&quot; + i + &quot; HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
            <outline text="thread.sleepFor(100)"/>
            <outline text="local(response = &quot;&quot;)"/>
            <outline text="local(startTicks = clock.ticks())"/>
            <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
              <outline text="response = tcp.readStream(clientStream, 4096)"/>
              <outline text="thread.sleepFor(10)"/>
            </outline>
            <outline text="tcp.closeStream(clientStream)"/>
            <outline text="if not (response contains &quot;200 OK&quot;)">
              <outline text="allOK = false"/>
            </outline>
          </outline>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="local(count = system.temp.httpTest.requestCount)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="return allOK and (count == 3)"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="delete(@system.temp.httpTest)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - 404 Not Found response - Server returns HTTP 404 status line and error body">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates HTTP 404 error response - server always returns 404 for this test"/>
      </outline>
      <outline text="Script">
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="tcp.writeStream(streamID, &quot;HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found&quot;)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49205, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49205))"/>
          <outline text="tcp.writeStream(clientStream, &quot;GET /nonexistent HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="return (response contains &quot;404 Not Found&quot;) and (response contains &quot;Not Found&quot;)"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="HTTP round-trip - large response body - Server returns a response body larger than 255 bytes">
      <outline text="Metadata">
        <outline text="timeout: 15"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Validates responses larger than bigstring limit (255 bytes) work over TCP - checks headers, size, and body content"/>
      </outline>
      <outline text="Script">
        <outline text="on httpHandler(streamID, remoteAddr, remotePort)">
          <outline text="local(request = tcp.readStream(streamID, 4096))"/>
          <outline text="local(body = string.filledString(&quot;X&quot;, 500))"/>
          <outline text="local(response = &quot;HTTP/1.1 200 OK\r\nContent-Length: 500\r\nConnection: close\r\n\r\n&quot; + body)"/>
          <outline text="tcp.writeStream(streamID, response)"/>
          <outline text="tcp.closeStream(streamID)"/>
          <outline text="return true"/>
        </outline>
        <outline text="local(listenID = tcp.listenStream(49206, 5, @httpHandler))"/>
        <outline text="try">
          <outline text="local(clientStream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49206))"/>
          <outline text="tcp.writeStream(clientStream, &quot;GET /big HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
          <outline text="thread.sleepFor(100)"/>
          <outline text="local(response = &quot;&quot;)"/>
          <outline text="local(startTicks = clock.ticks())"/>
          <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 200)">
            <outline text="response = tcp.readStream(clientStream, 4096)"/>
            <outline text="thread.sleepFor(10)"/>
          </outline>
          <outline text="tcp.closeStream(clientStream)"/>
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="local(headersOK = (response contains &quot;200 OK&quot;) and (response contains &quot;Content-Length: 500&quot;))"/>
          <outline text="local(bodyDelivered = sizeOf(response) &gt;= 500)"/>
          <outline text="local(bodyContent = response contains string.filledString(&quot;X&quot;, 500))"/>
          <outline text="return headersOK and bodyDelivered and bodyContent"/>
        </outline>
        <outline text="else">
          <outline text="tcp.closeListen(listenID)"/>
          <outline text="scriptError(tryError)"/>
        </outline>
      </outline>
    </outline>
    <outline text="webserver stack - inetd start and HTTP GET via webserver dispatch - Full stack: inetd.startOne -&gt; HTTP request -&gt; webserver.dispatch -&gt; responder -&gt; response">
      <outline text="Metadata">
        <outline text="skip: True"/>
        <outline text="skip_reason: fwsNetEvent* functions are stubbed in headless mode; requires migration to tcp_* API (see webserver_hello_world.yaml)"/>
        <outline text="requires_system_root: True"/>
        <outline text="timeout: 30"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Full webserver stack test. Blocked on fwsNetEvent* migration to tcp_* API.&#10;When this migration is complete, remove skip and this test validates the&#10;entire HTTP pipeline: inetd listener -&gt; webserver.server -&gt; webserver.dispatch -&gt; responder.&#10;"/>
      </outline>
      <outline text="Script">
        <outline text="webserver.init()"/>
        <outline text="user.inetd.config.http.port = 49207"/>
        <outline text="webserver.data.responders.helloWorld.enabled = true"/>
        <outline text="inetd.startOne(@user.inetd.config.http)"/>
        <outline text="thread.sleepFor(100)"/>
        <outline text="local(stream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49207))"/>
        <outline text="tcp.writeStream(stream, &quot;GET /helloworld HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
        <outline text="local(response = &quot;&quot;)"/>
        <outline text="local(startTicks = clock.ticks())"/>
        <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 300)">
          <outline text="response = tcp.readStream(stream, 4096)"/>
          <outline text="thread.sleepFor(10)"/>
        </outline>
        <outline text="tcp.closeStream(stream)"/>
        <outline text="inetd.stopOne(@user.inetd.config.http)"/>
        <outline text="webserver.data.responders.helloWorld.enabled = false"/>
        <outline text="return (response contains &quot;200 OK&quot;) and (response contains &quot;Hello World&quot;)"/>
      </outline>
    </outline>
    <outline text="webserver stack - dynamic responder script via dispatch - Test custom responder script invoked via webserver dispatch">
      <outline text="Metadata">
        <outline text="skip: True"/>
        <outline text="skip_reason: fwsNetEvent* functions are stubbed in headless mode; requires migration to tcp_* API"/>
        <outline text="requires_system_root: True"/>
        <outline text="timeout: 30"/>
        <outline text="expected_result: true"/>
        <outline text="notes: Tests custom responder dispatch. Blocked on same fwsNetEvent* migration.&#10;Purpose: verify webserver.dispatch routes to correct responder based on URL path.&#10;"/>
      </outline>
      <outline text="Script">
        <outline text="webserver.init()"/>
        <outline text="user.inetd.config.http.port = 49208"/>
        <outline text="inetd.startOne(@user.inetd.config.http)"/>
        <outline text="thread.sleepFor(100)"/>
        <outline text="local(stream = tcp.openStream(tcp.addressEncode(&quot;127.0.0.1&quot;), 49208))"/>
        <outline text="tcp.writeStream(stream, &quot;GET /custom HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n&quot;)"/>
        <outline text="local(response = &quot;&quot;)"/>
        <outline text="local(startTicks = clock.ticks())"/>
        <outline text="while (sizeOf(response) == 0) and ((clock.ticks() - startTicks) &lt; 300)">
          <outline text="response = tcp.readStream(stream, 4096)"/>
          <outline text="thread.sleepFor(10)"/>
        </outline>
        <outline text="tcp.closeStream(stream)"/>
        <outline text="inetd.stopOne(@user.inetd.config.http)"/>
        <outline text="return response contains &quot;HTTP/1.&quot;"/>
      </outline>
    </outline>
  </body>
</opml>
