      </outline>
      <outline text="Script">
        <outline text="return frontier.enableAgents(false)"/>
      </outline>
    </outline>
    <outline text="frontier.isValidSerialNumber - always true in headless - Serial number validation always returns true in CLI mode">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="return frontier.isValidSerialNumber(&quot;anything&quot;)"/>
