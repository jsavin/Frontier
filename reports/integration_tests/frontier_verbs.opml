  <body>
    <outline text="frontier.getProgramPath - returns string - getProgramPath should return a string value">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (path = frontier.getProgramPath())"/>
        <outline text="return typeof(path) == 'TEXT'"/>
      </outline>
    </outline>
    <outline text="frontier.getProgramPath - contains frontier-cli - Path should contain the CLI executable name">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (path = frontier.getProgramPath())"/>
        <outline text="return path contains &quot;frontier-cli&quot;"/>
      </outline>
    </outline>
    <outline text="frontier.getProgramPath - is absolute path - Path should be absolute (starts with /)">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (path = frontier.getProgramPath())"/>
        <outline text="return path[1] == '/'"/>
      </outline>
    </outline>
    <outline text="frontier.getFilePath - returns string - getFilePath should return a string value">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local (path = frontier.getFilePath())"/>
        <outline text="return typeof(path) == 'TEXT'"/>
