        <outline text="protocol_ops: [{'op': 'script/eval', 'params': {'expression': 'new(tableType, @workspace.test_depth_table)'}, 'validate': {'success': True}, 'description': 'create subtable'}, {'op': 'odb/set', 'params': {'items': [{'path': 'workspace.test_depth_table.nested_val', 'type': 'string', 'value': 'deep'}]}, 'validate': {'success': True}, 'description': 'set nested value'}, {'op': 'odb/list', 'params': {'items': [{'path': 'workspace', 'depth': 2}]}, 'validate': {'success': True, 'entries_include': [{'name': 'test_depth_table', 'type': 'table'}]}, 'description': 'list with depth 2'}, {'op': 'odb/delete', 'params': {'items': [{'path': 'workspace.test_depth_table'}]}, 'validate': {'success': True}, 'description': 'cleanup'}]"/>
