    <outline text="odb/list - list workspace children - List top-level children of workspace table">
      <outline text="Metadata">
        <outline text="protocol_ops: [{'op': 'odb/list', 'params': {'items': [{'path': 'workspace', 'depth': 1}]}, 'validate': {'success': True, 'result_count': 1, 'entries_min': 1}}]"/>
      </outline>
    </outline>
    <outline text="odb/list - list system table children - List children of system table">
      <outline text="Metadata">
