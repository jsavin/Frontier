    <outline text="script.error - long error message - Error with very long message should handle gracefully">
      <outline text="Metadata">
        <outline text="expected_success: False"/>
      </outline>
      <outline text="Script">
        <outline text="local(longMsg = &quot;Error: &quot;)"/>
        <outline text="local(i)"/>
        <outline text="for i = 1 to 20">
          <outline text="longMsg = longMsg + &quot;This is a very long error message component. &quot;"/>
        </outline>
        <outline text="script.error(longMsg)"/>
        <outline text="return false"/>
      </outline>
    </outline>
    <outline text="script verbs - complete lifecycle test - Create, set source, compile, run, get result">
      <outline text="Metadata">
        <outline text="skip: Not a production Frontier verb - no glue in Frontier.root"/>
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="lang.new(scriptType, @system.temp.lifecycle)"/>
        <outline text="script.setsource(@system.temp.lifecycle, &quot;return 100 + 23&quot;)"/>
        <outline text="script.compile(@system.temp.lifecycle)"/>
        <outline text="local(result = @system.temp.lifecycle())"/>
        <outline text="return result == 123"/>
      </outline>
