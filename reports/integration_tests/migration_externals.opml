      </outline>
      <outline text="Script">
        <outline text="defined(system.verbs.builtins) and typeOf(system.verbs.builtins) == &quot;tabl&quot;"/>
      </outline>
    </outline>
    <outline text="Very deep table access - 4+ levels - Tables nested 4+ levels deep should work">
      <outline text="Metadata">
