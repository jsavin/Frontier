<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Migration Externals (migration_externals) - 19 tests: 16 pass (84%) 3 skip (15%)</title>
    <dateCreated>Thu, 05 Mar 2026 19:10:44 GMT</dateCreated>
  </head>
  <body>
    <outline text="Deep script execution - system.verbs.globals.string - The string verb should work after migration">
      <outline text="Metadata">
        <outline text="expected_result: 123"/>
      </outline>
      <outline text="Script">
        <outline text="string(123)"/>
      </outline>
    </outline>
    <outline text="Deep script verification - system.verbs.globals.string exists - Verify string verb exists and is a script">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="defined(system.verbs.globals.string) and typeOf(system.verbs.globals.string) == &quot;scpt&quot;"/>
      </outline>
    </outline>
    <outline text="Shallow script access - workspace script - Scripts directly in workspace should migrate correctly">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="skip: True"/>
        <outline text="reason: Runtime script creation has pre-existing issues - not related to migration fix"/>
      </outline>
      <outline text="Script">
        <outline text="defined(workspace)"/>
      </outline>
    </outline>
    <outline text="Deep script access - nested table script - Scripts deeply nested in tables should migrate">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="// Access a deeply nested script (3+ levels)"/>
        <outline text="// system.verbs.builtins.file.exists is a good example"/>
        <outline text="if not defined(system.verbs.builtins.file.exists)">
          <outline text="return &quot;file.exists not found&quot;"/>
        </outline>
        <outline text="local(scriptType = typeOf(system.verbs.builtins.file.exists))"/>
        <outline text="if scriptType != 'scpt'">
          <outline text="return &quot;wrong type: &quot; + string(scriptType)"/>
        </outline>
        <outline text="// Test execution - check if this file exists"/>
        <outline text="return file.exists(frontier.getprogrampath())"/>
      </outline>
    </outline>
    <outline text="Multiple deep scripts - verify all string verbs - Test multiple scripts in system.verbs.string table">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="local(ct = 0)"/>
        <outline text="// Count scripts in string verb table"/>
        <outline text="for adr in @system.verbs.string">
          <outline text="if typeOf(adr^) == 'scpt'">
            <outline text="ct = ct + 1"/>
          </outline>
        </outline>
        <outline text="// Should have multiple string verb scripts"/>
        <outline text="return ct &gt; 10"/>
      </outline>
    </outline>
    <outline text="Shallow outline access - workspace outline - Outlines directly in workspace should migrate correctly">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="skip: True"/>
        <outline text="reason: Runtime outline creation has pre-existing issues - not related to migration fix"/>
      </outline>
      <outline text="Script">
        <outline text="defined(workspace)"/>
      </outline>
    </outline>
    <outline text="Deep outline access - examples outlines - Access deeply nested sample outlines in examples table">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
      </outline>
      <outline text="Script">
        <outline text="defined(examples)"/>
      </outline>
    </outline>
    <outline text="Shallow table access - workspace subtable - Tables directly in workspace should be accessible after migration">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
