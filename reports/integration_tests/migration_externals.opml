    <outline text="Shallow WPText access - workspace text - WPText directly in workspace should migrate">
      <outline text="Metadata">
        <outline text="expected_result: true"/>
        <outline text="skip: True"/>
        <outline text="reason: Runtime wptext creation has pre-existing issues - not related to migration fix"/>
      </outline>
      <outline text="Script">
        <outline text="defined(workspace)"/>
      </outline>
    </outline>
    <outline text="Deep WPText access - nested documentation - WPText in deep tables should be accessible">
      <outline text="Metadata">
        <outline text="expected_result_type: string"/>
      </outline>
      <outline text="Script">
        <outline text="// Look for WPText in system tables (documentation often stored as WPText)"/>
        <outline text="local(found = false)"/>
        <outline text="local(wpCount = 0)"/>
        <outline text="// Search for any WPText objects in system.verbs"/>
        <outline text="for adr in @system.verbs">
          <outline text="if typeOf(adr^) == 'tabl'">
            <outline text="for subadr in adr">
              <outline text="if typeOf(subadr^) == 'wptx'">
                <outline text="wpCount = wpCount + 1"/>
                <outline text="found = true"/>
              </outline>
            </outline>
          </outline>
        </outline>
        <outline text="if found">
          <outline text="return &quot;found &quot; + string(wpCount) + &quot; wptext objects&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="// WPText might not exist in system tables, create one for testing"/>
          <outline text="lang.new(tableType, @system.temp.wptest)"/>
          <outline text="lang.new(wptextType, @system.temp.wptest.doc)"/>
          <outline text="wp.setText(&quot;Deep WPText&quot;, @system.temp.wptest.doc)"/>
          <outline text="if typeOf(system.temp.wptest.doc) == 'wptx'">
            <outline text="local(txt = wp.getText(@system.temp.wptest.doc))"/>
            <outline text="delete(@system.temp.wptest)"/>
            <outline text="return txt"/>
          </outline>
          <outline text="return &quot;wptext creation failed&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="Menu type verification - Check if any menus exist in the database">
      <outline text="Metadata">
        <outline text="expected_result_type: string"/>
      </outline>
      <outline text="Script">
        <outline text="// Menus are less common, check if any exist"/>
        <outline text="local(menuCount = 0)"/>
        <outline text="// Search in suites (menus often stored there)"/>
        <outline text="if defined(suites)">
          <outline text="for adr in @suites">
            <outline text="if typeOf(adr^) == 'tabl'">
              <outline text="for subadr in adr">
                <outline text="if typeOf(subadr^) == 'menu'">
                  <outline text="menuCount = menuCount + 1"/>
                </outline>
              </outline>
            </outline>
          </outline>
        </outline>
        <outline text="if menuCount &gt; 0">
          <outline text="return &quot;found &quot; + string(menuCount) + &quot; menus&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="// Create a test menu if none exist"/>
          <outline text="lang.new(menuType, @system.temp.testMenu)"/>
          <outline text="if typeOf(system.temp.testMenu) == 'menu'">
            <outline text="return &quot;created test menu&quot;"/>
          </outline>
          <outline text="return &quot;no menus found&quot;"/>
        </outline>
      </outline>
    </outline>
    <outline text="Picture type verification - Check if any pictures exist in the database">
      <outline text="Metadata">
        <outline text="expected_result_type: string"/>
      </outline>
      <outline text="Script">
        <outline text="// Pictures are stored in examples"/>
        <outline text="if defined(examples.picture)">
          <outline text="if typeOf(examples.picture) == 'pict'">
            <outline text="return &quot;found picture&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;wrong type: &quot; + string(typeOf(examples.picture))"/>
          </outline>
        </outline>
        <outline text="// Also check testPicture"/>
        <outline text="if defined(examples.testPicture)">
          <outline text="if typeOf(examples.testPicture) == 'pict'">
            <outline text="return &quot;found test picture&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="return &quot;wrong type: &quot; + string(typeOf(examples.testPicture))"/>
          </outline>
        </outline>
        <outline text="return &quot;no pictures found&quot;"/>
      </outline>
    </outline>
    <outline text="Full migration verification - all external types - Verify all external object types survive migration">
      <outline text="Metadata">
        <outline text="expected_result_type: string"/>
      </outline>
      <outline text="Script">
        <outline text="local(results = {})"/>
        <outline text="local(errors = {})"/>
        <outline text="// Test script access (most critical)"/>
        <outline text="try">
          <outline text="local(s = string(123))"/>
          <outline text="results.script = &quot;PASS&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="results.script = &quot;FAIL: &quot; + tryError"/>
          <outline text="errors.script = tryError"/>
        </outline>
        <outline text="// Test table access"/>
        <outline text="if defined(system.verbs.builtins) &amp;&amp; typeOf(system.verbs.builtins) == 'tabl'">
          <outline text="results.table = &quot;PASS&quot;"/>
        </outline>
        <outline text="} else">
          <outline text="results.table = &quot;FAIL&quot;"/>
          <outline text="errors.table = &quot;builtins table not accessible&quot;"/>
        </outline>
        <outline text="// Test outline access (if exists)"/>
        <outline text="if defined(examples.[&quot;Sample Outline 1&quot;])">
          <outline text="if typeOf(examples.[&quot;Sample Outline 1&quot;]) == 'outl'">
            <outline text="results.outline = &quot;PASS&quot;"/>
          </outline>
          <outline text="} else">
            <outline text="results.outline = &quot;FAIL: wrong type&quot;"/>
          </outline>
        </outline>
        <outline text="} else">
          <outline text="results.outline = &quot;SKIP: no outlines in database&quot;"/>
        </outline>
        <outline text="// Count passes"/>
        <outline text="local(passCount = 0)"/>
        <outline text="local(failCount = 0)"/>
        <outline text="for item in results">
          <outline text="if string.beginsWith(string(item^), &quot;PASS&quot;)">
            <outline text="passCount = passCount + 1"/>
          </outline>
          <outline text="} else if string.beginsWith(string(item^), &quot;FAIL&quot;)">
            <outline text="failCount = failCount + 1"/>
          </outline>
        </outline>
        <outline text="if failCount &gt; 0">
          <outline text="// Return detailed error info"/>
          <outline text="local(msg = &quot;FAILURES: &quot;)"/>
          <outline text="for item in errors">
            <outline text="msg = msg + nameOf(item) + &quot;=&quot; + string(item^) + &quot;; &quot;"/>
          </outline>
          <outline text="return msg"/>
        </outline>
        <outline text="} else">
          <outline text="return &quot;All tests passed: &quot; + string(passCount) + &quot; external types verified&quot;"/>
        </outline>
      </outline>
    </outline>
