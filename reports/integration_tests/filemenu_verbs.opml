    <outline text="fileMenu lifecycle - open, write, save, closeall, reopen, verify - Full lifecycle test: create database, open with fileMenu, write data, save, close all, reopen with db.open, and verify persisted data">
      <outline text="Metadata">
        <outline text="expected_result: lifecycleValue"/>
      </outline>
      <outline text="Script">
        <outline text="local(tmpDir = &quot;{FRONTIER_TEST_TMP_DIR}&quot;)"/>
        <outline text="local(dbPath = tmpDir + &quot;/&quot; + &quot;filemenu_lifecycle.root7&quot;)"/>
        <outline text="db.new(dbPath)"/>
        <outline text="fileMenu.open(dbPath)"/>
        <outline text="db.setvalue(dbPath, &quot;lifecycleKey&quot;, &quot;lifecycleValue&quot;)"/>
        <outline text="fileMenu.save(dbPath)"/>
        <outline text="fileMenu.closeall()"/>
        <outline text="db.open(dbPath, false)"/>
        <outline text="local(val = db.getvalue(dbPath, &quot;lifecycleKey&quot;))"/>
        <outline text="db.close(dbPath)"/>
        <outline text="return val"/>
      </outline>
    </outline>
    <outline text="fileMenu.open + db.setvalue/getvalue - database interop - Guest database opened via fileMenu.open is accessible via db.* verbs">
      <outline text="Metadata">
        <outline text="expected_result: 42"/>
