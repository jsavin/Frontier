<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Html Core Tests (html_core_tests)</title>
    <dateCreated>Mon, 19 Jan 2026 08:33:40 GMT</dateCreated>
  </head>
  <body>
    <outline text="Html Core Tests (html_core_tests)">
      <outline text="html.urlencode - basic ASCII space - Encode simple string with space">
        <outline text="Metadata">
          <outline text="expected_result: hello%20world"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;hello world&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - special characters - Encode string with special characters">
        <outline text="Metadata">
          <outline text="expected_result: hello%20%26%20goodbye"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;hello &amp; goodbye&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - query string characters - Encode characters used in query strings">
        <outline text="Metadata">
          <outline text="expected_result: name%3DJohn%26age%3D30"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;name=John&amp;age=30&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - empty string - Encoding empty string should work">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - no special chars - String with no special characters unchanged">
        <outline text="Metadata">
          <outline text="expected_result: hello"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;hello&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - URL with path - Encode URL path with slashes and special chars">
        <outline text="Metadata">
          <outline text="expected_result: path%2Fto%20file.html"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;path/to file.html&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - Unicode/special characters - Encode non-ASCII characters">
        <outline text="Script">
          <outline text="html.urlencode(&quot;café&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - basic ASCII space - Decode simple percent-encoded space">
        <outline text="Metadata">
          <outline text="expected_result: hello world"/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello%20world&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - special characters - Decode percent-encoded special characters">
        <outline text="Metadata">
          <outline text="expected_result: hello &amp; goodbye"/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello%20%26%20goodbye&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - query string - Decode encoded query string">
        <outline text="Metadata">
          <outline text="expected_result: name=John&amp;age=30"/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;name%3DJohn%26age%3D30&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - empty string - Decoding empty string should work">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - no encoding - String with no percent-encoding unchanged">
        <outline text="Metadata">
          <outline text="expected_result: hello"/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - plus as space - Plus signs decoded as spaces (common in query strings)">
        <outline text="Metadata">
          <outline text="expected_result: hello world"/>
        </outline>
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello+world&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - invalid percent sequence - Invalid hex digits should not crash (defensive test)">
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello%ZZworld&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urldecode - incomplete percent sequence - Incomplete encoding at end should not crash">
        <outline text="Script">
          <outline text="html.urldecode(&quot;hello%2&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode/urldecode - round trip - Encode then decode should return original">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(original = &quot;hello &amp; world&quot;)"/>
          <outline text="local(encoded = html.urlencode(original))"/>
          <outline text="local(decoded = html.urldecode(encoded))"/>
          <outline text="return decoded == original"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - simple key-value - Parse single key-value pair (returns list)">
        <outline text="Metadata">
          <outline text="expected_result: John"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;name=John&quot;))"/>
          <outline text="return list[2]"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - multiple parameters - Parse query string with multiple parameters (returns list)">
        <outline text="Metadata">
          <outline text="expected_result: John,30"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;name=John&amp;age=30&quot;))"/>
          <outline text="return list[2] + &quot;,&quot; + list[4]"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - encoded values - Parse query string with percent-encoded values (returns list)">
        <outline text="Metadata">
          <outline text="expected_result: hello world"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;message=hello%20world&quot;))"/>
          <outline text="return list[2]"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - empty string - Parse empty query string should not crash (returns empty list)">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;&quot;))"/>
          <outline text="return sizeOf(list) == 0"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - no value - Parse parameter without value (flag parameter, returns list)">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;debug&quot;))"/>
          <outline text="return (sizeOf(list) == 2) and (list[1] == &quot;debug&quot;)"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - empty value - Parse parameter with empty value (returns list)">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;name=&quot;))"/>
          <outline text="return list[2]"/>
        </outline>
      </outline>
      <outline text="html.parsehttpargs - special characters in values - Parse values with special characters (returns list)">
        <outline text="Metadata">
          <outline text="expected_result: John&amp;Jane"/>
        </outline>
        <outline text="Script">
          <outline text="local(list = html.parsehttpargs(&quot;name=John%26Jane&amp;age=30&quot;))"/>
          <outline text="return list[2]"/>
        </outline>
      </outline>
      <outline text="html.expandurls - http URL - Convert HTTP URL to anchor tag">
        <outline text="Script">
          <outline text="html.expandurls(&quot;Visit http://www.example.com/&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - https URL - Convert HTTPS URL to anchor tag">
        <outline text="Script">
          <outline text="html.expandurls(&quot;Visit https://www.example.com/&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - ftp URL - Convert FTP URL to anchor tag">
        <outline text="Script">
          <outline text="html.expandurls(&quot;ftp://ftp.example.com/&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - email address - Convert email address to mailto link">
        <outline text="Script">
          <outline text="html.expandurls(&quot;Contact webmaster@example.com&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - no URLs - Text without URLs should remain unchanged">
        <outline text="Metadata">
          <outline text="expected_result: No URLs in this string."/>
        </outline>
        <outline text="Script">
          <outline text="html.expandurls(&quot;No URLs in this string.&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - multiple URLs - Multiple URLs in same string should all be expanded">
        <outline text="Script">
          <outline text="html.expandurls(&quot;http://www.example.com/ and ftp://ftp.example.com/&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - URL at end of sentence - URL followed by punctuation should handle correctly">
        <outline text="Script">
          <outline text="html.expandurls(&quot;Visit http://www.example.com/.&quot;)"/>
        </outline>
      </outline>
      <outline text="html.expandurls - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="html.expandurls(&quot;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - simple expression macro - Process simple arithmetic macro">
        <outline text="Metadata">
          <outline text="expected_result: 2"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;{1+1}&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - string macro - Process macro that returns string">
        <outline text="Metadata">
          <outline text="expected_result: hello"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;{\&quot;hello\&quot;}&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - no macros - Text without macros should remain unchanged">
        <outline text="Metadata">
          <outline text="expected_result: plain text"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;plain text&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - multiple macros - Process multiple macros in same string">
        <outline text="Metadata">
          <outline text="expected_result: 2 and 4"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;{1+1} and {2+2}&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.processmacros - nested macro - Process nested macro expressions (single-pass, inner macro evaluates first)">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="local(result = html.processmacros(&quot;{1+{2+3}}&quot;, false, @pagetable))"/>
          <outline text="# Single-pass evaluation: inner {2+3}=5, outer becomes {1, 5} which remains as string"/>
          <outline text="return result == &quot;{1, 5}&quot;"/>
        </outline>
      </outline>
      <outline text="html.processmacros - macro with text - Mix macros with regular text">
        <outline text="Metadata">
          <outline text="expected_result: The answer is 42."/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;The answer is {40+2}.&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - escape all macros (empty safe list) - All macros should be escaped when safe list is empty">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{dangerous.call()}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Escaped version should be longer than original (entities are longer than single chars)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - allow safe macro - Safe macros in whitelist should not be escaped">
        <outline text="Metadata">
          <outline text="expected_result: {safe}"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="safemacros.safe = true"/>
          <outline text="local(result = html.neutermacros(&quot;{safe}&quot;, @safemacros))"/>
          <outline text="return result"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - mixed safe and unsafe - Escape only unsafe macros, leave safe ones">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="safemacros.safe = true"/>
          <outline text="local(original = &quot;{safe} {unsafe}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Safe macro unchanged, unsafe macro escaped (result longer than original)"/>
          <outline text="local(hasSafe = string.patternMatch(&quot;{safe}*&quot;, result))"/>
          <outline text="local(isLonger = sizeOf(result) &gt; sizeOf(original))"/>
          <outline text="return hasSafe and isLonger"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - prevent file.delete attack - SECURITY: Dangerous file operations must be neutered">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{file.delete(\&quot;important\&quot;)}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - prevent script execution - SECURITY: Arbitrary script execution must be blocked">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{dialog.alert(\&quot;xss\&quot;)}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="return html.neutermacros(&quot;&quot;, @safemacros)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - no macros - Text without macros should remain unchanged">
        <outline text="Metadata">
          <outline text="expected_result: plain text"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="return html.neutermacros(&quot;plain text&quot;, @safemacros)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - macro with params (unsafe) - Macros with parameters should be checked">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="safemacros.clock = true;  # Allow clock without params"/>
          <outline text="local(original = &quot;{clock.now()}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Should be neutered because clock is allowed but not with params"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - macro with params (safe with table config) - NOTE: This test documents current behavior - macro neutering is complex">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="lang.new(tableType, @safemacros.clock)"/>
          <outline text="safemacros.clock.flLegal = true"/>
          <outline text="safemacros.clock.flParams = true"/>
          <outline text="local(result = html.neutermacros(&quot;{clock.now()}&quot;, @safemacros))"/>
          <outline text="return sizeOf(result) &gt; 0"/>
        </outline>
      </outline>
      <outline text="html.neutertags - escape all tags (empty safe list) - All tags should be escaped when safe list is empty">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="local(original = &quot;&lt;b&gt;bold&lt;/b&gt;&quot;)"/>
          <outline text="local(result = html.neutertags(original, @safetags))"/>
          <outline text="# Escaped version should be longer (entities are longer than single chars)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - allow safe tag - Safe tags in whitelist should not be escaped">
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="safetags.b = true"/>
          <outline text="local(result = html.neutertags(&quot;&lt;b&gt;bold&lt;/b&gt;&quot;, @safetags))"/>
          <outline text="return result"/>
        </outline>
      </outline>
      <outline text="html.neutertags - mixed safe and unsafe - Escape only unsafe tags, leave safe ones">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="safetags.b = true"/>
          <outline text="local(original = &quot;&lt;b&gt;bold&lt;/b&gt; &lt;script&gt;alert('xss')&lt;/script&gt;&quot;)"/>
          <outline text="local(result = html.neutertags(original, @safetags))"/>
          <outline text="# Safe &lt;b&gt; tag preserved, script tag escaped (result longer)"/>
          <outline text="local(hasB = string.patternMatch(&quot;*&lt;b&gt;*&quot;, result))"/>
          <outline text="local(isLonger = sizeOf(result) &gt; sizeOf(original))"/>
          <outline text="return hasB and isLonger"/>
        </outline>
      </outline>
      <outline text="html.neutertags - XSS prevention (script tag) - SECURITY: Script tags must be escaped">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="local(original = &quot;&lt;script&gt;alert('xss')&lt;/script&gt;&quot;)"/>
          <outline text="local(result = html.neutertags(original, @safetags))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - XSS prevention (iframe) - SECURITY: Iframe tags must be escaped">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="local(original = &quot;&lt;iframe src='evil.com'&gt;&lt;/iframe&gt;&quot;)"/>
          <outline text="local(result = html.neutertags(original, @safetags))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - XSS prevention (img with onerror) - SECURITY: Img tags should be carefully controlled">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="local(original = &quot;&lt;img src=x onerror='alert(1)'&gt;&quot;)"/>
          <outline text="local(result = html.neutertags(original, @safetags))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="return html.neutertags(&quot;&quot;, @safetags)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - no tags - Text without tags should remain unchanged">
        <outline text="Metadata">
          <outline text="expected_result: plain text"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="return html.neutertags(&quot;plain text&quot;, @safetags)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - tag auto-closing - Safe tags can be auto-closed for proper nesting">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="lang.new(tableType, @safetags.b)"/>
          <outline text="safetags.b.flLegal = true"/>
          <outline text="safetags.b.flClose = true"/>
          <outline text="local(result = html.neutertags(&quot;&lt;b&gt;bold&quot;, @safetags))"/>
          <outline text="# Should add closing &lt;/b&gt; tag"/>
          <outline text="return string.contains(result, &quot;&lt;/b&gt;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.neutertags - tag balancing - Multiple unclosed safe tags should all be closed">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="lang.new(tableType, @safetags.i)"/>
          <outline text="safetags.i.flLegal = true"/>
          <outline text="safetags.i.flClose = true"/>
          <outline text="local(result = html.neutertags(&quot;&lt;i&gt;one &lt;i&gt;two&quot;, @safetags))"/>
          <outline text="# Should add two closing &lt;/i&gt; tags"/>
          <outline text="return string.countFields(result, &quot;&lt;/i&gt;&quot;) == 2"/>
        </outline>
      </outline>
      <outline text="html - complete sanitization workflow - SECURITY: Full sanitization of untrusted user input">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safetags, safemacros)"/>
          <outline text="lang.new(tableType, @safetags)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="# Allow only safe formatting tags"/>
          <outline text="safetags.b = true"/>
          <outline text="safetags.i = true"/>
          <outline text="# Don't allow any macros"/>
          <outline text="local(untrustedInput = &quot;&lt;b&gt;Hello&lt;/b&gt; &lt;script&gt;alert('xss')&lt;/script&gt; {file.delete()}&quot;)"/>
          <outline text="local(step1 = html.neutertags(untrustedInput, @safetags))"/>
          <outline text="local(step2 = html.neutermacros(step1, @safemacros))"/>
          <outline text="# Verify script and macro are escaped but &lt;b&gt; is preserved"/>
          <outline text="local(hasB = string.patternMatch(&quot;*&lt;b&gt;*&quot;, step2))"/>
          <outline text="local(isLonger = sizeOf(step2) &gt; sizeOf(untrustedInput))"/>
          <outline text="return hasB and isLonger"/>
        </outline>
      </outline>
      <outline text="html - URL parameter workflow - Encode, build URL, parse, and decode parameters">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(name = html.urlencode(&quot;John Doe&quot;))"/>
          <outline text="local(message = html.urlencode(&quot;Hello &amp; goodbye&quot;))"/>
          <outline text="local(query = &quot;name=&quot; + name + &quot;&amp;message=&quot; + message)"/>
          <outline text="local(list = html.parsehttpargs(query))"/>
          <outline text="return (list[2] == &quot;John Doe&quot;) and (list[4] == &quot;Hello &amp; goodbye&quot;)"/>
        </outline>
      </outline>
      <outline text="html - macro processing with URL expansion - Process macros then auto-link URLs in result">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="local(withMacros = &quot;Result: {1+1}, visit http://example.com/&quot;)"/>
          <outline text="local(processed = html.processmacros(withMacros, false, @pagetable))"/>
          <outline text="local(withLinks = html.expandurls(processed))"/>
          <outline text="# Should expand macro and create link"/>
          <outline text="return string.contains(withLinks, &quot;2&quot;) and string.contains(withLinks, &quot;&lt;a href&quot;)"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
