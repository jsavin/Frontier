<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Repl Sessions (repl_sessions)</title>
    <dateCreated>Tue, 20 Jan 2026 08:37:48 GMT</dateCreated>
  </head>
  <body>
    <outline text="REPL - system root auto-loaded - System root should be auto-loaded if available">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: typeof(system)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['tabl']"/>
      </outline>
    </outline>
    <outline text="REPL - system.paths available - system.paths should be initialized">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: typeof(system.paths)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['tabl']"/>
      </outline>
    </outline>
    <outline text="REPL - kernel verbs available - Kernel verbs should work with system root loaded">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: sizeOf(&quot;test&quot;)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['4']"/>
      </outline>
    </outline>
    <outline text="REPL - string verbs available - String verbs should be accessible">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: string.upper(&quot;hello&quot;)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['HELLO']"/>
      </outline>
    </outline>
    <outline text="REPL - workspace separate from system table - Workspace should be separate table under system.repl.workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: testvar = 42&#10;typeof(system.repl.workspace)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['tabl']"/>
      </outline>
    </outline>
    <outline text="REPL - workspace doesn't pollute root - Variables in workspace shouldn't appear in root scope">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: x = 42&#10;# Try to access x without workspace prefix (should fail)&#10;try { x } else { 0 }&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - workspace doesn't affect system.compiler - Workspace assignments shouldn't modify system tables">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: compiler = &quot;custom&quot;&#10;typeof(system.compiler)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['tabl']"/>
      </outline>
    </outline>
    <outline text="REPL - continues after syntax error - Syntax errors shouldn't crash REPL">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: 1 +&#10;2 + 2&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['syntax', '4']"/>
      </outline>
    </outline>
    <outline text="REPL - continues after runtime error - Runtime errors shouldn't crash REPL">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: 1 / 0&#10;42&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['divide by zero', '42']"/>
      </outline>
    </outline>
    <outline text="REPL - continues after undefined variable - Undefined variable errors shouldn't crash REPL">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: nonexistent_var&#10;x = 10&#10;x&#10;/exit&#10;"/>
        <outline text="expected_output_contains: [&quot;Can't evaluate&quot;, &quot;hasn't been defined&quot;, '10']"/>
      </outline>
    </outline>
    <outline text="REPL - workspace intact after error - Errors shouldn't corrupt workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: safe = 100&#10;1 / 0&#10;safe&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['divide by zero', '100']"/>
      </outline>
    </outline>
    <outline text="REPL - multiple errors in sequence - REPL should handle multiple consecutive errors">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: 1 / 0&#10;undefined_var&#10;1 +&#10;42&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - variables persist across evaluations - Variables should persist within same session">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: x = 1&#10;x = x + 1&#10;x = x + 1&#10;x&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['3']"/>
      </outline>
    </outline>
    <outline text="REPL - multiple variables coexist - Multiple variables should persist together">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: a = 10&#10;b = 20&#10;c = 30&#10;a + b + c&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['60']"/>
      </outline>
    </outline>
    <outline text="REPL - complex state builds up - Complex workspace state should persist">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: counter = 0&#10;counter = counter + 1&#10;counter = counter + 1&#10;sum = 0&#10;sum = sum + counter&#10;sum&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['2']"/>
      </outline>
    </outline>
    <outline text="REPL - table variables persist - Table values should persist in workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: lang.new(tableType, @data)&#10;data.x = 1&#10;data.y = 2&#10;data.x + data.y&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['3']"/>
      </outline>
    </outline>
    <outline text="REPL - define function in workspace - Function definitions in REPL. May be affected by ADR-009 hash table stack&#10;restoration issue in some scenarios, though currently passing in most cases.&#10;">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: on doubleIt(x) { return x * 2 }&#10;doubleIt(21)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
        <outline text="known_issue: ADR-009: Function definitions may not persist across evaluations due to hash table stack restoration"/>
      </outline>
    </outline>
    <outline text="REPL - call workspace function multiple times - Multiple function calls in REPL. May be affected by ADR-009 hash table stack&#10;restoration issue in some scenarios.&#10;">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: on add(a, b) { return a + b }&#10;add(1, 2)&#10;add(10, 20)&#10;add(100, 200)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['3', '30', '300']"/>
        <outline text="known_issue: ADR-009: Multiple function calls may fail due to hash table stack restoration between evaluations"/>
      </outline>
    </outline>
    <outline text="REPL - clear and rebuild workspace - Should be able to clear and rebuild workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="skip: True"/>
        <outline text="skip_reason: QuickScript model: /vars and /clear commands removed (not applicable)"/>
        <outline text="stdin_input: old = 1&#10;/clear&#10;new = 2&#10;new&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['2']"/>
      </outline>
    </outline>
    <outline text="REPL - cleared variables inaccessible - After clear, old variables should error">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="skip: True"/>
        <outline text="skip_reason: QuickScript model: /vars and /clear commands removed (not applicable)"/>
        <outline text="stdin_input: x = 42&#10;/clear&#10;x&#10;/exit&#10;"/>
        <outline text="expected_output_contains: [&quot;Can't evaluate&quot;, &quot;hasn't been defined&quot;]"/>
      </outline>
    </outline>
    <outline text="REPL - many sequential operations - REPL should handle many sequential evaluations">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: sum = 0&#10;sum = sum + 1&#10;sum = sum + 2&#10;sum = sum + 3&#10;sum = sum + 4&#10;sum = sum + 5&#10;sum&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['15']"/>
      </outline>
    </outline>
    <outline text="REPL - accumulate complex state - Complex workspace state should accumulate correctly">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: count = 0&#10;total = 0&#10;count = count + 1&#10;total = total + count&#10;count = count + 1&#10;total = total + count&#10;count = count + 1&#10;total = total + count&#10;total&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['6']"/>
      </outline>
    </outline>
    <outline text="REPL - use lang verbs - Language verbs should work in REPL">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: lang.new(tableType, @t)&#10;typeof(t)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['tabl']"/>
      </outline>
    </outline>
    <outline text="REPL - use string verbs - String manipulation should work">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: s = &quot;hello&quot;&#10;string.upper(s)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['HELLO']"/>
      </outline>
    </outline>
    <outline text="REPL - use typeof - typeof should work on workspace variables">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: num = 42&#10;str = &quot;text&quot;&#10;bool = true&#10;typeof(num)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['long']"/>
      </outline>
    </outline>
    <outline text="REPL - use sizeOf on workspace - sizeOf should work on workspace table">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: a = 1&#10;b = 2&#10;c = 3&#10;sizeOf(workspace)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['3']"/>
      </outline>
    </outline>
    <outline text="REPL - interleave code and commands - Should seamlessly mix code and commands">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="skip: True"/>
        <outline text="skip_reason: QuickScript model: /vars and /clear commands removed (not applicable)"/>
        <outline text="stdin_input: x = 10&#10;/vars&#10;y = 20&#10;/vars&#10;x + y&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['x = 10', 'y = 20', '30']"/>
      </outline>
    </outline>
    <outline text="REPL - help doesn't affect workspace - /help command shouldn't affect workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: x = 42&#10;/help&#10;x&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['Available commands', '42']"/>
      </outline>
    </outline>
    <outline text="REPL - shows welcome message - REPL should show welcome on startup">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: /exit&#10;"/>
        <outline text="expected_output_contains: ['Frontier REPL', 'Interactive', 'UserTalk']"/>
      </outline>
    </outline>
    <outline text="REPL - shows help hint - Welcome should mention /help command">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: /exit&#10;"/>
        <outline text="expected_output_contains: ['/help']"/>
      </outline>
    </outline>
    <outline text="REPL - shows exit hint - Welcome should mention /exit command">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: /exit&#10;"/>
        <outline text="expected_output_contains: ['/exit']"/>
      </outline>
    </outline>
    <outline text="REPL - prompt shows context - Prompt should display current context">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: /exit&#10;"/>
        <outline text="expected_output_contains: ['[root]&gt;']"/>
      </outline>
    </outline>
    <outline text="REPL - prompt appears after each evaluation - Prompt should appear after each input">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: 1 + 1&#10;2 + 2&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['[root]&gt;']"/>
      </outline>
    </outline>
    <outline text="REPL - handles very long workspace names - Long variable names should work">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: this_is_a_very_long_variable_name_that_should_still_work = 42&#10;this_is_a_very_long_variable_name_that_should_still_work&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - handles unicode in workspace variables - Non-ASCII characters in identifiers cause errors">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: test_var = &quot;Hello&quot;&#10;test_var&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['Hello']"/>
      </outline>
    </outline>
    <outline text="REPL - nil return doesn't display - Nil values should not display (Phase 1 behavior)">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: nil&#10;42&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - empty statement block - Empty blocks should not error">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: if false { }&#10;42&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - clean exit with /exit - /exit should cleanly exit without errors">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: /exit&#10;"/>
        <outline text="expected_output_contains: ['Goodbye']"/>
      </outline>
    </outline>
    <outline text="REPL - clean exit with EOF - EOF (Ctrl-D) should cleanly exit">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: "/>
        <outline text="expected_output_contains: ['Goodbye']"/>
      </outline>
    </outline>
    <outline text="REPL - workspace cleanup on exit - Exit should cleanly dispose workspace">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="stdin_input: x = 42&#10;/exit&#10;"/>
      </outline>
    </outline>
    <outline text="REPL - works without system root - REPL should work even if system root not loaded">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="no_system_root: True"/>
        <outline text="stdin_input: x = 42&#10;x&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['42']"/>
      </outline>
    </outline>
    <outline text="REPL - basic verbs work without system root - Kernel verbs should work without system root">
      <outline text="Metadata">
        <outline text="repl_mode: True"/>
        <outline text="no_system_root: True"/>
        <outline text="stdin_input: typeof(42)&#10;/exit&#10;"/>
        <outline text="expected_output_contains: ['long']"/>
      </outline>
    </outline>
  </body>
</opml>
