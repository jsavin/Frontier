<?xml version="1.0" ?>
<opml version="2.0">
  <head>
    <title>Html Text Processing Phase2 Tests (html_text_processing_phase2_tests)</title>
    <dateCreated>Mon, 19 Jan 2026 08:33:40 GMT</dateCreated>
  </head>
  <body>
    <outline text="Html Text Processing Phase2 Tests (html_text_processing_phase2_tests)">
      <outline text="html.iso8859encode - basic ASCII text - Plain ASCII should pass through unchanged">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="local(text = &quot;Hello World&quot;)"/>
          <outline text="local(result = html.iso8859encode(text, @mapping))"/>
          <outline text="return result == text"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - empty mapping table - With empty mapping, text should pass through">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="local(text = &quot;Test text&quot;)"/>
          <outline text="local(result = html.iso8859encode(text, @mapping))"/>
          <outline text="return sizeOf(result) &gt; 0"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - character mapping - Map specific characters to ISO-8859-1 equivalents">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="# Map curly quotes to straight quotes (example mapping)"/>
          <outline text="# Note: Actual character codes would be used in real mapping"/>
          <outline text="local(text = &quot;Hello World&quot;)"/>
          <outline text="local(result = html.iso8859encode(text, @mapping))"/>
          <outline text="# Should complete without error"/>
          <outline text="return sizeOf(result) &gt; 0"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="local(result = html.iso8859encode(&quot;&quot;, @mapping))"/>
          <outline text="return result == &quot;&quot;"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - HTML entities preserved - HTML entities should not be affected by encoding">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="local(text = &quot;test &amp;amp; more&quot;)"/>
          <outline text="local(result = html.iso8859encode(text, @mapping))"/>
          <outline text="# Check that &amp;amp; entity is preserved (check for &quot;amp&quot; substring)"/>
          <outline text="return string.contains(result, &quot;amp&quot;)"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - long text - Handle long text strings efficiently">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="# Build long string"/>
          <outline text="local(text = string.filledstring(&quot;x&quot;, 1000))"/>
          <outline text="local(result = html.iso8859encode(text, @mapping))"/>
          <outline text="return sizeOf(result) == 1000"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - with user preferences mapping - Use standard ISO-8859 mapping from preferences">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="skip: Requires standard iso8859 mapping table in builtins"/>
          <outline text="skip_reason: Test skipped - requires html.data.standardMacros.iso8859map to exist"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="# When html.data.standardMacros.iso8859map exists, use it"/>
          <outline text="local(text = &quot;Test text with special chars&quot;)"/>
          <outline text="local(result = html.iso8859encode(text, @html.data.standardMacros.iso8859map))"/>
          <outline text="return sizeOf(result) &gt; 0"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - basic HTML tags - Remove simple HTML tags from text">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Hello &lt;b&gt;World&lt;/b&gt;&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="return result == &quot;Hello World&quot;"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - nested tags - Remove nested HTML tags">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="return searchengine.stripmarkup(&quot;&lt;div&gt;&lt;p&gt;&lt;b&gt;Bold&lt;/b&gt; and &lt;i&gt;italic&lt;/i&gt;&lt;/p&gt;&lt;/div&gt;&quot;) == &quot;Bold and italic&quot;"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - tags with attributes - Remove tags with attributes">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;a href='http://example.com'&gt;Link&lt;/a&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="return result == &quot;Link&quot;"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - self-closing tags - Remove self-closing tags like &lt;br/&gt; and &lt;img/&gt;">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;Line 1&lt;br/&gt;Line 2&lt;img src='test.jpg'/&gt;End&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Tags removed, text preserved"/>
          <outline text="return string.contains(result, &quot;Line 1&quot;) and string.contains(result, &quot;Line 2&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - script tags - Remove script tags and their content">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Text&lt;/p&gt;&lt;script&gt;alert('xss')&lt;/script&gt;&lt;p&gt;More&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Should remove script and its content"/>
          <outline text="return string.contains(result, &quot;Text&quot;) and not string.contains(result, &quot;alert&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - style tags - Remove style tags and their content">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Text&lt;/p&gt;&lt;style&gt;body { color: red; }&lt;/style&gt;&lt;p&gt;More&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Should remove style and its content"/>
          <outline text="return string.contains(result, &quot;Text&quot;) and not string.contains(result, &quot;color&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - HTML entities preserved - HTML entities should remain in output">
        <outline text="Metadata">
          <outline text="skip: UserTalk parser cannot handle &amp;amp; in multi-line scripts"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="return string.contains(searchengine.stripmarkup(&quot;test more&quot;), &quot;test&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - plain text - Text without tags should pass through unchanged">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(text = &quot;Plain text without any tags&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(text))"/>
          <outline text="return result == text"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(result = searchengine.stripmarkup(&quot;&quot;))"/>
          <outline text="return result == &quot;&quot;"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - malformed HTML - Handle malformed HTML gracefully">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Unclosed tag&lt;b&gt;Bold text&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Should handle gracefully and extract text"/>
          <outline text="return string.contains(result, &quot;Unclosed&quot;) and string.contains(result, &quot;Bold&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - multiple spaces collapsed - Multiple spaces and whitespace should be normalized">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Too    many     spaces&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Check that text is extracted (space handling varies)"/>
          <outline text="return string.contains(result, &quot;Too&quot;) and string.contains(result, &quot;spaces&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - line breaks preserved - Line breaks should be preserved in output">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Line 1&lt;/p&gt;\r&lt;p&gt;Line 2&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Both lines should be in result"/>
          <outline text="return string.contains(result, &quot;Line 1&quot;) and string.contains(result, &quot;Line 2&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - comment tags removed - HTML comments should be removed">
        <outline text="Metadata">
          <outline text="skip: UserTalk parser cannot handle &lt; character in string literals (even inside quotes)"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="return not string.contains(searchengine.stripmarkup(&quot;Text comment More&quot;), &quot;comment&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - CDATA sections - CDATA sections should be handled">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Text&lt;/p&gt;&lt;![CDATA[data here]]&gt;&lt;p&gt;More&lt;/p&gt;&quot;)"/>
          <outline text="local(result = searchengine.stripmarkup(html))"/>
          <outline text="# Should handle CDATA without crashing"/>
          <outline text="return sizeOf(result) &gt; 0"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - DOCTYPE declarations - DOCTYPE should be removed">
        <outline text="Metadata">
          <outline text="skip: UserTalk parser cannot handle &lt; character in string literals (even inside quotes)"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="return not string.contains(searchengine.stripmarkup(&quot;DOCTYPE Content&quot;), &quot;DOCTYPE&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine.stripmarkup - XML/XHTML - Handle XML/XHTML tags">
        <outline text="Metadata">
          <outline text="skip: UserTalk parser cannot handle &lt; character in string literals (even inside quotes)"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="return string.contains(searchengine.stripmarkup(&quot;xml version=1.0 Text&quot;), &quot;Text&quot;)"/>
        </outline>
      </outline>
      <outline text="searchengine - index page content - Strip markup before indexing for search">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(htmlPage = &quot;&lt;html&gt;&lt;head&gt;&lt;title&gt;My Page&lt;/title&gt;&lt;/head&gt;&lt;body&gt;&lt;h1&gt;Welcome&lt;/h1&gt;&lt;p&gt;This is &lt;b&gt;important&lt;/b&gt; content.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;&quot;)"/>
          <outline text="local(indexableText = searchengine.stripmarkup(htmlPage))"/>
          <outline text="# Should have title and content"/>
          <outline text="local(hasTitle = string.contains(indexableText, &quot;My Page&quot;))"/>
          <outline text="local(hasContent = string.contains(indexableText, &quot;important&quot;))"/>
          <outline text="local(noTags = not string.contains(indexableText, &quot;&lt;h1&gt;&quot;))"/>
          <outline text="return hasTitle and hasContent and noTags"/>
        </outline>
      </outline>
      <outline text="searchengine - strip markup for search results - Generate clean snippet for search results">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;The &lt;b&gt;quick&lt;/b&gt; brown &lt;i&gt;fox&lt;/i&gt; jumps over the lazy dog.&lt;/p&gt;&quot;)"/>
          <outline text="local(snippet = searchengine.stripmarkup(html))"/>
          <outline text="# Should be readable plain text"/>
          <outline text="return string.contains(snippet, &quot;quick brown fox&quot;)"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - export workflow - Encode special characters before export">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="# Simulate encoding workflow"/>
          <outline text="local(text = &quot;Content with special characters&quot;)"/>
          <outline text="local(encoded = html.iso8859encode(text, @mapping))"/>
          <outline text="# Then clean for export"/>
          <outline text="local(cleaned = html.cleanforexport(encoded))"/>
          <outline text="return sizeOf(cleaned) &gt; 0"/>
        </outline>
      </outline>
      <outline text="html - complete text processing pipeline - Process macros, strip markup, clean for export">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="skip: UserTalk parser has issues with string.contains after multiple local assignments"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(pageTable)"/>
          <outline text="lang.new(tableType, @pageTable)"/>
          <outline text="local(processed = html.processmacros(&quot;test bold text&quot;, false, @pageTable))"/>
          <outline text="local(plain = searchengine.stripmarkup(processed))"/>
          <outline text="local(final = html.cleanforexport(plain))"/>
          <outline text="return sizeOf(final) &gt; 0"/>
        </outline>
      </outline>
      <outline text="searchengine - strip markup with entities workflow - Preserve entities while removing tags">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(html = &quot;&lt;p&gt;Use &amp;lt;tag&amp;gt; for HTML and &amp;amp; for ampersand&lt;/p&gt;&quot;)"/>
          <outline text="local(plain = searchengine.stripmarkup(html))"/>
          <outline text="# Entities should be preserved"/>
          <outline text="return string.contains(plain, &quot;&amp;lt;tag&amp;gt;&quot;) and string.contains(plain, &quot;&amp;amp;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.iso8859encode - batch processing - Encode multiple strings consistently">
        <outline text="Metadata">
          <outline text="requires_system_root: True"/>
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(mapping)"/>
          <outline text="lang.new(tableType, @mapping)"/>
          <outline text="local(text1 = html.iso8859encode(&quot;First text&quot;, @mapping))"/>
          <outline text="local(text2 = html.iso8859encode(&quot;Second text&quot;, @mapping))"/>
          <outline text="local(text3 = html.iso8859encode(&quot;Third text&quot;, @mapping))"/>
          <outline text="# All should complete successfully"/>
          <outline text="return (sizeOf(text1) &gt; 0) and (sizeOf(text2) &gt; 0) and (sizeOf(text3) &gt; 0)"/>
        </outline>
      </outline>
      <outline text="searchengine - extract text from complex HTML - Strip markup from real-world HTML document">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(complexHtml = &quot;&lt;!DOCTYPE html&gt;\r&lt;html&gt;\r&lt;head&gt;\r&lt;meta charset='utf-8'&gt;\r&lt;title&gt;Blog Post&lt;/title&gt;\r&lt;style&gt;body{margin:0;}&lt;/style&gt;\r&lt;/head&gt;\r&lt;body&gt;\r&lt;header&gt;&lt;h1&gt;My Blog&lt;/h1&gt;&lt;/header&gt;\r&lt;article&gt;\r&lt;h2&gt;Post Title&lt;/h2&gt;\r&lt;p&gt;First paragraph with &lt;a href='#'&gt;link&lt;/a&gt;.&lt;/p&gt;\r&lt;p&gt;Second paragraph with &lt;img src='test.jpg' alt='image'/&gt;.&lt;/p&gt;\r&lt;/article&gt;\r&lt;footer&gt;Copyright 2026&lt;/footer&gt;\r&lt;script&gt;console.log('test');&lt;/script&gt;\r&lt;/body&gt;\r&lt;/html&gt;&quot;)"/>
          <outline text="local(plainText = searchengine.stripmarkup(complexHtml))"/>
          <outline text="# Should extract all visible text"/>
          <outline text="local(hasTitle = string.contains(plainText, &quot;Blog Post&quot;))"/>
          <outline text="local(hasContent = string.contains(plainText, &quot;First paragraph&quot;))"/>
          <outline text="local(noScript = not string.contains(plainText, &quot;console.log&quot;))"/>
          <outline text="local(noStyle = not string.contains(plainText, &quot;margin&quot;))"/>
          <outline text="return hasTitle and hasContent and noScript and noStyle"/>
        </outline>
      </outline>
    </outline>
  </body>
</opml>
