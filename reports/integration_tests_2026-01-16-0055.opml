          <outline text="expected_result: The answer is 42."/>
        </outline>
        <outline text="Script">
          <outline text="local(pagetable)"/>
          <outline text="lang.new(tableType, @pagetable)"/>
          <outline text="return html.processmacros(&quot;The answer is {40+2}.&quot;, false, @pagetable)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - escape all macros (empty safe list) - All macros should be escaped when safe list is empty">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{dangerous.call()}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Escaped version should be longer than original (entities are longer than single chars)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - allow safe macro - Safe macros in whitelist should not be escaped">
        <outline text="Metadata">
          <outline text="expected_result: {safe}"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="safemacros.safe = true"/>
          <outline text="local(result = html.neutermacros(&quot;{safe}&quot;, @safemacros))"/>
          <outline text="return result"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - mixed safe and unsafe - Escape only unsafe macros, leave safe ones">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="safemacros.safe = true"/>
          <outline text="local(original = &quot;{safe} {unsafe}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Safe macro unchanged, unsafe macro escaped (result longer than original)"/>
          <outline text="local(hasSafe = string.patternMatch(&quot;{safe}*&quot;, result))"/>
          <outline text="local(isLonger = sizeOf(result) &gt; sizeOf(original))"/>
          <outline text="return hasSafe and isLonger"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - prevent file.delete attack - SECURITY: Dangerous file operations must be neutered">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{file.delete(\&quot;important\&quot;)}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - prevent script execution - SECURITY: Arbitrary script execution must be blocked">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
          <outline text="lang.new(tableType, @safemacros)"/>
          <outline text="local(original = &quot;{dialog.alert(\&quot;xss\&quot;)}&quot;)"/>
          <outline text="local(result = html.neutermacros(original, @safemacros))"/>
          <outline text="# Verify it got escaped (result longer due to HTML entities)"/>
          <outline text="return sizeOf(result) &gt; sizeOf(original)"/>
        </outline>
      </outline>
      <outline text="html.neutermacros - empty string - Empty string should not crash">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="local(safemacros)"/>
