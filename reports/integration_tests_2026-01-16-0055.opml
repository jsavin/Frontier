        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;hello world&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - special characters - Encode string with special characters">
        <outline text="Metadata">
          <outline text="expected_result: hello%20%26%20goodbye"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;hello &amp; goodbye&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - query string characters - Encode characters used in query strings">
