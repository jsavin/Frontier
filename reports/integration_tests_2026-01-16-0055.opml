        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;name=John&amp;age=30&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - empty string - Encoding empty string should work">
        <outline text="Metadata">
          <outline text="expected_result: "/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - no special chars - String with no special characters unchanged">
