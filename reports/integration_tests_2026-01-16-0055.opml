      <outline text="op.expand - expand one level - Expand current node one level (show immediate children)">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="lang.new(outlineType, @workspace.outline)"/>
