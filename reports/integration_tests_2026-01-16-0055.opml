          <outline text="expected_result: path%2Fto%20file.html"/>
        </outline>
        <outline text="Script">
          <outline text="html.urlencode(&quot;path/to file.html&quot;)"/>
        </outline>
      </outline>
      <outline text="html.urlencode - Unicode/special characters - Encode non-ASCII characters">
