        </outline>
        <outline text="Script">
          <outline text="local(tmpDir = &quot;{FRONTIER_TEST_TMP_DIR}&quot;)"/>
          <outline text="local(newName = tmpDir + &quot;/&quot; + &quot;frontier_test_rename_new.txt&quot;)"/>
