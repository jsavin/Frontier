      </outline>
      <outline text="op.collapse - collapse current node - Collapse current node (hide all children)">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="lang.new(outlineType, @workspace.outline)"/>
