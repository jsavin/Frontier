          <outline text="t.alpha = &quot;first&quot;"/>
          <outline text="t.middle = &quot;mid&quot;"/>
          <outline text="lang.settarget(@t)"/>
          <outline text="table.sortby(&quot;name&quot;)"/>
          <outline text="return table.getsortorder()"/>
        </outline>
      </outline>
