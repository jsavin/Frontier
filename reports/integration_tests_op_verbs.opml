      <outline text="op.outlinetoxml - basic conversion - Convert simple outline to OPML XML format">
        <outline text="Metadata">
          <outline text="expected_result: true"/>
        </outline>
        <outline text="Script">
          <outline text="lang.new(outlineType, @workspace.outline)"/>
