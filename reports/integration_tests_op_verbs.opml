          </outline>
          <outline text="op.firstSummit()"/>
          <outline text="local(ok = true)"/>
          <outline text="for i = 2 to 11">
            <outline text="op.go(down, 1)"/>
            <outline text="if op.getRefcon() != ((i - 1) * 100)">
              <outline text="ok = false"/>
            </outline>
          </outline>
          <outline text="return ok"/>
