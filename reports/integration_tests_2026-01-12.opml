          <outline text="op.insert(&quot;Bob&quot;, down)"/>
          <outline text="op.insert(&quot;David&quot;, down)"/>
          <outline text="op.sort()"/>
          <outline text="op.firstSummit()"/>
          <outline text="op.go(down, 1)"/>
