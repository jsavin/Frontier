else {
	msg (string.timestring() + ":" + "Error: " + tryError)};
local (day, month, year, hour, minute, second);
date.get (clock.now (), @day, @month, @year, @hour, @minute, @second);
clock.sleepFor (60 - second) //sleep until next minute tick