on resume () {	«Call user's resume scripts.		«Any returned value is ignored.	«Changes:		«Thursday, September 28, 2000 at 6:22:54 PM by JES			«Allow the callback to be an address or the address of an address.	local (i);	if not defined (user.callbacks.resume) {		new (tabletype, @user.callbacks.resume)};	for i = 1 to sizeof (user.callbacks.resume) {		try {			local (adrScript = @user.callbacks.resume [i]);			while typeOf (adrScript^) == addressType {				adrScript = adrScript^};			adrScript^ ()}};	return (true)}