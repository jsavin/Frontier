on getPngHeightWidth (f) {
	//Change notes:
		//3/5/07; 11:17:58 AM by LL
			//Created.
	local (signature, height, width, s, hwlist = {});
	case typeOf (f) {
		addressType {
			on numberFromBytes (ix) {
				local (hexByteOne = string.mid (string.hex (f^ [ix]), 5, 2));
				local (hexByteTwo = string.mid (string.hex (f^ [ix+1]), 5, 2));
				local (hexByteThree = string.mid (string.hex (f^ [ix+2]), 5, 2));
				local (hexByteFour = string.mid (string.hex (f^ [ix+3]), 5, 2));
				return (number ("0x" + hexByteOne + hexByteTwo + hexByteThree + hexByteFour))};
			return ({numberFromBytes (21), numberFromBytes (17)})}; //{height, width}
		stringType;
		filespecType {
			file.open (f);
			signature = string (file.read (f, 16));
			width = number (file.read (f, 4));
			height = number (file.read (f, 4));
			file.close (f)}};
	hwList = hwList + height;
	hwList = hwList + width;
	return (hwList)}
