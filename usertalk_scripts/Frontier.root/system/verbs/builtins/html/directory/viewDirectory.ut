										type = "folder"}
									else {
										if string.lower (url) endswith ".opml" {
											local (adrincache = html.directory.getInclusionFromCache (identifier, url, adrdirectories));
											if typeof (adrincache^) == stringtype {
												text = text + "&nbsp;(Error: " + adrincache^ + ")"};
											type = "folder";
											flfolder = true;
											«local (linkurl)
