on openURL (s, openURLIn=nil) { //3/21/26 by JES
	//Modernized for three runtime modes:
		//GUI mode (isHeadless=false): use legacy AppleEvent path
			//CLI mode (isHeadless=true, macOS with display): use "open" command
			//Headless (isHeadless=true, no display): log URL to console
	//2/15/26; 12:40:28 AM by JES
		//Added Linux and headless macOS support.
	if system.environment.isHeadless {
		if not string.isValidUrl (s) {
			scriptError ("Can't open the URL because it isn't a valid URL.")};
		try {
			sys.openUrl (s);
			return (true)};
		msg ("Open this URL in your browser: " + s);
		return (false)};
	local (id = webBrowser.launch ());
	if id == false or id == 'NONE' {
		return (false)};
	case sys.os () {
		"MacOS" {
			return (appleEvent (id, 'GURL', 'GURL', '----', string (s), 'cwin', openUrlIn))};
		"Win95";
		"WinNT" {
			if string.lower (id) contains "netscape" {
				return (webBrowser.callBrowser (id, "WWW_OpenURL", s + ",,-1"))};
			return (webBrowser.callBrowser (id, "WWW_OpenURL", s))}}}