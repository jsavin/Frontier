on getSubFolder (path) {	«12/13/98; 7:01:34 AM by DW		«A new core verb, we are going to move all UserLand-managed folders in to this folder. Others are welcome to do so too.	local (pc = file.getPathChar ());	local (folderPath = Frontier.pathString + "Guest Databases" + pc);	if not (file.exists (folderPath)) {		if (file.exists (Frontier.pathString + "Nirvana Server" + pc)) {			folderPath = Frontier.pathString + "Nirvana Server" + pc}		else { //Guest Databases not found, Nirvana Server not found, create a Guest Databases folder			file.newFolder (folderPath)}}; //create the Guest Databases folder	path = string.popLeading (path, "/");	path = string.replaceAll (path, "/", pc);	folderPath = folderPath + path;	if not (folderPath endsWith pc) {		folderPath = folderPath + pc};	if not (file.exists (folderPath)) {		file.sureFilePath (folderPath);		file.sureFolder (folderPath)};	return (folderPath)}