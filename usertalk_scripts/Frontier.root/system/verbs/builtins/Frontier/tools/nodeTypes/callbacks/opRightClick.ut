on opRightClick (adradrmenu) {	«Changes		«4/22/06; 4:11:51 AM by JES			«Add Make/Un-Comment commands for script windows. Bug fix: Only display the Expand All Subs command if the heading has sub-subs.		«9/19/05; 3:32:20 PM by JES			«Add Set/Clear Breakpoint and Compile Script commands for script windows.		«8/23/05; 5:57:54 PM by JES			«Added support in the right click menu for Add Link and Jump. Operation on the selection is smart, based on whether it's an outline or a script, read-only or not, in text mode or not, and what the selected text is.		«3/25/02; 8:49:42 PM by JES			«Add the Post to Weblog command, if running in Radio.		«6/23/01; 12:38:36 AM by JES			«If a nodeType has a getBookmarkLogic script, then flbookmarkpossible is true. Call builtins.bookmarksMenu.add to add a bookmark, instead of Frontier.tools.commands.addBookmark.		«12/30/00; 8:02:50 PM by JES			«Only add the Add Link command for nodes which are links, or which have no type.		«12/18/00; 8:52:54 PM by JES			«Script for the Add Bookmark command calls playlist.bookmark.addNodeItem. Make it possible to bookmark a Manila site's homepage, templates, and siteStructureMessage nodes.		«Saturday, December 02, 2000 at 2:46:18 PM by PBS			«Add an Add Link... command when:				«It's an outline.				«The outline is not read only.				«There are no subheads.		«Monday, September 18, 2000 at 5:28:05 AM by DW			«The code for Expand All Subheads was wrong, it was only expanding one level of subheads. 		local (adrMenu = @system.temp.rightClickMenu);		local (adrWindow = target.get ());	local (flSubsExpanded = op.subsExpanded ()); //do we need Expand or Collapse menu item?	local (flHasSubs = (op.countSubs (1) > 0)); //has subheads?	local (flHasSubSubs = (op.countSubs (1) != op.countSubs (2)));	local (flTextMode = wp.inTextMode ());	local (flBreakpoint = script.getBreakpoint ());	local (flComment = script.isComment ());	local (flHtmlFormatting = op.getHtmlFormatting ());	local (lineText = op.getLineText ());	local (lowerOpText = string.lower (string (adrWindow^)));	local (sizeOpText = sizeOf (lowerOpText));	local (selStart, selEnd);	local (selText);	if flTextMode {		wp.getSelect (@selStart, @selEnd);		selText = wp.getSelText ();		flTextMode = true}	else {		selText = op.getLineText ();		selStart = 0; selEnd = sizeOf (selText)};	local (flReadOnly = false);	if not date.versionLessThan (Frontier.version (), "7.0b17") {		flReadOnly = window.isReadOnly (adrWindow)};	local (windowType = typeOf (adrWindow^));	local (flbookmarkpossible);	bundle { //set flbookmarkpossible		flbookmarkpossible = false;		try {			local (adr = table.getCursorAddress ());			if typeof (adr) == addresstype {				flbookmarkpossible = typeof (adr^) == tabletype}};		if not flbookmarkpossible {			local (url);			flbookmarkpossible = op.attributes.getOne ("url", @url)};		«if not flbookmarkpossible //12/18/00 JES: bookmarks are possible for homepage, template and siteStructureMessage nodes			«local (type, url)			«if op.attributes.getOne ("type", @type)				«flbookmarkpossible = string.lower (type) == "manilahomepage"				«if not flbookmarkpossible					«flbookmarkpossible = string.lower (type)  == "manilatemplate"				«if not flbookmarkpossible					«flbookmarkpossible = string.lower (type)  == "manilasitestructuremessage"};		local (nodeType);	op.attributes.getOne ("type", @nodeType);		local (flnewmenu = true);	bundle { //add commands pertinent to the type		local (adrtable);		if Frontier.tools.nodetypes.findnodetype (nodeType, @adrtable) {			local (adrtypemenu = @adrtable^.rightClickMenu);			if defined (adrtypemenu^) {				adrmenu^ = adrtypemenu^;				flnewmenu = false};			if defined (adrtable^.getBookmarkLogic) {				flbookmarkpossible = true}			else { //it might be a builtin node type				if defined (bookmarksMenu.builtinNodeTypes.nodeTypes) {					local (nodeType = nameOf (adrtable^));					if defined (bookmarksMenu.builtinNodeTypes.nodeTypes.[nodeType]) {						flbookmarkpossible = true}}}}};	if flnewmenu {		new (menubartype, adrmenu)};	local (oldtarget = target.set (adrmenu));	local (menuname = "Right-Click Menu");	op.firstSummit ();	op.setLineText (menuname);		bundle { //add the users right-click menu if it's been edited		local (adrusermenu = @user.tools.menus.rightclickmenu);		if defined (adrusermenu^) {			if timemodified (adrusermenu) > (timecreated (adrusermenu) + 5) {				op.insertoutline (adrusermenu, right)}}};		on addCommand (itemName, scriptString) {		menu.addMenuCommand (adrMenu, menuName, itemName, scriptString)};	on addSeparator () {		op.insert ("-", down)};	bundle { //add basic outlining/text commands		if system.environment.isRadio { //Post to Weblog command			if windowType == outlineType {				addCommand ("Post to Weblog", "radio.outliner.menuCommands.postToWeblog ()")}};				if flHasSubs { //Expand and Collapse menu items			if flSubsExpanded { //Collapse				menu.addMenuCommand (adrMenu, menuName, "Collapse", "op.collapse ()")}			else {				addCommand ("Expand", "op.expand (1)")};			if flHasSubSubs { // or (not flSubsExpanded)				if flSubsExpanded {					addSeparator ()};				addCommand ("Expand All Subheads", "op.expand (infinity)")}}		else { //PBS 12/02/00: Add Link... command			if windowType == outlineType {				if not flReadOnly {					if nodeType == nil or string.lower (nodeType) == "link" { //12/30/00 JES						addCommand ("Add Link...", "Frontier.tools.commands.addLink ()")}}}};				addSeparator ();		if not flReadOnly { //Cut command			addCommand ("Cut", "editMenu.cut ()")};		addCommand ("Copy", "editMenu.copy ()");		if not flReadOnly { //Paste command			addCommand ("Paste", "editMenu.paste ()")};		if flbookmarkpossible {			addSeparator ();			addCommand ("Add Bookmark...", "bookmarksMenu.addNode ()")};				bundle { //Script-only commands			if windowType == scriptType {				addSeparator ();				if flBreakpoint {					addCommand ("Clear Breakpoint", "script.clearBreakpoint ()")}				else {					addCommand ("Set Breakpoint", "script.setBreakpoint ()")};				if flComment {					addCommand ("Un-Comment", "script.unComment ()")}				else {					addCommand ("Make Comment", "script.makeComment ()")};				addCommand ("Compile Script", "script.compile (window.frontmost ())")}};				addSeparator ();		bundle { //Jump, Open URL commands for selected text			local (url="", adrJump = "");			on selectionIsWithinUrlTag (adrUrl=nil) {				local (ixStart = selStart+1, ixEnd = selEnd, ct = sizeOf (lineText));				while ixStart > 1 {					if lineText[ixStart] == "<" {						break};					ixStart--};				while ixEnd < ct {					if lineText[ixEnd] == ">" {						break};					ixEnd++};				local (s = string.mid (lineText, ixStart, ixEnd - ixStart + 1));				on compileIt () { //use xml.compile to get a url out of here					try {						local (t);						xml.compile (s, @t);						if defined (t[1].["/atts"].href) {							if adrUrl != nil {								adrUrl^ = t[1].["/atts"].href;								return (true)}};						if defined (t[1].["/atts"].src) {							if adrUrl != nil {								adrUrl^ = t[1].["/atts"].src;								return (true)}}};					return (false)};				return (compileIt ())};			on expandToStopChars (stopcharsleft, stopcharsright) {				local (ix1=selStart + 1, ix2=selEnd, sizetext = sizeOf (lineText));				if ix1 > sizetext {					ix1 = sizetext};				if ix2 > sizetext {					ix2 = sizetext};				if ix1 > 1 {					while not (stopcharsleft contains lineText[ix1]) {						ix1--;						if ix1 == 1 {							break}};					if stopcharsleft contains linetext[ix1] {						ix1++}};				if ix2 < sizetext {					while not (stopcharsright contains lineText[ix2]) {						ix2++;						if ix2 == sizetext {							break}};					if stopcharsright contains linetext[ix2] {						ix2--}};				target.set (oldtarget);				wp.setSelect (ix1-1, ix2);				selText = wp.getSelText ();				wp.getSelect (@selStart, @selEnd);				target.set (adrmenu)};			on expandSelection () {				local (stopchars = " (){};-+*^\\,@<>");				expandToStopChars (stopchars, stopchars);				if selText contains "://" and (not string.nthField (selText, ">", 2) contains "://") {					selStart = selStart + string.patternMatch ("://", selText);					selEnd = selStart;					stopchars = " (){}*^\\@<>\"'";					expandToStopChars (stopchars, stopchars);					url = selText}				else { //an address?					if windowType == outlineType {						if defined (selText^) {							adrJump = selText}}					else { //script						adrJump = selText}};				if flHtmlFormatting and url == "" { //expand selection to include HTML					«if linetext contains "://" //non-working, somewhat illogical code						«local (ix = string.patternMatch ("://", string.mid (linetext, 1, selEnd)))						«if ix > 0							«while ix > 1								«if " \"'" contains linetext[ix]									«ix++									«break								«ix--							«local (s = string.mid (linetext, ix, infinity))							«ix = string.patternMatch ("://", s) + 3							«local (ct = sizeOf (s))							«if ix > ct								«ix = ct							«while ix < ct								«if " \"'" contains s[ix+1]									«break								«ix++							«url = string.mid (s, 1, ix)					local (tagUrl = "");					if selectionIsWithinUrlTag (@tagUrl) { //expand to include the tag (and closing tag), and set the url						expandToStopChars ("<", ">");						target.set (oldtarget);						selEnd++;						wp.setSelect (selStart, selEnd);						target.set (adrmenu);						if tagUrl != "" {							url = tagUrl}}}};			if flTextMode { //expand selection if necessary, and set url				if selStart == selEnd and selStart == sizeOf (linetext) { //special case -- the user most likely right-clicked from another heading while in text mode					target.set (oldtarget);					wp.setTextMode (false);					target.set (adrmenu);					selText = op.getLineText ();					selStart = 0; selEnd = sizeOf (selText);					flTextMode = false}				else { //auto-expand					expandSelection ()}};			if not flTextMode { //try to operate on the whole heading?				if nodeType == "" { //don't get URLs from headings with a node type -- they get handled specially					local (ixurl = string.patternMatch ("://", lineText));					if ixurl > 0 { //is there a URL in there somewhere?						while ixurl != 1 {							ixurl--;							if " \"" contains lineText[ixurl] {								ixurl++;								break}};						url = string.delete (lineText, 1, ixurl-1);						url = string.nthField (url, " ", 1);						url = string.nthField (url, "\"", 1)};					if defined (lineText^) { //the whole heading is the address to jump to						adrJump = lineText}					else { //find the first defined identifier and use it						local (theLine = linetext);						try {							local (t); new (tableType, @t);							on addToT (s) {								local (i, ct = sizeOf (s));								for i = 1 to ct {									t.[s[i]] = " "}};							addToT ("()-+/*=<>^@");							theLine = string.multipleReplaceAll (theLine, @t)};						local (identifier, ctFields = string.countFields (theLine, " "), i);						for i = 1 to ctFields {							identifier = string.nthField (theLine, " ", i);							case string.lower (identifier) { //non-useful identifiers -- skip them								"";								"if";								"on";								"string" {									continue}};							if defined (identifier^) {								if defined (parentOf (identifier^)^) {									adrJump = identifier;									break}};							local (ixInOutline = string.patternMatch ("on " + string.lower (identifier), lowerOpText));							if ixInOutline > 0 {								if ixInOutline == sizeOpText or (" ()\\" contains lowerOpText[ixInOutline+3+sizeOf (identifier)]) {									adrJump = identifier;									break}}}}}};			local (jumpCommand = "(Jump", openUrlCommand = "(Open URL");			if url != "" { //we have a URL to open				openUrlCommand = "Open URL " + url};			if adrJump != "" { //we have an address to jump to				local (sJump = adrJump);				if string.lower (sJump) beginswith "system.verbs.builtins." {					sJump = string.delete (sJump, 1, sizeOf ("system.verbs.builtins."))};				if string.lower (sJump) beginswith "system.verbs." {					sJump = string.delete (sJump, 1, sizeOf ("system.verbs."))};				jumpCommand = "Jump to " + sJump};			addCommand (openUrlCommand, "frontier.tools.windowTypes.commands.openUrl (\"" + string.replaceAll (url, "\"", "\\\"") + "\")");			addCommand (jumpCommand, "system.callbacks.cmd2Click (\"" + string.replaceAll (adrJump, "\"", "\\\"") + "\")")};				if nodeType != "" { //display node type string in dialog box; Get Info, Debug commands			addSeparator ();			addCommand ("Get Info", "Frontier.tools.nodeTypes.getInfo ()");			addCommand ("Debug", "op.attributes.getall (@scratchpad.atts); edit (@scratchpad.atts); window.zoom (@scratchpad.atts)")}};		try {target.set (oldTarget)};		adradrmenu^ = adrmenu;	return (true)};bundle { //test code	local (adrmenu);	opRightClick (@adrmenu)}