«Prompt the user for location and name of the new tool gdb.	«09/30/00; 11:51:33 PM by PBSlocal (f);local (toolsFolder = Frontier.tools.getToolsFolderPath ());f = toolsFolder + "untitled.root";if file.putFileDialog ("New Tool:", @f) {	if file.exists (f) {		if defined ([f]) {			fileMenu.close (f)}};	Frontier.tools.newTool (f);	edit (@[f]); //make gdb visible	window.zoom (@[f])} //zoom the window -- make all top-level items visible