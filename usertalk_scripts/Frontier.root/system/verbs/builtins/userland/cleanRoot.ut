bundle { { //2026-05-06 JES: strip legacy embedded image blob tables (Kevin Hughes EIT icon set)
	//The @websites.samples.["#images"] and @websites.samples.UserLand.["#images"]
	//tables hold ~94 MB of GIFs from the Kevin Hughes 1995 EIT public-domain
	//icon set, embedded into Virgin.root as legacy docserver / Manila content.
	//None of these blobs are referenced by any path Frontier currently uses
	//(legacy webserver, Manila, Betty, docserver are all stubbed or removed).
	//
	//We strip the #images sub-tables specifically; the rest of @websites
	//(including @websites.samples.default, .["#data"], .["#ftpSite"], etc.)
	//is preserved because integration tests still reference those addresses
	//and html.cleanForExport's default arg points at @websites.["#data"].
	//
	//Also strip @fatpages (legacy Manila page cache) and
	//@user.html.changedPages (transient outline). firstRootRun re-creates
	//user.html.changedPages.
	try {delete (@websites.samples.["#images"])};;
	try {delete (@websites.samples.UserLand.["#images"])};;
	try {delete (@fatpages)};;
	try {delete (@user.html.changedPages)}};};

filemenu.save ();;

