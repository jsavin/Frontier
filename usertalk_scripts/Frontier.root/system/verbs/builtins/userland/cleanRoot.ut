	Frontier.tools.thread.ct = 0;;
	Frontier.tools.thread.enabled = true};};

bundle { { //save a copy
	local (f = frontier.pathstring + "Virgin.root");;
	//file.move (f, file.getSpecialFolderPath (file.volumeFromPath (f), "Trash", false))
	local (oldtarget = target.set (@root));;
	FileMenu.saveCopy (f);;
	try {target.set (oldtarget)};;
	bundle { { //2026-05-06 JES: compact the saveCopy output so dist Virgin.root has no avail-list dead space
		//FileMenu.saveCopy is a byte-copy (preserves avail-list dead space).
		//db.compactDatabase walks live records only, so the result is the
		//minimum size needed to represent the data. Without this step the
		//stripped tables above stay in the file as freed-but-not-truncated
		//blocks. Order matters: we must compact AFTER saveCopy because the
		//compaction temp file opens f as a guest db.
		//
		//Error handling: on any failure (open, compact, delete, move),
		//surface a scriptError with the failing step so dist builds fail
		//loudly instead of silently producing a non-compacted Virgin.root.
		//db.compactDatabase auto-closes the source on success and
		//force-closes on failure, so no manual db.close is needed (and
		//calling db.close after a successful compact would error).
		local (slimPath = f + ".compact");;
		try {file.delete (slimPath)};;
		local (compactErr = "");;
		try { {
			db.open (f, false);;
			db.compactDatabase (f, slimPath)}} //auto-closes f
		else { {
			compactErr = "compact failed: " + tryError};};
		if compactErr != "" { {
			//best-effort cleanup of any stranded slimPath
			try {file.delete (slimPath)};;
			scriptError ("cleanRoot: " + compactErr)};};
		if not file.exists (slimPath) { {
			scriptError ("cleanRoot: compact returned ok but slimPath missing: " + slimPath)};};
		try {file.delete (f)}
		else { {
			//slimPath has the new content; leave it for manual recovery
			scriptError ("cleanRoot: failed to delete saveCopy output before move: " + tryError)};};
		if file.exists (f) { {
			scriptError ("cleanRoot: f still exists after delete: " + f)};};
		try {file.move (slimPath, f)}
		else { {
			scriptError ("cleanRoot: failed to move slimPath to f: " + tryError)};};
		if not file.exists (f) { {
			scriptError ("cleanRoot: move succeeded but final Virgin.root missing: " + f)}}};}}};
