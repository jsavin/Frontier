on reconcileFolder (original, clone, copyFilter) {
	//3.0.2: validate input parameters as folders. also fixed path calcuation 
		//when the case of original or clone differed from that used in the file system
	if not file.isFolder (original) {
		scriptError ("\"" + file.fileFromPath (original) + "\" is not a folder.")};
	original = filespec (original);
	
	if not file.isFolder (clone) {
		scriptError ("\"" + file.fileFromPath (clone) + "\" is not a folder.")};
	clone = filespec (clone);
	
	local (extraname = "Extra Files" + file.getPathChar ());
	on checkForMissingFiles (path) {
		local (f);
		fileloop (f in path) { //loop over files in the original folder
			rollBeachBall ();
			if file.isFolder (f) { //skip any folder named Extra Files
				if file.fileFromPath (f) == extraname {
					continue}};
			clonepath = clone + (f - original);
			if not file.exists (clonepath) { //file or folder is missing
				file.filteredCopy (f, clonepath, copyFilter)}
			else {
				if file.isFolder (f) {
					checkForMissingFiles (f)}
				else {
					if file.modified (f) > file.modified (clonepath) { //the user changed the file
						file.filteredCopy (f, clonepath, copyFilter)}}}}};
	checkForMissingFiles (original);
	
	local (userfolder = clone + extraname);
	on checkForExtraFiles (path) {
		local (f);
		fileloop (f in path) {
			rollBeachBall ();
			if f != userfolder { //don't look at or inside of the user's personal folder
				origpath = original + (f - clone);
				if not file.exists (origpath) { //new file created by user, move it to personal folder
					if file.exists (userfolder) {
						if not file.isFolder (userfolder) { //we're really paranoid
							file.delete (userfolder);
							file.newFolder (userfolder)}}
					else {
						msg (userfolder);
						file.newFolder (userfolder)};
					file.move (f, userfolder)}
				else { //the file is a copy from the original folder
					if file.isFolder (f) {
						checkForExtraFiles (f)}}}}};
	checkForExtraFiles (clone)}; //make sure there aren't any extra files or folders in the clone
bundle { //test code
	on filter (f) {
		msg (f);
		return (true)};
	reconcileFolder (user.mirrors.mirror001.source, user.mirrors.mirror001.dest, @filter)}