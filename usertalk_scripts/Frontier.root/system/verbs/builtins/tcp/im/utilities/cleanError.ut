on cleanError (s) {
	//Changes
		//8/12/02; 2:17:33 AM by JES
			//Created. Strip out smart quotes.
	if system.environment.isMac {
		s = string.replaceAll (s, "“", "\"");
		s = string.replaceAll (s, "”", "\"");
		s = string.replaceAll (s, "‘", "\'");
		s = string.replaceAll (s, "’", "\'")};
	return (s)}