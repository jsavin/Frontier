on registerProtocol (x, forProtocol) { «Registers application as a “handler” for this protocol with a given prefix. The handler will receive “OpenURL”, or if that fails, “GetURL” event.	pack (x, @x);	setbinarytype (@x, 'sign');	return (appleEvent (Netscape.id, 'WWW!', 'RGPR', '----', x, 'PROT', string (forProtocol)))}