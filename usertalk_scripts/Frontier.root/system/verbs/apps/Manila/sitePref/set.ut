on set (adrSitePrefs, prefname, prefdata) {	«Changes		«9/6/01; 8:32:57 PM by JES			«Changed params from a list to a record of named parameters, for SOAP compatibility.	with adrSitePrefs^ {		local (params = {"username":username, "password":string (password), "siteName":sitename, "prefName":prefname, "prefdata":prefdata});		return (manila.callHandler (host, port, "manila.sitepref.set", @params, rpcPath:rpcPath))}}