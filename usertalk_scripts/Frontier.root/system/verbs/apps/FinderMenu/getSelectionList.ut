on getSelectionList () {
	if Finder.isScriptable () {
		with objectModel, Finder {
			try {
				local (x = get (selection, as:filespectype));
				return (list (x))}
			else {
				return {}}}}
	else {
		return (appleEvent (@FinderMenu.ucmd.code, 'ƒSel', 'ƒSel'))}};
bundle { //test code
	dialog.alert (getSelectionList ())}