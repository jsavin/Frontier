on getUpdated (adrSession, objectType, startDate, endDate) {
	//Changes
		//4/19/06; 7:47:53 PM by JES
			//Created. Returns a list of Id's for objects of the given type, which have been updated between startDate and endDate.
	local (retval = salesforce.callApi (adrSession, nameOf (this^), {"sObjectType":objectType, "startDate":startDate, "endDate":endDate}));
	if sizeOf (retval) == 0 {
		return ({})};
	if typeOf (retval[1]) == listType {
		return (retval[1])};
	return ({retval[1]})}
