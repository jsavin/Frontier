on create (adrSession, objectType, adrDataTable) {
	//Changes
		//4/20/06; 3:02:54 AM by JES
			//Created. Create an object of the given objectType, with field values as specified by name/value pairs in the table referenced by adrDataTable.
	local (t); new (tableType, @t);
	local (adr);
	for adr in adrDataTable {
		t.["ns3:" + nameOf (adr^)] = adr^};
	local (retval = salesforce.callApi (adrSession, nameOf (this^), {"sObjects":t}, objectType));
	if retval.success {
		return (retval.id)}
	else { //throw the error
		scriptError ("Can't create the object because the server returned an error: " + retval.errors.message)}};
