on describeLayout (adrSession, objectType) {
	«Changes
		«4/13/06; 2:45:39 AM by JES
			«Created. Return a description of the specified object type's layout (as returned by salesforce.describeLayout).
	return (salesforce.callApi (adrSession, nameOf (this^), {"sObjectType":objectType}))};
«bundle //test code
	«local (adrses)
	«bundle //set adrses
		«if defined (temp.salesforce.sessions) and sizeOf (temp.salesforce.sessions)
			«local (sesnum = sizeOf (temp.salesforce.sessions))
			«adrses = @temp.salesforce.sessions[sesnum]
		«else //log in
			«salesforce.login (workspace.salesforcecomUsername, workspace.salesforcecomPassword, @adrses)
	«table.assign (@workspace.retval, this^ (adrses, "Account"))
	«edit (@workspace.retval)