on cleanReturnStruct (adrStruct) {
	«Changes
		«4/19/06; 6:40:35 PM by JES
			«Created. Clean up data objects in a struct returned by a call to the Salesforce API.
				«The main thing we address is the fact that the API returns arrays of structs, which we convert to struct of structs (table of tables) to make them more accessible to UserTalk scripts.
	
	on doLevel (adrtable) {
		local (i, ct = sizeOf (adrtable^));
		for i = ct downto 1 {
			local (adr = @adrtable^[i]);
			case typeOf (adr^) {
				tableType {
					doLevel (adr)};
				listType {
					if sizeOf (adr^) {
						if typeOf (adr^[1]) == tableType {
							salesforce.utilities.arrayOfStructToStructOfStruct (adr);
							adr = @adrtable^[i]; //avoid possible crash
							doLevel (adr)}}}}}};
	
	if typeOf (adrStruct^) == tableType {
		doLevel (adrStruct)};
	
	return (true)};
«bundle //testing
	«cleanReturnStruct (@workspace.retval)