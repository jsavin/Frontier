on update (adrSession, objectType, objectId, adrDataTable) {	«Changes		«4/20/06; 3:02:54 AM by JES			«Created. Update an object of the given objectType, with field values as specified by name/value pairs in the table referenced by adrDataTable.				«Returns the Id of the updated object.	local (t); new (tableType, @t);	local (adr);	for adr in adrDataTable {		t.["ns3:" + nameOf (adr^)] = adr^};	t.["ns3:Id"] = objectId;	local (retval = salesforce.callApi (adrSession, nameOf (this^), {"sObjects":t}, objectType));	if retval.success {		return (retval.id)}	else { //throw the error		scriptError ("Can't update the object because the server returned an error: " + retval.errors.message)}};«bundle //testing	«local (adrses)	«bundle //set adrses		«if defined (temp.salesforce.sessions) and sizeOf (temp.salesforce.sessions)			«local (sesnum = sizeOf (temp.salesforce.sessions))			«adrses = @temp.salesforce.sessions[sesnum]		«else //log in			«salesforce.login (workspace.salesforcecomUsername, workspace.salesforcecomPassword, @adrses)	«local (t); new (tableType, @t)	«t.Name = "Nutty Fuzzbutter"	«table.assign (@workspace.retval, this^ (adrses, "Account", "0013000000D0Hl4AAF", @t) )	«table.assign (@workspace.retval, this^ (adrses, "Account", "doesntExist", @t) )	«edit (@workspace.retval)