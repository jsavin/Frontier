on login (username, password, adrAdrSession, adrEndpoint=@salesforce.data.defaultEndpoint) {
	//Changes
		//4/26/06; 6:54:23 PM by JES
			//Remove email address from test code.
		//4/13/06; 1:44:20 AM by JES
			//Created. Login to salesforce.com API, and get credentials needed for subsequent calls.
				//Credentials and other session information are stored in a table in system.temp.salesforce, and the address of the table is stored in adrAdrSession.
			//Returns true if the login was successful, or an error if not.
	local (endpoint, sessionBasename);
	if not defined (system.temp.salesforce) {
		new (tableType, @system.temp.salesforce)};
	if not defined (system.temp.salesforce.sessions) {
		new (tableType, @system.temp.salesforce.sessions)};
	
	with adrEndpoint^ { //set up SCNS endpoint
		endpoint = "soap://" + server;
		if port != 80 {
			endpoint = endpoint + ":" + port};
		endpoint = endpoint + path;
		sessionBasename = endpoint;
		if defined (namespaceUri) {
			if namespaceUri != "" {
				endpoint = endpoint + "?ns=" + namespaceUri}}};
	
	local (adrSession = table.uniqueName (sessionBasename + ",", @system.temp.salesforce.sessions, 7));
	adrSession^ = [endpoint].login (username:username, password:password);
	adrSession^.whenLoggedOn = clock.now ();
	
	adrSession^.passwordExpired = boolean (adrSession^.passwordExpired);
	
	adrSession^.namespaceUri = adrEndpoint^.namespaceUri;
	adrSession^.objectNamespaceUri = adrEndpoint^.objectNamespaceUri;
	
	adrAdrSession^ = adrSession;
	
	return (true)};
