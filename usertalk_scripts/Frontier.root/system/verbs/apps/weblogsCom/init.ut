//Changes
	//9/23/05; 12:13:12 PM by LL
		//Use the radio.weblogs.com changes.xml.
	//11/11/01; 7:09:36 PM by DW
		//Support post-corner-turn Weblogs.Com.
		//No more temp table, store the status message in the settings table.
	//10/25/01; 6:14:51 PM by DW
		//Add system.temp.weblogsCom table.
local (adrdata = frontier.openDataFile ("weblogsComData"));
if not defined (adrdata^.prefs) {
	new (tabletype, @adrdata^.prefs)};
if not defined (adrdata^.prefs.changesUrl) {
	if defined (myUserLandData.weblogsCom.prefs.changesUrl) {
		adrdata^.prefs.changesUrl = myUserLandData.weblogsCom.prefs.changesUrl}
	else {
		adrdata^.prefs.changesUrl = "http://static.userland.com/weblogMonitor/changesShort.xml"}};
bundle { //support post-corner-turn Weblogs.Com
	if adrdata^.prefs.changesUrl == "http://static.userland.com/weblogMonitor/changesShort.xml" {
		adrdata^.prefs.changesUrl = "http://radio.weblogs.com/weblogUpdates/changes.xml"}};
if not defined (adrdata^.prefs.flLogWeblogsComRead) {
	if defined (myUserLandData.prefs.flLogWeblogsComRead) {
		adrdata^.prefs.flLogWeblogsComRead = myUserLandData.prefs.flLogWeblogsComRead}
	else {
		adrdata^.prefs.flLogWeblogsComRead = true}};
if not defined (adrdata^.prefs.minuteToRead) {
	if defined (myUserLandData.prefs.minuteToReadWeblogsCom) {
		adrdata^.prefs.minuteToRead = myUserLandData.prefs.minuteToReadWeblogsCom}
	else {
		adrdata^.prefs.minuteToRead = 15}};
if not defined (adrdata^.prefs.enabled) {
	adrdata^.prefs.enabled = true};
if not defined (adrdata^.changes) {
	new (tabletype, @adrdata^.changes)};
if not defined (adrdata^.favorites) {
	if defined (myUserLandData.weblogsCom.favorites) {
		adrdata^.favorites = myUserLandData.weblogsCom.favorites}
	else {
		new (tabletype, @adrdata^.favorites)}};
if not defined (adrdata^.weblogs) {
	new (tabletype, @adrdata^.weblogs)};
if not defined (adrdata^.settings) {
	new (tabletype, @adrdata^.settings)};
if not defined (adrdata^.settings.dateLastRead) {
	adrdata^.settings.dateLastRead = date (0)};
if not defined (adrdata^.settings.statusMessage) {
	adrdata^.settings.statusMessage = "";
	weblogsCom.read ()};
bundle { //make sure everyMinute script is installed, if necessary
	if not defined (adrdata^.settings.flInstalled) {
		if not defined (user.scheduler.everyMinute.weblogsCom) {
			if adrdata^.prefs.enabled {
				user.scheduler.everyMinute.weblogsCom = @weblogsCom.everyMinute;
				adrdata^.settings.flInstalled = true}}}}; //only do this once
//bundle //add temp table
	//if not defined (system.temp.weblogsCom)
		//new (tabletype, @system.temp.weblogsCom)
	//if not defined (system.temp.weblogsCom.status)
		//system.temp.weblogsCom.status = ""
return (adrdata)