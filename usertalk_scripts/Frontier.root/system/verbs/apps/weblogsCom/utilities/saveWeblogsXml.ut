«Changes	«11/3/01; 9:29:30 AM by DW		«Created. Saves an XML representation of the weblogs table.window.about ();msg ("Copying table..");local (adrdata = weblogsCom.init ());local (myWeblogTable = adrdata^.weblogs);msg ("Deleting email addresses..");local (adr);for adr in @myWeblogTable {	delete (@adr^.ownerEmail)};msg ("Generating the XML..");local (xmltext = table.tableToXml (@myWeblogTable));file.writewholefile (frontier.pathstring + "myWeblogs.xml", xmltext);msg ("")