on view (cellBgColor=radio.data.htmlColors.cellBgColor, frameColor=radio.data.htmlColors.frameColor) {
	«Changes:
		«1/6/02; 4:42:14 AM by JES
			«Added table css classes.
		«11/24/01; 4:03:36 PM by DW
			«Linked into help system.
		«11/12/01; 5:34:50 AM by DW
			«Rewrite for post-corner-turn Weblogs.Com.
		«11/8/01; 1:34:58 AM by JES
			«If no favorite weblogs have been updated since the last scan, insert a message saying so. If you have not chosen any favorites, insert a message saying so. Only show the Disfavor button when there are favorites in the list to disfavor.
		«10/11/01; 6:22:37 PM by PBS
			«New optional parameters for framecolor and bgcolor. This removes references to myUserLandData.
	local (pta = html.getpagetableaddress ());
	pta^.title = radio.string.getlocalizedstring ("weblogsCom.title");
	«scratchpad.params = pta^
	local (adrdata = weblogsCom.init ());
	if sizeof (adrdata^.changes) == 0 { //fresh install
		weblogsCom.read ()}
	else {
		if (clock.now () - adrdata^.settings.dateLastRead) >= 3600 { //more than one hour
			weblogsCom.read ()}};
	local (htmltext = "\r", indentlevel = 0);
	on add (s) {
		htmltext = htmltext + string.filledstring ("\t", indentlevel) + s + "\r\n"};
	
	local (lasthourtable);
	bundle { //fill lasthourtable
		local (i, adr, secssinceupdate);
		new (tabletype, @lasthourtable);
		for i = sizeof (adrdata^.changes) downto 1 {
			adr = @adrdata^.changes [i];
			secssinceupdate = number (adrdata^.settings.dateLastRead) - number (adr^);
			if secssinceupdate > 3600 {
				break};
			lasthourtable.[nameof (adr^)] = true}};
	
	local (args);
	if pta^.method == "POST" {
		new (tabletype, @args);
		webserver.parseargs (pta^.requestBody, @args);
		«scratchpad.args = args; edit (@scratchpad.args)
		if defined (args.addToFavorites) {
			delete (@args.addToFavorites);
			for adr in @args {
				name = string.urldecode (nameof (adr^));
				adrdata^.favorites.[name] = clock.now ()}};
		if defined (args.removeFromFavorites) {
			delete (@args.removeFromFavorites);
			for adr in @args {
				name = string.urldecode (nameof (adr^));
				try {delete (@adrdata^.favorites.[name])}}}};
	add ("<p><i>" + radio.string.getlocalizedstring ("weblogsCom.lastupdate") + ": " + adrdata^.settings.dateLastRead + ".</i></p>");
	add ("<p>" + radio.string.getlocalizedstring ("weblogsCom.intro") + " " + radio.userinterface.helpLink ("The Weblogs page") + "</p>");
	add ("<table cellspacing=\"0\" cellpadding=\"10\"><tr>"); indentlevel++;
	add ("<td valign=\"top\">"); indentlevel++;
	bundle { //add the last hour's changes table
		add ("<form method=\"POST\">"); indentlevel++;
		add ("<table class=\"dwsFrameTable\" cellspacing=\"0\" cellpadding=\"0\"><tr bgcolor=\"" + framecolor + "\"><td>"); indentlevel++;
		add ("<table class=\"dwsTable\" cellspacing=\"1\" cellpadding=\"3\">"); indentlevel++;
		local (day, month, year, hour, minute, second);
		date.get (adrdata^.settings.dateLastRead, @day, @month, @year, @hour, @minute, @second);
		add ("<tr><td class=\"dwsTableCellHeader\" colspan=\"2\"><b>" + date.hourtostring (hour) + " changes</b></td></tr>");
		for adr in @lasthourtable {
			name = nameof (adr^);
			if not defined (adrdata^.favorites.[name]) {
				local (adrlog = @adrdata^.weblogs.[name]);
				add ("<tr bgcolor=\"" + cellbgcolor + "\">"); indentlevel++;
				bundle { //add checkbox
					local (checkboxval = "xxx ");
					if false {
						checkboxval = checkboxval + "checked"};
					add ("<td class=\"dwsTableCell\" valign=\"top\"><input type=\"checkbox\" name=\"" + string.urlencode (name) + "\" value=" + checkboxval + "></td>")};
				add ("<td class=\"dwsTableCell\"><a href=\"" + adrlog^.url + "\">" + name + "</a></td>");
				add ("</tr>"); indentlevel--}};
		add ("</table>"); indentlevel--;
		add ("</td></tr></table>"); indentlevel--;
		add ("<br><input type=\"submit\" name=\"addToFavorites\" value=\"" + radio.string.getlocalizedstring ("weblogsCom.addButton") + "\">");
		add ("</form>"); indentlevel--};
	add ("</td>"); indentlevel--;
	add ("<td valign=\"top\">"); indentlevel++;
	bundle { //add the favorites
		add ("<form method=\"POST\">"); indentlevel++;
		add ("<table class=\"dwsFrameTable\" cellspacing=\"0\" cellpadding=\"0\"><tr bgcolor=\"" + framecolor + "\"><td>"); indentlevel++;
		add ("<table class=\"dwsTable\" cellspacing=\"1\" cellpadding=\"3\">"); indentlevel++;
		add ("<tr><td class=\"dwsTableCellHeader\" colspan=\"3\"><b>Favorites</b></td></tr>");
		local (ctfavorites = 0);
		if sizeOf (adrdata^.favorites) > 0 {
			local (i, name, adr);
			for i = sizeof (adrdata^.changes) downto 1 {
				adr = @adrdata^.changes [i];
				name = nameof (adr^);
				if defined (adrdata^.favorites.[name]) {
					local (adrlog = @adrdata^.weblogs.[name]);
					add ("<tr bgcolor=\"" + cellbgcolor + "\">"); indentlevel++;
					bundle { //add checkbox
						local (checkboxval = "xxx ");
						if false {
							checkboxval = checkboxval + "checked"};
						add ("<td class=\"dwsTableCell\" valign=\"top\"><input type=\"checkbox\" name=\"" + string.urlencode (name) + "\" value=" + checkboxval + "></td>")};
					add ("<td class=\"dwsTableCell\"><a href=\"" + adrlog^.url + "\">" + name + "</a></td>");
					local (day, month, year, hour, minute, second);
					date.get (adr^, @day, @month, @year, @hour, @minute, @second);
					add ("<td class=\"dwsTableCell\" valign=\"middle\" align=\"right\"><font size=\"-2\" color=\"gray\">&nbsp;" + date.hourtostring (hour) + "&nbsp;</font></td>");
					add ("</tr>"); indentlevel--;
					ctfavorites++}};
			if ctfavorites == 0 { //insert a message saying that no favorites have been updated
				add ("<tr bgcolor=\"" + cellbgcolor + "\">"); indentlevel++;
				add ("<td class=\"dwsTableCell\" width=\"200\">The favorites list is empty because none of your favorite weblogs have been updated in the last twenty-four hours.</td>");
				add ("</tr>"); indentlevel--}}
		else { //no favorites
			add ("<tr bgcolor=\"" + cellbgcolor + "\">"); indentlevel++;
			add ("<td class=\"dwsTableCell\" width=\"200\">Your favorite weblogs will appear in this list when they're updated.<p>To choose your favorites, check the box next to the weblog in the table at the left, and click the Add to Favorites button.</td>");
			add ("</tr>"); indentlevel--};
		add ("</table>"); indentlevel--;
		add ("</td></tr></table>"); indentlevel--;
		if ctfavorites > 0 {
			add ("<br><input type=\"submit\" name=\"removeFromFavorites\" value=\"" + radio.string.getlocalizedstring ("weblogsCom.disfavorButton") + "\">")};
		add ("</form>"); indentlevel--};
	add ("</td>"); indentlevel--;
	add ("</tr></table>"); indentlevel--;
	return (htmltext)};
«bundle //test code
	«html.setpagetableaddress (@scratchpad.params)
	«view ()