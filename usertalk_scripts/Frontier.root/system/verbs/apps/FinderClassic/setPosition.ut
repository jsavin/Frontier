on setPosition (folderpath, h, v) { « set the position of the indicated folder's window	local (fwindow);	if not Finder.makeWindow (folderpath, 0, @fwindow) {		return (false)};	newpos = long (point.set (h, v));	return (finderEvent (Finder.id, Finder.class, 'posn', '----', fwindow, 'fmsc', newpos))}