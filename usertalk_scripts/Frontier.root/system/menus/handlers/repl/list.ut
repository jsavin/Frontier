on list (path = "") {
	//List the contents of a REPL focus table (or the current one).
		//5/8/26 by JES
			//Issue #594 -- accept optional path arg so the slash-command and
			//palette accepts_args paths both route through this handler via
			//the unified palette_arg_inject synthesis. Empty / missing path
			//falls through to repl.list (""), which lists the current focus
			//table (existing behavior).
		//5/29/26 by JES
			//Issue #674 -- when called from the palette menu with no argument,
			//prompt the user for a path via dialog.ask. Slash commands (/list
			//with no arg) preserve their existing current-table behavior.
			//Guard: repl.isActive () is false in non-REPL contexts (integration
			//tests, protocol mode, -e eval) so dialog.ask is never invoked there.
			//repl.fromSlash () is true only for slash-command dispatches, so
			//menu activation in a live REPL falls into the prompt branch.
	if path == "" and repl.isActive () and not repl.fromSlash () {
		local (promptResult = "");
		if dialog.ask ("List table:", @promptResult) {
			path = promptResult}};
	repl.list (path);
	return (true)}