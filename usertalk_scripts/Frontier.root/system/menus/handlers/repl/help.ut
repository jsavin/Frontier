on help ()
	//Print the REPL slash-command reference.
		//5/6/26 by JES
			//Initial implementation. Mirrors the C-side repl_output_help() text
			//so the menu and the power-user shortcut reach the same surface.
	stdout ("Available commands:\r")
	stdout ("  /clear             Clear variables and reset focus to root\r")
	stdout ("  /exit              Exit the REPL\r")
	stdout ("  /help              Show this help message\r")
	stdout ("  /jump [path]       Navigate to a table (like cd)\r")
	stdout ("  /keycodes          Debug terminal key sequences\r")
	stdout ("  /list [path]       List contents of a table\r")
	stdout ("\r")
	stdout ("Press slash at column 1 of an empty prompt to open the menu palette.\r")
	return (true)