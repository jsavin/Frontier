on windowTypesCloseAdapter (name) {
	//Phase E adapter: bridge kernel string-path callback to the windowTypes
	//framework's address-based closeWindow handler.
		//5/31/26 by JES
			//Mirror of windowTypesOpenAdapter; see its change log for
			//background. Used for idclosewindowscript firing path.
		//6/1/26 by JES
			//Propagate the framework's return value rather than masking it
			//with unconditional true. The framework's closeWindow returns
			//false when a save-confirmation dialog is cancelled, which the
			//kernel-level close chain interprets as 'abort the close'. In
			//Phase E (REPL only, no save dialog) this is moot; in Phase F
			//(editor windows with unsaved-change prompts) swallowing the
			//veto would silently close the window and lose user edits.
			//Pre-empt the data-loss bug now with a one-line correctness fix.
			//
			//Also: use a local copy of 'name' rather than mutating the
			//parameter (mirror of windowTypesOpenAdapter; see its log).
	local (path = name);
	if path beginsWith "@" {
		path = string.delete (path, 1, 1)};
	local (adr);
	try {adr = address (path)};
	if adr == nil {
		return (true)};
	if not defined (adr^) {
		return (true)};
	return (Frontier.tools.windowTypes.callbacks.closeWindow (adr))}