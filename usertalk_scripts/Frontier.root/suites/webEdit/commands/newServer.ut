«Changes	«8/31/05; 1:47:27 AM by JES		«Set flNotes to true if we're capable of running the nice outline-based notes editor.	«8/31/05; 12:33:28 AM by JES		«Created. Moved from the menu script for WebEdit -> New Server. Add server pref, flRadioUserLand, default to false.local (serverName);local (adrTable);webEdit.init ();if dialog.ask ("Server Name:", @serverName) {	adrTable = @user.webEdit.servers.[serverName];	if not (defined (adrTable^)) {		new (tableType, adrTable);		local (flKernelSupportsButtons = not (date.versionLessThan (Frontier.version (), "7.1b18")) );		adrTable^.host = serverName;		adrTable^.port = 80;		adrTable^.username = user.prefs.name;		adrTable^.password = "";		adrTable^.flNotes = flKernelSupportsButtons;		adrTable^.flRadioUserLand = false};	edit (adrTable);	window.setTitle (adrTable, serverName);	webEdit.buildServerSubMenu ()};return (true)