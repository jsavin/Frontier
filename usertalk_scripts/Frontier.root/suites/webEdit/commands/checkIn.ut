on checkIn () {
	//Changes
		//8/31/05; 1:32:24 AM by JES
			//Added new outline-with-buttons based note editor.
	
	local (adrObject, s, note = "");
	
	bundle { //get the currently selected object
		adrObject = webEdit.getSelectedObject ();
		if adrObject == false {
			return (false)}};
	
	local (currentServer = webEdit.getCurrentServer ());
	local (adrPrefs = @user.webEdit.servers.[currentServer]);
	
	if (defined (adrPrefs^.flNotes)) and (adrPrefs^.flNotes) {
		local (flKernelSupportsButtons = not (date.versionLessThan (Frontier.version (), "7.1b18")) );
		if flKernelSupportsButtons { //new fancy outline-based note editor
			if not webEdit.noteEditor (adrObject, "Check In", @note) {
				return (false)}}
		else {
			if not (dialog.ask ("Change Note:", @note)) {
				return (false)}}};
	
	s = webEdit.checkInObject (adrObject, note);
	
	webEdit.notify (s);
	
	return (true)}
//bundle //test code
	//checkIn ()