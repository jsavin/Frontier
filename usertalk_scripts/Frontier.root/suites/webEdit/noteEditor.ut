on noteEditor (adrObject, commandName, adrNote) {	«Changes		«9/1/05; 12:42:47 PM by JES			«Fixed window title when doing a Check In command.		«8/31/05; 2:47:54 AM by JES			«Changed order of the buttons. Cancel goes on the right.		«8/31/05; 2:01:10 AM by JES			«Expand the note outline. Reset target before returning.		«8/31/05; 1:34:45 AM by JES			«Created. Outline-based note editor for WebEdit Send To Server and Check In commands. Returns true if the user confirmed or false if cancelled or closed.	local (adrNoteWindow);	webEdit.getDefaultNote (adrObject, @adrNoteWindow);	window.attributes.setOne ("webEditAction", "", adrNoteWindow);	local (t); new (tableType, @t); //button table	script.newScriptObject ("window.attributes.setOne (\"webEditAction\", \"confirm\")", @t.["00000001\t" + commandName]);	script.newScriptObject ("window.attributes.setOne (\"webEditAction\", \"cancel\")", @t.["00000002\tCancel"]);	local (oldTarget = target.get ());	edit (adrNoteWindow, commandName + " Notes for " + nameOf (adrObject^), false, @t);	op.fullExpand ();	local (flConfirmed = false);	while window.isOpen (adrNoteWindow) { //loop, waiting for the user to close, cancel or confirm		local (action);		if window.attributes.getOne ("webEditAction", @action, adrNoteWindow) {			case action {				"cancel" {					window.close (adrNoteWindow)};				"confirm" {					adrnote^ = string.trimWhiteSpace (string (adrNoteWindow^));					flConfirmed = true;					window.close (adrNoteWindow)}}};		thread.sleepTicks (15)}; //wait 0.25 sec	window.attributes.setOne ("webEditAction", "", adrNoteWindow);	try {target.set (oldTarget)};	return (flConfirmed)}