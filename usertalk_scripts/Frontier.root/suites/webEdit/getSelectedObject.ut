on getSelectedObject () {
	«Changes
		«7/6/05; 8:58:25 PM by JES
			«New pref, user.webEdit.prefs.flGetAddressesFromNotepad.
				«If true, and the frontmost window is the workspace.notepad or user.rootUpdates.updateOutline, then we get the address from the text of the current outline heading.
	local (adr);
	adr = table.getCursorAddress ();
	if not defined (user.webEdit.prefs.flGetAddressesFromNotepad) {
		user.webEdit.prefs.flGetAddressesFromNotepad = false};
	if user.webEdit.prefs.flGetAddressesFromNotepad {
		case adr {
			@user.rootUpdates.updateOutline;
			@workspace.notepad {
				adr = op.getLineText ();
				if not (adr contains "[\"") {
					adr = string.nthField (adr, " ", 1)};
				try {
					adr = address (adr);
					if not defined (adr^) {
						return (false)}}
				else {
					return (false)}}}};
	if not defined (adr^) {
		return (false)};
	return (adr)}