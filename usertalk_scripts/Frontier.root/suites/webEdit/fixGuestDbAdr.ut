on fixGuestDbAdr (adr) { //possibly convert for guest database
	«Changes
		«8/31/05; 12:16:49 AM by JES
			«If the server table has a boolean, flRadioUserLand, use it to determine whether the server is running Radio UserLand. Otherwise assume Frontier.
			«We use this to determine whether to patch up guest database addresses for objects in a Tool, to deal with the fact that Tools live in different places in Frontier and Radio.
		« 9/29/98; 2:43:24 PM by DW
			«Created.
			«Turn something like: ["C:\\Palm Springs\\Websites\\guest2.root"].["#enhancedState"]
			«Into: (websites\guest2.root).["#enhancedState"]
			«The server will understand the request to apply to a 
				«file in the same location relative to the Frontier app.
	if not table.inGuestDatabase (adr) {
		return (adr)};
	local (alist = string.parseaddress (adr));
	bundle { //fix up Tools paths
		local (toolsfolder = frontier.tools.gettoolsfolderpath ());
		if alist[1] beginsWith toolsfolder { //is the object inside an installed Tool?
			local (server = webEdit.getCurrentServer (adr));
			local (flServerIsRadio = false);
			if defined (user.webEdit.servers.[server].flRadioUserLand) {
				flServerIsRadio = user.webEdit.servers.[server].flRadioUserLand};
			if flServerIsRadio {
				if not system.environment.isRadio { //but we're Frontier
					alist[1] = frontier.pathstring + "Tools" + file.getPathChar () + file.fileFromPath (alist[1])}}
			else { //server is Frontier
				if system.environment.isRadio { //but we're Radio
					alist[1] = Frontier.getSubFolder ("apps") + "Tools" + file.getPathChar () + file.fileFromPath (alist[1])}}}};
	local (s = string.lower (alist [1])); //file path to the root
	s = "(" + s - string.lower (frontier.pathString) + ")";
	ix = string.patternMatch ("].", adr);
	s = s + string.delete (adr, 1, ix);
	return (s)};
«bundle //test code
	«webedit.fixGuestDbAdr (@musicSuite)
		«"(tools:music.root).musicSuite"