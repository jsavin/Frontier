on undoCheckOut (userName, password, adrObject) {	«Undo a checkout.	«Changes		«7/6/05; 7:47:27 PM by JES			«Pop off file-part of addresses in all messages returned to the client.		local (adrCallback = @user.webEditServer.callbacks.undoCheckOut);	local (adrPreCallback = @user.webEditServer.callbacks.preUndoCheckOut);	local (now = clock.now ());		if not (people.authenticateUser (userName, password, "WebEdit")) {		scriptError ("Can't check in " + string.popFileFromAddress (adrObject) + " because an invalid username or password was supplied.")};		adrObject = webEditServer.fixGuestDbAdr (adrObject);		«Make sure the object is checked out by this user.		«You can only delete objects you've checked out.	if not (custody.isCheckedOutByUser (adrObject, userName)) {		return ("Can't undo check-out for " + string.popFileFromAddress (adrObject) + " because " + userName + " has not checked it out.")};		webEditServer.callbackLoop (adrPreCallback, adrObject, userName, now, "");		custody.undoCheckOut (userName, password, string (address (adrObject)));		webEditServer.callbackLoop (adrCallback, adrObject, userName, now, "");		filemenu.saveMyRoot (adrobject);		return (string.popFileFromAddress (adrObject) + "'s check-out has been undone.")}