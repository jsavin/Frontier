on getSubItemData (userName, password, adrTable) {	«Changes		«8/30/05; 4:38:11 PM by JES			«Created. Get data about a table's sub-items from the server.		webEditServer.init (); //ensure callback tables are initialized		local (adrPreCallback = @user.webEditServer.callbacks.preGetSubItemData);	local (adrCallback = @user.webEditServer.callbacks.getSubItemData);	local (now = clock.now ());		if not (people.authenticateUser (userName, password, "WebEdit")) {		scriptError ("Can't get sub-item data for " + string.popFileFromAddress (adrObject) + " because an invalid username or password was supplied.")};		local (t); new (tableType, @t); //table to return to the client	adrTable = webeditserver.fixGuestDbAdr (adrTable);		webEditServer.callbackLoop (adrPreCallback, adrTable, username, now, "");		local (i, ct = sizeOf (adrTable^));	for i = 1 to ct {		local (adrItem = @adrTable^[i]);		local (adrTgt = table.uniqueName ("item", @t, 9));		new (tableType, adrTgt);		adrTgt^.name = nameOf (adrItem^);		adrTgt^.type = string (typeOf (adrItem^));		adrTgt^.size = sizeOf (adrItem^)};		webEditServer.callbackLoop (adrCallback, adrTable, username, now, @t);		return  (t)}