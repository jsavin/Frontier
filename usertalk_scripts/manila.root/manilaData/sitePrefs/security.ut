			«The Content Editor can access the navigation on the Advanced page.

local (pta = parentOf (code));
local (url = string.lower (pta^.uri + "$"+ pta^.pathArgs)); //PBS 12/03/01: Content Editor can edit nav links
if url endsWith "/admin/siteprefs/default$advanced" {
	return (manilaSuite.editors.contentEditorsAndManagingEditorsOnly ())};
return (manilaSuite.editors.managingEditorOnly ()) //only the managing editor can access site prefs