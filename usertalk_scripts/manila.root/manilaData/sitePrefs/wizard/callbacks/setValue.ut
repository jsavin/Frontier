		"newsRoom.flPublicReadDgAccess" {
			local (pta = html.getPageTableAddress ());
			local (adrSite = pta^.adrSiteRootTable);
			local (adrDiscuss = @adrSite^.discuss);
			if not defined (adrDiscuss^) {
				adrDiscuss = adrSite};
			if not defined (adrDiscuss^.edit) {
				return (true)};
			local (groupName = pta^.defaultMembershipGroup);
			local (fl = boolean (adrVal^));
			
			if fl { //everybody can read the discussion group
				if defined (adrDiscuss^.["#members"]) {
					delete (@adrDiscuss^.["#members"])};
				adrDiscuss^.edit.["#members"] = groupName}
			else { //only members can read the discussion group
				if defined (adrDiscuss^.edit.["#members"]) {
					delete (@adrDiscuss^.edit.["#members"])};
				adrDiscuss^.["#members"] = groupName};
			
			return (true)};
