		"newsRoom.staticRenderingUsername" {
			adrNewsSite^.staticSite.["#ftpsite"].account = string(adrVal^)};
		"newsRoom.staticRenderingPassword" {
			if sizeOf(adrVal^) {
				adrNewsSite^.staticSite.["#ftpsite"].password = string(adrVal^)}};
		
		"newsRoom.sysopMail" {
			manilaSuite.admin.setManagingEditorList (string (adrVal^))};
		"newsRoom.tagLine" {
			wp.newtextobject (string (adrval^), @adrNewsSite^.tagline)};
		"newsRoom.timeZone.zone" {
			if string.lower (adrVal^) == "server" {
				if defined (pta^.newsSite^.timeZone) {
					delete (@pta^.newsSite^.timeZone)}}
			else {
				local (zone);
				zone = ((number (adrVal^) * 0.5) - 13) + 0.5;
				if not defined (pta^.newsSite^.timeZone) {
					new (tableType, @pta^.newsSite^.timeZone)};
				zone = long (zone) * 60 * 60;
				pta^.newsSite^.timeZone.zone = zone};
			return (true)};
		"newsRoom.urls.baseUrl" { //PBS 7/14/99: set the base URL
			local (oldUrl = pta^.ftpSite^.url);
			local (newUrl = string (adrVal^));
			if string.lower (oldUrl) != string.lower (newUrl) {
				local (adrSite = pta^.adrSiteRootTable);
				manilaSuite.admin.changeSiteUrl (oldUrl, newUrl, adrSite)}};
		"newsRoom.urls.login" {
			pta^.urls^.memberLogon = string (adrVal^)};
		"newsRoom.urls.prefsHome" {
