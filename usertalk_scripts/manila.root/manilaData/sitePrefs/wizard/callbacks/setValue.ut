			adrNewsSite^.notifySender = string (adrval^)};
		"newsRoom.numMessagesInDiscussListing" { //JES 07/07/00
			local (num = number (adrVal^));
			if num < 1 or num > 999 {
				num = 1};
			pta^.newsSite^.numMessagesInDiscussListing = num};
		"newsRoom.numMessagesInDiscussTopicsListing" { //PBS 09/30/00
			local (num = number (adrVal^));
			if num < 1 or num > 999 {
				num = 10};
			pta^.newsSite^.numMessagesInDiscussTopicsListing = num};
