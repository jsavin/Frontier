		"newsRoom.numNewsItemsToRenderDepartment" { //PBS 09/10/01
			adrNewsSite^.numNewsItemsToRenderDepartment = adrVal^};
		"newsRoom.pageTemplate" {
			local (s = string (adrval^));
			s = string.replaceAll (s, lf, "");
			s = mainResponder.neuterText (s, flNeuterMacros:true, flNeuterTags:false);
			
			//Check the template for needed macros.
			local (errorString);
			if not (manilaSuite.admin.isGoodTemplate (s, @errorString)) {
				errorString = string.replaceAll (errorString, "{", "&#123;");
				errorString = string.replaceAll (errorString, "}", "&#125;");
				errorString = string.replace (errorString, "The", "the");
				local (replacementTable); new (tableType, @replacementTable);
				replacementTable.error = errorString;
				pta^.sitePrefsErrorMessage = manilaSuite.getString ("admin.cantUpdateTemplateBecause", @replacementTable)}
			else {
				wp.newTextObject (s, @manilaSuite.getSiteAddress ()^.["#template"]);
				
				bundle { //6/30/99; 11:55:40 AM by DW, call the callbacks
					local (params);
					new (tabletype, @params);
					params.templateText = s;
					if defined (adrNewsSite^.callbacks) {
						mainResponder.callbackloop (@adrNewsSite^.callbacks.templateChanged, @params)}}}};
		"newsRoom.permanentLinkImage" {
			table.assign (@adrNewsSite^.permanentLinkImage, manilaSuite.unTaint (adrVal^))};
