		"newsRoom.staticRenderingMethod" {
			try {manilaSuite.staticRendering.setWritingMethod(adrSite, adrVal^)}};
		"newsRoom.staticRenderingURL" {
			//be careful here, don't want to wipe out the file version.
			if string(adrVal^) != "" {
				adrNewsSite^.staticSite.["#ftpsite"].url = string(adrVal^)}};
		"newsRoom.staticRenderingHost" {
			adrNewsSite^.staticSite.["#ftpsite"].domain = string(adrVal^)};
