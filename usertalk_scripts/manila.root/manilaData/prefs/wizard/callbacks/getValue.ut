on getValue (partialAddress, defaultValue) {
	//Get a value from a member's prefs. Handle the issue with bulletins prefs not specifying the subtable. (Each site gets a subtable in the member's bulletins table, this way multiple sites can share a membership group.)
		//12/14/01; 1:31:32 PM by PBS
	
	local (adrNewsSite = manilaSuite.getNewsSiteAddress ());
	local (adrSite = manilaSuite.getSiteAddress ());
	local (pta = html.getPageTableAddress ());
	
	case string.lower (partialAddress) {
		"bulletins.enabled" {
			if defined (adrNewsSite^.bulletinsPrefName) {
				local (subtableName = string.trimWhiteSpace (adrNewsSite^.bulletinsPrefName));
				if subtableName != "" {
					if defined (pta^.adrMemberInfo^.bulletins.[subtableName].enabled) {
						return (boolean (pta^.adrMemberInfo^.bulletins.[subtableName].enabled))}
					else {
						return (false)}}};
			return (defaultValue)};
		"bulletins.inhtml" {
			if defined (adrNewsSite^.bulletinsPrefName) {
				local (subtableName = string.trimWhiteSpace (adrNewsSite^.bulletinsPrefName));
				if subtableName != "" {
					if defined (pta^.adrMemberInfo^.bulletins.[subtableName].inhtml) {
						return (boolean (pta^.adrMemberInfo^.bulletins.[subtableName].inhtml))}
					else {
						return (false)}}};
			return (defaultValue)}};
	
	return (defaultvalue)}