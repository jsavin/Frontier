on default () {
	//Changes
		//10/3/05; 3:37:02 AM by JES
			//Only call manilaSuite.sitePrefs.setTemplate if defined.
		//6/29/05; 2:42:02 PM by PR
			//we do it this way to bypass a limitation in html.processMacros, this allows us to do the folloing in templates:
				//\<tag attribute='{whoAmI}'>
	local (pta = html.getPageTableAddress());
	pta^.title = nil; // manilaSuite.sitePrefs.defaultPage gets called too late to set the title
	if defined (manilaSuite.sitePrefs.setTemplate) {
		manilaSuite.sitePrefs.setTemplate ()};
	//pta^.processMacros = true // the above call disables all macro processing
	//return ("{manilaSuite.sitePrefs.defaultPage()}") //6/30/05; 3:04:32 AM by JES
	return (manilaSuite.admin.sitePrefsPage ())}