«An interesting experiment..
	«This script is called by an RPC handler, it returns a rendering of the current news outline so that the console can show the editor what the news page will look like, right on the console. Distributed rendering! This is interesting..
	«2/18/99; 3:46:11 AM by DW

local (oldpta = nil, s);
try {
	oldpta = html.getPageTableAddress ()};
local (t); new (tabletype, @t); local (pta = @t);
html.setPageTableAddress (pta);
html.buildPageTable (this, pta);
try {
	s = parentof(parentof(this^)^)^.default ()}
else {
	if oldpta != nil {
		html.setPageTableAddress (oldpta)};
	scripterror (tryerror)};
if oldpta != nil {
	html.setPageTableAddress (oldpta)};
return (s)