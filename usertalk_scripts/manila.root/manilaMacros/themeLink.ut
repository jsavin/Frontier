on themeLink () {
	«Return a link to the site the theme this site uses is derived from.
		«06/05/00; 4:51:10 PM by PBS
		«Changes:
			«06/11/00; 3:53:49 AM by JES
				«localized
	
	local (adrTheme);
	if manilaSuite.themes.getCurrentThemeAddress (@adrTheme) {
		local (displayName = nameOf (adrTheme^));
		if defined (adrTheme^.info.displayName) {
			displayName = adrTheme^.info.displayName};
		if defined (adrTheme^.info.siteUrl) {
			local (siteUrl);
			siteUrl = adrTheme^.info.siteUrl;
			if siteUrl != "" {
				«local (link = html.getLink (displayName, siteUrl))
				local (replacementTable); new (tableType, @replacementTable);
				replacementTable.siteUrl = siteUrl;
				replacementTable.themeName = displayName;
				local (s = manilaSuite.getString ("macros.thisSiteIsUsingTheme", @replacementTable));
				return (manilaSuite.unTaint (s))}}};
	
	return ("")}