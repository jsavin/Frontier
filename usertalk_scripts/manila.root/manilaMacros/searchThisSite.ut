on searchThisSite (buttontext="Search", flThisSiteOnly=true, thisSiteOnlyCheckText="This site only") {
	//Changes
		//8/21/02; 3:56:06 PM by JES
			//New optional parameters, flThisSiteOnly and thisSiteOnlyCheckText. Used to add a "this site only" checkbox to the form.
		//8/18/02; 7:03:26 PM by JES
			//If this server is not a search engine server, return the empty string.
		//8/8/02; 3:46:12 PM
			//Created.
	if not config.mainResponder.prefs.flSearchEngine {
		return ("")};
	
	local (htmltext = "");
	on add (s) {
		htmltext = htmltext + s;};
	
	local (siteurl = manilaSuite.getSiteUrl ());
	local (searchurl = siteurl + "search/");
	add ("<form method=\"get\" action=\"" + searchurl + "\"><nobr>");
	add ("<input type=\"text\" name=\"q\" size=\"13\" value=\"\">&nbsp;");
	add ("<input type=\"submit\" value=\"" + buttontext + "\">");
	add ("</nobr>");
	if flThisSiteOnly {
		add ("<input type=\"hidden\" name=\"searchThisSiteOnly\" value=\"true\" />")}
	else {
		add ("<br /><input type=\"checkbox\" name=\"searchThisSiteOnly\" value=\"true\" checked />&nbsp;" + thisSiteOnlyCheckText)};
	add ("</form>");
	
	return (htmltext)}