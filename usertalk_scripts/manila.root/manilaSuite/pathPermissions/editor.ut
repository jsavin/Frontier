on editor (flIncludeIntroText=true) {
	//Changes
		//11/3/04; 6:23:00 PM by JES
			//If the feature is not enabled for this site, don't display the editor.
		//5/21/03; 3:41:53 PM by JES
			//Created. Admin interface for editing path-based permissions in a Manila site.
	
	return ("Disabled"); // 11/05/05; 10:46:18 AM by PR disabled
	
	local (pta = html.getPageTableAddress ());
	local (adrsite = manilaSuite.getSiteAddress (pta));
	local (adrdata = manilaSuite.pathPermissions.init (adrsite));
	local (adrpaths = @adrdata^.paths);
	
	local (htext = "");
	on add (s) {
		htext = htext + (s + "\r");};
	
	bundle { //managing editor test
		if not manilaSuite.editors.managingEditorTest () {
			scriptError (manilaSuite.getString ("admin.cantDisplayPageNoPermission"))}};
	
	if flIncludeIntroText { //set page title, add intro text
		pta^.title = manilaSuite.getString ("pathPermissions.editorPageTitle");
		if not adrdata^.flEnabled {
			return ("The access restrictions feature is not enabled for this site.")};
		add (manilaSuite.getString ("pathPermissions.editorPageIntroText"))};
	
	if pta^.method == "POST" {
		local (adrargs = @pta^.postArgs);
		if defined (adrargs^.addPath) { //add a path
			local (path = manilaSuite.untaint (adrargs^.pathToAdd));
			if not (path beginswith "/") {
				path = "/" + path};
			adrpaths^.[path] = adrargs^.accessLevel;
			local (t); new (tableType, @t);
			t.path = path;
			add ("<p><b>" + manilaSuite.getString ("pathPermissions.confirmAddPath", @t) + "</b></p>")};
		if defined (adrargs^.deletePaths) { //delete one or more paths
			local (adr, flDeleted = false);
			for adr in adrargs {
				if adr^ == "x" {
					local (path = string.urlDecode (nameOf (adr^)));
					if defined (adrpaths^.[path]) {
						delete (@adrpaths^.[path]);
						flDeleted = true}}};
			if flDeleted { //add confirm text
				add ("<p><b>" + manilaSuite.getString ("pathPermissions.confirmDeletePaths") + "</b></p>")}}};
	
	bundle { //add a path
		add ("<form method=\"POST\">");
		local (prompt = manilaSuite.getString ("pathPermissions.pathToAddPrompt"));
		local (addPathButton = manilaSuite.getString ("pathPermissions.addPathButton"));
		local (pathToAddInput = "<input type=\"text\" name=\"pathToAdd\" width=\"40\" />");
		local (submitButton = "<input type=\"submit\" name=\"addPath\" value=\"" + addPathButton + "\" />");
		local (accessPopup = "");
		bundle { //build accessPopup
			on addOption (name, value) {
				accessPopup = accessPopup + "<option value=\"" + value + "\">" + name + "</option>\r"};
			accessPopup = "<select name=\"accessLevel\">\r";
			addOption (manilaSuite.getString ("admin.members"), "members");
			addOption (manilaSuite.getString ("admin.editors"), "editors");
			addOption (manilaSuite.getString ("admin.contributingEditors"), "contributingEditors");
			addOption (manilaSuite.getString ("admin.contentEditors"), "contentEditors");
			addOption (manilaSuite.getString ("admin.managingEditors"), "managingEditors");
			accessPopup = accessPopup + "</select>"};
		add ("<p><b>" + prompt + "</b>&nbsp;" + pathToAddInput + "&nbsp;" + accessPopup + "&nbsp;" + submitButton + "</p>");
		add ("</form>")};
	bundle { //existing paths with checks and a delete button
		if sizeOf (adrpaths^) == 0 { //no paths
			add ("<p><br />" + manilaSuite.getString ("pathPermissions.noPaths") + "</p>")}
		else { //list paths, with a check next to each for deletion
			add ("<p><br />" + manilaSuite.getString ("pathPermissions.pathsListHeader") + "</p>");
			add ("<form method=\"POST\">");
			add ("<table cellpadding=\"0\" cellspacing=\"4\" border=\"0\" width=\"400\">");
			bundle { //add headers
				add ("<tr>");
				add ("<td><b>" + manilaSuite.getString ("pathPermissions.deleteHeader") + "</b></td>");
				add ("<td><b>" + manilaSuite.getString ("pathPermissions.pathHeader") + "</b></td>");
				add ("<td><b>" + manilaSuite.getString ("pathPermissions.accessLevelHeader") + "</b></td>")};
			local (adr);
			for adr in adrpaths { //add each path with a check for deletion
				local (name = string.urlEncode (nameOf (adr^)) );
				local (checkbox =  "<input type=\"checkbox\" name=\"" + name + "\" value=\"x\" />");
				local (accessLevel);
				case adr^ {
					"members" {
						accessLevel = manilaSuite.getString ("admin.members")};
					"editors" {
						accessLevel = manilaSuite.getString ("admin.editors")};
					"contentEditors" {
						accessLevel = manilaSuite.getString ("admin.contentEditors")};
					"contributingEditors" {
						accessLevel = manilaSuite.getString ("admin.contributingEditors")};
					"managingEditors" {
						accessLevel = manilaSuite.getString ("admin.managingEditors")}};
				add ("<tr><td>" + checkbox + "</td><td>" + nameOf (adr^) + "</td><td>" + accessLevel + "</td></tr>")};
			local (deleteButton = manilaSuite.getString ("common.deleteButton"));
			local (submitButton = "<input type=\"submit\" name=\"deletePaths\" value=\"" + deleteButton + "\" />");
			add ("</table>");
			add ("<br />" + submitButton);
			add ("</form>")}};
	
	return (htext)}