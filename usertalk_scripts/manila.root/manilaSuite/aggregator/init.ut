on init (adrsite=nil) {
	//Changes
		//3/18/06; 4:18:11 AM by JES
			//If we attempt to subscribe to a feed and get an error, don't attempt again (delete from the site's subscriptions), and clean up any stale data that might have been created.
		//5/28/03; 4:47:01 PM by JES
			//New optional parameter, adrsite. Allows this script to be called outside the website framework context.
		//3/8/03; 1:58:41 AM by JES
			//Add the aggregator sub-table to the site's table if not present.
		//2/25/03; 6:07:55 AM by DW
			//Created. The beginning of a mini-aggregator for Manila. The idea is that a group of people have a common set of interests, and many of them don't have the incentive to run an aggregator on their desktop. So we put one in Manila. The managing editors of the site can add new feeds to the mix, or remove stale ones.  All the Manila sites on the server share the pool of feeds, so if two sites subscribe to the same feed, there's only one entry in the services table in aggregator.root. It's kind of efficient that way. Let's see how it goes.
			//Here's a list of other places that need to be updated when this is released
				//manilaSuite.filters.firstFilter
					//This routine is called from manilaSuite.filters.firstFilter. It's the one link into the outside world to get things started. When and if this is released beyond just a test installation, you must also release manilaSuite.filters.firstFilter. 
				//manilaData.legalMacros.viewAggregator
					//The macro that lets you view the contents of the aggregator for this site.
				//manilaMacros.viewAggregator
					//The script that is called to view the aggregator.
	if adrsite == nil {
		local (pta = html.getpagetableaddress ());
		adrsite = pta^.adrSiteRootTable};
	local (adrprefs = @adrsite^.["#newsSite"].aggregator);
	if not defined (adrprefs^) {
		new (tabletype, adrprefs)};
	if not defined (adrprefs^.services) { //a table of booleans, the name is the url of a feed
		new (tabletype, @adrprefs^.services)};
	bundle { //make sure the aggregator is properly initialized and installed
		local (adrdata = xml.aggregator.init (), adrmyservice, adrglobalservice, url);
		local (i, ct = sizeOf (adrprefs^.services));
		for i = ct downto 1 {
			adrmyservice = @adrprefs^.services[i];
			url = nameof (adrmyservice^);
			adrglobalservice = @adrdata^.services.[url];
			if not defined (adrglobalservice^) {
				local (flerror = false, errorstring);
				try {
					xml.aggregator.subscribeService (url, @errorstring);
					if not defined (adrglobalservice^) {
						flerror = true}}
				else { //error -- bail out and don't do this feed again
					flerror = true};
				if flerror {
					if defined (adrglobalservice^) {
						delete (adrglobalservice)};
					delete (adrmyservice)}}}};
	bundle { //make sure our macros are legal
		if not defined (config.mainresponder.prefs.legalMacros.viewAggregator) {
			manilaSuite.makeManilaMacrosSafe ()}};
	bundle { //site shell upgrade
		if not defined (adrsite^.aggregator) {
			if defined (manilaData.newSiteTemplate.aggregator) {
				adrsite^.aggregator = manilaData.newSiteTemplate.aggregator}}};
	return (adrprefs)}