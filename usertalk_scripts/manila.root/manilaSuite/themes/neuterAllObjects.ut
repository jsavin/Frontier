on neuterAllObjects (adrTheme) {
	«Make sure all the objects in the theme have been neutered. No harmful macros are allowed.
		«06/06/00; 1:39:14 AM by PBS
	«Changes:
		«3/30/04; 11:20:39 AM by JES
			«Added support for the navigation appearance currentItemFormat preference, in which {item} needs to be legal.
		«4/21/03; 1:04:25 PM by JES
			«Don't neuter macros in the External Style Sheet.
		«4/5/02; 3:01:47 AM by JES
			«Added responseitemfulltemplate to the legal object names.
		«10/8/01; 3:24:25 PM by PBS
			«Support some slides and directory templates that were missing.
		«10/27/00; 9:04:47 PM by JES
			«Fixed problem where macros would be neutered in responseItemTemplate-s.
		«10/25/00; 9:21:29 PM by JES
			«Allow for lightweight macros in discussion group templates.
	
	on neuterObject (adrItem) {
		local (itemName = nameOf (adrItem^));
		local (originalType = typeOf (adrItem^));
		case originalType { //skip some types of objects
			tableType;
			booleanType;
			longType;
			dateType {
				return (true)}};
		
		on replaceValue (s) {
			case originalType {
				stringType {
					adrItem^ = s};
				wpTextType {
					wp.newTextObject (s, adrItem)};
				outlineType {
					op.newOutlineObject (s, adrItem)}};
			return (true)};
		
		on doNeuter (adrLegalMacrosTable) {
			local (s = string (adrItem^));
			s = html.neuterMacros (s, adrLegalMacrosTable);
			replaceValue (s);
			return (true)};
		
		if nameOf (parentOf (adrItem^)^) == "directory" { //PBS 10/08/01: fix name collisions with directory templates
			itemName = "directory" + itemName};
		if nameOf (parentOf (adrItem^)^) == "slides" { //PBS 10/08/01: fix name collisions with slides templates
			itemName = "slides" + itemName};
		
		case string.lower (itemName) { //some objects have special case macros tables
			"template";
			"signinbox";
			"signoutbox";
			"newsdaytemplate";
			"newsitemstemplate";
			"daylistheader";
			"daylistfooter";
			"daylisttemplate";
			"daylistitemtemplate";
			"msgtemplate";
			"topiclistheader";
			"topiclistfooter";
			"topiclisttemplate";
			"topiclistitemtemplate";
			"topictemplate";
			"topicmsgtemplate";
			"responseitemtemplate";
			"responsefullitemtemplate";
			"directorytemplate";
			"directorycommenttemplate"; //PBS 10/08/01
			"directorysuggestalinktemplate"; //PBS 10/08/01
			"slidestemplate"; //PBS 10/08/01
			"currentitemformat";
			"itemformat" {
				local (macrosTable = manilaSuite.themes.getLegalMacrosForObject (itemName));
				doNeuter (@macrosTable)};
			"printfriendly" { //PBS 10/08/01: same as regular template
				local (macrosTable = manilaSuite.themes.getLegalMacrosForObject ("template"));
				doNeuter (@macrosTable)};
			"cascadingstylesheet";
			"externalstylesheet";
			"javascript" {
				return (true)}} //don't neuter at all, curly brace macros are never evaluated
		else {
			doNeuter (@config.mainResponder.prefs.legalMacros)};
		
		return (true)};
	
	on doTable (adrTable) {
		local (adrItem);
		for adrItem in adrTable {
			local (itemType = typeOf (adrItem^));
			if itemType == tableType {
				doTable (adrItem)}
			else {
				neuterObject (adrItem)}}};
	
	doTable (adrTheme);
	
	return (true)}