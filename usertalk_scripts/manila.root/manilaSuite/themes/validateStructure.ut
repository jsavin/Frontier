on validateStructure (adrTheme) {
	«Validate the table structure of a theme. scriptError if there's a problem. This is a relaxed validator. It detects structural problems, but some details may escape it. One important thing it does do is ensure that there are no scripts objects in the theme.
		«06/06/00; 12:19:47 AM by PBS
	
	try { //enclose in a try, for a friendlier error message in the case of unknown errors
		on checkTable (adrTable, namesList, flTopLevelTable, validTypes) {
			local (tableName);
			if flTopLevelTable {
				tableName = "top level table"}
			else {
				tableName = nameOf (adrTable^)};
			
			local (oneItem);
			for oneItem in namesList { //check against the names list
				if not defined (adrTable^.[oneItem]) {
					scriptError ("the " + tableName + " table does not contain an item named " + oneItem)}};
			
			local (adrItem);
			for adrItem in adrTable { //check types
				local (itemName = nameOf (adrItem^));
				local (objectType = typeOf (adrItem^));
				if not (validTypes contains objectType) {
					scriptError (itemName + " in the " + tableName + " table is not a valid type")};
				if itemName beginsWith "fl" {
					if not (objectType == booleanType) {
						scriptError (itemName + " in the " + tableName + " table is not a boolean")}}};
			
			return (true)};
		
		bundle { //top level table
			«local (namesList = {"appearance", "flEnabled", "flPublic", "Info", "Pictures"})
			local (namesList = {"appearance", "flEnabled", "flPublic", "Info"});
			local (validTypes = {tableType, booleanType});
			checkTable (adrTheme, namesList, true, validTypes)};
		
		bundle { //appearance
			local (namesList = {"alink", "background", "bgcolor", "bylineFormat", "calendarTemplates", "cascadingStyleSheet", "colors", "flBackIssueDisplayTitle", "flBylinesOnHomePage", "flBylinesOnStories", "flCalendarOnHomePage", "flEditFormOnHomePage", "flHomePageDisplayTitle", "javaScript", "link", "membersBoxTemplates", "navigation", "newsDayTemplate", "newsItemsTemplate", "numNewsDaysToRender", "template", "text", "vlink"});
			local (validTypes = {tableType, booleanType, wpTextType, stringType, outlineType, longType, dateType});
			checkTable (@adrTheme^.appearance, namesList, false, validTypes)};
		bundle { //calendarTemplates
			local (namesList = {"dayNameTemplate", "dayTemplate", "monthYearTemplate"});
			local (validTypes = {stringType});
			checkTable (@adrTheme^.appearance.calendarTemplates, namesList, false, validTypes)};
		bundle { //colors
			local (namesList = {"adminBoxBackground", "adminBoxBackgroundText", "adminBoxHeader", "adminBoxHeaderText", "discussListings", "membersBox", "membersBoxHeader", "membersBoxHeaderText", "separator", "separatorText"});
			local (validTypes = {stringType});
			checkTable (@adrTheme^.appearance.colors, namesList, false, validTypes)};
		bundle { //membersBoxTemplates
			local (namesList = {"signInBox", "signOutBox"});
			local (validTypes = {stringType, wpTextType, outlineType});
			checkTable (@adrTheme^.appearance.membersBoxTemplates, namesList, false, validTypes)};
		bundle { //navigation
			local (namesList = {"itemFormat", "separatorFormat"});
			local (validTypes = {stringType, wpTextType, outlineType});
			checkTable (@adrTheme^.appearance.navigation, namesList, false, validTypes)};
		
		bundle { //Info
			local (namesList = {"Author", "AuthorEmail", "CreationDate", "Description", "displayName", "siteUrl"});
			local (validTypes = {stringType, wpTextType, outlineType, dateType});
			checkTable (@adrTheme^.Info, namesList, false, validTypes)};
		
		bundle { //check whole table for script objects
			on checkForScripts (adrTable) {
				local (adrItem);
				for adrItem in adrTable {
					local (objectType = typeOf (adrItem^));
					if objectType == scriptType {
						scriptError ("Can't validate this theme because " + nameOf (adrItem^) + " is a script object.")};
					if objectType == tableType {
						checkForScripts (adrItem)}}};
			checkForScripts (adrTheme)}}
	else {
		scriptError ("Can't validate this theme because " + tryError + ".")};
	
	return (true)}; //the theme validated
bundle { //test code
	«local (adrItem)
	«for adrItem in @config.manila.themes
		«validateStructure (adrItem)
	validateStructure (@config.manila.themes.boxes)}