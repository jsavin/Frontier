			table.assign (@macrosTable.postTime, true);
			table.assign (@macrosTable.lastPostTime, true);
			table.assign (@macrosTable.messages, true);
			table.assign (@macrosTable.responseForm, true)};
		"topicmsgtemplate" {
			table.assign (@macrosTable.bgcolor, true);
			table.assign (@macrosTable.headerColor, true);
			table.assign (@macrosTable.headerTextColor, true);
			table.assign (@macrosTable.author, true);
			table.assign (@macrosTable.subject, true);
			table.assign (@macrosTable.topicLink, true);
			table.assign (@macrosTable.messageNumberLink, true);
			table.assign (@macrosTable.inResponseToLink, true);
			table.assign (@macrosTable.previousMessageLink, true);
			table.assign (@macrosTable.nextMessageLink, true);
			table.assign (@macrosTable.postTime, true);
			table.assign (@macrosTable.readCount, true);
			table.assign (@macrosTable.responseCount, true);
			table.assign (@macrosTable.editLink, true);
			table.assign (@macrosTable.responseList, true);
			table.assign (@macrosTable.messageText, true);
			table.assign (@macrosTable.discussLink, true);
			table.assign (@macrosTable.internalLink, true);
			table.assign (@macrosTable.authorIcon, true);
			table.assign (@macrosTable.enclosureLink, true)}; //11/04/00 JES
		"trackbackitemtemplate" {
			table.assign (@macrosTable.bgcolor, true);
			table.assign (@macrosTable.itemLink, true);
			table.assign (@macrosTable.excerpt, true);
			table.assign (@macrosTable.weblogTitle, true);
			table.assign (@macrosTable.trackbackTime, true)};
		"trackbacktemplate";
		"trackbackheader";
		"trackbackfooter" {
			table.assign (@macrosTable.trackbackUrl, true);
			table.assign (@macrosTable.postTitle, true);
			table.assign (@macrosTable.postUrl, true)};
		"trackbacklinktemplate" {
			table.assign (@macrosTable.trackbackCount, true)};
		"directorytemplate" {
			table.assign (@macrosTable.breadcrumbs, true);
			table.assign (@macrosTable.directory, true);
			table.assign (@macrosTable.editor, true);
			table.assign (@macrosTable.lastModDate, true);
			table.assign (@macrosTable.hits, true);
			table.assign (@macrosTable.suggestLink, true);
			table.assign (@macrosTable.opmlUrl, true); //12/14/2000; 8:13:17 AM by DW
			table.assign (@macrosTable.subItems, true)}; //3/6/01; 10:40:59 AM by DW
		"slidestemplate" {
