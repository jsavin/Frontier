		"directorycommenttemplate" { //PBS 10/08/01
			table.assign (@macrosTable.comment, true)};
		"directorysuggestalinktemplate" { //PBS 10/08/01
			table.assign (@macrosTable.url, true)}};
	
	return (macrosTable)}