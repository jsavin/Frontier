on canEditComments (pta, usernum, password) {
	«Checks the radio comment editor cookie to see if this user is authorized to edit the comments on this site.
	«Changes
		«23/08/04; 11:28:50 AM by PR: now uses a much safer combined hash
		«19/08/04; 9:42:30 AM by PR Initial check in
	local (groupName = pta^.defaultMembershipGroup);
	local (adrmembers = mainResponder.members.getMembershipTable (groupname));
	local (cookieName = adrmembers^.cookieName + "radioCommentEditor");
	local (cookieString);
	if defined (pta^.requestHeaders.cookies.[cookieName]) {
		cookieString = pta^.requestHeaders.cookies.[cookieName]};
	t = mainresponder.members.cookieStringToTable (cookieString);
	if defined (t.id) {
		if getargs.u == t.id {
			if t.h == manilaSuite.radioHosting.getEditorHash (pta, usernum, password) {
				return (true)}}};
	return (false)}