					s = string.replaceAll (s, "{url}", memberurl, false);
					s = string.replaceAll (s, "{memberLink}", memberlink, false);
					s = string.replaceAll (s, "{email}", membermail, false);
					local (postTime = mainResponder.localization.dateTimeString (adrmsg^.posttime, pta) );
					bundle { //add permalink after post time
						postTime = postTime + " <a href=\"#a" + msgnum + "\" title=\"Permanent link to this comment.\" target=\"_self\">#</a>"};
					s = string.replaceAll (s, "{postTime}", postTime, false);
					local (ipaddress = "");
					if defined (adrmsg^.ipAddress) {ipaddress = adrmsg^.ipAddress};
					s = string.replaceAll (s, "{ipAddress}", ipaddress, false)};
				«bundle //1/15/05 by DW -- add rel="nofollow" on all anchors
					«s = string.replaceall (s, "<a", "<a rel=\"nofollow\"", false)
				add (s);
				if not (pta^.method == "POST") {
					adrmsg^.ctReads++};
				ctcomments++;
				
				bundle { //flip the bgcolor
					if bgcolor == bgcolor1 {
						bgcolor = bgcolor2}
					else {
						bgcolor = bgcolor1}}};
			
			local (responsenum);
			for responsenum in adrmsg^.responses {
				if sizeOf (htmltext) > 102400 { //100 KB max
					break};
				addMessage (responsenum)};
			
			return (true)};
		
		bundle { //form start
			add ("<form method=\"POST\" target=\"_self\">")};
		add (header); indentlevel++;
		add (linkback); //link to the original post
		if flError { //replace the message with the error message
			footer = string.replace (footer, "[[message]]", "<tr><td class=\"comment\" colspan=\"2\" width=\"100%\" style=\"color:red\"><b>" + errorMessage + "</b></td></tr>")};
		if flComments { //add the comments
			«if flCanDeleteComments //JES 7/21/04: form start for comment deletion
				«add ("<form method=\"POST\" target=\"_self\">")
			if flCommentsInThisSite {
				local (msgnum = number (postnum));
				local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum, adrsite));
				local (response);
				for response in adrmsg^.responses {
					if sizeOf (htmltext) > 102400 { //100 KB max
						break};
					addMessage (response)}}
			else {
				local (msgnum = adrcomments^.msgnum);
				local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum, adrsite));
				addMessage (msgnum)};
			«if flCanDeleteComments //JES 7/21/04: delete button for comment deletion, form end
				«local (lowerTrimmedTemplate = string.lower (string.trimWhiteSpace (string (adrdata^.comments.itemTemplate) )) )
				«local (flAddTableTags = false)
				«if lowerTrimmedTemplate contains "<tr"
					«if not (lowerTrimmedTemplate contains "<table")
						«flAddTableTags = true
				«local (deleteButton = "<input type=\"submit\" name=\"deleteComments\" value=\"" + manilaSuite.getString ("radioHosting.deleteCommnetsButton") + "\" />")
				«if flAddTableTags
					«add ("<tr bgcolor=\"" + bgcolor + "\"><td>" + deleteButton + "</td></tr>")
				«else
					«add ("<br /><br />" + deleteButton)
				«add ("</form>")
			footer = string.replace (footer, "[[message]]", "")};
		if ctcomments < 1 { //no comments
			footer = string.replace (footer, "[[message]]", "<tr><td class=\"comment\" colspan=\"2\" width=\"100%\" bgcolor=\"" + bgcolor + "\"><b>" + manilaSuite.getString ("radioHosting.noCommentsFound") + "</b></td></tr><tr><td colspan=\"2\">&nbsp;</td></tr>")};
		add (footer); indentlevel--;
		bundle { //form end
			add ("</form>")}};
	
	return (htmltext)};
«bundle //testing
	«html.setPageTableAddress (@workspace.pt)
	«commentsPage ()
	«html.deletePageTableAddress ()