				«Created. Render a comments page for an arbitrary site and postnum. Create new members for people who create comments, as needed. Set a cookie for membership, so the user doesn't have to re-enter their name, email and website url.
	
	local (adrdata = manilaSuite.radioHosting.init ());
	local (flLoginRequiredForComments = adrdata^.flLoginRequired);
	local (pta = html.getPageTableAddress ());
	pta^.flAnchorRelNofollow = true; //JES 1/20/05: tell Manila's finalFilter to add rel="nofollow" to all <a ... > tags
	«workspace.pt = pta^
	
	if (not config.manila.prefs.flRadioHostingEnabled) or (not adrdata^.flEnabled) { //return a 404 page
		return (manilaSuite.notFound.page (pta))};
	
	local (getargs); new (tableType, @getargs);
	webserver.parseArgs (string.replaceAll (pta^.searchArgs, "&amp;", "&"), @getargs);
	
	local (flTrackback = false);
	if defined (pta^.pathArgs) { //set flTrackback
		if string.lower (pta^.pathArgs) == "trackback" {
			flTrackback = true}};
	if flTrackback { //return a 404 page if the TrackBack or comment features are disabled
		if not manilaSuite.getNewsSitePref ("trackback.flAcceptPingsAutomatically", default: false) {
			return (manilaSuite.notFound.page (pta))}}
	else {
		if not manilaSuite.getNewsSitePref ("newsItems.flCommentsEnabledByDefault", default:false) {
			return (manilaSuite.notFound.page (pta))}};
	
	bundle { // shortcut straight to the count
		if defined (getargs.c) {
			if getargs.c == "counts" {
				pta^.template = "{bodytext}";
				if flTrackback { //trackback counters
					return ("{manilaSuite.radioHosting.renderCounterJavaScript (true)}")}
				else { //comment counters
					return ("{manilaSuite.radioHosting.renderCounterJavaScript ()}")}};
			if getargs.c == "getRpcInfo" { // 27/09/04; 10:16:48 AM by PR: moved
				pta^.template = "{bodytext}";
				pta^.responseHeaders.["Content-Type"] = "text/xml";
				return ("{manilaSuite.radioHosting.getRpcInfo ()}")}}};
	
	local (usernum = getargs.u);
	if usernum contains "#" { //workaround a bug
		usernum = string.nthField (usernum, "#", 1)};
	
	«23/08/04; 11:13:19 AM by PR: If the user prefs for this user contains a password then we can show the moderation form
	local (flRadio = false, userPassword);
	if defined (adrData^.userPrefs.[usernum].password) {
		flRadio = true;
		userPassword = adrData^.userPrefs.[usernum].password;
		if defined (pta^.postargs.c) && !defined (getargs.c) && defined (pta^.postargs.password) {
			if pta^.postargs.password != "" {
				getargs.c = pta^.postargs.c}}}; // work around the fact that there is one big form on the page...
	
	local (flCanDeleteComments = false);
	bundle { //set flCanDeleteComments
		«7/21/04; 2:47:31 PM by JES: Right now, this is only implemented for Manila site Managing/Content Editors. Radio may come later.
		«19/08/04; 9:41:53 AM by PR: implemented a Radio editor check
		if flRadio {
			flCanDeleteComments = manilaSuite.radioHosting.canEditComments (pta, getargs.u, userPassword)}
		else {
			flCanDeleteComments = manilaSuite.editors.canEditContent (pta)}};
	
	local (flCommentModerationEnabled = adrdata^.flCommentsModerated and (not manilaSuite.editors.editorialTest (pta)));
	local (flModeratedCommentPosted = false);
	if defined (getargs.postPending) {
		flModeratedCommentPosted = true;
		delete (@getargs.postPending)};
	
	local (htmltext = "", indentlevel = 0);
	on add (s) {
		htmltext = htmltext + (string.filledString ("\t", indentlevel) + string.trimWhiteSpace (s) + "\r");};
	
	local (adrsite = manilaSuite.getSiteAddress ());
	
	local (loginError = "");
	
	bundle { //process searchArgs: logout if c=logout. return counter JavaScript if c=counts
		«on setRadioCookie (flClear=false) // 19/08/04; 9:35:34 AM by PR set or clear the cookie for the radio comment editor
			«JES 1/13/06: Factored to manilaSuite.radioHosting.setRadioCookie.
		if defined (getargs.c) {
			if getargs.c == "logout" { //clear mainResponder cookie and redirect to clear comments cookie
				local (groupname = pta^.defaultMembershipGroup);
				local (adrmembers = mainResponder.members.getMembershipTable (groupname));
				mainResponder.members.setCookie ("", "", adrmembers);
				getargs.c = "logout2";
				mainResponder.redirect (pta^.path + "?" + webserver.encodeArgs (@getargs));
				return ("")};
			if getargs.c == "logout2" { //clear comments cookie and redirect to comments page
				manilaSuite.radioHosting.setCookie ("");
				delete (@getargs.c);
				mainResponder.redirect (pta^.path + "?" + webserver.encodeArgs (@getargs));
				return ("")};
			«if getargs.c == "counts" // 02/09/04; 1:21:16 PM by PR: moved
				«pta^.template = "{bodytext}"
				«if flTrackback //trackback counters
					«return ("{manilaSuite.radioHosting.renderCounterJavaScript (flTrackBack:true)}")
				«else //comment counters
					«return ("{manilaSuite.radioHosting.renderCounterJavaScript ()}")
			«if getargs.c == "getRpcInfo" // 27/09/04; 10:16:48 AM by PR: moved
				«pta^.template = "{bodytext}"
				«pta^.responseHeaders.["Content-Type"] = "text/xml"
				«return ("{manilaSuite.radioHosting.getRpcInfo ()}")
			if getargs.c == "radioLogin" { // 19/08/04; 9:34:57 AM by PR handle a radio user login
				if flRadio {
					if string.hashmd5(pta^.postargs.password) == userPassword {
						manilaSuite.radioHosting.setRadioCookie (usernum, userPassword);
						delete (@getargs.c);
						local (pathArg = "");
						if pta^.pathArgs != "" {
							pathArg = "$" + pta^.pathArgs};
						mainResponder.redirect (pta^.path + pathArg + "?" + webserver.encodeArgs (@getargs));
						return ("")}
					else {
						delete (@getargs.c);
						loginError = "Error: wrong password."}}};
			if getargs.c == "radioLogout" { // 19/08/04; 9:35:07 AM by PR handle a radio user logout
				if flRadio {
					manilaSuite.radioHosting.setRadioCookie (usernum, userPassword, flClear:true);
					delete (@getargs.c);
					local (pathArg = "");
					if pta^.pathArgs != "" {
						pathArg = "$" + pta^.pathArgs};
					mainResponder.redirect (pta^.path + pathArg + "?" + webserver.encodeArgs (@getargs));
					return ("")}}}};
	
	local (postnum = getargs.p);
	local (adruserstable);
	bundle { //set adruserstable
		if flTrackback {
			adruserstable = @adrdata^.trackback.users}
		else { //comments
			adruserstable = @adrdata^.comments.users}};
	local (postlink = "");
	bundle { //set postlink
		if defined (getargs.link) {
			postlink = getargs.link}};
	
	local (adrcache);
	bundle { //set adrcache
		if flTrackback { //set adrcache for trackback cache
			adrcache = @adrdata^.trackback.counterScriptCache.[string.padWithZeros (usernum, 7)]}
		else { //set adrcache for comment cache
			adrcache = @adrdata^.comments.counterScriptCache.[string.padWithZeros (usernum, 7)]}};
	if pta^.method == "POST" { //clear the cached counter JavaScript
		if defined (adrcache^) {
			delete (adrcache)}};
	
	on getCommentsTable (usernum) {
		local (adrtable = @adruserstable^.[string.padWithZeros (usernum, 7)] );
		if not defined (adrtable^) {
			new (tableType, adrtable)};
		return (adrtable)};
	local (adrcommentstable = getCommentsTable (usernum) );
	on getComments (postid) {
		return (@adrcommentstable^.[postid] )};
	local (adrcomments = getComments (postnum) );
	local (flComments = false, flCommentsInThisSite = false);
	bundle { //set flComments
		if defined (adrcomments^) {
			if sizeOf (adrcomments^) > 0 {
				flComments = true}};
		try { //see if the comment is in this manila site -- if so, set flCommentsInThisSite to true
			if string.lower (usernum) == string.lower (manilaSuite.getCanonicalSiteName (adrsite)) {
				flCommentsInThisSite = true;
				flComments = true};
			if string.lower (postlink) beginsWith string.lower (manilaSuite.getSiteUrl (adrsite)) {
				flCommentsInThisSite = true}}};
	bundle { //convert to new style storage in a table
		if defined (adrcomments^) {
			if typeOf (adrcomments^) != tableType {
				local (msgnum = adrcomments^);
				new (tableType, adrcomments);
				adrcomments^.msgnum = msgnum;
				adrcomments^.link = ""}}};
	
	local (adrStats = manilaSuite.radioHosting.initUserStats(usernum, adrdata)); // 03/09/04; 10:30:28 AM by PR: init the user stats
	
	bundle { //set page title
		if flTrackback {
			pta^.title = manilaSuite.getString ("trackback.trackbackPageTitle")}
		else { //comments
			pta^.title = manilaSuite.getString ("radioHosting.commentsPageTitle")}};
	
	on getMemberTable (memberkey) {
		local (groupname = pta^.defaultMembershipGroup);
		local (adrmember = mainResponder.members.getMemberTable (groupname, memberkey));
		return (adrmember)};
	on addRadioModeration () {
		«19/08/04; 9:34:06 AM by PR if this a radio comment display the moderation form
		if flRadio {
			local (s = "");
			if !flCanDeleteComments {
				if loginError != "" {
					s = s +  ("<p><a name=\"error\"></a>" + loginError + "</p>\r")};
				s = s + ("<p><hr size=\"1\" width=\"100%\"><p>" + manilaSuite.getString ("radioHosting.commentModerationPrompt") + "<br /><br /><b>Password:</b> <input name=\"password\" type=\"password\" /> <input type=\"submit\" value=\"" + manilaSuite.getString ("common.submitButton") + "\" /></p>\r");
				s = s + "<input type=\"hidden\" name=\"c\" value=\"radioLogin\" />"}
			else {
				«logout message
				s = s + "<p><a target=\"_self\" href=\"" + pta^.path + "?c=radioLogout&" + webserver.encodeArgs (@getargs) + "\">" + manilaSuite.getString ("radioHosting.disableCommentDeletion") + "</a></p>"};
			return (s)};
		return ""};
	
	on forbiddenPage () {
		pta^.template = string (manilaData.notFoundTemplate);
		pta^.title = "403 Forbidden";
		pta^.code = 403;
		pta^.activeUrls = false;
		return ("Request Forbidden.")};
	
	if flTrackback { //handle trackback posts (pings) and pop-up window rendering
		«bundle //debugging
			«if not defined (workspace.tbs)
				«new (tableType, @workspace.tbs)
			«workspace.tbs.[string (clock.now ()) + "_" + clock.ticks ()] = pta^
		local (flPing = (pta^.method == "POST") );
		if defined (pta^.postArgs.deleteTrackbacks) { //cause form posts for trackback deletion to get passed to manilaSuite.trackback.defaultPage
			flPing = false};
		bundle { //work around a bug in MovableType
			«Ben Trott tells us that if the ping URL contains a query string, then MT uses a GET instead of a POST, for backward compatibility with older MT installations that implement the old version of the TrackBack spec.
			if pta^.requestBody contains "url=" {
				webserver.parseargs (pta^.requestBody, @getargs)};
			if defined (getargs.title) {
				if not defined (pta^.postArgs) {
					new (tableType, @pta^.postArgs)};
				table.copyContents (@getargs, @pta^.postArgs);
				flPing = true;
				if defined (adrcache^) { //clear counter cache
					delete (adrcache)}}};
		if flPing { //accept an incoming ping
			«adrcomments is the address of a sub-table for this usernum and post
				«we'll treat it as if it were a message table, and allow the trackback sub-system to store its data there.
			bundle { //call trackbackSubmit callbacks
				try {
					local (adrcallbacks = @config.manila.callbacks.trackbackSubmit);
					if not defined (adrcallbacks^) {
						new (tableType, adrcallbacks)};
					for adr in adrcallbacks {
						local (adrscript = adr);
						try {
							while typeOf (adrscript^) == addressType { //follow addresses
								adrscript = adrscript^};
							if not adrscript^ (pta) {
								return (forbiddenPage ())}}}}};
			on respondCallback (url, title, excerpt, weblogName) {
				url = manilaSuite.untaint (url);
				bundle { //strip markup from the ping elements
					url = searchEngine.stripMarkup (url);
					title = searchEngine.stripMarkup (title);
					excerpt = searchEngine.stripMarkup (excerpt);
					weblogName = searchEngine.stripMarkup (weblogName)};
				on countTrackbacks (adrUrls) {
					local (ct = 0);
					if defined (adrUrls) {
						for adr in adrUrls {
							if adr^.flPosted {
								ct++}}};
					return (ct)};
				on initUrlTable (adrparent, url) {
					trackback.initPost (adrparent);
					return (@adrparent^.trackback.inbound.urls.[url])};
				if not defined (adrcomments^) {
					new (tableType, adrcomments)};
				local (adrurl = initUrlTable (adrcomments, url));
				if not defined (adrurl^) {
					new (tableType, adrurl)};
				adrurl^.weblogName = manilaSuite.untaint (weblogName);
				adrurl^.title = manilaSuite.untaint (title);
				adrurl^.excerpt = manilaSuite.untaint (excerpt);
				adrurl^.whenPing = clock.now ();
				adrurl^.flPosted = true;
				if defined (adrcomments^.count) {
					adrcomments^.count++}
				else {
					adrcomments^.count = countTrackbacks (@adrcomments^.trackback.inbound.urls)};
				bundle { // 01/09/04; 1:10:56 PM by PR: set whenLastModified 
					adrStats^.whenLastModified = clock.now()}};
			return (trackback.respondToPing (@respondCallback))}
		else { //render a trackback pop-up window
			if defined (adrcomments^) {
				return (manilaSuite.trackback.defaultPage (true, @adrcomments^.trackback, flCanDeleteComments))}
			else {
				return (manilaSuite.trackback.defaultPage (true, nil, flCanDeleteComments))}}}
	else { //handle comment posts and pop-up window rendering
		manilaSuite.radioHosting.setTemplate ();
		local (header = string (adrdata^.comments.header));
		local (footer = string (adrdata^.comments.footer));
		local (linkback = "");
		bundle { //set linkback
			if defined (adrcomments^) {
				if sizeOf (adrcomments^.link) > 0 {
					linkback = string.replaceAll (string (adrdata^.comments.postLink), "{posturl}", adrcomments^.link);
					manilaSuite.untaint (linkback)}}};
		local (bgcolor1 = adrdata^.comments.colors.bgcolor1);
		local (bgcolor2 = adrdata^.comments.colors.bgcolor2);
		local (commentform = "");
		bundle { //render commentform
			on addToCommentForm (s) {
				commentform = commentform + (string.trimWhiteSpace (s) + "\r");};
			«addToCommentForm ("<form method=\"POST\" target=\"_self\">")
			addToCommentForm ("<a name=\"newComment\"></a>");
			if flModeratedCommentPosted {
				addToCommentForm ("<p><b>" + manilaSuite.getString ("radioHosting.commentSubmittedForApproval") + "</b></p>")};
			local (flHasCookie = false, adrmember, membername = "", memberurl = "");
			if defined (pta^.adrMemberInfo) {
				adrmember = pta^.adrMemberInfo;
				membername = nameOf (adrmember^);
				if defined (adrmember^.personalInfo) {
					if defined (adrmember^.personalInfo.name) {
						membername = adrmember^.personalInfo.name};
					if defined (adrmember^.personalInfo.webSiteUrl) {
						memberurl = adrmember^.personalInfo.webSiteUrl}};
				flHasCookie = true};
			if not flHasCookie { //try to get the email from the radioComments cookie
				local (email);
				if manilaSuite.radioHosting.getEmailFromCookie (@email) {
					adrmember = manilaSuite.members.getMemberTableFromSiteAddress (adrsite, email);
					if defined (adrmember^) {
						memberName = nameOf (adrmember^);
						if defined (adrmember^.personalInfo) {
							if defined (adrmember^.personalInfo.name) {
								membername = adrmember^.personalInfo.name};
							if defined (adrmember^.personalInfo.webSiteUrl) {
								memberurl = adrmember^.personalInfo.webSiteUrl}};
						flHasCookie = true}}};
			if flHasCookie { //add name, email and website as hidden fields
				addToCommentForm ("<input type=\"hidden\" name=\"name\" value=\"" + membername + "\" />");
				addToCommentForm ("<input type=\"hidden\" name=\"email\" value=\"" + nameOf (adrmember^) + "\" />");
				addToCommentForm ("<input type=\"hidden\" name=\"url\" value=\"" + memberurl + "\" />")};
			addToCommentForm ("<table cellpadding=\"4\" cellspacing=\"0\" border=\"0\" width=\"100%\">");
			if flCanDeleteComments { //JES 7/21/04: delete button for comment deletion
				local (deleteButton = "<input type=\"submit\" name=\"deleteComments\" value=\"" + manilaSuite.getString ("radioHosting.deleteCommnetsButton") + "\" />");
				addToCommentForm ("<tr><td colspan=\"2\">" + deleteButton + "</td></tr>")};
			local (logoutlink = "");
			if flHasCookie { //set logoutlink
				local (t); new (tableType, @t);
				t.membername = membername;
				local (linktext = manilaSuite.getString ("radioHosting.notSoAndSo", @t));
				local (tooltip = manilaSuite.getString ("radioHosting.clickIfYoureNotSoAndSo", @t));
				logoutlink = "<span>[<a href=\"" + pta^.uri + "?c=logout&" + webserver.encodeArgs (@getargs) + "\" title=\"" + tooltip + "\" target=\"_self\">" + linktext + "</a>]</span>";
				};«logoutlink = "<span>[<a href=\"" + pta^.uri + "?u=" + usernum + "&p=" + postnum + "&c=logout\" title=\"" + tooltip + "\" target=\"_self\">" + linktext + "</a>]</span>"
			addToCommentForm ("[[message]]");
			bundle { //header
				addToCommentForm ("<tr><td class=\"form\" colspan=\"2\" width=\"100%\"><b>" + manilaSuite.getString ("radioHosting.addYourCommentPrompt") + "</b>&nbsp;&nbsp;" + logoutlink + "</td></tr>")};
			if not flHasCookie { //add name, email and website fields, -or- login fields
				if flLoginRequiredForComments {
					local (membershipRequiredPrompt);
					if defined (pta^.newsSite^.flMembership) and pta^.newsSite^.flMembership { //membership is enabled
						membershipRequiredPrompt = string.replace (manilaSuite.getString ("radioHosting.membershipRequiredSignUpHere"), "[[signupUrl]]", manilaSuite.getUrl ("memberSignUp", pta), false)}
