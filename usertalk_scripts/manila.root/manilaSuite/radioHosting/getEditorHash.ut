on getEditorHash (pta, usernum, password) {
	«23/08/04; 11:21:53 AM by PR
		«Get the hash for the radio editor
	local (groupName, hash);
	bundle { // set the group name
		if defined (pta^.responderAttributes.defaultMembershipGroup) {
			groupName = pta^.responderAttributes.defaultMembershipGroup};
		if defined (pta^.responderAttributes.members) {
			groupName = pta^.responderAttributes.members}};
	hash = string.hashMD5 (password + groupName + usernum);
	return (hash)}