on initUserStats (userNum, adrData=nil) {
	//24/09/04; 11:39:31 AM by PR
		//set to use only one whenLastModified for both trackback and comments
	//03/09/04; 10:13:43 AM by PR
		//Initialize the user stats tables and set whenLastModified for a given usernum, we can accept both a zero padded string or a number, we assume that radioHosting has bee enabled
	if adrData == nil {
		adrdata = manilaSuite.radioHosting.init ()};
	
	bundle { // make sure we end up with a zero padded string as the usernum
		if typeOf (userNum) != stringType {
			userNum = string.padwithzeros (userNum, 7)};
		if sizeOf (userNum) != 7 {
			userNum = string.padwithzeros (userNum, 7)}};
	
	if !defined (adrData^.userStats) {
		new (tableType, @adrData^.userStats)};
	local (adrStats = @adrData^.userStats.[userNum]);
	if !defined (adrStats^) {
		new (tableType, adrStats)};
	
	adrStats^.whenLastModified = clock.now ();
	
	return (adrStats)};
