						adr^.count = countTrackbacks (@adr^.trackback.inbound.urls)} // 02/09/04; 9:17:38 AM by PR: use the count script, now checks for deleted items
					else {
						adr^.count = 0}};
				ct = adr^.count;
				tbcounts = tbcounts + ("\"" + ct + "\", ");;
				tbpostids = tbpostids + ("\"" + postid + "\", ");;
				tbend++};
			tbend++}};
	postids = "[" + postids + "\"\"]";
	tbpostids = "[" + tbpostids + "\"\"]";
	counts = "[" + counts + "\"\"]";
	tbcounts = "[" + tbcounts + "\"\"]";
	
	«24/09/04; 8:22:17 AM by PR build the return for comments and trackback individually
	if flComment {
		commentReturn = string (manilaSuite.radioHosting.data.counterScript);
		bundle { // comment return 
			commentReturn = string.replace (commentReturn, "[[postids]]", postids);
			commentReturn = string.replace (commentReturn, "[[counts]]", counts);
			commentReturn = string.replace (commentReturn, "[[end]]", end);
			commentReturn = string.trimWhiteSpace (commentReturn)}};
	if flTrackback {
		trackbackReturn = string (manilaSuite.radioHosting.data.counterScript);
		bundle { // trackback return
			trackbackReturn = string.replace (trackbackReturn, "[[postids]]", tbpostids);
			trackbackReturn = string.replace (trackbackReturn, "[[counts]]", tbcounts);
			trackbackReturn = string.replace (trackbackReturn, "[[end]]", tbend);
			trackbackReturn = string.replaceAll (trackbackReturn, "commentCounter", "trackbackCounter", false);
			trackbackReturn = string.replaceAll (trackbackReturn, "postids", "tbpostids", false);
			trackbackReturn = string.replaceAll (trackbackReturn, "counts", "tbcounts", false);
			trackbackReturn= string.replaceAll (trackbackReturn, "start", "tbstart", false);
			trackbackReturn = string.replaceAll (trackbackReturn, "end", "tbend", false);
			trackbackReturn = string.trimWhiteSpace (trackbackReturn)}};
	
	if (flOneFile) {
		return (commentReturn + "\n" + trackbackReturn)} // return both
	else {
		if flTrackbackReturn {
			return (trackbackReturn)}
		else {
			return (commentReturn)}}};
