on setCookie (email, flExpireAtEndOfSession=false) {
	//Changes:
		//2/19/02; 2:39:09 AM by JS
			//Created. Cribbed from mainResponder.members.setCookie.
	local (pta = html.getPageTableAddress ());
	local (groupname = pta^.defaultMembershipGroup);
	local (adrmembers = mainResponder.members.getMembershipTable (groupname));
	local (s);
	s = string.innerCaseName (adrMembers^.cookieName + "RadioComments") + "=";
	s = s + string.urlEncode (email) + "; ";
	if (not flExpireAtEndOfSession) and (sizeof (adrMembers^.cookieExpires) > 0) {
		s = s + "expires=" + adrMembers^.cookieExpires + "; "};
	s = s + "path=/";
	
	pta^.responseHeaders.["Set-Cookie"] = s;
	
	return (s)}