on getSeparatorColors (adrSeparator, adrSeparatorText) {
	«Get the editor's specified separator colors.
		«12/21/99; 7:49:13 PM by PBS
	
	local (adrSeparatorDefault = @manilaData.newSiteTemplate.["#newsSite"].colors.separator);
	local (adrSeparatorTextDefault = @manilaData.newSiteTemplate.["#newsSite"].colors.separatorText);
	
	adrSeparator^ = manilaSuite.getNewsSitePref ("colors.separator", default:adrSeparatorDefault^, flCreate:true, flUnTaint:true);
	adrSeparatorText^ = manilaSuite.getNewsSitePref ("colors.separatorText", default:adrSeparatorTextDefault^, flCreate:true, flUnTaint:true);
	
	if string.trimWhiteSpace (adrSeparator^) == "" {
		adrSeparator^ = adrSeparatorDefault^};
	if string.trimWhiteSpace (adrSeparatorText^) == "" {
		adrSeparatorText^ = adrSeparatorTextDefault^};
	
	return (true)}