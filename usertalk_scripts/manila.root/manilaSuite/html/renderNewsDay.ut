on renderNewsDay (s, d, title="", templateText=nil, pta=nil) {
	//Render text through the news day template.
		//05/02/00; 2:57:30 PM by PBS
		//Changes:
			//05/14/00; 6:46:36 PM by JES
				//localized
			//05/31/00; 12:51:21 PM by JES
				//localized {newsPostTime}
			//9/13/01; 3:56:13 PM by PBS
				//Support for alternate date formats.
			//9/14/01; 2:59:06 PM by PBS
				//Support for custom permanent link icons.
	
	local (htmlText);
	
	if templateText == nil {
		if pta == nil {
			pta = html.getPageTableAddress ()};
		if defined (pta^.newsSite^.newsDayTemplate) {
			templateText = string (pta^.newsSite^.newsDayTemplate)}
		else {
			templateText = "<b>{newsPostTime}</b>\r<p>\r{newsContent}\r<p>"}};
	
	local (archiveLink);
	bundle { //set archiveLink
		local (day, month, year, hour, minute, second);
		date.get (d, @day, @month, @year, @hour, @minute, @second);
		month = string.padwithzeros (month, 2);
		day = string.padwithzeros (day, 2);
		local (replacementTable); new (tableType, @replacementTable);
		replacementTable.date = mainResponder.localization.shortDateString (d, pta);
		local (archiveLinkTitle = manilaSuite.getString ("news.archiveLinkTitle", @replacementTable, pta: pta)); //PBS 06/14/00: this string is used twice: once as link title, once as alt attribute for the image //06/15/00 JES: merge with localized version
		local (imgSrc = manilaData.newSiteTemplate.["#newsSite"].permanentLinkImage); //PBS 09/14/01: get the img tag for the permanent link icon
		if defined (pta^.newsSite^.permanentLinkImage) {
			imgSrc = pta^.newsSite^.permanentLinkImage};
		if (imgSrc contains "<img") and (not (imgSrc contains "alt=")) { //add alt tag
			imgSrc = string.replace (imgSrc, "<img ", "<img alt=\"" + archiveLinkTitle + "\" ")};
		//archiveLink = "<a href=\"" + manilaSuite.getUrL ("newsHome") + year + "/" + month + "/" + day + "\" title=\"" + manilaSuite.getString ("news.archiveLinkTitle", @replacementTable, pta: pta) + ".\"><img src=\"http://static.userland.com/misc/snImages/dailyLinkIcon.gif\" height=\"15\" width=\"12\" border=\"0\"></a>"
		archiveLink = "<a href=\"" + manilaSuite.getUrl ("newsHome") + year + "/" + month + "/" + day + "\" title=\"" + archiveLinkTitle + ".\">" + imgSrc + "</a>";
		if manilaSuite.staticRendering.isStaticRendering () {
			archiveLink = manilaSuite.staticRendering.patchLocalUrls (archiveLink)}};
	
	local (dateString);
	bundle { //PBS 09/13/01: get the date string
		local (dateFormat = "dwmdy"); //PBS 09/13/01: get the date format
		if defined (pta^.newsSite^.homePageDateFormat) {
			dateFormat = pta^.newsSite^.homePageDateFormat};
		local (day, month, year, hour, minute, second);
		date.get (d, @day, @month, @year, @hour, @minute, @second);
		case dateFormat { //PBS 09/13/01: support for date formats
			"dwmdy" { //default
				dateString = mainResponder.localization.longDateString (d, pta)};
			"dmy" { //26 March 2001
				dateString = day + " " + mainResponder.getString ("date.monthNames." + string.padWithZeros (month, 2)) + " " + year};
			"mdy" { //March 26, 2001
				dateString = mainResponder.getString ("date.monthNames." + string.padWithZeros (month, 2)) + " " + day +", " + year};
			"m/d/y" { //03/26/2001
				dateString = string.padWithZeros (month, 2) + "/" + string.padWithZeros (day, 2) + "/" + year};
			"d/m/y" { //26/03/2001
				dateString = string.padWithZeros (day, 2) + "/" + string.padWithZeros (month, 2) + "/" + year};
			"m.d.y" { //03.26.2001
				dateString = string.padWithZeros (month, 2) + "." + string.padWithZeros (day, 2) + "." + year};
			"d.m.y" { //26.03.2001
				dateString = string.padWithZeros (day, 2) + "." + string.padWithZeros (month, 2) + "." + year}}};
	
	htmlText = templateText;
	//htmlText = string.replaceAll (htmlText, "{newsPostTime}", mainResponder.localization.longDateString (d, pta), false) // 05/31/00 JES: localized
	htmlText = string.replaceAll (htmlText, "{newsPostTime}", dateString, false); // 05/31/00 JES: localized
	htmlText = string.replaceAll (htmlText, "{newsContent}", s, false);
	htmlText = string.replaceAll (htmlText, "{newsTitle}", title, false);
	htmlText = string.replaceAll (htmlText, "{newsArchiveLink}", archiveLink, false);
	
	return (htmlText)}