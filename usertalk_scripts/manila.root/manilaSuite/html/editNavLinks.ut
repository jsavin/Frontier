on editNavLinks () {
	«Changes
		«3/27/06; 4:32:25 PM by JES
			«Properly handle deletion of the only nav link.
		«9/19/05; 3:30:51 PM by JES
			«Changed Cohort column header to "Visible To", which newbies will understand more easily.
		«13/07/05; 6:01:57 PM by PR
			«Add a new drop down for cohorts, only the selected cohort will be able to see the specified nav item
			«The cohort is specfied in the XML using 'cohort=cohortname'
		«7/5/05; 4:46:20 PM by JES
			«Add new checkbox column for specifying that a link is private. Private links are displayed only for editors. They're specified in the XML using the editorsOnly="true" attribute on an item.
		«3/17/05; 5:19:08 PM by JES
			«Provide a mechanism for inserting non-breaking spaces in link names. Non-breaking spaces are represented by "\ " in the web UI, and are translated in both directions.
		«8/18/03; 11:15:11 AM by JES
			«Fixed a bug which could sometimes cause the arrow operations not to work.
		«5/22/03; 12:37:11 PM by JES
			«Use locally served arrow icons instead of hard-coded ones.
		«5/5/03; 11:32:23 AM by JES
			«Added support for navigation links which are specified using a shortcut or msgnum.
		«5/3/03; 3:03:57 PM by JES
			«Don't throw an error if there are no items in the navigation structure.
		«4/22/03; 10:46:50 AM by JES
			«When processing changes, encode &, <, >, and " characters, so that the XML will be well formed. The browser will happily decode these characters when going in the other direction.
		«4/21/03; 4:47:02 PM by JES
			«Localized. Added managing editor/content editor tests. Load the arrow icons from the local server instead of using hard-coded urls. Decompile the XML structure back into XML when POSTing.
		«4/20/03; 4:12:58 PM by DW
			«Bryan Bell wants a navigation links editor for his users.
				«http://static.redjupiter.com/images/bryanbell/navLinks.gif
	local (pta = html.getpagetableaddress ());
	bundle { //managing/content editor test
		if not manilaSuite.editors.managingEditorTest () {
			if not manilaSuite.editors.contentEditorTest () {
				scriptError (manilaSuite.getString ("admin.cantDisplayPageNoPermission"))}}};
	local (uparrowurl, downarrowurl);
	bundle { //set uparrow, downarrow
		uparrowurl = "http://" + pta^.host + "/mainResponderResources/icons/upArrow";
		downarrowurl = "http://" + pta^.host + "/mainResponderResources/icons/downArrow"};
	local (adrroot = pta^.adrSiteRootTable);
	local (adrnavigator = pta^.navigator);
	local (adrstructure = @adrnavigator^.structure);
	pta^.title = manilaSuite.getString ("blogrollEditor.pageTitle");
	local (htmltext = "", indentlevel = 0);
	bundle { //compile the xml text if it's been modified
		local (flcompile = true);
		if defined (adrnavigator^.structure) {
			if timemodified (@adrnavigator^.outline) <= timemodified (@adrnavigator^.structure) {
				flcompile = false}};
		if flcompile {
			xml.compile (string (adrnavigator^.outline), @adrnavigator^.structure)}};
	
	on add (s) {
		htmltext = htmltext + string.filledstring ("\t", indentlevel) + s + "\r"};
	on input (name, value, size=20, maxlength=100) {
		return ("<input type=\"text\" name=\"" + name + "\" size=\"" + size + "\" maxlength=\"" + maxlength + "\" value=\"" + value + "\">")};
	on cohortDropdown (name, selected) {
		local (s = "<select name=\"" + name + "\">\r");
		local (adrCohort);
		for adrCohort in @manilaSuite.members.getGroupFromSiteAddress (manilaSuite.getSiteAddress())^.cohorts {
			s = s + "<option";
			if adrCohort^.name == selected {
				s = s + " selected"};
			s = s + ">" + adrCohort^.name + "</option>"};
		s = s + "</select>";
		return (s)};
	on encode (s) {
		s = string.replaceAll (s, "\\&", "[[[&]]]");
		s = string.replaceAll (s, "&", "&amp;");
		s = string.replaceAll (s, "[[[&amp;]]]", "&");
		s = string.replaceAll (s, "<", "&lt;");
		s = string.replaceAll (s, ">", "&gt;");
		s = string.replaceAll (s, "\"", "&quot;");
		«s = string.replaceAll (s, "\'", "&apos;")
		return (s)};
	
	local (msgforuser = "");
	if pta^.method == "POST" {
		«scratchpad.params = pta^
		local (flchanges = false);
		local (args = pta^.postargs);
		bundle { //moving items
			local (i, adr, name, ix);
			for i = sizeof (args) downto 1 {
				adr = @args [i];
				name = nameof (adr^);
				if name beginswith "uparrow" {
					local (adrnavigator = @adrstructure^ [1]);
					local (ix = number (string.nthfield (string.delete (name, 1, 7), ".", 1)));
					local (adrsource = @adrnavigator^ [ix]);
					local (adrdest = @adrnavigator^ [ix-1]);
					local (temp = adrdest^);
					adrdest^ = adrsource^;
					adrsource^ = temp;
					flchanges = true;
					break}; //there will be two uparrows, only want to do it once
				if name beginswith "downarrow" {
					local (adrnavigator = @adrstructure^ [1]);
					local (ix = number (string.nthfield (string.delete (name, 1, 9), ".", 1)));
					local (adrsource = @adrnavigator^ [ix]);
					local (adrdest = @adrnavigator^ [ix+1]);
					local (temp = adrdest^);
					adrdest^ = adrsource^;
					adrsource^ = temp;
					flchanges = true;
					break}}}; //there will be two downarrows, only want to do it once
		if not flchanges { //if we move something, no other changes happen
			bundle { //pick up editing changes
				local (i, adr, name, ix);
				for i = sizeof (args) downto 1 {
					adr = @args [i];
					name = nameof (adr^);
					if name beginswith "name" {
						local (adrnavigator = @adrstructure^ [1]);
						local (ix = number (string.delete (name, 1, 4)));
						local (adritem = @adrnavigator^ [ix]);
						local (adratts = @adritem^.["/atts"]);
						if adratts^.name != adr^ {
							adratts^.name = string.replaceAll (encode (adr^), "\\ ", "&nbsp;");
							flchanges = true};
						local (newvalue = args.["value" + ix]);
						«local (flEditorsOnly = defined (args.["flEditorsOnly" + ix]))
						if defined (args.["cohort" + ix]) {
							adratts^.cohort = args.["cohort" + ix];
							flchanges = true};
						local (adrvalue = @adratts^.pagename);
						try { //see if this is a msgnum type item
							local (msgnum = number (newvalue)); //will fail if non-numeric
							local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum));
							msgnum = adrmsg^.msgnum; //will fail if message doesn't exist
							adrvalue = @adratts^.msgnum;
							if not defined (adrvalue^) { //changing type
								if defined (adratts^.pagename) {
									delete (@adratts^.pagename)};
								if defined (adratts^.shortcut) {
									delete (@adratts^.shortcut)};
								adrvalue^ = ""}}
						else { //see if this is a shortcut type item
							if defined (pta^.glossary^.[newvalue]) {
								adrvalue = @adratts^.shortcut;
								if not defined (adrvalue^) { //changing type
									if defined (adratts^.pagename) {
										delete (@adratts^.pagename)};
									if defined (adratts^.msgnum) {
										delete (@adratts^.msgnum)};
									adrvalue^ = ""}}
							else { //it's a pagename type item
								if not defined (adrvalue^) { //changing to pagename type?
									if defined (adratts^.shortcut) {
										delete (@adratts^.shortcut)};
									if defined (adratts^.msgnum) {
										delete (@adratts^.msgnum)};
									adrvalue^ = ""}}};
						«if flEditorsOnly
							«if not defined (adratts^.editorsOnly)
								«adratts^.editorsOnly = "true"
								«flchanges = true
						«else
							«if defined (adratts^.editorsOnly)
								«delete (@adratts^.editorsOnly)
								«flchanges = true
						if adrvalue^ != newvalue {
							adrvalue^ = encode (newvalue);
							flchanges = true}}}};
			bundle { //delete items?
				local (i, adr, name, ix);
				for i = sizeof (args) downto 1 {
					adr = @args [i];
					name = nameof (adr^);
					if name beginswith "delete" {
						local (adrnavigator = @adrstructure^ [1]);
						local (adritem = @adrnavigator^ [number (string.delete (name, 1, 6))]);
						delete (adritem);
						flchanges = true}}};
			bundle { //new item?
				if (args.newname != "") and (args.newurl != "") { //a new item was specified
					«local (flEditorsOnly = defined (args.newFlEditorsOnly))
					local (adrnavigator = @adrstructure^ [1]);
					local (adrnewitem = xml.addTable (adrnavigator, "item"));
					local (adratts = @adrnewitem^.["/atts"]);
					new (tabletype, adratts);
					adratts^.name = encode (args.newname);
					«if flEditorsOnly
						«adratts^.editorsOnly = "true"
					if defined (args.["newcohort"]) {
						adratts^.cohort = args.["newcohort"]};
					local (adrvalue = @adratts^.pagename);
					try { //see if this is a msgnum type item
						local (msgnum = number (args.newurl)); //will fail if non-numeric
						local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum));
						msgnum = adrmsg^.msgnum; //will fail if message doesn't exist
						adrvalue = @adratts^.msgnum}
					else { //see if this is a shortcut type item
						if defined (pta^.glossary^.[args.newurl]) {
							adrvalue = @adratts^.shortcut}};
					adrvalue^ = encode (args.newurl);
					adrnewitem^.["/pcdata"] = "";
					flchanges = true}}};
		if flchanges {
			msgforuser = string.replace (manilaSuite.getString ("blogrollEditor.updatedMessage"), "[[time]]", mainResponder.localization.dateTimeString (manilaSuite.convertTime (clock.now ())))};
		local (xtext);
		try {
			xtext = xml.decompile (@adrstructure^[1])}
		else {
			xtext = "<navigator/>"};
		xtext = string.trimWhiteSpace (string.delete (xtext, 1, string.patternMatch ("\r", xtext)) );
		op.newOutlineObject (xtext, @adrnavigator^.outline)};
	
	add ("<p>" + manilaSuite.getString ("blogrollEditor.explanatoryText") + "</p>");
	
	add ("<form method=\"POST\">"); indentlevel++;
	add ("<table cellspacing=\"5\">"); indentlevel++;
	bundle { //add column headers
		add ("<tr><td><center><b>" + manilaSuite.getString ("blogrollEditor.orderHeader") + "</b></center></td><td><b>" + manilaSuite.getString ("blogrollEditor.nameHeader") + "</b></td><td><b>" + manilaSuite.getString ("blogrollEditor.urlHeader") + "</b></td><td><center><b>" + manilaSuite.getString ("blogrollEditor.visibleTo") + "</b></center></td><td><center><b>" + manilaSuite.getString ("blogrollEditor.deleteHeader") + "</b></center></td></tr>")};
	bundle { //add the items
		local (adritem, adritems, ct = 1, arrows);
		adritems = @adrstructure^ [1];
		if typeOf (adritems^) == stringType { //empty
			new (tableType, adritems)};
		if sizeOf (adritems^) > 0 {
			for adritem in adritems {
				local (uparrow = "<input type=\"image\" name=\"uparrow" + ct + "\" src=\"" + uparrowurl + "\">");
				local (downarrow = "<input type=\"image\" name=\"downarrow" + ct + "\" src=\"" + downarrowurl + "\">");
				local (deleteCheck = "<input type=\"checkbox\" name=\"delete" + ct + "\">");
				local (currentCohort = "Everyone");
				if defined (adritem^.["/atts"].cohort) {
					currentCohort = adritem^.["/atts"].cohort};
				«local (privateChecked = "")
				«if defined (adritem^.["/atts"].editorsOnly)
					«if adritem^.["/atts"].editorsOnly
						«privateChecked = " checked"
				«local (privateCheck = "<input type=\"checkbox\" name=\"flEditorsOnly" + ct + "\"" + privateChecked + ">")
				bundle { //set arrows
					if ct == 1 {
						if sizeOf (adritems^) == 1 {
							arrows = ""}
						else {
							arrows = downarrow}}
					else {
						if ct == sizeof (adritems^) {
							arrows = uparrow}
						else {
							arrows = uparrow + "<br>" + downarrow}}};
				local (value);
				if defined (adritem^.["/atts"].pagename) {
					value = adritem^.["/atts"].pagename};
				if defined (adritem^.["/atts"].msgnum) {
					value = adritem^.["/atts"].msgnum};
				if defined (adritem^.["/atts"].shortcut) {
					value = adritem^.["/atts"].shortcut};
				local (name = adritem^.["/atts"].name);
				bundle { //massage name
					name = string.replaceAll (name, "&nbsp;", "\\ ")};
				add ("<tr><td><center>" + arrows + "</center></td><td>" + input ("name" + ct, name) + "</td><td>" + input ("value" + ct, value) + "</td><td><center>" + cohortDropdown ("cohort" + ct, currentCohort) + "</center></td><td><center>" + deleteCheck + "</center></td></tr>");
				ct++}}};
	bundle { //add link fields
		add ("<tr><td>&nbsp;</td></tr>");
		add ("<tr><td><b>" + manilaSuite.getString ("blogrollEditor.addLinkPrompt") + "</b></td><td>" + input ("newname", "") + "</td><td>" + input ("newurl", "") + "</td><td align=\"center\">" + cohortDropdown ("newcohort", "Everyone") + "</td></tr>")};
	bundle { //update button
		add ("<tr><td colspan=\"3\">&nbsp;</td><td><center><input type=\"submit\" name=\"update\" value=\"" + manilaSuite.getString ("blogrollEditor.updateButton") + "\"></center></td></tr>")};
	add ("</table>"); indentlevel--;
	add ("</form>"); indentlevel--;
	
	if msgforuser != "" {
		add ("<p><font color=\"green\"><i>" + msgforuser + "</i></font></p>")};
	
	return (manilasuite.untaint (htmltext))};
«bundle //test code
	«html.setpagetableaddress (@scratchpad.params)
	«editNavLinks ()