on bodyTag (pta=nil) {
	//This is a stripped-down body tag macro for Manila. It's faster, and it doesn't do background images -- and it doesn't have the background images bug that Manila previously had.
		//Friday, December 17, 1999 at 10:04:00 PM by PBS
		//Changes:
			//12/21/99; 7:10:58 PM by PBS
				//If the specified color is "", then use an appropriate default color.
			//05/26/00; 12:48:49 AM by PBS
				//Support margin attributes in the body tag was added.
			//9/18/01; 4:13:34 PM by PBS
				//Support for margins.
	
	local (htmlText, oneAtt);
	local (attsList = {"bgcolor", "alink", "vlink", "link", "text", "topmargin", "leftmargin", "marginheight", "marginwidth", "background"});
	//local (attsList = {"bgcolor", "alink", "vlink", "link", "text", "background"})
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	on add (s) {
		htmlText = htmlText + s};
	
	//Add bgcolor, link, alink, vlink, and text attributes.
	for oneAtt in attslist {
		if defined (pta^.[oneAtt]) {
			local (s = pta^.[oneAtt]);
			if string.trimWhiteSpace (s) == "" {
				case string.lower (oneAtt) {
					"bgcolor" {
						s = "white"};
					"alink" {
						s = "red"};
					"vlink" {
						s = "purple"};
					"link" {
						s = "blue"};
					"text" {
						s = "black"}}
				else {
					continue}};
			if defined (system.verbs.colors.[s]) {
				s = "#" + system.verbs.colors.[s]};
			add (" " + oneAtt+ "=\"" + s + "\"")}};
	
	return ("<body" + htmlText + ">")}