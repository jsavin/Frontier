		//Created. 
		//The scripts in config.manila.callbacks.getEmailNotificationAdText get a chance to set "adtext" which we return. This text is appended to email notifications that a message has been created or modified.

local (params);
new (tabletype, @params);
params.adtext = "";
try {mainResponder.callbackLoop (@config.manila.callbacks.getEmailNotificationAdText, @params)};
return (params.adtext)