on deleteGemCallback (adrContextTable) {
	«manilaSuite.callbacks.deleteGemCallback : 04/06/14, 21:13:37 by DAB
		«This callback runner allows the server manager to place a set of callback scripts 
		«at config.manila.callbacks.deleteGem to handle deleting and undeleting of Gems
	
	local (adrUserCallbacks = @config.manila.callbacks.deleteGem);
	
	if defined (adrUserCallbacks^) { //loop through the callbacks
		local (adrScript);
		for adrScript in adrUserCallbacks {
			try { //scriptErrors can't stop callbacks
				while typeOf (adrScript^) == addressType {
					adrScript = adrScript^};
				if typeOf (adrScript^) == scriptType {
					callScript (adrScript, {}, adrContextTable)}}}};
	
	return (true)} //return the table 