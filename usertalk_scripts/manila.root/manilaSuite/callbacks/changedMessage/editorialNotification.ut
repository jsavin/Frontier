local (flNew = false);

bundle { //special case for home page -- it may be the first edit after being flipped
	if adrMsg^.msgNum == adrSite^.["#newsSite"].discussLinks.homePageMsgNum {
		if not defined (adrMsg^.flNewPostNotificationSent) {
			adrMsg^.flNewPostNotificationSent = false};
		if not (adrMsg^.flNewPostNotificationSent) {
			adrMsg^.flNewPostNotificationSent = true;
			flNew = true}}}; //state that it's a new home page, because it's the first edit after a flip

manilaSuite.emailNotification.notifyEditors (adrMsg, adrSite, url, adrMember, flNew, language);
return (true)