on editAdvancedItem (itemName, pta=nil) {
	//Send a message to Pike: please open a window to edit this template, JavaScript, or other site management item from the Advanced page.
		//01/13/00; 4:37:42 PM by PBS
		//Changes:
			//02/06/00; 9:14:41 PM by PBS
				//Send the window info table to Pike as part of the itemInfoTable.
	
	local (pikeIp, pikePort, pikeRpcPath);
	bundle { //get information about the machine running Pike
		local (pikeInfoTable);
		pikeInfoTable = manilaSuite.pike.getPikeInfo (pta);
		pikeIp = pikeInfoTable.ipAddress;
		pikePort = pikeInfoTable.port;
		pikeRpcPath = pikeInfoTable.rpcPath};
	
	local (procedureName = "pike.editAdvancedItem");
	
	local (siteInfoTable);
	siteInfoTable = manilaSuite.pike.buildSiteInfo (pta);
	
	local (itemInfoTable);
	bundle { //get info about the current item
		//The table contains two elements:
			//body -- the contents of the item.
			//type -- the name of the item type.
				//Template
				//Navigation
				//Cascading Style Sheet
				//JavaScript
				//Site Structure
				//Custom Prefs
				//News Day Template
				//Join Now Members Box
				//Sign Out Members Box
		new (tableType, @itemInfoTable);
		itemInfoTable.body = manilaSuite.pike.getAdvancedItemAsString (itemName);
		itemInfoTable.type = itemName;
		
		bundle { //PBS 02/06/00: get the window info table for this item
			new (tableType, @itemInfoTable.windowInfo);
			local (adrSite = pta^.adrSiteRootTable);
			manilaSuite.rpcUtils.getWindowInfoTable (itemName, adrSite, @itemInfoTable.windowInfo)}};
	
	local (params = {siteInfoTable, itemInfoTable});
	
	local (result);
	result = betty.rpc.client (pikeIp, pikePort, procedureName, @params, fldebug:false);
	
	return (result)}