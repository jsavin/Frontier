on memberHasPike (pta=nil) {
	//Return true if the member is a Pike user, false otherwise. In the member record, there's a Pike subtable. It contains a boolean, flEnabled. If true, the user has Pike. Otherwise not.
		//01/13/00; 6:53:49 PM by PBS
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	if not defined (pta^.adrMemberInfo^.pike.flEnabled) {
		return (false)};
	
	return (pta^.adrMemberInfo^.pike.flEnabled)}