				adrsite^.admin.deleteMessages = manilaData.newSiteTemplate.admin.deleteMessages}}};
	
	if flHtml { //delete pta^.adrMemberInfo if using the print-friendly template // 10/05/05; 6:33:46 PM by PR disabled, interferes with access control
		if pta^.flPrintFriendlyTemplate or pta^.flContentOnlyTemplate { //JES 12/30/04: add flContentOnlyTemplate
			if defined (pta^.adrMemberInfo) {
				delete (@pta^.adrMemberInfo)}}};
	
	return (true)}