		bundle { //PBS 09/10/01: site shell upgrade -- /stats/ default page
			if not defined (adrSite^.stats.default) {
				if defined (adrSite^.stats) {
					adrSite^.stats.default = manilaData.newSiteTemplate.stats.default}}};
		bundle { //PBS 12/14/01: site shell upgrade -- custom prefs wizard callbacks
			if not defined (adrNewsSite^.prefsWizard.callbacks) {
				if defined (adrNewsSite^.prefsWizard) {
					adrNewsSite^.prefsWizard.callbacks = manilaData.prefs.wizard.callbacksGlue}}};
		
		pta^.newsSite^.siteShellVersion = 8.0}; //now it is an 8.0 site, don't run the checks again
	
