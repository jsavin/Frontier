		bundle { //PBS 11/22/00: site shell upgrade -- directories
			if not defined (adrNewsSite^.directory) {
				adrNewsSite^.directory = manilaData.newSiteTemplate.["#newsSite"].directory};
			if not defined (adrSite^.directory) {
				adrSite^.directory = manilaData.newSiteTemplate.directory}};
		bundle { //PBS 11/25/00: site shell upgrade -- fix default directory template
			if defined (adrNewsSite^.directory.template) {
