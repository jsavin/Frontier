					adrNewsSite^.directory.template = manilaData.newSiteTemplate.["#newsSite"].directory.template;
					manilaSuite.directory.setTemplateModified (adrNewsSite)}}};
		bundle { //PBS 12/19/00: site shell upgrade -- slides
			if not defined (adrSite^.slides) {
				adrSite^.slides = manilaData.newSiteTemplate.slides};
			if not defined (adrNewsSite^.slides) {
				adrNewsSite^.slides = manilaData.newSiteTemplate.["#newsSite"].slides}};
