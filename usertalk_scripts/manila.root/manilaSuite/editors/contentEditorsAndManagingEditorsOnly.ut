on contentEditorsAndManagingEditorsOnly () {
	«Call this script from a #security script when you want to ensure that only content editors and managing editors have access.
		«12/3/01; 5:26:30 PM by PBS
	
	local (adrNewsSite = responderAttributes.newsSite);
	local (meList = adrNewsSite^.sysopMail);
	if defined (adrNewsSite^.contentEditors) {
		meList = meList + adrNewsSite^.contentEditors};
	if typeOf (meList) != listType {
		meList = {meList}};
	
	return (manilaSuite.editors.prefsSecurity (meList))}