on contentEditorTest (pta=nil) {
	«Return true if this is a content editor, false otherwise.
		«11/26/01; 9:36:54 AM by PBS
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	if defined (pta^.flContentEditor) {
		return (pta^.flContentEditor)};
	
	if not defined (pta^.adrMemberInfo) {
		pta^.flContentEditor = false;
		pta^.flEditor = false; //PBS 03/14/01: minor optimization
		return (false)};
	
	local (email = string.lower (nameOf (pta^.adrMemberInfo^)));
	
	local (i);
	local (meList = manilaSuite.editors.getContentEditorList (pta));
	for i = 1 to sizeOf (meList) {
		if string.lower (meList [i]) == email {
			pta^.flContentEditor = true;
			pta^.flEditor = true; //PBS 03/14/01: minor optimization
			return (true)}};
	
	pta^.flContentEditor = false;
	
	return (false)}