on contributingEditorTest (pta=nil) {
	//Return true if this is a contributing editor, false otherwise.
		//5/21/03; 3:35:28 PM by JES
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	if defined (pta^.flContributingEditor) {
		return (pta^.flContributingEditor)};
	
	if not defined (pta^.adrMemberInfo) {
		pta^.flContributingEditor = false;
		pta^.flEditor = false;
		return (false)};
	
	local (email = string.lower (nameOf (pta^.adrMemberInfo^)));
	
	local (i);
	local (ceList = manilaSuite.editors.getContributingEditorList (pta));
	for i = 1 to sizeOf (ceList) {
		if string.lower (ceList [i]) == email {
			pta^.flContributingEditor = true;
			pta^.flEditor = true; //PBS 03/14/01: minor optimization
			return (true)}};
	
	pta^.flContributingEditor = false;
	
	return (false)}