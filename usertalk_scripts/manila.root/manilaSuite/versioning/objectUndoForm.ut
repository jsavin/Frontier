on objectUndoForm (pta, adrObject, actionURL) {
	«manilaSuite.versioning.objectUndoForm : 04/05/19, 14:29:40 by DAB
		«create a form to display available versions of an advanced entity
	«messages at manilaData.localization.languages.english.strings.versioning
	local (adrSite = manilasuite.getSiteAddress(pta));
	if not manilaSuite.getNewsSitePref("versioning.flRestoreWanted", adrSite, false, true) {
		return ""};
	
	local (adrNewsSite = manilaSuite.getNewsSiteAddress(adrSite)); //04/05/18, 21:10:08 by DAB
	local (objectId = manilaSuite.custody.getObjectIdentifier (adrObject, false));
	
	local (htmltext = "");
	on add(s) {
		htmltext = htmltext + s;};
	
	if pta^.method == "POST" { //05/02/12, 12:21:36 by DAB 
		if defined(pta^.postargs.objectID) and pta^.postargs.objectID == objectID {
			add(manilaSuite.versioning.objectUndo(pta, adrObject))}}; //typiclaly null string
	
	local (maxFilesOpened, maxVersions);
	manilaSuite.versioning.getConfiguration(@maxFilesOpened, @maxVersions);
	local (filesOpened=0, versionsFound=0);
	
	on openRoot(f) {
		if file.exists (f) {
			if window.isOpen (f) {
				return true};
			try {
				fileMenu.open (f, true);
				filesOpened++;
				return true}};
		return false};
	
	local (adrLinkTbl = @adrNewsSite^.versioning.[objectID]);
	if defined(adrLinkTbl^) {
		loop {
			if filesOpened == maxFilesOpened {
				break};
			if versionsFound == maxVersions {
				break};
			
			local (f = adrLinkTbl^.logFile);
			if not openRoot(f) {
				break};
			with (@[f])^ {
				adrLinkTbl = address(adrLinkTbl^.logEntry)};
			if not defined(adrLinkTbl^) {
				break};
			if not defined(adrLinkTbl^.timestamp) {
				break};
			
			if versionsFound == 0 { //start form here
				add("\r<form method = 'post' name = 'rollback' action = '" + actionURL + "'>");
				add ("<input type='hidden' name='objectid' value='" + objectID + "'>"); //05/02/12, 12:18:44 by DAB
				if defined (pta^.requestHeaders.referer) {
					add ("<input type='hidden' name='referer' value='" + pta^.requestHeaders.referer + "'>")};
				local(bgcolor, textcolor);
				manilaSuite.html.getSeparatorColors(@bgcolor, @textColor);
				add("\r\t<table align='center' style='background-color:" + bgColor + ";color:" + textColor +"'>");
				
				add("\r\t\t\<tr>");
				add("\r\t\t\t<td align='right'>");
				add(manilaSuite.getString("versioning.ETPRollbacktoLabel", pta:pta));
				add(":</td>");
				add("\r\t\t<td>");
				add("\r\t\t\t<select name = 'rollbackTo'>");
				add("\r\t\t\t\t<option value = '' selected>" + manilaSuite.getString("versioning.ETPRollbackMenuDefault", pta:pta)  + "</option>")};
			
			add("\r\t\t\t\t<option value = '" + string(adrLinkTbl^.timeStamp) + "'>" + string(adrLinkTbl^.timeStamp + "</option>"));
			
			versionsFound++}};
	
	if versionsFound  > 0 {
		add("\r</select>");
		add("</td>");
		
		add("\r\t\t<td>");
		local (checked = ""); // provision for making the defautl value dependent later maybe
		add("<input type = 'checkbox' name ='rollBackDiscard'" + checked  + ">&nbsp;");
		add("</td>");
		add("\r\t\t<td>");
		add(manilaSuite.getString("versioning.ETPRollbackCheckboxLabel", pta:pta));
		add("</td>");
		
		add("\r\t\t<td>");
		add("<input type = 'submit' name='versioning' value = '" +  manilaSuite.getString("versioning.ETPRollbackSubmitButton", pta:pta) + "'>");
		add("</td>");
		
		add("\r\t</tr>");
		
		add("\r\t</table>");
		add("\r</form>");
		add("\r<br>")};
	
	return htmltext}