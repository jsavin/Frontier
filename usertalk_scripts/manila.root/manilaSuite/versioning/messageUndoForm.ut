	local (currentMsgSubject = adrMsg^.subject);
	
	on openRoot(f) {
		if file.exists (f) {
			if window.isOpen (f) {
				return true};
			try {
				fileMenu.open (f, true);
				filesOpened++;
				return true}};
		return false};
	
	local (adrLinkTbl);
	loop {
		if filesOpened == maxFilesOpened {
			break};
		if versionsFound == maxVersions {
			break};
		
		adrLinkTbl = @adrMsg^.versioning;
		if not defined(adrLinkTbl^) {
			break};
		
		local (f = adrLinkTbl^.logFile);
		if not openRoot(f) {
			break};
		adrMsg = @[f];
		with adrMsg^ {
			adrMsg = address(adrLinkTbl^.logEntry)};
		if not defined(adrMsg^) {
			break};
		
		if versionsFound == 0 { //start form here
			add("<form method = 'post' name = 'rollback' action = '" + action + "'>");
			add("\r<input type = 'hidden' name = 'msgnum' value = '" + currentMsgnum + "'>");
			if defined (pta^.requestHeaders.referer) {
				add ("\r<input type='hidden' name='referer' value='" + pta^.requestHeaders.referer + "'>")};
			local (headerColor, headerTextColor, backgroundColor, backgroundTextColor);
			manilaSuite.html.getAdminBoxColors (@headerColor, @headerTextColor, @backgroundColor, @backgroundTextColor);
			
			add("\r\t<table style='background-color:" + backgroundColor + ";color:" + backgroundTextColor +"'>");
			
			add("\r\t\t\<tr>");
			add("\r\t\t\t<td align='right'>");
			add(manilaSuite.getString("versioning.ETPRollbacktoLabel", pta:pta));
			add(":</td>");
			add("\r\t\t<td>");
			add("\r\t\t\t<select name = 'rollbackTo'>");
			add("\r\t\t\t\t<option value = '' selected>" + manilaSuite.getString("versioning.ETPRollbackMenuDefault", pta:pta)  + "</option>")};
		
		add("\r\t\t\t\t<option value = '" + string(adrLinkTbl^.timeStamp) + "'>" + string(adrLinkTbl^.timeStamp));
