on rollback () {
	«manilaSuite.versioning.rollback : 04/05/18, 21:27:59 by DAB
		«perform the actual rollback operation for messages; provoked by a post on the rollback form
		«in an ETP form
		«manilaFixer.versioning.rollback : 02/04/14, 15:31:11 by DAB
	local (pta = html.getPageTableAddress());
	local (adrSite = manilaSuite.getmanilaSiteAddress(pta));
	local (adrMember = pta^.adrMemberInfo);
	local (maxFilesOpened, maxVersions); //04/05/18, 21:50:36 by DAB
	manilaSuite.versioning.getConfiguration(@maxFilesOpened, @maxVersions); //04/05/18, 21:50:07 by DAB
	
	local (replTbl);
	bundle { //replacement table
		new(tabletype, @replTbl);
		replTbl.sitename = manilaSuite.getCanonicalSitename(adrSite);
		replTbl.maxFilesOpened =  maxFilesOpened;
		replTbl.maxVersions =  maxVersions};
	
	local (htmltext = "");
	on add(s) {
		htmltext = htmltext + s;};
	on errorReport(s) {
		add("<p align = 'center'>");
		add("<span style = 'color:red'>" + manilaSuite.getString("versioning." + s, @replTbl, pta:pta)  + "</span>");
		add("</p>")};
	
	pta^.title = manilaSuite.getString("Versioning.pageTitleRollback", @replTbl, pta:pta);
	
	manilaSuite.referer.checkEdit ();
	
	if pta^.method != "POST" { //shoudl not be here except from posts
		scriptError("redirect " + pta^.requestHeaders.referer)};
	
	local (msgNum = pta^.postArgs.msgNum);
	local (adrMsg = manilaSuite.discuss.getCurrentMessageTable(msgNum, pta));
	local (flDiscardCurrent = defined(pta^.postArgs.rollBackDiscard) and pta^.postArgs.rollBackDiscard=="on");
	replTbl.msgNum =  msgNum;
	
	if pta^.postargs.rollbackto == "" {
		errorReport("errNoVersionSpecified");
		return htmlText};
	
	if not (manilaSuite.custody.memberCanCheckOutObject (adrMsg, adrMember, adrSite, true)) {
		return (manilaSuite.getString ("discuss.cantPostStoryCustodyError"))};
	
	local (adrPriorMsg = adrMsg);
	local (flFound);
	bundle { //locate desired version
		replTbl.version =   date(pta^.postargs.rollbackto);
		
		local (filesOpened=0, versionsFound=0);
		
		on openRoot(f) {
			if file.exists (f) {
				if window.isOpen (f) {
					return true};
				try {
					fileMenu.open (f, true);
					filesOpened++;
					return true}};
			return false};
		
		local (adrLinkTbl);
		loop {
			if filesOpened == maxFilesOpened {
				errorReport("errmaxFilesOpened");
				break};
			
			if versionsFound == maxVersionss {
				errorReport("errmaxVersions");
				break};
			
			adrLinkTbl = @adrPriorMsg^.versioning;
			if not defined(adrLinkTbl^) {
				errorReport("errNoLink");
				break};
			
			local (f = adrLinkTbl^.logFile);
			if not openRoot(f) {
				errorReport("errMissingLog");
				break};
			
			adrPriorMsg = @[f];
			with adrPriorMsg^ {
				adrPriorMsg = address(adrLinkTbl^.logEntry)};
			if not defined(adrPriorMsg^) {
				errorReport("errMissingEntry");
				break};
			
			if adrLinkTbl^.timestamp == date(pta^.postargs.rollbackto) {
				flFound = true;
				break};
			
			versionsFound++};
		};
	
	if flFound {
		table.assign(adrMsg, adrPriorMsg^);
		if flDiscardCurrent {
			manilaSuite.custody.undoCheckOut (adrMsg, adrMember, adrSite, flMessage:true)}
		else {
			manilaSuite.custody.checkIn (adrMsg, adrMember, adrSite, true)};
		local (redirectUrl = pta^.responderAttributes.urls^.discussMsgReader + msgNum);
		if defined (pta^.postArgs.referer) {
			redirectUrl = pta^.postArgs.referer};
		mainResponder.redirect (redirectUrl)};
	
	return  htmlText};
«bundle
	«local (tbl = temp.pta.["123"].firstFilter)
	«html.setPageTableAddress(@tbl)
	«rollback()