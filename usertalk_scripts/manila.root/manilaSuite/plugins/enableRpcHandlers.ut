on enableRpcHandlers () {
	//Enable plugins RPC handlers.
		//02/24/00; 2:56:32 PM by PBS
	
	if not defined (config.manila.plugins) {
		new (tableType, @config.manila.plugins)};
	if not defined (config.manila.plugins.rpcHandlers) {
		new (tableType, @config.manila.plugins.rpcHandlers)};
	
	user.betty.rpcHandlers.manilaPlugins = @config.manila.plugins.rpcHandlers;
	
	return (true)}