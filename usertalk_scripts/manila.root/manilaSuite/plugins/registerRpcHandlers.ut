on registerRpcHandlers (pluginName, adrRpcHandlers) {
	//Register the RPC handlers for a plugin.
		//02/23/00; 3:52:24 PM by PBS
	
	local (adrConfigTable = @config.manila.plugins.rpcHandlers);
	if not defined (adrConfigTable^) {
		new (tableType, adrConfigTable)};
	
	if not defined (adrConfigTable^.[pluginName]) {
		adrConfigTable^.[pluginName] = adrRpcHandlers};
	
	return (true)}