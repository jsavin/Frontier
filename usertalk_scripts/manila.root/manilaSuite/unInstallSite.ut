on unInstallSite (adrSite) {
	//Changes:
		//2/15/07; 1:25:37 PM by LL
			//Try to remove the site from the aggregator subscriptions list.
		//6/28/06; 3:27:45 PM by LL
			//Fix to check if the default domain is defined when removing sub-site from config.mainresponder.domains table.
		//7/12/05; 1:16:03 PM by JES
			//Fix a typo.
		//5/28/05; 5:52:12 PM by JES
			//Remove sites from config.mainResponder.domains when uninstalled, if appropriate.
		//01/31/00; 5:32:56 PM by PBS
			//Don't remove tables from discuss.root and members.root -- because if it's a table then it's a shared discussion group or membership group.
			//Delete the gdb from user.databases only if it contains just one table. Otherwise, it probably contains other Manila sites, and should not be deleted from user.databases.
		//10/22/99; 1:37:10 AM by PBS
			//Remove a site from this server.
				//Remove addresses from discuss.root and members.root.
	
	//Discussion group.
	local (adrDg = @adrSite^.["#discussionGroup"]);
	if defined (adrDg^) {
		local (dgName = adrSite^.["#prefs"].discussionRoot);
		local (adrDiscussFile = @[system.temp.mainResponder.discussRootFile]);
		if defined (adrDiscussFile^.[dgName]) {
			if typeOf (adrDiscussFile^.[dgName]) != tableType { //PBS 01/31/00: don't delete tables, because if it's a table it's a shared discussion group.
				delete (@adrDiscussFile^.[dgName])}}};
	
	//Membership group.
	local (adrMembers = @adrSite^.["#membershipGroup"]);
	if defined (adrMembers^) {
		local (groupName = adrSite^.["#prefs"].defaultMembershipGroup);
		local (adrMembersFile = @[system.temp.mainResponder.membersRootFile]);
		if defined (adrMembersFile^.[groupName]) {
			if typeOf (adrMembersFile^.[groupName]) != tableType { //PBS 01/31/00: don't delete tables, because it it's a table it's a shared membership group.
				delete (@adrMembersFile^.[groupName])}}};
	
	//config.manila.sites.
	if defined (config.manila.sites) {
		local (i);
		for i = sizeOf (config.manila.sites) downTo 1 {
			local (adrItem = @config.manila.sites [i]);
			try {
				if adrItem^ == adrSite {
					delete (adrItem)}}}};
	
	//user.databases.
	local (f);
	f = window.getFile (table.getRootAddress (adrSite));
	//PBS 01/31/00: Delete from user.databases only if this gdb contains just one site. Otherwise, there may be other sites in this gdb, and the entry in user.databases should not be deleted.
	if sizeOf ([f]) < 2 {
		local (lowerF = string.lower (f));
		local (i);
		for i = sizeOf (user.databases) downTo 1 {
			local (adrItem = @user.databases [i]);
			if defined (adrItem^.f) {
				if string.lower (adrItem^.f) == lowerF {
					delete (adrItem)}}}};
	
	//config.mainResponder.domains
	bundle {
		local (siteurl = manilaSuite.getSiteUrl (adrSite));
		local (urlparts = string.urlSplit (siteurl));
		if sizeOf (urlparts[3]) == 0 { //it's a top-level site
			if defined (config.mainResponder.domains.[urlparts[2]]) {
				if typeOf (config.mainResponder.domains.[urlparts[2]]) == addressType {
					if config.mainResponder.domains.[urlparts[2]] == adrSite {
						delete (@config.mainResponder.domains.[urlparts[2]])}}}}
		else { //sub-site
			if not defined (config.mainResponder.domains.[urlparts[2]]) { //use default domain
				urlparts[2] = "default"};
			if mainResponder.siteTree.domainIsSiteTree (@config.mainResponder.domains.[urlparts[2]]) {
				try {
					mainResponder.siteTree.removeSiteFromTree (urlparts[2], "/" + urlparts[3])}}}};
	
	//aggregator.services
	bundle {
		local (siteurl = adrsite^.["#ftpSite"].url);
		if not (siteurl endswith "/") {
			siteurl = siteurl + "/"};
		local (rssurl = siteurl + "xml/rss.xml");
		if defined (aggregatorData.services.[rssurl]) {
			delete (@aggregatorData.services.[rssurl])}};
	
	try { //JES 6/9/02: Clear the site list cache
		delete (@system.temp.mainResponder.siteListCache)};
	
	return (true)}