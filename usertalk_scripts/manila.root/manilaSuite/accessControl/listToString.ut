on listToString (theList) {
	//manilaSuite.accessControl.listToString : 04/05/28, 18:13:56 by DAB
		//after John vanDyke and Jake Savins algorithm for metadata, optimised by DAB
		//Bayly.listToString : 02/08/09, 16:24:35 by DAB
	local (s = string (theList));
	return  string.replaceAll (string.replaceAll (string.replaceAll ( string.mid (s, 2, sizeOf (s) - 2), "\\\"", char (17)), "\"", ""), char (17), "\"")};
