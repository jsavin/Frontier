on testOne (adrTbl, adrMember) {
	//Changes
		//09/15/06; 2:59:06 PM by LL
			//Bug fix: Ensure only cohort scripts are evaluated in the table and delete any editor values set in the page table.
		//10/09/05, 13:56:13 by DAB
			//Created. Return true if adrMember satisfies conditions of any cohort setup in adrTbl.
	if sizeOf (adrTbl^) == 0 { //default to Eveyone
		return (true)};
	
	if defined (adrTbl^.pageTable.flContentEditor) {
		delete (@adrTbl^.pageTable.flContentEditor)};
	if defined (adrTbl^.pageTable.flManagingEditor) {
		delete (@adrTbl^.pageTable.flManagingEditor)};
	if defined (adrTbl^.pageTable.flEditor) {
		delete (@adrTbl^.pageTable.flEditor)};
	if defined (adrTbl^.pageTable.flContributingEditor) {
		delete (@adrTbl^.pageTable.flContributingEditor)};
	//condition "pagetble" member link 
	adrTbl^.pageTable.adrMemberInfo = adrMember;
	local (adrScript);
	for adrScript in adrTbl {
		if nameOf(adrScript^) == "pageTable" {
			continue};
		if adrScript^^ (@adrTbl^.pageTable) {
			return (true)}};
	return (false)}