					not defined (adrMemberInView^.bulletins.[sitename].inHtml);
					not adrMemberInView^.bulletins.[sitename].enabled {
						MemberBulletinsType = "none"};
					adrMemberInView^.bulletins.[sitename].inHtml {
						MemberBulletinsType = "html"}}
				else {
					MemberBulletinsType = "plaintext"}};
			
			on addMenuOption (name, value) {
				local (s);
				s = "\r\t\t\t<option value=\"" + value + "\"";
				case true {
					adrMemberInView and (value ==MemberBulletinsType);
					value == newMemberBulletinsType {
						s = s + " selected"}};
				s = s + ">" + name + "</option>";
				add (s);
				return true};
			
			addMenuOption (manilaSuite.getString ("admin.noBulletins"), "none");
			addMenuOption (manilaSuite.getString ("admin.plaintextBulletins"), "plaintext");
			addMenuOption (manilaSuite.getString ("admin.htmlBulletins"), "html");
			
			add ("</select>");
			add ("</td>");
			add ("\r\t</tr>")};
		
		bundle { //row to send welcome message or not
			add ("\r\t<tr>");
			add ("\r\t<td >");
			add (manilaSuite.getString ("accesscontrol.memberWelcomePrompt", @replTbl, pta:pta));
			add ("</td>");
			add ("\r\t<td align=\"left\">");
			local (checked = " checked");
			if newMemberWelcomeEmailChecked {
				checked = ""};
			add ("<input type=\"radio\" name=\"sendWelcomeEmail\" value=\"false\"" + checked + ">");
			add (manilaSuite.getString ("common.No", pta: pta));
			checked = "";
			if newMemberWelcomeEmailChecked {
				checked = " checked"};
			add ("<input type=\"radio\" name=\"sendWelcomeEmail\" value=\"true\"" + checked + ">");
			add (manilaSuite.getString ("common.yes", pta: pta));
			add ("</td>");
			add ("\r\t</tr>")};
		
		bundle { //row for blocked/unblocked
			add ("\r\t<tr>");
			add ("\r\t<td >");
			add (manilaSuite.getString ("admin.blockMemberButton", @replTbl, pta:pta));
			add ("</td>");
			add ("\r\t<td align=\"left\">");
			local (checked = " checked");
			local (flBlocked = adrMemberInView and defined (adrMemberInView^.blocked) and adrMemberInView^.blocked);
			if flBlocked {
				checked = ""};
			add ("<input type=\"radio\" name=\"blockmember\" value=\"false\"" + checked + ">");
			add (manilaSuite.getString ("common.No", pta: pta));
			checked = "";
			if flBlocked {
				checked = " checked"};
			add ("<input type=\"radio\" name=\"blockmember\" value=\"true\"" + checked + ">");
			add (manilaSuite.getString ("common.yes", pta: pta));
			add ("</td>");
			add ("\r\t</tr>")};
		
		if adrMemberInView { //static rows of information
			if defined (adrMemberInView^.lastVisit) {
				add ("\r\t<tr>");
				add ("\r\t<td >");
				add (manilaSuite.getString ("admin.lastVisitPrompt"));
				add ("</td>");
				add ("\r\t<td align=\"left\">");
				add (mainResponder.localization.dateTimeString (adrMemberInView^.lastVisit, pta));
				add ("</td>");
				add ("\r\t</tr>")};
			if defined (adrMemberInView^.hitCount) {
				add ("\r\t<tr>");
				add ("\r\t<td >");
				add (manilaSuite.getString ("admin.hitCountPrompt"));
				add ("</td>");
				add ("\r\t<td align=\"left\">");
				add (string.addCommas (adrMemberInView^.hitCount));
				add ("</td>");
				add ("\r\t</tr>")}};
		
		bundle { //row for button
			add ("\r\t<tr>");
			add ("\r\t<td align=\"right\" colspan=\"2\">");
			if adrMemberInView {
				add ("<input type=\"submit\" name =\"editMember\" value=\"" + manilaSuite.getString ("accessControl.buttonEditMember") + "\">")}
			else {
				add ("<input type=\"submit\" name =\"addMemberToGroup\" value=\"" + manilaSuite.getString ("accessControl.buttonAddMember") + "\">")};
			add ("</td>");
			add ("\r\t</tr>")};
		
		add ("\r</table>");
		add ("\r</form>")};
	
	bundle { //operate on existing member
		add (manilaSuite.getString ("accessControl.memberDrillDown", @replTbl, pta:pta));
		
		add ("\r<form method=\"post\" action=\"" + adminurl + "#membership\" name=\"setuser\">");
		add ("\r<table align=\"center\">");
		
		bundle { //row for selection of members
			add ("\r\t<tr>");
			add ("\r\t<td align=\"left\" rowspan=\"4\">");
			add (manilaSuite.accessControl.memberMenu (pta, "setuser", "memberkeys", selectedMembers, 10, 100));
			add ("</td>");
			
			add ("\r\t<td align=\"center\" >");
			add ("<input type=\"submit\" name =\"viewmembers\" value=\"" + manilaSuite.getString ("accessControl.buttonViewMember") + "\">");
			add ("</td>");
			
			add ("\r\t</tr>")};
		
		bundle { //row (s) for buttons
			add ("\r\t<tr>");
			add ("\r\t<td align=\"center\">");
			add ("<input type=\"submit\" name =\"blockmembers\" value=\"" + manilaSuite.getString ("accessControl.buttonblockMember") + "\">");
			add ("</td>");
			add ("\r\t</tr>");
			
			add ("\r\t<tr>");
			add ("\r\t<td align=\"center\">");
			add ("<input type=\"submit\" name =\"unblockmembers\" value=\"" + manilaSuite.getString ("accessControl.buttonunblockMember") + "\">");
			add ("</td>");
			add ("\r\t</tr>");
			
			add ("\r\t<tr>");
			add ("\r\t<td align=\"center\">");
			add ("<input type=\"submit\" name =\"deletemembers\" value=\"" + manilaSuite.getString ("accessControl.buttonDeleteMember") + "\">");
			add ("</td>");
			add ("\r\t</tr>")};
		
		add ("\r</table>");
		add ("\r</form>")};
	
	return htmltext};
«bundle //test code
	«local (tbl = temp.pta.["414"].firstFilter)
	«html.setPageTableAddress (@tbl)
	«wp.newTextObject (maintainCohorts (), @temp.maintainCohorts)
	«edit (@temp.maintainCohorts)