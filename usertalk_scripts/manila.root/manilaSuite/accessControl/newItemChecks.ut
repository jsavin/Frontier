on newItemChecks (pta,  adrMsg) {
	«Changes
		«11/8/05; 5:22:28 AM by JES
			«Bug fix: pass adrMsg^.accessControl.permittedCohorts to checkMemberCohorts, instead of adrMsg^.accessControl.
		«05/20/04, 17:59:54 by DAB
			«Created. Return true or false depending on whether the pagetable grants access to a newsItem message
				«was manilaFixer.accessControl.newItemChecks : 02/08/24, 11:10:03 by DAB
	local (adrSite = manilaSuite.getManilaSiteAddress(pta));
	if defined (pta^.adrMemberInfo) and mainResponder.discuss.memberCanEdit(adrMsg, pta^.adrMemberInfo, pta) {
		return true}; // you can always see your editable messages
	
	if not defined(adrMsg^.accessControl) {
		return true}; //unrestricted
	
	on dateChecks() { //release/expiry date checks
		if not defined(adrMsg^.accessControl.releaseDate) {
			adrMsg^.accessControl.releaseDate = nil};
		if not defined(adrMsg^.accessControl.expiryDate) {
			adrMsg^.accessControl.expiryDate = nil}; //02/05/09, 18:42:05 by DAB
		
		local (now = clock.now());
		case true {
			(adrMsg^.accessControl.releaseDate==nil) and (adrMsg^.accessControl.expiryDate == nil) {
				return true}; //unrestricted
			(adrMsg^.accessControl.expiryDate==nil) {
				return (now > adrMsg^.accessControl.releaseDate)};
			(adrMsg^.accessControl.releaseDate==nil) {
				return (adrMsg^.accessControl.expiryDate > now)}}
		else {
			return (now > adrMsg^.accessControl.releaseDate) and (now < adrMsg^.accessControl.expiryDate)}};
	
	if not dateChecks() {
		return false};
	
	«if not manilaSuite.accessControl.checkMemberCohorts(pta, @adrMsg^.accessControl)
		«return false
	case true { //04/06/04, 14:45:55 by DAB
		not defined(adrMsg^.accessControl.permittedCohorts);
		adrMsg^.accessControl.permittedCohorts == {} { //{} == everyone has access
			return true};
		not manilaSuite.accessControl.checkMemberCohorts(pta, adrMsg^.accessControl.permittedCohorts) { //05/02/13, 11:35:32 by DAB
			return false}};
	
	return true};
«bundle
	«local (tbl = temp.pta.["374"].firstFilter)
	«html.setPageTableAddress(@tbl)
	«checks()