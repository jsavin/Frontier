							try {table.rename(@pta^.adrMemberInfo, "manilaFixer_roAdrMemberInfo")}}
						else {
							goAway("accessControl/inaccessible", false)}} «hide message number
					else {
						goAway("accessControl/inaccessible", false)}}} «hide message number    
			else {
				 if getPathAttribute("romlac", @cohorts) {
					«if RO restrictions exists and we don't satisfy fail
					if manilaSuite.accessControl.checkMemberCohorts(pta, cohorts) {
						try {table.rename(@pta^.adrMemberInfo, "manilaFixer_roAdrMemberInfo")}}
					else {
						goAway("accessControl/inaccessible", false)}} «hide message number
				else { //check message cohort values only 
					checkMessageValues()}}}
		else { //check message cohort values only 
			checkMessageValues()}};
	
	if defined(adrOriginalMsg^.accessControl.expiryDate) and typeof(adrOriginalMsg^.accessControl.expiryDate) == dateType { //02/10/31, 08:45:21 by DAB
		if not manilaSuite.staticRendering.isStaticRendering(pta) { //02/10/31, 08:46:49 by DAB
			pta^.responseHeaders.Expires = adrOriginalMsg^.accessControl.expiryDate
				«pta^.responseHeaders.Expires = adrMsgStorage^.accessControl.expiryDate}};
	
	if defined(adrNewsSite^.accessControl.flTrackAccess) and adrNewsSite^.accessControl.flTrackAccess { //02/08/24, 15:27:01 by DAB
		«we track access to actual message not topic head message 
		if defined(pta^.adrMemberInfo) { //may not be, especially if read-only
			local (memberKey = nameof(pta^.adrMemberInfo^));
			if not defined(adrMsg^.accessControl) { //02/09/28, 15:08:50 by DAB
				new(tabletype, @adrMsg^.accessControl)};
