						try {table.rename(@pta^.adrMemberInfo, "manilaFixer_roAdrMemberInfo")}}}
				else {
					goAway("accessControl/inaccessible")}}} //02/03/06, 21:31:41 by DAB
		else {
			goAway("accessControl/inaccessible")}}; //02/03/06, 21:31:41 by DAB
	
	«bundle    //check site structure cohorts, they override if they exist 02/09/19, 00:30:52 by DAB
		«on restricted(pathAttname)
			«local (s = manilaSuite.sitePrefs.siteStructure.getPathAttValue(pathAttname,  flInherit:true))
			«if s  == ""      //no path attribute means no restriction
				«return false    //05/06/03, 14:02:01 by DAB
					«return true    //02/10/02, 18:34:02 by DAB
			«local (pattAttCohorts = {})    //02/08/25, 21:18:52 by DAB
			«pattAttCohorts = pattAttCohorts +  ("{\"" +string.replaceAll(s, ",", "\",\"") + "\"}")
			«if pattAttCohorts == {}
				«return false    //05/06/03, 14:02:06 by DAB
					«return true    //02/10/02, 18:34:10 by DAB
			«temp.[pathAttname] = pattAttCohorts
			«return  not manilaSuite.accessControl.checkMemberCohorts(pta, pattAttCohorts)
		«
		«case true    
			«not defined(adrNewsSite^.accesscontrol.siteStructureCohorts) 
			«not adrNewsSite^.accesscontrol.siteStructureCohorts   
				«checkMessageValues()
			«not restricted("mlac")
				«
			«flDoReadOnlyChecks and  not restricted("romlac")     //try for read only status, if permitted
			«flDoReadOnlyChecks and not restricted("romlac")     //try for read only status, if permitted
				«try {table.rename(@pta^.adrMemberInfo, "manilaFixer_roAdrMemberInfo")}
		«else    //check message cohorts 02/09/19, 12:35:31 by DAB
			«checkMessageValues()
	
	bundle { //check site structure cohorts, they override if they exist 05/06/03, 14:43:44 by DAB/PR
		on getPathAttribute(pathAttname, adrPattAttCohorts) {
			local (s = manilaSuite.sitePrefs.siteStructure.getPathAttValue(pathAttname,  flInherit:true));
			if s  == "" { //no path attribute returns false
				return false}; //05/06/03, 14:02:01 by DAB
			adrPattAttCohorts^ = {};
			adrPattAttCohorts^ = adrPattAttCohorts^ +  ("{\"" +string.replaceAll(s, ",", "\",\"") + "\"}");
			«if adrPattAttCohorts^ == {}    //no path attribute returns false commented 05/06/04, 14:50:02 by DAB
				«return false   
			return  true};
		
		if  defined(adrNewsSite^.accesscontrol.siteStructureCohorts)  and adrNewsSite^.accesscontrol.siteStructureCohorts { //testing paths 
			local (cohorts);
			if  getPathAttribute("mlac", @cohorts) {
				«authorised goes on to test date stuff; unauthorised can try read only access
				if  manilaSuite.accessControl.checkMemberCohorts(pta, cohorts) {
					}
				else {
					«read write access failed; try for read only, or fail
					if  getPathAttribute("romlac", @cohorts) {
