				};
			flDoReadOnlyChecks { //try for read only status, if permitted
				case true {
					not defined(adrOriginalMsg^.accessControl.permittedROCohorts);
					adrOriginalMsg^.accessControl.permittedROCohorts == {} { //{} == nobody has read access
						goAway("accessControl/inaccessible")}; //02/03/06, 21:31:41 by DAB
