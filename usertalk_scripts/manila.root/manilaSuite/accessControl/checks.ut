	local (adrMsg );
	local (msgNum); //moved up scope 02/07/21, 15:23:51 by DAB
	bundle { //compute message table address or return
		case true {
			defined (pta^.msgNum) {
				msgNum = pta^.msgNum};
			defined(pta^.pathArgs) and pta^.pathArgs != "" { //not defined for static renders 02/08/13, 11:29:04 by DAB
				msgNum = number (pta^.pathArgs)};
			pta^.adrObject == @adrSite^.default { //04/05/20, 12:11:03 by DAB
				msgnum = manilaSuite.getDiscussLinksAddress (adrSite)^.homePageMsgnum}}
		else {
			if manilaSuite.sitePrefs.siteStructure.pathToSiteStructureValue("msgnum") {
				msgnum = pta^.msgNum}};
		
		if msgNum == 0 {
			return true}; //no message, grant access
		
		adrMsg = manilaSuite.discuss.getCurrentMessageTable (msgnum, pta:pta)};
	
	if defined (pta^.adrMemberInfo) and mainResponder.discuss.memberCanEdit(adrMsg, pta^.adrMemberInfo, pta) {
		return true}; // you can always see your editable messages
	
	adrOriginalMsg = manilaSuite.accessControl.goToOriginal(pta, adrmsg); //adrOriginalMsg is top of thread 02/05/06, 17:13:34 by DAB
	
	«if not defined(adrOriginalMsg^.accessControl)
		«return true    //unrestricted
	
	pta^.manilaFixer_accessControlledMessage = true; //02/05/14, 17:52:06 by DAB
	
	on goAway(url, flOkToappendMsgnum=true) { «flOkToappendMsgnum added 05/06/04, 15:36:10 by DAB
		if pta^.adrObject == @adrSite^.picture {
			scriptError ("!redirect " + pta^.ftpSite^.url + "accessControl/AccessDeniedGIF$" + msgnum)}
		else {
			url = pta^.ftpSite^.url  + url; //02/03/06, 21:32:01 by DAB
			if flOkToappendMsgnum { «made conditional 05/06/04, 15:35:58 by DAB
				url = url + "$" + msgnum}; //02/07/21, 15:25:07 by DAB
			pta^.code = 302; //non-permanent redirect 
			pta^.responseBody = webserver.util.buildErrorPage ("302 FOUND", "Found the page.");
			pta^.responseHeaders.location = url;
			pta^.responseHeaders.URI = url;
			try {delete (@pta^.responseHeaders.["Content-Type"])};
			scripterror("!")}};
	
	on dateChecks() { //release/expiry date checks
		if not defined(adrOriginalMsg^.accessControl.releaseDate) {
			adrOriginalMsg^.accessControl.releaseDate = nil};
		if not defined(adrOriginalMsg^.accessControl.expiryDate) {
			adrOriginalMsg^.accessControl.expiryDate = nil}; //02/05/09, 18:42:05 by DAB
		
		local (now = clock.now());
		case true {
			(adrOriginalMsg^.accessControl.releaseDate==nil) and (adrOriginalMsg^.accessControl.expiryDate == nil) {
				return true}; //unrestricted
			(adrOriginalMsg^.accessControl.expiryDate==nil) {
				return (now > adrOriginalMsg^.accessControl.releaseDate)};
			(adrOriginalMsg^.accessControl.releaseDate==nil) {
				return (adrOriginalMsg^.accessControl.expiryDate > now)}}
		else {
			return (now > adrOriginalMsg^.accessControl.releaseDate) and (now < adrOriginalMsg^.accessControl.expiryDate)}};
	
	if defined(adrOriginalMsg^.accessControl) { «made conditional 05/06/04, 14:05:09 by DAB
		if not dateChecks() {
			goAway("accessControl/nonCurrent")}}; //02/03/06, 21:31:45 by DAB
	
	local (flDoReadOnlyChecks = true); //02/09/28, 14:17:26 by DAB
	
	on checkMessageValues() {
		case true {
