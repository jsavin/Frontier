on getCohortNames (adrSite) {
	//manilaSuite.AccessControl.getCohortNames : 04/05/20, 17:01:30 by DAB
		//returns  a list of short adresses of cohort entries
		//was manilaFixer.accessControl.getCohortNames  : 02/10/23, 21:12:43 by DAB
	local (adrGroup = manilaSuite.members.getGroupFromSiteAddress(adrSite));
	local (adrCohorts = @adrGroup^.cohorts);
	if not defined(adrCohorts) {
		return false};
	local (userCohorts = {});
	local (adr);
	for adr in adrCohorts {
		if defined(adr^.systemdefinition) and adr^.systemdefinition {
			continue};
		userCohorts[0] = string.popfileFromAddress(adr)};
	return userCohorts};
manilaFixer.accessControl.getCohortNames(@myfirstSiteManilawebsite)
