on getCommentData (siteName, blogId) {
	//Changes
		//10/6/02; 8:35:52 PM by JES
			//Created. Returns an array of structs for all the comments in a site. Each struct has the following members:
			//msgnum -- the message number for the top message in the comment thread
			//postid -- the postId of the post in the Radio weblog for which the comments are a response
			//count -- the number of messages in thee comment thread
	local (adrsite = manilaSuite.rpcUtils.getSiteAddress (siteName));
	local (adrdata = manilaSuite.radioHosting.init (adrsite));
	if (not config.manila.prefs.flRadioHostingEnabled) or (not adrdata^.flEnabled) { //error
		scriptError ("Can't get the counts for \"" + blogId + "\" because Radio Hosting is not enabled for this Manila site.")};
	
	on countMessages (msgnum) {
		local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum, adrsite));
		local (ct = 1);
		local (responsenum);
		for responsenum in adrmsg^.responses {
			ct = ct + countMessages (responsenum)};
		return (ct)};
	
	local (adrcomments = @adrdata^.comments);
	local (adrusers = @adrcomments^.users);
	local (adruser = @adrusers^.[blogId]);
	if not defined (adruser^) {
		return ({})};
	
	local (commentData = {});
	for adr in adruser {
		if typeOf (adr^) != tableType { //update data storage to new format
			local (n = adr^);
			new (tableType, adr);
			adr^.link = "";
			adr^.msgnum = n};
		local (postid = nameOf (adr^));
		local (msgnum = adr^.msgnum);
		local (ct = countMessages (msgnum));
		local (t); new (tableType, @t);
		t.msgnum = msgnum;
		t.postid = postid;
		t.count = ct;
		commentData = commentData + {t}};
	
	return (commentData)}