on restoreDefault (username, password, siteName) {
	«Restore the Cascading Style Sheet to the default.
		«Changes:
			«06/06/00; 4:33:20 PM by PBS
				«Call the themes restore script.
			«06/22/00; 3:11:54 PM by JES
				«Fixed error saving root.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't restore the cascading style sheet to the default because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (siteInfo);
	bundle { //restore the cascading style sheet to the default
		new (tableType, @siteInfo);
		siteInfo.adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName);
		«manilaSuite.newSite.createStyleSheet (@siteInfo)
		manilaSuite.themes.restoreStyleSheet (@siteInfo)};
	
	fileMenu.saveMyRoot (siteInfo.adrSite); //save the root, a change was made
	
	local (cssText);
	bundle { //get the text of the cascading style sheet
		local (adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
		local (adrObject = @adrNewsSite^.cascadingStyleSheet);
		cssText = string (adrObject^)};
	
	return (cssText)}