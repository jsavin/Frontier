on getTable (siteName, role, username, password) {
	«Get info about editors in a given role. You must be an editor to access this information.
		«11/15/00; 8:42:08 PM by JES
			«Cribbed from manilaSuite.rpcHandlers.editors.get. This version is SOAP compatible.
		«3/19/01; 3:18:27 PM by JES
			«When called via SOAP, return an array of structs, specifying the Manila namespace, namespace URI, and struct type.
		«05/23/01; 1:15:21 AM by JES
			«Specify customStructType instead of customArrayType, which follows from a change in soap.rpc.server, based on SOAP interop work.
	
	bundle { //make sure this person is an editor of the site.
		local (beginningErrorString = "Can't get the editors list because ");
		manilaSuite.rpcUtils.editorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrSite = manilaSuite.rpcUtils.getSiteAddress (sitename));
	local (editorsList);
	local (lowerRole = string.lower (role));
	case lowerRole {
		"managingeditor";
		"managingeditors" {
			editorsList = adrSite^.["#newsSite"].sysopMail};
		"contributingeditor";
		"contributingeditors" {
			editorsList = adrSite^.["#newsSite"].contributingEditors}}
	else { //invalid role name
		scriptError ("Can't get the editors list because \"" + role + "\" is not a valid role name.")};
	
	if typeOf (editorsList) != listType {
		editorsList = {editorsList}};
	
	local (groupName = manilaSuite.rpcUtils.getMembersGroupName (siteName));
	
	local (flSoap = false);
	if string.upper (responder) == "SOAP" {
		adrRequest^.customStructType = manilaData.soap.constants.customArrayTypes.editor;
		adrRequest^.customNamespace = manilaData.soap.constants.manilaNamespace;
		adrRequest^.customNamespaceURI = manilaData.soap.constants.manilaNamespaceURI;
		flSoap = true};
	local (retVal);
	if flSoap {
		retVal = {}}
	else {
		new (tableType, @retVal)};
	local (oneEditor, ix = 1);
	for oneEditor in editorsList { //add editors to table
		local (editorTable);
		new (tableType, @editorTable);
		local (editorName = oneEditor); //name is email address by default
		local (adrMember = mainResponder.members.getMemberTable (groupName, oneEditor));
		if defined (adrMember^.personalInfo.name) {
			if string.trimWhiteSpace (adrMember^.personalInfo.name) != "" {
				editorName = adrMember^.personalInfo.name}};
		editorTable.name = editorName;
		editorTable.email = oneEditor;
		if flSoap {
			retVal[ix] = editorTable}
		else {
			local (adrEditor = table.uniqueName ("editor", @retVal, 3));
			adrEditor^ = editorTable};
		ix++};
	
	return (retVal)}