on attachEnclosureUrl (username, password, siteName, msgNum, url, length="", type="") {
	//Changes
		//3/20/05; 1:50:08 AM by JES
			//Add an enclosure to a message. If length or type is passed in empty, then we get the headers from the server where the file lives.
	
	local (adrDiscuss = manilaSuite.rpcUtils.getDiscussAddress (siteName));
	local (adrmsg = mainResponder.discuss.getMessageTable (msgNum, adrroot:adrDiscuss));
	
	if length == "" or type == "" { //get headers from the server
		local (urlParts = string.urlsplit (url));
		local (s = tcp.httpClient ("HEAD", server:urlParts [2], path:urlParts [3], timeOutTicks:60*30, flmessages:false, ctFollowRedirects:5, flJustHeaders:true));
		local (headheaders);
		new (tabletype, @headheaders);
		webserver.util.parseHeaders (s, @headheaders);
		length = headheaders.["Content-length"];
		type = headheaders.["Content-Type"]};
	local (adrtable = @adrmsg^.enclosure);
	new (tableType, adrtable);
	adrtable^.url = url;
	adrtable^.length = length;
	adrtable^.type = type;
	return (true)}