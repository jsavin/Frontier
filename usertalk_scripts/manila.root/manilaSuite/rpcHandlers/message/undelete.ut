on undelete (username, password, siteName, msgNum) {
	//Undelete a message.
		//Changes:
			//06/22/00; 11:10:35 PM by JES
				//Bug fix - the call to delete was passing an boolean, adrmsg^.flDeleted, not an address, @adrmsg^.flDeleted, so it failed, but silently since it's in a try block.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't undelete message \"" + msgNum + "\" because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrDiscuss = manilaSuite.rpcUtils.getDiscussAddress (siteName));
	local (adrmsg = mainResponder.discuss.getMessageTable (msgNum, adrRoot:adrDiscuss));
	
	try {delete (@adrmsg^.flDeleted)};
	
	return (true)}