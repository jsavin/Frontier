on countPictures (username, password, siteName) {
	//Get the number of pictures in message storage.
		//Changes:
			//11/26/01; 11:02:42 AM by PBS
				//Support content editors.
	
	bundle { //make sure this person is a managing or content editor of the site.
		local (beginningErrorString = "Can't count pictures because ");
		manilaSuite.rpcUtils.managingEditorOrContentEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (t = manilaSuite.rpcHandlers.message.listPictures (username, password, siteName));
	
	return (sizeOf (t))}