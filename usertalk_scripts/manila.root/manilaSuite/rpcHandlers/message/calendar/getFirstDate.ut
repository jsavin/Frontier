on getFirstDate (username, password, siteName) {
	//Get the first date in the message storage calendar.
	
	bundle { //make sure this user has access to the discussion group
		local (beginningErrorString = "Can't get the first date in the message calendar because ");
		manilaSuite.rpcUtils.dgAccessCheck (siteName, username, password, beginningErrorString)};
	
	local (adrDiscuss = manilaSuite.rpcUtils.getDiscussAddress (siteName));
	
	return (mainResponder.calendar.getFirstDay (@adrDiscuss^.calendar))}