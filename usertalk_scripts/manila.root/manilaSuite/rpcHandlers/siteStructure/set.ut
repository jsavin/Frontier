on set (username, password, siteName, s, windowInfoTable) {
	//Set the site structure XML text to s.
		//Changes:
			//06/05/05; 8:14:06 PM by PR
				//added a check to siteStructure.isValid before storing
			//02/06/00; 9:11:15 PM by PBS
				//Save the window info table.
			//02/22/01; 12:06:02 AM by JES
				//Convert outgoing text from Mac to Latin, if the server is a Mac.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't set the site structure because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	manilaSuite.rpcUtils.cleanObjectForImport (@s);
	
	local (adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName));
	if not defined (adrSite^.["#hierarchy"].outline) {
		local (siteInfo);
		new (tableType, @siteInfo);
		siteInfo.adrSite = adrSite;
		manilaSuite.newSite.createHierarchy (@siteInfo)};
	try {
		local (t);
		if system.environment.isMac {
			s = latinToMac.convert (s)};
		xml.compile (s, @t);
		bundle { // 06/05/05; 5:45:16 PM by PR is the sitestructure valid?
			local (pta); // isValid calls get string which requires a pta... 
			local (adrDG = manilaSuite.discuss.getDiscussionGroupAddress(adrSite));
			local (errors = "");
			new (tableType, @pta);
			//pta.manilaLanguageTableAddress = @manilaData.localization.languages.[adrSite^.["#prefs"].language]
			pta.manilaLanguageTableAddress = @manilaData.localization.languages.english; // 06/05/05; 8:21:17 PM by PR default to english as all other rpc returns are in english
			html.setPageTableAddress (@pta);
			on gatherErrors (e) {
				errors = errors + e + "\r"};
			if !manilaSuite.sitePrefs.siteStructure.isValid (@t, @gatherErrors, adrDG^.prefs.nextMsgNum, adrSite) {
				scriptError (errors)};
			wp.newTextObject (s, @adrSite^.["#hierarchy"].outline)}}
	else {
		scriptError ("Can't update the site structure because " + tryerror)};
	
	bundle { //PBS 20/06/00: save the window info table
		manilaSuite.rpcUtils.setWindowInfoTable (windowInfoTable, "siteStructure", adrSite)};
	
	fileMenu.saveMyRoot (adrSite);
	
	return (true)};
//bundle // test
	//set ("patrick@userland.com", "12345", "homeManilaWebsite", string(scratchpad.testoutline), "windowInfo")