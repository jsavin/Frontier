on get (username, password, siteName) {
	«Get the text of the news day template.
	«Changes:
		«02/21/01; 11:55:10 PM by JES
			«Convert Mac text to Latin if the server is a Mac.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't get the news day template because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
	local (adrObject = @adrNewsSite^.newsDayTemplate);
	if not defined (adrObject^) {
		local (siteInfo);
		new (tableType, @siteInfo);
		siteInfo.adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName);
		manilaSuite.newSite.createNewsDayTemplate (@siteInfo)};
	
	local (t);
	new (tableType, @t);
	t.body = string (string (adrObject^));
	if system.environment.isMac {
		t.body = latinToMac.macToLatin (t.body)};
	bundle { //get window info table
		new (tableType, @t.windowInfo);
		local (adrSite = parentOf (adrNewsSite^));
		local (itemName = "newsDayTemplate");
		manilaSuite.rpcUtils.getWindowInfoTable (itemName, adrSite, @t.windowInfo)};
	
	return (t)}