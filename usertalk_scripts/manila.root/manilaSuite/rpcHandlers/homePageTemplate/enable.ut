on enable (username, password, siteName) {
	//Use the home page template.
		//10/14/00; 2:08:11 PM by PBS
		//Changes:
			//12/10/01; 6:02:18 PM by PBS
				//Toss the home page cache.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't enable the home page template because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName));
	
	bundle { //sanity checks -- make sure it exists and the current home page template is valid
		local (adrObject = @adrSite^.["#homePageTemplate"]);
		if not defined (adrObject^) {
			scriptError ("Can't enable the home page template because it doesn't exist.")};
		local (errorString);
		if not (manilaSuite.admin.isGoodTemplate (string (adrObject^), @errorString)) {
			scriptError (errorString)}};
	
	adrSite^.["#newsSite"].flUseHomePageTemplate = true; //turn it on
	
	manilaSuite.cache.tossHomePage (adrSite:adrSite); //PBS 12/10/01: toss the home page cache
	
	return (true)}