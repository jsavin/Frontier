on getmsgNum (username, password, siteName) {
	«Get the msgNum of the current home page.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't get the msgNum of the home page because ");
		manilaSuite.rpcUtils.managingEditorOrContentEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
	local (msgNum = adrNewsSite^.discussLinks.homePagemsgNum);
	
	return (msgNum)}