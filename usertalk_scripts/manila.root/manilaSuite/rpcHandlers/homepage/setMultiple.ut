on setMultiple (username, password, siteName, dateList, homePageTextList) {
	//01/24/01; 10:00:17 PM by JES
		//Set the text of multiple homePages, given dates and text of the pages.
			//The dateList and homePageTextList correspond to homePage dates and text, in reverse chronological order.
		//Returns a list of homePage message numbers, or errors.
			//If no homePage exists for a given date, there are two possible actions:
				//1) If no messages exist for any day after the given date, a new message will be created for the given date.
					//When a new message is created, the subject of the message is the date for the home page.
				//2) If messages exist for any day after the given date, the returned list element will contain 0, signifying that the homePage for the given date could not be created.
			//If the homePage for a given date is a deleted message, the message will be undeleted.
	//Changes:
		//1/30/04; 5:00:51 PM by JES
			//When creating new home page messages, add them to the home page index.
		//5/14/03; 1:17:51 PM by JES
			//Only add the client IP address to the messages if it's defined.
		//4/8/03; 11:40:30 PM by JES
			//Add the client's IP address to the message table of the new home page.
		//12/10/01; 6:06:33 PM by PBS
			//Toss the home page cache.
		//11/26/01; 11:00:13 AM by PBS
			//Support content editors.
		//05/02/01; 7:24:15 PM by JES
			//Call mainResponder callbacks, so that email notification will be sent for new and changed home pages.
		//01/29/01; 11:49:21 AM by JES
			//Set message text with a call to mainResponder.discuss.setMessageText.
		//01/26/01; 4:59:05 PM by JES
			//Make sure the homepage postTime is between the next and previous messages postTime. Set the homepage's lastUpdate to the date specified by the caller.
	
	bundle { //make sure this person is a managing editor or content editor of the site.
		local (beginningErrorString = "Can't set the home pages because ");
		manilaSuite.rpcUtils.managingEditorOrContentEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName));
	local (adrNewsSite = manilaSuite.getNewsSiteAddress (adrSite));
	local (adrDiscuss = manilaSuite.rpcUtils.getDiscussAddress (siteName));
	local (groupname = manilaSuite.rpcUtils.getMembersGroupName (siteName));
	local (ct = sizeOf (homePageTextList));
	local (returnTable); new (tableType, @returnTable);
	local (homePageMsgNum = adrSite^.["#newsSite"].discussLinks.homePageMsgNum);
	local (adrCurrentHomePageMsg = mainResponder.discuss.getMessageTable (homePageMsgNum, adrRoot:adrDiscuss));
	
	on checkDates (msgNum) {
		adrMsg = manilaSuite.discuss.getMessageTable (msgNum, adrSite);
		if msgNum > 1 {
			local (adrPrevMessage = manilaSuite.discuss.getMessageTable (msgNum - 1, adrSite));
			if adrMsg^.postTime < adrPrevMessage^.postTime {
				adrMsg^.postTime = adrPrevMessage^.postTime}};
		local (lastMsgNum = adrDiscuss^.prefs.nextMsgNum - 1);
		if msgNum < lastMsgNum {
			local (adrNextMessage = manilaSuite.discuss.getMessageTable (msgNum + 1, adrSite));
			if adrMsg^.postTime > adrNextMessage^.postTime {
				adrMsg^.postTime = adrNextMessage^.postTime}}};
	on sureHomePageMessage (d) {
		//Find a homePage message number, creating a new homePage if required, or returning 0 if not
		local (adrDay, msgNum, adrMsg);
		try { //if there's already a homepage for the given day, return its msgNum
			adrDay = mainResponder.calendar.getDayAddress (adrSite, d, false);
			if defined (adrDay^.msgNum) {
				return (adrDay^.msgNum)}};
		bundle { //see if it's possible to create a new homepage for the given day
			local (day, month, year, hour, minute, second, lastDay, lastYear, lastMonth);
			date.get (d, @day, @month, @year, @hour, @minute, @second);
			local (lastDayInCalendar = mainResponder.calendar.getLastDay (adrSite));
			date.get (lastDayInCalendar, @lastDay, @lastMonth, @lastYear, @hour, @minute, @second);
			if (lastYear >= year) and (lastMonth >= month) and (lastDay > day) {
				return (0)}}; //it's not an error since we still want to be able to set newer home pages
		bundle { //create the new homepage
			local (data); new (tableType, @data);
			if defined (client) {
				data.ipAddress = client};
			msgNum = mainResponder.discuss.addMessage (string (d), username, 0, "", false, false, d, adrDiscuss, false, groupname, flEmptyBodyOk: true, adrdata:@data);
			adrMsg = manilaSuite.discuss.getMessageTable (msgNum, adrSite);
			adrDay = mainResponder.calendar.getDayAddress (adrSite, d, true, tableType);
			adrDay^.discussionRoot = adrNewsSite^.discussionRoot;
			adrDay^.msgNum = msgNum;
			bundle { //JES 1/30/04: add to home page category
				local (homepagesCategory = manilaSuite.discuss.getHomepagesCategory (adrSite));
				manilaSuite.discuss.addCategoryToMessage (adrMsg, homepagesCategory, adrSite)}};
		return (msgNum)};
	on setHomePageText (msgNum, s, lastUpdate) {
		//Set the text for a single homePage
		local (adrMsg = manilaSuite.discuss.getMessageTable (msgNum, adrSite));
		local (flDoCallbacks = false, flNewMessage = false);
		if system.environment.isMac { //convert to Mac text
			s = latinToMac.convert (s)};
		bundle { //set the message text, neutering macros and tags
			//mainResponder.neuterText demands a page table, so create one.
			local (pt);
			new (tableType, @pt);
			pt.enableSafeMacros = true;
			if defined (adrSite^.["#newsSite"].legalTags) {
				pt.legalTags = @adrSite^.["#newsSite"].legalTags};
			local (t);
			local (oldPta);
			try {oldPta = html.getPageTableAddress ()};
			html.setPageTableAddress (@pt);
			local (originalMsgText = adrMsg^.body);
			mainResponder.discuss.setMessageText (adrMsg, s, lastUpdateTime:lastUpdate);
			if adrMsg^.body != originalMsgText {
				flDoCallbacks = true;
				if originalMsgText == "" {
					flNewMessage = true}};
			if oldPta == nil {
				html.deletePageTableAddress ()}
			else {
				html.setPageTableAddress (oldPta)}};
		if flDoCallbacks { //call the rpcSaveMessage callbacks at config.mainResponder.callbacks.rpcSaveMessage
			local (adrCallbacks);
			if flNewMessage {
				adrCallbacks = @config.mainResponder.callbacks.rpcNewMessage}
			else {
				adrCallbacks = @config.mainResponder.callbacks.rpcSaveMessage};
			if defined (adrCallbacks^) {
				local (paramTable);
				new (tableType, @paramTable);
				paramTable.dgName = groupname;
				paramTable.username = username;
				paramTable.password = password;
				paramTable.title = adrMsg^.subject;
				paramTable.body = adrMsg^.body;
				paramTable.msgNum = msgNum;
				paramTable.url = manilaSuite.getSiteUrl (adrSite);
				paramTable.adrMsgTable = adrMsg;
				paramTable.lastSave = clock.now ();
				paramTable.siteName = siteName;
				paramTable.adrSite = adrSite;
				if defined (adrSite^.["#prefs"].language) { // 05/19/00 JES: localization support
					paramTable.language = adrSite^.["#prefs"].language}
				else {
					paramTable.language = nil};
				if defined (client) {
					paramTable.client = client};
				try {mainResponder.callbackLoop (adrCallbacks, @paramTable)}}};
		return (true)};
	on addToReturnTable (d, msgNum) {
		local (itemNum = sizeOf (returnTable) + 1);
		adrItem = @returnTable.[string.padWithZeros (itemNum, 5)];
		new (tableType, adrItem);
		adrItem^.date = d;
		adrItem^.msgNum = msgNum;
		adrItem^.flError = (msgNum == 0)};
	
	for i = ct downTo 1 { //loop over each day's new home page text, starting with the oldest
		local (msgNum, d = dateList[i]);
		msgNum = sureHomePageMessage (d);
		if msgNum != 0 { //0 means the homepage didn't exist, and could not be created
			checkDates (msgNum);
			if adrNewsSite^.discussLinks.homePageMsgnum < msgNum {
				adrNewsSite^.discussLinks.homePageMsgnum = msgNum};
			setHomePageText (msgNum, homePageTextList[i], d)};
		addToReturnTable (d, msgNum)};
	
	manilaSuite.cache.tossHomePage (adrSite:adrSite); //PBS 12/10/01: toss the home page cache
	
	return (returnTable)}