on getNextDate (username, password, siteName, dt) {
	//Get the date in the home page calendar following dt.
		//Changes:
			//06/22/00; 9:29:50 PM by JES
				//Bug fix - the call to manilaSuite.rpcUtils.memberCheck didn't pass the beginningErrorString parameter
	
	bundle { //make sure the person is a member of the site
		local (beginningErrorString = "Can't get the next date in the home page calendar because ");
		manilaSuite.rpcUtils.memberCheck (siteName, username, password, beginningErrorString)};
	
	local (adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName));
	
	return (mainResponder.calendar.getNextDay (adrSite, dt))}