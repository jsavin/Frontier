on restoreDefault (username, password, siteName) {
	«Restore the custom prefs XML text to the default.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't restore the custom prefs to the default because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (siteinfo, adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
	new (tableType, @siteInfo);
	siteInfo.adrSite = manilaSuite.rpcUtils.getSiteAddress (siteName);
	manilaSuite.newSite.createCustomPrefsWizard (@siteInfo);
	fileMenu.saveMyRoot (adrNewsSite);
	
	return (string (adrNewsSite^.prefsWizard.outline))}