on set (username, password, siteName, s, windowInfoTable) {
	«Set the text of the news items template.
		«04/30/00; 11:33:42 PM by PBS
		«Changes:
			«09/03/00; 12:43:12 PM by PBS
				«Neuter macros.
			«02/22/01; 12:06:02 AM by JES
				«Convert outgoing text from Mac to Latin, if the server is a Mac.
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't set the news item template because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
	local (adrObject = @adrNewsSite^.newsItems.template);
	
	if system.environment.isMac {
		s = latinToMac.convert (s)};
	s = string.replaceAll (s, cr + lf, cr);
	s = string.replaceAll (s, lf, cr);
	
	bundle { //PBS 09/03/00: neuter macros
		local (macrosTable = manilaSuite.themes.getLegalMacrosForObject ("newsItemsTemplate"));
		s = html.neuterMacros (s, @macrosTable)};
	
	wp.newTextObject (s, adrObject);
	
	bundle { //PBS 20/06/00: save the window info table
		local (adrSite = parentOf (adrNewsSite^));
		manilaSuite.rpcUtils.setWindowInfoTable (windowInfoTable, "newsItemTemplate", adrSite)};
	
	fileMenu.saveMyRoot (adrObject);
	
	return (true)}