on restoreDefault (username, password, siteName) {
	«Restore the sign out members box to the default.
		«01/16/00; 6:22:59 PM by PBS
		«Changes:
			«06/06/00; 4:37:01 PM by PBS
				«Call the themes restore script.
			«06/22/00; 4:13:02 PM by JES
				«Bug fix with undefined signOutBox error in return statement
	
	bundle { //make sure this person is a managing editor of the site.
		local (beginningErrorString = "Can't restore the sign out members box to the default because ");
		manilaSuite.rpcUtils.managingEditorCheck (siteName, username, password, beginningErrorString)};
	
	local (adrNewsSite = manilaSuite.rpcUtils.getNewsSiteAddress (siteName));
	local (adrSite = parentOf (adrNewsSite^));
	local (adrTemplate = @adrNewsSite^.membersBoxTemplates.signOutBox);
	«adrTemplate^ = manilaData.newSiteTemplate.["#newsSite"].membersBoxTemplates.signOutBox
	local (siteInfo);
	new (tableType, @siteInfo);
	siteInfo.adrSite = adrSite;
	manilaSuite.themes.restoreSignOutBox (@siteInfo);
	
	fileMenu.saveMyRoot (adrSite); //save the root, a change was made
	
	«return (string (adrTemplate^))
	return (string (adrNewsSite^.membersBoxTemplates.signOutBox))}