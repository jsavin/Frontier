on respondToPing () {
	«Changes
		«3/21/07; 2:55:01 PM by LL
			«Do not respond to pings for sites that don't have the TrackBack feature enabled.
		«4/20/06; 2:30:41 PM by JES
			«Add missing forbiddenPage handler.
		«4/17/06 at 12:42:56 PM by LL
			«Added support for a TrackBack submit callback.
		«9/11/03; 12:51:53 PM by JES
			«Strip HTML markup from the excerpt, title, weblog name and URL. The trackBack spec doesn't allow markup.
		«5/1/03; 12:13:30 PM by JES
			«Created. Respond to a Trackback ping to a message in a Manila site.
	local (pta = html.getPageTableAddress ());
	«workspace.pt = pta^ //debugging
	
	local (msgnum = pta^.pathArgs);
	local (adrmsg = manilaSuite.discuss.getMessageTable (msgnum));
	
	on forbiddenPage () {
		pta^.template = string (manilaData.notFoundTemplate);
		pta^.title = "403 Forbidden";
		pta^.code = 403;
		pta^.activeUrls = false;
		return ("Request Forbidden.")};
	
	bundle { //call trackbackSubmit callbacks
		try {
			local (adrcallbacks = @config.manila.callbacks.trackbackSubmit);
			if not defined (adrcallbacks^) {
				new (tableType, adrcallbacks)};
			for adr in adrcallbacks {
				local (adrscript = adr);
				try {
					while typeOf (adrscript^) == addressType { //follow addresses
						adrscript = adrscript^};
					if not adrscript^ (pta) {
						return (forbiddenPage ())}}}}};
	
	if defined (config.manila.prefs.flTrackbackEnabled) {
		if not config.manila.prefs.flTrackbackEnabled {
			return (manilaSuite.notFound.page (pta))}};
	if not manilaSuite.getNewsSitePref ("trackback.flEnabled", default:false) {
		return (manilaSuite.notFound.page (pta))};
	
	trackback.initPost (adrmsg);
	
	on respondCallback (url, title, excerpt, weblogName) {
		bundle { //strip markup from the ping elements
			url = searchEngine.stripMarkup (url);
			title = searchEngine.stripMarkup (title);
			excerpt = searchEngine.stripMarkup (excerpt);
			weblogName = searchEngine.stripMarkup (weblogName)};
		
		local (adrurl = @adrmsg^.trackback.inbound.urls.[url]);
		if not defined (adrurl^) {
			new (tableType, adrurl)};
		adrurl^.weblogName = weblogName;
		adrurl^.title = title;
		adrurl^.excerpt = excerpt;
		adrurl^.whenPing = clock.now ();
		if manilaSuite.getNewsSitePref ("trackback.flAcceptPingsAutomatically", default: true) {
			adrurl^.flPosted = true}
		else {
			adrurl^.flPosted = false}};
	
	return (trackback.respondToPing (@respondCallback))};
«bundle //test code
	«html.setPageTableAddress (@workspace.pt)
	«respondToPing ()