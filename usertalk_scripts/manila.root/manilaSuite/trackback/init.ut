on init (adrsite) {
	//Changes
		//7/21/03; 4:16:31 PM by JES
			//Only install the trackback sub-table of the site's newsItems table if the site has a newsItems table.
		//4/24/03; 7:20:18 AM by DW
			//Created.
	if defined (adrsite^.newsItems) {
		if not defined (adrsite^.newsItems.trackback) {
			adrsite^.newsItems.trackback = manilaData.newSiteTemplate.newsItems.trackback}};
	local (adrtrackback = @adrsite^.["#newssite"].trackback);
	if not defined (adrtrackback^) {
		new (tabletype, adrtrackback)};
	if not defined (adrtrackback^.flEnabled) {
		adrtrackback^.flEnabled = false};
	if not defined (adrtrackback^.flPingOnPost) {
		adrtrackback^.flPingOnPost = true};
	if not defined (adrtrackback^.flAcceptPingsAutomatically) {
		adrtrackback^.flAcceptPingsAutomatically = true};
	if not defined (adrtrackback^.trackbackLinkTemplate) {
		adrtrackback^.trackbackLinkTemplate = manilaData.newSiteTemplate.["#newsSite"].trackback.trackbackLinkTemplate};
	if not defined (adrtrackback^.templates) {
		adrtrackback^.templates = manilaData.newSiteTemplate.["#newsSite"].trackback.templates};
	if not defined (adrtrackback^.colors) {
		new (tableType, @adrtrackback^.colors)};
	if not defined (adrtrackback^.colors.bgcolor1) {
		adrtrackback^.colors.bgcolor1 = "white"};
	if not defined (adrtrackback^.colors.bgcolor2) {
		adrtrackback^.colors.bgcolor2 = "#CCCCCC"};
	return (adrtrackback)};
//bundle //test code
	//init (@tbtestManilaWebsite)