on shortcutWasDeleted (adrMsgTable) {
	//Return true if the shortcut was deleted. We know it was deleted if there's a shortcut entry in the image table that does not exist in the #glossary.
		//01/12/00; 3:03:33 PM by PBS
	
	local (shortcut);
	if manilaSuite.pictures.getShortcutFromImageTable (adrMsgTable, @shortcut) {
		local (pta = html.getPageTableAddress ());
		local (adrGlossary = pta^.glossary);
		if not defined (adrGlossary^.[shortcut]) {
			return (true)}}; //the shortcut was deleted
	
	return (false)} //the shortcut wasn't deleted