on hasValidPicture (pta=nil, adrErrorString=nil) {
	«Return true if there's an attached picture and it's type is GIF or JPEG, otherwise return false and fill in the error string.
		«1/3/00;12:01:05 PM by PBS
		«3/13/07; 12:11:08 PM by LL
			«Add support for PNG images.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	on setError (s) {
		if adrErrorString != nil {
			adrErrorString^ = s};
		return (true)};
	
	if not defined (pta^.postArgs.attachFile) {
		setError ("there is no attached picture");
		return (false)}; //there's no picture attached at all
	
	if typeOf (pta^.postArgs.attachFile) != tableType {
		setError ("there is no attached picture");
		return (false)}; //it must be a table
	
	if not defined (pta^.postArgs.attachFile.["Content-type"]) {
		setError ("there is no content type description for this picture");
		return (false)};
	
	local (type = pta^.postArgs.attachFile.["Content-type"]);
	local (lowerType = string.lower (type));
	
	case lowerType {
		"image/gif";
		"image/jpeg";
		"image/pjpeg";
		"image/png";
		"image/x-png" {
			return (true)}};
	
	if lowerType contains "macb" {
		setError ("the file is of type MacBinary, rather than GIF or JPEG. Please see the <a href=\"http://manilanewbies.userland.com/stories/storyReader$17\">HowTo</a> for fixing your browser settings");
		return (false)};
	
	setError ("the file is of type \"" + manilaSuite.unTaint (type) + "\". A picture must be a GIF, a JPEG or a PNG");
	return (false)}