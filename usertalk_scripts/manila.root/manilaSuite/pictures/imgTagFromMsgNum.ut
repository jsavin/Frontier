on imgTagFromMsgNum (msgNum) {
	//Given a message number, generate an image tag for the image that's attached to that dg message.
		//Changes:
			//10/20/99; 11:04:05 AM by PBS
				//Now works with new-style image management: pictures are stored in the discussion group. Old-style image management, where images were written to disk, still works.
	
	local (pta = html.getPageTableAddress ());
	local (adrTable = mainResponder.discuss.getMessageTable (msgNum));
	local (imgTag = "<img alt=\"\" border=\"0\" ");
	local (folderPath, urlPrefix);
	
	if defined (adrTable^.image) { //PBS 10/20/99: new style picture management
		return (mainResponder.discuss.buildImageTag (msgNum))}
	else { //old-style image management: the image is on disk
		bundle { //compute folderPath and urlPrefix
			local (pc = file.getPathChar ());
			local (adrDiscuss = mainResponder.discuss.openRoot ());
			
			on add (s) { //append sub-folders to folderpath
				folderPath = folderPath + s + pc;
				urlPrefix = urlPrefix + s + "/"};
			
			folderPath = adrDiscuss^.prefs.binaryServerFolder;
			urlPrefix = adrDiscuss^.prefs.binaryServerURL;
			
			add (pta^.defaultMembershipGroup);
			add (adrTable^.member);
			add (pta^.discussionRoot);
			add (msgNum)};
		
		if (file.exists (folderPath) and (file.filesInFolder (folderPath, 1) > 0)) {
			local (f);
			fileLoop (f in folderPath, 1) {
				local (fname = file.fileFromPath (f));
				local (imageURL = urlPrefix + fname);
				
				try { // get height & width
					local (hwList);
					
					case file.type (f) {
						'gif ';
						'GIFf' {
							hwList = html.getGifHeightWidth (f);
							imgTag = imgTag + "height=\"" + hwList[1] + "\" width=\"" + hwList[2] + "\" "};
						'jpg ';
						'JPEG' {
							hwList = html.getJpegHeightWidth (f);
							imgTag = imgTag + "height=\"" + hwList[1] + "\" width=\"" + hwList[2] + "\" "}};
					
					imgTag = imgTag + "src=\"" + imageURL + "\">";
					break}}}};
	
	imgTag = manilaSuite.unTaint (imgTag); //no curly brace macros allowed here
	
	return (imgTag)}