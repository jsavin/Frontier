on staticPicturesDisable (adrSite) {
	//manilaSuite.pictures.staticPicturesDisable : 04/05/23, 09:20:38 by DAB
		//undo static picture serving in this site
		//returns coutn of messages changed
	local (cnt=0);
	on disableOne(adrMsg) {
		if manilaSuite.pictures.writeToDiskUndo(adrMSg) {
			manilaSuite.pictures.updateShortcut (adrMsg);
			cnt++};
		thread.sleepfor(0); //yield for a bit
		return true};
	
	manilaSuite.discuss.visitIndex(adrSite, "pictures", @disableOne);
	return cnt}