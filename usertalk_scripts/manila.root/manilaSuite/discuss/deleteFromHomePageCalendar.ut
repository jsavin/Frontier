on deleteFromHomePageCalendar (adrMsgTable, adrSite) {
	«Delete an entry in the home page calendar when deleting a discussion group message. Return true if a day was deleted.
		«12/13/01; 9:29:02 PM by PBS
	«Changes:
		«4/1/03; 2:28:45 PM by JES
			«Only delete the day if there are previous days in the home page calendar. Prevents an error when deleting the message that contains the only remaining home page.
			«When deleting a day table, also delete the month and possibly year, if this is the only day in the month/year.
		«1/3/02; 12:52:37 PM by PBS
			«Use a try because there may not be a day in the calendar for that day.
	
	local (flDeleted = false);
	try { //PBS 01/03/02: in a try now because there may not be a day in the calendar
		local (postDate = adrMsgTable^.postTime);
		local (msgNum = adrMsgTable^.msgNum);
		local (adrDay = mainResponder.calendar.getDayAddress (adrSite, postDate, false));
		if defined (adrDay^.msgNum) {
			if defined (adrDay^.discussionRoot) {
				if adrDay^.msgNum == msgNum {
					delete (@adrDay^.msgNum);
					delete (@adrDay^.discussionRoot);
					flDeleted = true;
					local (adrMonth = parentOf (adrDay^));
					local (adrYear = parentOf (adrMonth^));
					local (flDeleteDay = false, flDeleteMonth = false, flDeleteYear = false);
					if sizeOf (adrDay^) == 0 {
						flDeleteDay = true;
						if sizeOf (adrMonth^) == 1 {
							flDeleteMonth = true;
							if sizeOf (adrYear^) == 1 {
								flDeleteYear = true}}};
					try { //if there's a previous day in the calendar then it's ok to delete this day
						local (prevDay = mainResponder.calendar.getMostRecentDay (adrSite, date.yesterday (postDate)));
						local (adrPrevDay = mainResponder.calendar.getDayAddress (adrSite, prevDay, false));
						if defined (adrPrevDay^.msgNum) { //set the home page message number
							adrSite^.["#newsSite"].discussLinks.homePageMsgnum = adrPrevDay^.msgNum};
						if flDeleteDay {delete (adrDay)};
						if flDeleteMonth {delete (adrMonth)};
						if flDeleteYear {delete (adrYear)}}}}}};
	
	return (flDeleted)}