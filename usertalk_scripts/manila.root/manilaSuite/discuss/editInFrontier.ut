//Changes:
	//04/19/00 at 4:15:50 PM by JES
		//localized
	//05/01/00; 3:57:07 PM by JES
		//Changed getString calls to use a replacement table address instead of a lists

local (pta = html.getPageTableAddress ());
local (msgNum = pta^.postArgs.msgNum);
local (htmlText = "", indentLevel = 0);
local (replacementTable); new (tableType, @replacementTable); // 05/01/00 JES: use replacement table instead of a list
replacementTable.msgNum = msgNum;

on add (s) {
	htmlText = htmlText + string.filledString ("\t", indentLevel) + s + "\r"};

try { //try to send the message to the client via XML-RPC
	mainResponder.discuss.sendMessageToClient (msgNum, pta^.client, 80)}
else { //it didn't work
	pta^.title = manilaSuite.getString ("discuss.itDidntWorkPageTitle"); // 4/19/00 JES: localized
	tryError = manilaSuite.untaint (tryError);
	replacementTable.error = tryError;
	add (manilaSuite.getString ("discuss.couldntSendContentsOfMessagePage", @replacementTable)); // 4/19/00 JES: localized
	//bundle // old code for filling in non-localized bodytext
		//add ("Sorry, the server couldn't send the contents of message " + msgNum + " to your workstation.<p>")
		//add ("Here's the message we received from your workstation (it may be cryptic):")
		//add ("<blockquote><i>" + manilaSuite.unTaint (tryError) + "</i></blockquote>")
		//add ("<b>Here are some things to check</b>:<ul><p>"); indentLevel++
		//add ("<li>You must be running an authorized alpha of Frontier 6.<p>")
		//add ("<li>You must have suites.editorial installed and initialized.<p>")
		//add ("<li>The Frontier application must be running <i>on your workstation.</i><p>")
		//add ("<li>Frontier must be running on port 80. (This will become a preference setting.)<p>")
		//add ("<li>If you're sure everything is set up correctly, and you're coming in thru a proxy server or firewall, please check with your system administrator about a possible server configuration error.<p>")
		//add ("</ul>"); indentLevel--
	return (htmlText)};

pta^.title = manilaSuite.getString ("discuss.yourOutlineIsReadyPageTitle");

add ("<font size=\"+0\">"); indentLevel++;
add (manilaSuite.getString ("discuss.editInFrontierInstructions", @replacementTable)); // 4/19/00 JES: localized
//bundle // old code for filling in non-localized bodytext
	//add ("The server has automatically sent a copy of message " + msgNum + " to your workstation.<ul><p>"); indentLevel++
	//add ("<li>When you bring Frontier to the front, you will see an outline window containing the XML structure for this message.<p>")
	//add ("<li>You can only edit the &lt;body> and &lt;subject> part of the message. Preserve the message structure, don't reorganize the outline.<p>")
	//add ("<li>When you're finished editing the outline, come back to this page and click on the button below.<p>")

bundle { //form with a button in it
	add ("<form method=\"POST\" action=\"" + manilaSuite.getUrl ("discussGetChangesFromWorkstation") + "\">"); indentLevel++;
	add ("<input name=\"msgNum\" type=\"hidden\" value=\"" + msgNum + "\">");
	try {add ("<input type=\"hidden\" name=\"referer\" value=\"" + manilaSuite.unTaint (pta^.requestHeaders.referer) + "\">")};
	add ("&nbsp;<input type=\"submit\" value=\"" + manilaSuite.getString ("discuss.saveChangesOnServerButton") + "\">&nbsp;"); // 4/19/00 JES: localized
	add ("</form>"); indentLevel--};

add ("<li>" + manilaSuite.getString ("discuss.afterYouSaveOutlineWillClose") + "<p>"); // 4/19/00 JES: localized
add ("</ul>"); indentLevel--;
add ("</font>"); indentLevel--;

return (htmlText)