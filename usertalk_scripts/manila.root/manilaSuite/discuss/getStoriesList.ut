on getStoriesList (category=nil, discussRoot=nil, adrSite=nil) {
	//Get a list of msgNums of stories. Loop through all the messages in the discussion group.
	
	local (adrNewsSite = manilaSuite.getNewsSiteAddress (adrSite));
	local (storiesList = {});
	
	if category == nil {
		category = adrNewsSite^.storiesListedIn};
	local (lowerCategory = string.lower (category));
	
	if discussRoot == nil {
		discussRoot = adrNewsSite^.discussionRoot};
	
	local (i);
	
	local (adrRoot = mainResponder.discuss.openRoot ());
	local (adrMessages = @adrRoot^.messages);
	
	for i = 1 to sizeOf (adrMessages^) { //loop through the stories list
		local (adrItem = @adrMessages^ [i]);
		if typeOf (adrItem^) == tableType {
			if defined (adrItem^.alsoListedIn) {
				if not (mainResponder.discuss.isMessageDeleted (adrItem)) {
					local (j);
					for j = 1 to sizeOf (adrItem^.alsoListedIn) {
						if string.lower (adrItem^.alsoListedIn [j]) == lowerCategory {
							storiesList = storiesList + adrItem^.msgNum;
							break}}}}}};
	
	return (storiesList)}