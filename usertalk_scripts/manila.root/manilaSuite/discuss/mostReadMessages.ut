on mostReadMessages () {
	«Display the most-read messages.
		«Changes:
			«4/20/03; 1:07:58 PM by JES
				«Pass the group name to mainResponder.discuss.listTopMessages.
			«04/19/00 at 6:17:40 PM by JES
				«localized
			«02/12/00; 3:39:17 PM by PBS
				«Bug fix: new sites would never get their stats compiled if stats are not being compiled every night. Now they will.
				«Removed the line about rankings being compiled every night -- because it's not necessarily true, since stats may be compiled on demand rather than nightly.
			«01/28/00; 12:49:44 PM by PBS
				«If the stats haven't been compiled today, compile them before displaying. This was added because we found that the nightly dg stats compilation takes a long time on EditThisPage.Com, so we disabled it. For servers with lots of sites, it's more efficient to compile stats as needed, and cache them until the next day.
			«12/6/99; 5:55:25 PM by PBS
				«The error message displayed when no rankings had been compiled was missing the word "because."
	
	local (pta = html.getPageTableAddress ());
	pta^.activeUrls = false;
	local (numMessages = 50);
	local (storyUrl = pta^.urls^.discussMsgReader);
	pta^.title = manilaSuite.getString ("discuss.mostReadMessagesPageTitle"); // 4/19/00 JES: localized
	
	local (adrDiscussRoot = mainResponder.discuss.openRoot ());
	local (adrStats = @adrDiscussRoot^.stats);
	
	bundle { //PBS 01/28/00: compile stats if they haven't been compiled since yesterday
		if defined (adrStats^) {
			local (adrRankings = @adrStats^.rankings);
			if not defined (adrRankings^) {
				new (tableType, adrRankings);
				setTimeCreated (adrRankings, date.yesterday (clock.now ()))};
			local (timeCompiled = timeCreated (adrRankings));
			local (midnight);
			local (day, month, year, hour, minute, second);
			date.get (clock.now (), @day, @month, @year, @hour, @minute, @second);
			midnight = date.set (day, month, year, 0, 0, 0);
			if timeCompiled < midnight { //do the stats need to be re-compiled? 
				new (tabletype, adrrankings);
				local (adrmessages = @adrDiscussRoot^.messages, ctmessages = sizeof (adrmessages^), j, adrmessage);
				for j = 1 to ctmessages {
					adrmessage = @adrmessages^ [j];
					adrrankings^.[nameof (adrmessage^)] = adrmessage^.ctReads};
				local (oldtarget = target.set (adrrankings));
				table.sortBy ("Value");
				try {target.set (oldtarget)}}}};
	
	if not defined (adrStats^) {
		return (manilaSuite.getString ("discuss.noStatsForThisDGError"))}; // 4/19/00 JES: localized
	if not defined (adrStats^.rankings) {
		return (manilaSuite.getString ("discuss.noRankingsForThisDGError"))}; // 4/19/00 JES: localized
	local (ctRankings = sizeOf (adrStats^.rankings));
	if ctRankings < 50 {
		numMessages = ctRankings};
	
	local (htmlText);
	
	htmlText = manilaSuite.unTaint (mainResponder.discuss.listTopMessages (numMessages, storyUrl, pta^.defaultMembershipGroup));
	
	«htmlText = htmlText + "\r<p>"
	«htmlText = htmlText + "<i>Rankings are compiled every night.</i>"
	
	return (htmlText)}