on isStory (adrMsgTable, adrSite=nil) {
	«Is a discussion group message a story?
		«This script can run outside the page rendering context if adrSite is not nil.
		«10/19/99; 3:51:09 PM by PBS
	
	local (category = manilaSuite.discuss.getStoriesCategory (adrSite));
	return (manilaSuite.discuss.isInCategory (adrMsgTable, category))}