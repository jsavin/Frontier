on getCurrentMessageTable (msgNum=nil, pta=nil) {
	//Get the address of the current message table.
		//Check to see if it's already been calculated and cached in the page table.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	if defined (pta^.adrMsgTable) {
		return (pta^.adrMsgTable)};
	
	if msgNum == nil {
		if defined (pta^.msgNum) {
			msgNum = pta^.msgNum}
		else {
			if pta^.pathArgs != "" {
				msgNum = number (pta^.pathArgs)}}};
	
	local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
	
	pta^.adrMsgTable = adrMsgTable;
	
	return (adrMsgTable)}