on undoCheckOut (adrObject, adrMember, adrSite, flForce=false, flMessage=false) {
	«Undo a checkout. Return false if the object has been checked out by another person. If flForce is true, remove the lock no matter what.
		«02/08/00; 10:57:54 PM by PBS
	
	local (adrTable = manilaSuite.custody.getObjectsTableAddress (adrSite, flMessage));
	local (objectIdentifier = manilaSuite.custody.getObjectIdentifier (adrObject, flMessage));
	local (adrItem = @adrTable^.[objectIdentifier]);
	if (defined (adrItem^)) {
		if not flForce {
			if not (manilaSuite.custody.isCheckedOutByUser (adrItem, adrMember, adrSite, flMessage)) {
				if not (manilaSuite.custody.hasLockTimedOut (adrItem, adrSite)) {
					return (false)}}};
		delete (adrItem)};
	
	return (true)}