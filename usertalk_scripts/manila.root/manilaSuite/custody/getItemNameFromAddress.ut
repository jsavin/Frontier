on getItemNameFromAddress (adrObject, adrSite) {
	«Changes:
		«3/13/07; 11:04:44 AM by LL
			«Added login box template.
		«7/6/05; 2:35:27 AM by JES
			«Never throw a scriptError. Return the name of the object instead. Fixes an error loading the Admin page.
		«04/05/15, 16:30:01 by DAB
			«added external style sheet, print-friendly template, colors, navigation appearance, calendar appearance, theme, templates
			«allow plugins to use custory with plugin internal tables
		«9/5/02; 4:35:28 PM by JES
			«Added homePageTemplate to the names returned.
		«11/20/00; 7:34:11 PM by PBS
			«Added directory template.
		«05/01/00; 5:26:47 PM by PBS
			«Support for the news items template.
		«02/12/00; 2:00:17 AM by PBS
			«Given the address of an advanced object, return its name.
	
	local (adrNewsSite = @adrSite^.["#newsSite"]);
	
	if typeof(adrObject) != addressType { //04/05/21, 22:38:38 by DAB
		adrObject = address(adrObject)};
	
	case adrObject {
		@adrSite^.["#template"] {
			return ("Template")};
		@adrSite^.["#templates"] { //04/05/16, 10:38:58 by DAB
			return ("Auxiliary Templates")};
		@adrSite^.["#homePageTemplate"] {
			return ("Home Page Template")};
		@adrSite^.["#navigator"].outline {
			return ("Navigation")};
		@adrNewsSite^.cascadingStyleSheet {
			return ("Cascading Style Sheet")};
		@adrNewsSite^.javascript {
			return ("JavaScript")};
		@adrSite^.["#hierarchy"].outline {
			return ("Site Structure")};
		@adrNewsSite^.prefsWizard.outline {
			return ("Custom Prefs")};
		@adrNewsSite^.newsDayTemplate {
			return ("News Day Template")};
		@adrNewsSite^.membersBoxTemplates.signInBox {
			return ("Join Now Members Box")};
		@adrNewsSite^.membersBoxTemplates.signOutBox {
			return ("Sign Out Members Box")};
		@adrNewsSite^.membersBoxTemplates.logInBox {
			return ("Login Members Box")};
		@adrNewsSite^.newsItems.template {
			return ("News Item Template")};
		@adrNewsSite^.directory.template {
			return ("Directory Template")};
		@adrNewsSite^.externalStyleSheet { //04/05/15, 16:28:56 by DAB
			return ("External Style Sheet")}; //04/05/15, 16:28:56 by DAB
		@adrNewsSite^.colors { //04/05/15, 18:25:02 by DAB
			return ("Colors")};
		@adrNewsSite^.navigation { //04/05/15, 20:18:08 by DAB
			return "Navigation Appearance"};
		@adrNewsSite^.calendarTemplates { //04/05/15, 21:03:44 by DAB
			return "Calendar Appearance"};
		@adrNewsSite^.theme { //04/05/16, 10:34:59 by DAB
			return "Theme"};
		@adrNewsSite^.robots { //04/05/16, 12:44:56 by DAB
			return "Robots.txt"};
		@adrNewsSite^.legalTags { //04/05/17, 13:32:36 by DAB
			return "Legal Tags"}}
	else { //04/05/15, 16:32:16 by DAB
		if defined(adrNewsSite^.alternateTemplates) {
			case adrObject {
				@adrNewsSite^.alternateTemplates.printFriendly {
					return ("Print-Friendly Template")}}};
		if defined(adrSite^.["#plugins"]) {
			if string.popFileFromAddress(adrObject) beginsWith string.popFileFromAddress(@adrSite^.["#plugins"].data) {
				local (remnant = string.delete(string.popFileFromAddress(adrObject), 1, string.length(string.popFileFromAddress(@adrSite^.["#plugins"].data ))));
				«return string.replaceAll(string.popLeading(remnant, "."),  ".", " ")
				return string.replaceAll(string.replaceAll(string.replaceAll(string.popLeading(remnant, "."), "[\"", ""), "\"]", ""),  ".", " ")}}};
	
	return (nameOf (adrObject^))
		«scriptError ("Can't get the item name for " + adrObject + " because the address does not point to an advanced item.")}