on link (url, linkTitle="") {
	«Generate an img tag that displays a help icon.
		«11/30/00; 11:36:49 AM by PBS
	
	local (adrIcon = @mainResponder.resources.userlandIcons.help);
	local (hwList = html.getGifHeightWidth (adrIcon));
	local (alt = linkTitle); //alt text is required for HTML 4 validation
	
	local (helpGifUrl = "/mainResponderResources/userlandIcons/help");
	
	local (imgTag = "<img src=\"" + helpGifUrl + "\" height=\"" + hwList [1] + "\" width=\"" + hwList [2] + "\" border=\"0\" alt=\"" + alt + "\">");
	local (link = "<a href=\"" + url + "\" linkTitle=\"" + linkTitle + "\">" + imgTag + "</a>");
	
	return (manilaSuite.unTaint (link))}