on inSiteInclusionCallback (pathPart, adrAdrElement, adrAdrXstruct, adrCrumbList) {
	//Changes
		//6/5/02; 3:01:32 PM by JES
			//Created. Dive into an in-site inclusion. Returns true if the directory sub-element can be found, or false if not.
				//Sets adrAdrElement^ to the address of the XML element for the included directory.
				//Sets adrAdrXstruct^ to the address of the compiled XML of the outline.
				//Adds the message subject to the crumb list at adrCrumbList.
	local (othermsgnum, nomad);
	local (fladdtocrumblist = false);
	bundle { //set othermsgnum
		local (pathPart = string.delete (pathPart, 1, 1));
		if pathPart endswith "~" {
			pathPart = string.delete (pathPart, sizeof (pathPart), 1);
			fladdtocrumblist = true};
		othermsgnum = number (pathPart)};
	local (pta = html.getPageTableAddress ());
	local (adrdiscussiongroup = manilaSuite.discuss.getDiscussionGroupAddress ());
	local (adrdirectories = @adrdiscussiongroup^.directories);
	local (adrmsg = mainresponder.discuss.getmessagetable (othermsgnum, adrroot:adrdiscussiongroup));
	local (adrdirectoryinfo = html.directory.initDirectoryTable (nameOf (adrmsg^), adrdirectories));
	manilasuite.directory.initMessageTable (adrmsg, adrdirectoryinfo);
	nomad = xml.getaddress (@adrdirectoryinfo^.xmlstruct, "opml");
	adrAdrXstruct^ = @adrdirectoryinfo^.xmlstruct;
	adrAdrElement^ = xml.getaddress (nomad, "body");
	if fladdtocrumblist {
		adrcrumblist^ = adrcrumblist^ + {adrmsg^.subject}};
	return  (true)}