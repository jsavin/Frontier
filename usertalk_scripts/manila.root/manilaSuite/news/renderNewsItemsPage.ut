on renderNewsItemsPage (adrTable=nil, pta=nil) {
	«Changes:
		«9/28/05; 1:37:19 PM by JES
			«Comment out reference to userlandWidgets.
		«11/25/00; 6:30:32 PM by PBS
			«Call manilaSuite.html.stripHomePageTitle instead of manilaSuite.html.stripTitleFromTemplate. The latter has been deprecated. (A code factoring issue.)
		«10/26/00; 10:24:53 PM by PBS
			«Set default last update time, so it's not prior to the creation of the site itself.
		«05/02/00; 2:38:57 PM by PBS
			«Support for the news items home page title preference.
		«04/24/00; 3:12:40 PM by PBS
			«Created. Render a news items page.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	bundle { //PBS 10/26/00: set default last update -- normally will be over-ridden later
		local (adrSite = manilaSuite.getManilaSiteAddress (pta));
		pta^.lastUpdate = timeModified (adrSite)};
	
	local (flSysopPlacesCalendar = string.lower (pta^.template) contains "{calendar}");
	
	local (htmlText = "", indentLevel = 0);
	on add (s) {
		htmlText = htmlText + string.filledString ('\t', indentLevel) + s + "\r"};
	
	pta^.title = manilaSuite.getString ("news.homePageTitle", pta: pta); //the title comes from the dg message table
	if defined (pta^.newsSite^.newsItemsHomePageTitle) { //PBS 05/02/00: support news items home page title preference
		pta^.title = manilaSuite.unTaint (pta^.newsSite^.newsItemsHomePageTitle)};
	bundle { //add expires meta tag; possibly strip the home page title
		manilaSuite.html.addExpiresMetaTag (); //add a meta tag that prevents caching
		«manilaSuite.html.stripTitleFromTemplate (pta) //the editor may not want a title to appear on the home page
		manilaSuite.html.stripHomePageTitle (pta)}; //PBS 11/25/00: this script replaces manilaSuite.html.stripTitleFromTemplate
	bundle { //display the current news items -- and calendar if turned on
		if not flSysopPlacesCalendar {
			add ("<table cellspacing=\"0\" cellpadding=\"0\">"); indentLevel++;
			add ("<tr>"); indentLevel++;
			add ("<td valign=\"top\">"); indentLevel++};
		
		bundle { //render the news items
			local (flHomePage = false);
			if parentOf (pta^.adrObject^) == pta^.adrSiteRootTable { //is this the home page or an archive page?
				flHomePage = true};
			
			local (flUseNewsDayTemplate = false);
			if defined (pta^.newsSite^.flNewsItemsByNewsDay) {
				if pta^.newsSite^.flNewsItemsByNewsDay {
					flUseNewsDayTemplate = true}};
			
			if flHomePage {
				add (manilaSuite.news.renderHomePage (pta, flUseNewsDayTemplate))}
			else {
				add (manilaSuite.news.renderArchivePage (adrTable, pta, flUseNewsDayTemplate))};
			
			add (manilaSuite.staticRendering.displayRenderButton (pta))};
		
		if not flSysopPlacesCalendar {
			add ("</td>"); indentLevel--;
			add ("<td width=\"20\">&nbsp;</td>"); indentLevel++};
		
		bundle { //add the stuff that goes down the right edge
			if not flSysopPlacesCalendar {
				add ("<td valign=\"top\">")};
			
			bundle { //get the calendar text; possibly add it to the page
				if pta^.newsSite^.flCalendarOnHomePage {
					local (calendarHtml = manilaSuite.html.drawCalendar (pta));
					if not flSysopPlacesCalendar { //PBS 8/10/99
						add (calendarHtml)};
					pta^.calendar = calendarHtml}}; //PBS 8/10/99
			
			bundle { //add the UserLand bookmarks
				if defined (pta^.newsSite^.siteNavigationBox) and not flSysopPlacesCalendar { //PBS 8/10/99
					add ("<p><center>" + string (pta^.newsSite^.siteNavigationBox) + "</center>")};
				«else
					«if defined (pta^.newsSite^.flNavBoxOnHomePage) and pta^.newsSite^.flNavBoxOnHomePage
						«add ("<p><center>" + string (userlandWidgets.standardElements.navBox) + "</center>")}};
		
		if not flSysopPlacesCalendar {
			add ("</td>"); indentLevel--;
			add ("</tr>"); indentLevel--;
			add ("</table>"); indentLevel--}};
	
	return (htmlText)}