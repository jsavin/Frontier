on getCommentUrl (adrmsgtable, permalinkUrl=nil) {
	//Changes
		//10/18/05; 4:50:09 AM by JES
			//Allow caller to specify permalinkUrl -- a link back to the post this comment link is going next to.
		//2/17/03; 2:32:31 PM by JES
			//Created. Generate a URL for a comment link like the ones in Radio sites.
	
	local (adrsite = manilaSuite.getSiteAddress ());
	local (baseurl = manilaSuite.getSiteUrl () + "comments");
	if permalinkUrl == nil {
		local (day, month, year, hour, minute, second);
		date.get (manilaSuite.news.getPostTime (adrmsgtable, adrSite), @day, @month, @year, @hour, @minute, @second);
		local (relativeurl = year + "/" + string.padWithZeros (month, 2) + "/" + string.padWithZeros (day, 2) + "#a" + adrmsgtable^.msgnum);
		permalinkurl = adrSite^.["#ftpSite"].url + relativeurl};
	local (linkarg = "&amp;link=" + string.urlEncode (permalinkurl));
	local (commentPageUrl = baseurl + "?u=" + manilaSuite.getCanonicalSiteName (adrsite) + "&amp;p=" + adrmsgtable^.msgNum + linkarg);
	
	return (commentPageUrl)}