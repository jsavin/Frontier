on defaultPage (pta=nil) {
	//Return a list of all pending news items.
		//04/19/00; 10:20:54 PM by PBS
	//Changes:
		//05/04/00; 10:57:46 PM by JES
			//localized page title
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	pta^.title = manilaSuite.getString ("news.pendingNewsItemsPageTitle", pta: pta);
	
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	local (htmlText);
	local (flCreateLink = true);
	
	htmlText = manilaSuite.news.pendingList (flCreateLink);
	
	return (manilaSuite.unTaint (htmlText))}