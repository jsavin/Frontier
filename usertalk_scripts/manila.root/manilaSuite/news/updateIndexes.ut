on updateIndexes (adrMsgTable, adrSite) {
	//Update the news item indexes.
		//04/20/00; 1:26:02 AM by PBS
	
	manilaSuite.news.updateAllList (adrMsgTable, adrSite);
	manilaSuite.news.updateReleasedList (adrMsgTable, adrSite);
	manilaSuite.news.updatePostedList (adrMsgTable, adrSite);
	manilaSuite.news.updatePendingList (adrMsgTable, adrSite);
	
	return (true)}