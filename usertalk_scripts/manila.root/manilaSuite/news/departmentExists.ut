on departmentExists (departmentName, adrSite) {
	//Return true if the department exists, false otherwise.
		//04/26/00; 12:52:53 AM by PBS
	
	local (adrDepartments = manilaSuite.news.getDepartmentTableAddress (adrSite));
	if defined (adrDepartments^.[departmentName]) {
		return (true)};
	return (false)}