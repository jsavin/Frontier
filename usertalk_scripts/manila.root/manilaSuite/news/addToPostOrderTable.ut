on addToPostOrderTable (adrMsgTable, adrSite) {
	«Add the item to the chronological table of items posted to the home page.
		«04/20/00; 3:57:29 PM by PBS
	
	local (adrIndex = manilaSuite.news.getIndexAddress ("postOrder", adrSite));
	local (postTime = manilaSuite.news.getPostTime (adrMsgTable, adrSite));
	xml.addValue (adrIndex, postTime, adrMsgTable^.msgNum);
	
	return (true)}