on editInBrowserPage () {
	//Changes:
		//9/6/05; 6:54:28 PM by JES
			//Add support for ETP callback, newsEditInBrowser.
		//7/10/05; 4:35:39 AM by JES
			//Added support for summary fields, which get passed to manilaSuite.news.editForm.
		//7/9/05; 5:44:35 AM by JES
			//Pass flFullItemPage to manilaSuite.news.formatNewsItem as true. Causes the full text of the news item to always appear in the preview area above the editor, regardless of what the news item summary prefs are set to.
		//3/12/05; 5:31:05 AM by JES
			//If the news item has an enclosure, pass its address to manilaSuite.news.editForm so the user gets some feedback that their enclosure is still registered.
		//Changes before 2005
			//4/18/03; 6:50:22 PM by JES
				//After posting an item which was edited via the edit link on the home page, redirect to the item itself, not just the top of the home page.
			//4/18/03; 6:31:02 PM by JES
				//Undid the last change.
			//4/18/03; 3:10:15 PM by JES
				//Commented out the preview at the top of the Edit News Item page.
			//4/17/03; 11:36:36 PM by JES
				//Add an #edit anchor to the default redirect URL so we go straight back to the editing form instead of to the preview at the top.
				//If a URL argument named redirectUrl is present, use its value for the redirectUrl parameter to manilaSuite.news.editForm. Used when clicking the edit link on the home page to redirect back to the item after POSTing the edited version.
			//4/1/03; 12:27:24 PM by JES
				//Don't throw an error if the news item doesn't define a department, url or description.
			//11/21/00; 4:33:40 PM by PBS
				//Use the new bottleneck for the Pike edit message button.
			//05/11/00; 8:01:59 PM by JES
				//merged in Brent's security fix for the client side trojan horse attack.
			//05/09/00; 10:41:34 PM by PBS
				//Check referer to defeat the client side trojan horse.
			//05/04/00; 7:43:15 PM by JES
				//localized
			//04/20/00; 2:39:41 PM by PBS
				//Created. Edit a news item in the browser.
	
	local (pta = html.getPageTableAddress ());
	workspace.pt = pta^;
	
	pta^.autoParagraphs = false;
	pta^.activeUrls = false;
	pta^.addLineFeeds = false;
	pta^.clayCompatibility = false;
	local (msgNum = pta^.pathArgs);
	local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	
	local (pageTitle = manilaSuite.getString ("news.editInBrowserPageTitle"));
	local (title = adrMsgTable^.subject);
	local (t = manilaSuite.news.xmlToTable (string (adrMsgTable^.body)));
	bundle { //JES 4/1/03: ensure description, url and department
		if not defined (t.description) {
			t.description = ""};
		if not defined (t.url) {
			t.url = ""};
		if not defined (t.department) {
			t.department = ""}};
	local (description = t.description);
	local (linkUrl = t.url);
	local (departmentName = t.department);
	local (adrDepartments = manilaSuite.news.getDepartmentTableAddress (adrSite));
	local (enclosure = "");
	if defined (adrMsgTable^.enclosure) {
		enclosure = @adrMsgTable^.enclosure};
	local (summary);
	if defined (t.summary) {
		summary = t.summary};
	
	local (actionUrl = manilaSuite.getUrl ("newsItemPostItem"));
	local (redirectUrl = pta^.url + "$" + pta^.pathArgs + "#edit");
	local (buttonText = manilaSuite.getString ("common.postChangesButton"));
	local (flMemberCanEdit = manilaSuite.news.memberCanEdit (adrMsgTable, pta^.adrMemberInfo));
	local (flMemberCanPostToHomePage = manilaSuite.news.memberCanPostToHomePage ());
	
	local (htmlText);
	on add (s) {
		htmlText = htmlText + s};
	
	local (flPost = (string.lower (pta^.method) == "post"));
	if flPost { //handle release or post commands
		manilaSuite.referer.checkSelf (); //PBS 05/09/00: check referer to defeat client side trojan horse
		if defined (pta^.postArgs.release) {
			if flMemberCanEdit {
				manilaSuite.news.releaseItem (adrMsgTable, adrSite);
				manilaSuite.custody.checkIn (adrMsgTable, pta^.adrMemberInfo, adrSite, true)}}; //release custody
		if defined (pta^.postArgs.post) {
			if flMemberCanPostToHomePage {
				manilaSuite.news.postItemToHomePage (adrMsgTable, adrSite);
				manilaSuite.custody.checkIn (adrMsgTable, pta^.adrMemberInfo, adrSite, true); //release custody
				local (redirectUrl = manilaSuite.getUrl ("newsHome"));
				if defined (pta^.responderAttributes.redirectUrl) {
					redirectUrl = pta^.responderAttributes.redirectUrl};
				scriptError ("!redirect " + redirectUrl)}};
		
		//Recalculate these booleans, since their values may be different now that the news item has been released or posted to the home page.
		flMemberCanEdit = manilaSuite.news.memberCanEdit (adrMsgTable, pta^.adrMemberInfo);
		flMemberCanPostToHomePage = manilaSuite.news.memberCanPostToHomePage ()};
	
	//if flMemberCanEdit
		//add ("<h3>Preview</h3>")
	local (newsItemTemplate = manilaSuite.news.getNewsItemTemplate (adrSite));
	local (memberKey = nameOf (pta^.adrMemberInfo^));
	on addPostOrReleaseButton () { //add Post to Homepage or Release button
		add ("<form method=\"post\" action=\"" + redirectUrl + "\">");
		if manilaSuite.editors.managingEditorTest (pta) {
			if not (manilaSuite.news.isPosted (adrMsgTable)) {
				add ("<input type=\"submit\" name=\"Post\" value=\"" + manilaSuite.getString ("news.postToHomePageButton") + "\">")}}
		else {
			if not (manilaSuite.news.isReleased (adrMsgTable)) {
				if string.lower (adrMsgTable^.member) == string.lower (memberKey) {
					add ("<input type=\"submit\" name=\"Release\" value=\"" + manilaSuite.getString ("news.releaseButton") + "\">")}};
			if not (manilaSuite.news.isPosted (adrMsgTable)) {
				if manilaSuite.news.isReleased (adrMsgTable) {
					if flMemberCanPostToHomePage {
						add ("<input type=\"submit\" name=\"Post\" value=\"" + manilaSuite.getString ("news.postToHomePageButton") + "\">")}}}};
		
		add ("</form>")};
	//addPostOrReleaseButton () //form for posting to home page -- above preview
	add (manilaSuite.news.formatNewsItem (adrMsgTable, newsItemTemplate, false, flFullItemPage:true));
	addPostOrReleaseButton (); //form for posting to home page -- below preview
	
	if flMemberCanEdit {
		//add ("<p><hr><h3>Edit</h3>")
		bundle { //Add the Edit in Pike button
			if defined (pta^.responderAttributes.urls^.editInPike) {
				//if manilaSuite.pike.memberHasPike (pta)
					//local (editInPikeUrl = pta^.responderAttributes.urls^.editInPike)
					//if not (editInPikeUrl endsWith "$")
						//editInPikeUrl = editInPikeUrl + "$"
					//editInPikeUrl = editInPikeUrl + adrMsgTable^.msgNum
					//local (adrSite = pta^.adrSiteRootTable)
					//local (adrMember = pta^.adrMemberInfo)
					//add ("<p>" + manilaSuite.pike.pikeButton (editInPikeUrl, adrMsgTable, adrMember, adrSite, true, manilaSuite.getString ("news.editInPike"), pta)) //true because this is a message
				add (manilaSuite.pike.editMessageButton (adrMsgTable, pta:pta))}}; //PBS 11/21/00: bottleneck for edit-message buttons //PBS 11/27/00: specify named pta parameter
		add ("<p>");
		if defined (pta^.searchArgTable.redirectUrl) {
			redirectUrl = pta^.searchArgTable.redirectUrl};
		if defined (pta^.searchArgTable.home) {
			redirectUrl = pta^.ftpSite^.url + "#a" + adrMsgTable^.msgNum};
		//local (editForm = manilaSuite.news.editForm (pageTitle, title, description, linkUrl, departmentName, adrDepartments, msgNum, actionUrl, redirectUrl, buttonText, enclosure, summary))
		local (adrETPBuilder = @manilaSuite.news.editForm);
		manilaSuite.plugins.ETPoverride.getScriptAddress("newsEditInBrowser", @adrETPbuilder);
		local (editForm = adrETPBuilder^ (pageTitle, title, description, linkUrl, departmentName, adrDepartments, msgNum, actionUrl, redirectUrl, buttonText, enclosure, summary));
		local (accessControls = manilaSuite.accesscontrol.ETPcontrols(pta, "newsitemeditinbrowser", adrMsgTable)); //accesscontrol 04.05.21, 22:03:59 by DAB
		if accessControls != "" { //04.05.22, 18:40:28 by DAB
			editForm = string.replace(editForm, "</form>", accessControls + "</form>")}; //only first one
		add(editForm); //04.05.22, 18:40:33 by DAB
		local (editUrl = manilaSuite.getUrl ("newsItemEditInBrowser"));
		editUrl = editUrl + adrMsgTable^.msgNum;
		editLink = html.getLink (manilaSuite.getString ("common.editLink"), editUrl)}
	else { //set title
		pta^.title = manilaSuite.getString ("news.previewPageTitle")};
	
	return (htmlText)};
//bundle //test code
	//html.setPageTableAddress (@workspace.pt)
	//editInBrowserPage ()