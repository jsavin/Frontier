on deleteFromIndex (indexName, adrMsgTable, adrSite) {
	«Delete from an index.
		«04/20/00; 2:14:26 PM by PBS
	
	local (adrIndex = manilaSuite.news.getIndexAddress (indexName, adrSite));
	local (msgNum = adrMsgTable^.msgNum);
	local (longNum = string.padWithZeros (msgNum, 7));
	if defined (adrIndex^.[longNum]) {
		delete (@adrIndex^.[longNum])};
	return (true)}