on renderWholeSiteStructure (adrManilaSite, adrStaticSite=nil) {
	«Render all the pages in the site structure.
		«03/06/00; 12:44:50 AM by PBS
	
	on renderCallback (adrItem, relativePath) {
		manilaSuite.staticRendering.renderPage (relativePath, adrManilaSite, adrStaticSite);
		return (true)};
	
	manilaSuite.siteStructure.visitPages (adrManilaSite, @renderCallback);
	
	return (true)}