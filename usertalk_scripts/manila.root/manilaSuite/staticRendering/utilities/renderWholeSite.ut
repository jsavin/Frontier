on renderWholeSite (adrManilaSite, adrStaticSite=nil) {
	«Changes
		«11/4/06; 5:49:12 PM by LL
			«Commented out the call to render the RSS feed since it's automatically handled in manilaSuite.staticRendering.renderPage.
		«11/11/03; 2:05:11 AM by JES
			«When rendering the entire site, also render the site's RSS feed.
		«03/07/00; 1:27:11 PM by PBS
			«Render an entire site -- home page, archived home pages, and site structure.
	
	local (oldPta = html.getPageTableAddress ());
	manilaSuite.staticRendering.startRenderSession (adrManilaSite, true);
	
	on setUpPageTable (adrTable, relPath) {
		adrTable^.relativePath = manilaSuite.unTaint (relPath);
		adrTable^.adrManilaSite = adrManilaSite;
		adrTable^.flManilaStaticRendering = true; //this flag means we're doing a Manila static rendering
		
		if adrStaticSite == nil {
			adrStaticSite = @adrManilaSite^.["#newsSite"].staticSite};
		adrTable^.adrStaticSite = adrStaticSite;
		
		new (tableType, @adrTable^.responseHeaders); //needed for RSS files
		
		html.setPageTableAddress (adrTable)};
	
	bundle { //render calendar, site structure, RSS feed, and home page
		try { //home page
			manilaSuite.staticRendering.renderPage ("/", adrManilaSite, adrStaticSite)}; //home page
		«try //rss feed
			«if manilaSuite.getNewsSitePref ("flSyndicate", adrManilaSite, true)
				«new (tableType, @pt)
				«setUpPageTable (@pt, "xml/rss.xml")
				«manilaSuite.staticRendering.renderBuiltinPage ("xml/rss.xml", adrManilaSite)
		try { //home page archives
			manilaSuite.staticRendering.utilities.renderWholeCalendar (adrManilaSite, adrStaticSite)};
		try { //site structure
			manilaSuite.staticRendering.utilities.renderWholeSiteStructure (adrManilaSite, adrStaticSite)}};
	html.setPageTableAddress (oldPta);
	local (t);
	t = manilaSuite.staticRendering.endRenderSession (adrManilaSite);
	return (t)};
«bundle //test code
	«html.setPageTableAddress (@workspace.pt)
	«renderWholeSite (@testManilaWebsite)