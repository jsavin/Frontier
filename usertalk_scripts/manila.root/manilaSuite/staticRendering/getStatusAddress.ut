on getStatusAddress (adrSite) {
	«Get the address of the table containing rendering status info for this site.
		«03/14/00; 4:05:35 PM by PBS
	
	bundle { //init temp.manila.staticRendering.sites table
		if not defined (temp.manila) {
			new (tableType, @temp.manila)};
		if not defined (temp.manila.staticRendering) {
			new (tableType, @temp.manila.staticRendering)};
		if not defined (temp.manila.staticRendering.sites) {
			new (tableType, @temp.manila.staticRendering.sites)}};
	
	local (canonicalSiteName = manilaSuite.getCanonicalSiteName (adrSite));
	
	local (adrSiteInfo = @temp.manila.staticRendering.sites.[canonicalSiteName]);
	
	return (adrSiteInfo)}