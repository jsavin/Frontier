on patchLocalUrls (s) {
	//Patch all the local URLs in the page.
		//03/05/00; 11:20:55 PM by PBS
		//Changes:
			//03/29/00; 9:07:05 PM by PBS
				//Don't attempt to patch URLs that begin with mailto, ftp, or https
			//04/08/00; 9:23:46 AM by PBS
				//Removed test code bundle from the bottom of the script.
			//04/12/00; 2:02:19 AM by PBS
				//Fixed a possible endless loop when dynamic-only URLs don't begin with http://
			//06/01/00; 1:45:54 PM by PBS
				//Don't attempt to patch URLs that begin with "javascript."
			//03/06/01; 4:55:20 PM by PBS
				//If a URL begins with #, return as-is, since it's an anchor.
			//03/16/01; 9:20:44 PM by PBS
				//If a link contains attributes in addition to href, preserve those attributes in the static version.
				//Fix for relative links -- a link to somePage would be translated to somepage/somepage.html. Now it will be properly translated to somepage.html.
			//03/21/01; 8:00:48 PM by PBS
				//Handle URLs that contain #, ?, or $ properly -- add the suffix before the fragment. This fixes, among other things, the problem with static rendering and the internalLink rule in the pikeRenderer.
			//05/06/01; 12:42:58 AM by JES
				//Convert the filename to lowercase, but don't convert the path part of the URI to lower-case, because html.buildObject will keep the same case as the path specified in the site-structure.
					//If it were 9 months ago, I'd have modified the rendering so that folder names would be lowercase, but there are too many already-rendered pages out there to do this -- it would have too much potential for creating 404s. Also, the lower-case links are already broken, so making this change doesn't indroduce any breakage that wasn't already there.
			//12/19/01; 9:16:29 PM by PBS
				//Handle URLs of the form /aaa/bbb/ -- URLs that end with slashes were broken. Fixed.
	
	local (pta = html.getPageTableAddress ());
	local (htmlText);
	local (adrNewsSite = pta^.newsSite);
	local (adrManilaSite = manilaSuite.staticRendering.getManilaSiteAddress ());
	
	local (dynamicUrl = adrManilaSite^.["#ftpSite"].url);
	local (staticUrl = pta^.ftpSite^.url);
	local (dynamicUri, staticUri);
	local (dynamicServer, staticServer);
	local (suffix = string.lower (manilaSuite.staticRendering.getSuffix ()));
	
	bundle { //get the dynamic and static uris
		local (urlParts = string.urlSplit (dynamicUrl));
		dynamicServer = urlParts [2];
		dynamicUri = "/" + urlParts [3];
		
		urlParts = string.urlSplit (staticUrl);
		staticServer = urlParts [2];
		staticUri = "/" + urlParts [3]};
	
	on filterUrl (url) { //translate url for static rendering
		local (fragmentCharacters = {"#", "$", "?"});
		
		bundle { //check if URL begins with a fragment
			local (oneFragment);
			for oneFragment in fragmentCharacters {
				if url beginsWith oneFragment {
					return (url)}}};
		
		local (lowerUrl = string.lower (url));
		
		local (flContainsFragment = false, fragment = "");
		bundle { //check if URL contains a fragment
			local (ix = 0, oneFragment, ixFragmentChar = 0);
			for oneFragment in fragmentCharacters {
				ix = string.patternMatch (oneFragment, lowerUrl);
				if ix > 0 {
					if (ix < ixFragmentChar) or (ixFragmentChar == 0) {
						ixFragmentChar = ix;
						flContainsFragment = true}}};
			if flContainsFragment {
				fragment = string.mid (url, ixFragmentChar, infinity)}};
		
		case true { //PBS 03/29/00: don't filter https, ftp, and mailto URLs
			lowerUrl beginsWith "https://";
			lowerUrl beginsWith "ftp://";
			lowerUrl beginsWith "javascript:"; //PBS 06/01/00: don't filter javascript links
			lowerUrl beginsWith "mailto:" {
				return (url)}};
		
		if manilaSuite.staticRendering.isDynamicLink (url) {
			if not (url beginsWith "http://") {
				return ("http://" + dynamicServer + url)}; //PBS 04/12/00: site of infinite loop (fixed)
			return (url)};
		
		//if lowerUrl contains "/discuss/" or lowerUrl contains "/stories/"
			//if (lowerUrl beginsWith string.lower (dynamicUrl)) or (not (lowerUrl beginsWith "http://"))
				//local (ix = string.patternMatch ("/discuss/", lowerUrl))
				//if ix < 1
					//ix = string.patternMatch ("/stories/", lowerUrl)
				//local (s = url)
				//if ix > 0
					//s = string.delete (url, 1, ix)
				//s = dynamicUrl + s
				//return (s)
		local (originalUrl = url);
		url = string.replace (url, dynamicUrl, staticUrl, false);
		if originalUrl beginsWith "http://" and url == originalUrl {
			return (url)};
		
		on patchUrlWithFragment () {
			if not flContainsFragment {
				if not (url endsWith "/") {
					if not (url endsWith suffix) {
						url = url + suffix}};
				return (true)};
			local (urlMinusFragment = string.delete (url, (sizeOf (url) - sizeOf (fragment)) + 1, infinity));
			if not (urlMinusFragment endsWith "/") {
				if not (urlMinusFragment endsWith suffix) {
					urlMinusFragment = urlMinusFragment + suffix}};
			url = urlMinusFragment + fragment;
			return (true)};
		
		if not (url beginsWith "http://") {
			local (dynamicUri, staticUri);
			local (urlParts = string.urlSplit (dynamicUrl));
			dynamicUri = "/" + urlParts [3];
			urlParts = string.urlSplit (staticUrl);
			staticUri = "/" + urlParts [3];
			url = string.replace (url, dynamicUri, staticUri, false);
			bundle { //05/05/2001 JES: convert the filename to lowercase, but don't convert the path part
				//url = string.lower (url) // (old code)
				if not (url endsWith "/") { //PBS 12/19/01: skip lowering the filename if path ends with /
					local (filename = string.nthField (url, "/", string.countFields (url, "/")));
					url = string.mid (url, 1, sizeOf (url) - sizeOf (filename)) + string.lower (filename)}};
			patchUrlWithFragment ();
			//if not (url endsWith "/") //PBS 03/16/01: add suffix to relative links that are to pages instead of folders
				//url = url + suffix};
		
		if url != originalUrl or (not (url beginsWith "http://")) { //did the URL get filtered? It's local, it may be a picture, or we may need to add an .html suffix.
			if lowerUrl contains "/picture$" {
				local (ctFields = string.countFields (lowerUrl, '$'));
				local (msgNum = string.nthField (lowerUrl, '$', ctFields));
				msgNum = number (msgNum);
				local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum, pta));
				if defined (adrMsgTable^.image.url) {
					url = adrMsgTable^.image.url}
				else {
					url = dynamicUrl + "picture$" + msgNum}}
			else {
				patchUrlWithFragment ();
				//if not (url endsWith "/")
					//if not (url endsWith suffix)
						//url = string.lower (url)
						//url = manilaSuite.staticRendering.convertUrl (url)}};
		
		return (url)};
	
	loop {
		local (ix = string.patternMatch ("<a href=\"", string.lower (s)));
		if ix < 1 {
			htmlText = htmlText + s;
			break};
		htmlText = htmlText + string.mid (s, 1, ix - 1);
		s = string.delete (s, 1, ix - 1);
		ix = string.patternMatch (">", string.lower (s));
		local (link = string.mid (s, 1, ix - 1));
		local (t);
		new (tableType, @t);
		try {
			xml.compile (link + "/>", @t);
			local (url = t [1].["/atts"].href);
			url = filterUrl (url);
			local (newLink = "<a href=\"" + url + "\"");
			bundle { //add other attributes
				if sizeOf (t [1].["/atts"]) > 1 {
					local (adrAtt);
					for adrAtt in @t [1].["/atts"] {
						local (attName = nameOf (adrAtt^));
						if string.lower (attName) != "href" {
							newLink = newLink + " " + attName + "=\"" + adrAtt^ + "\""}}}};
			s = string.replace (s, link, newLink);
			ix = string.patternMatch ("</a>", s);
			htmlText = htmlText + string.mid (s, 1, ix + 3)};
		s = string.delete (s, 1, ix + 3)};
	
	return (htmlText)}