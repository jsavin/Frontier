on handler (pta, adrObject) {
	«Changes
		«1/29/06; 11:56:06 PM by JES
			«Fix typo, pta^.pta^. ... -> pta^. ...
		«4/16/05; 1:52:11 AM by JES
			«Disabled map (table) view of site structure, due to unresolved issues. These will be fixed during the beta process, and released later.
		«04/05/15, 17:36:04 by DAB
			«factored out of manilaSuite.admin.advancedPage (with extreme prejudice) 
				«messages at manilaData.localization.languages.english.strings.admin
	local (advancedPageName = pta^.pathArgs);
	local (adrSite= manilaSuite.getManilaSiteAddress(pta));
	local (flMemberHasPike = manilaSuite.pike.memberHasPike (pta));
	local (adrView = manilaSuite.members.getMemberPrefAddress(pta^.adrMemberInfo, "siteprefs.advanced.sitestructure", "xml"));
	local (flContentEditor = false);
	if not pta^.flManagingEditor {
		flContentEditor = pta^.flContentEditor;
		if not flContentEditor {
			scriptError (manilaSuite.getString ("admin.cantDisplayPageNoPermission", pta: pta))}};
	
	local (htmlText = "");
	on add (s) {
		htmlText = htmlText + s;};
	
	local (sectionName = parentOf(this^)^.sectionName);
	local (shortName = manilaSuite.sitePrefs.utility.getShortSectionName (sectionName));
	local (displayname = manilaSuite.sitePrefs.utility.getDisplayName(pta, sectionName));
	local (value = manilaSuite.sitePrefs.utility.exportOutline (string (adrObject^)));
	
	local (description = manilaSuite.getString ("admin." + shortName + "SectionDescription", pta: pta));
	add("\r<p>");
	add(description);
	add("\r</p>");
	
	if defined(pta^.postargs.[shortname]) {
		local (replacementTable);
		bundle { //set up replacement table
			new (tableType, @replacementTable);
			replacementTable.displayName = displayName};
		
		case true {
			defined (pta^.postArgs.restoreToDefault) {
				add(manilaSuite.sitePrefs.utility.confirmBox(pta, shortname, "admin.restoreDefaultConfirmText", @replacementTable))};
			defined (pta^.postArgs.doRestoreDefault) { //restore to default
				local (siteInfo);
				new (tableType, @siteInfo);
				siteInfo.adrSite = adrSite;
				siteInfo.manilaLanguageTableAddress = manilaSuite.getLanguageTableAddress (pta); //10/31/00 JES: tell create scripts what language the site is using.
				manilaSuite.newSite.createHierarchy (@siteInfo);
				manilaSuite.custody.checkInAndOut(adrObject, pta^.adrMemberInfo, pta^.adrSiteRootTable, false);
				
				value = manilaSuite.sitePrefs.utility.exportOutline(string (adrObject^));
				add(manilaSuite.sitePrefs.utility.successMessage (pta, "admin.restoredDefaultSuccessSingular", @replacementTable))};
			defined (pta^.postargs.viewmap) {
				adrView^ = "map"};
			defined (pta^.postargs.viewxml) {
				adrView^ = "xml"};
			defined (pta^.postargs.deleteURI);
			defined (pta^.postArgs.changeatts);
			defined (pta^.postArgs.marked);
			defined (pta^.postArgs.sortmark);
			defined (pta^.postArgs.sitestructureRender);
			defined (pta^.postArgs.selectDirectives);
			defined (pta^.postArgs.ETPitems) {
				return manilaSuite.sitePrefs.siteStructure.map(pta^.fname + "$" + advancedPageName, shortname)}}
		else { //try to update
			local (s = string(pta^.postArgs.xmltext));
			s = string.replaceAll (s, lf, "");
			s = manilaSuite.unTaint (s);
			local (t);
			local (adrDG = manilaSuite.discuss.getDiscussionGroupAddress(adrSite));
			on errorReport(messageText) { «05/05/04, 15:53:42 by DAB
				add("<p style='color:red'>");
				add(messageText);
				add("</p>");
				return true};
			try {
				xml.compile (s, @t);
				if manilaSuite.sitePrefs.siteStructure.isValid(@t, @errorReport, adrDG^.prefs.nextMsgNum, adrSite) { «made Conditional
					wp.newTextObject (s, adrObject);
					manilaSuite.custody.checkInAndOut(adrObject, pta^.adrMemberInfo, pta^.adrSiteRootTable, false);
					
					add(manilaSuite.sitePrefs.utility.successMessage (pta, "admin.updatedSuccessSingular", @replacementTable));
					value = manilaSuite.sitePrefs.utility.exportOutline(string (adrObject^))}
				else {
					value = manilaSuite.sitePrefs.utility.exportOutline(s)}}
			else {
				replacementTable.tryError = tryError;
				add(manilaSuite.sitePrefs.utility.successMessage(pta, "admin.couldntUpdateBecauseSingular", @replacementTable));
				value = manilaSuite.sitePrefs.utility.exportOutline(s)}}}; //PBS 03/20/01: the carets need to be escaped
	
	if adrView^ == "map" { //structure map a la manilafixer
		return manilaSuite.sitePrefs.siteStructure.map(pta^.fname + "$" + advancedPageName, shortname)}
	else {
		add ("\r<form method='POST' action='" + pta^.fname + "$" + advancedPageName + "' name ='" + advancedPageName + "'>");
		add ("\r<table border='0' cellpadding='7' cellspacing='0' width='100%'>");
		add ("\r<input type='hidden' name='" + shortName + "' value='true'>");
		
		bundle { //row for textarea
			add ("\r\t<tr>");
			add ("\r\t\t<td align='left' valign='top' colspan='2'>");
			add("&nbsp;&nbsp;");
			add("<textarea name='xmltext' cols='" + manilaSuite.sitePrefs.data.cols + "' rows='" + manilaSuite.sitePrefs.data.rowsBig + "' style='width:" + manilaSuite.sitePrefs.data.textareaWidthPixels + "; height:" + manilaSuite.sitePrefs.data.textareaHeightPixels + "'>" + value + "</textarea>");
			add ("\r\t\t</td>");
			add ("\r\t</tr>")};
		
		bundle { //row for buttons
			add(manilaSuite.sitePrefs.utility.addButtons(pta, adrObject, sectionName, flMemberHasPike, "viewmap", "admin.siteStructureViewMap"))};
		
		add ("\r</table>");
		add ("\r</form>")};
	
	return htmltext}