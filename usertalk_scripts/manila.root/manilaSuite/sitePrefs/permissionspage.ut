on permissionsPage (pta) {
	«Changes
		«10/1/05; 3:00:12 AM by JES
			«Address HTML issues. Reformatted script to UserLand style.
		«05/05/15, 20:21:22 by DAB
			«Created. Handle the Permissions prefs page.
				«messages at manilaData.localization.languages.english.strings.permissions
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	local (sitename = manilaSuite.getCanonicalSitename (adrSite));
	local (adrGroup = manilaSuite.members.getGroupFromSiteAddress (adrSite));
	local (adrCohorts = @adrGroup^.cohorts);
	
	local  (adrNewsSite = manilaSuite.getNewsSiteAddress (adrSite));
	manilaSuite.accessControl.init(adrSite);
	
	local (htmltext = "");
	on add (s) {
		htmltext = htmltext + s;};
	
	local (replTbl);
	bundle { //build replace table 02/03/24, 09:39:55 by DAB
		new (tabletype, @replTbl);
		replTbl.sitename = sitename;
		replTbl.moderators = maniladata.accessControl.moderatorCohort};
	
	local (seperatorColor, seperatorTextColor);
	manilaSuite.html.getSeparatorColors (@seperatorColor, @seperatorTextColor);
	on separator (msgID, sectionName="") {
		local (id="");
		if sectionName!="" {
			id = " id=\"" + sectionName + "\""};
		add ("\r<table cellpadding=\"2\" cellspacing=\"0\" width=\"100%\"" + id + ">");
		add ("\r\t<tr>");
		add ("\r\t\t<td style=\"color:" + seperatorTextColor + ";background-color:" + seperatorColor + "\" colspan=\"2\">");
		add (manilaSuite.getString ("permissions." + msgID, @replTbl, pta:pta));
		add ("\r\t\t</td>");
		add ("\r\t</tr>");
		add ("\r</table>");
		return true};
	
	pta^.title = manilaSuite.getString ("permissions.pageTitle", @replTbl, pta:pta);
	«add ("<h2>" + pta^.title + "</h2>") //17/05/05; 3:57:47 PM by PR
	add (manilaSuite.getString ("permissions.helptext", @replTbl, pta:pta)); //
	
	on report (errID, hue="red") {
		add ("<p align=\"center\">");
		add ("<span style=\"color:" + hue + "\">" + manilaSuite.getString ("permissions." + errID, @replTbl, pta:pta) + "</span>");
		add ("</p>");
		return true};
	
	separator ("panelTitleHardPaths", "hardPaths");
	
	«how this works
		«You can manipulate only manila standard paths which in the table of hard wired paths at 
		«manilaData.accesscontrol.controlledPaths. Its too dangerous to control path access willy nilly.
		«Any paths that are modified are stored in #newsSite.accessControl.controlledPaths
			«entries there are copied of the entry from manilaData.accesscontrol.controlledPaths
			«with additional table entry cohorts (a list)
			«there's unused capability (no API) for plugins to add paths to #newsSite.accessControl.controlledPaths.
			«but these paths must be restricted the plugin website fragment only
		«Anyone can potentially visit this page, but they only see paths that they are permitted to access
		«and the cohorts they can assign to are the ones that contain their member key. This simple mechansim, allows
		«delegation down an authorisation hierarchy, but not up. In other words, if you have access you can assign it
		«to other cohorts you belong to. One exception is that the entry has a flag to specify whether being a 
		«member is a requirement or not. All cohorts except Eveyone contains only members. 
	bundle { //form for hardwired paths
		local (adrPath, namePath, current, exceptions);
		
		if pta^.method == "POST" {
			if defined (pta^.postargs.changepaths) {
				for adrPath in @manilaData.accesscontrol.controlledPaths {
					namePath = nameOf (adrPath^);
					replTbl.path = adrPath^.path;
					current = pta^.postargs.[namepath];
					if typeOf (current) != listType {
						current = {current}};
					if manilaSuite.accessControl.controlledPathSave (adrSite, namePath, current) {
						report ("pathChanged", "green")}};
				for adrPath in @adrNewsSite^.accessControl.controlledPaths {
					namePath = nameOf (adrPath^);
					if defined (manilaData.accesscontrol.controlledPaths.[namePath]) { //did we do this already?
						continue};
					replTbl.path = adrPath^.path;
					current = pta^.postargs.[namepath];
					if typeOf (current) != listType {
						current = {current}};
					if manilaSuite.accessControl.controlledPathSave (adrSite, namePath, current) {
						report ("pathChanged", "green")}}}};
		
		add ("<form method=\"POST\" action = \"" + pta^.fName + "$permissions#hardPaths\" name=\"permissions\">");
		add ("\r<table cellpadding=\"5\">");
		
		for adrPath in @manilaData.accesscontrol.controlledPaths {
			namePath = nameOf (adrPath^);
			replTbl.path = adrPath^.path;
			add ("\r\t<tr>\r\t\t<td colspan=\"2\">&nbsp;</td></tr>"); //spacer row
			add ("<tr>");
			add ("<td align=\"left\" valign=\"top\">");
			add (manilaSuite.getString ("permissions.labelStatsPath", @replTbl, pta:pta));
			add ("</td>");
			add ("<td>");
			current = adrPath^.default;
			try {
				 current = adrNewsSite^.accessControl.controlledPaths.[namePath].cohorts;
				if not manialSuIte.accessControl.checkMemberCohorts (pta, current) {
					continue}};
			exceptions = {};
			if adrPath^.flRequiresMember {
				exceptions = {"Everyone"}};
			add (manilaSuite.accessControl.cohortsPopup (pta, namePath, current, exceptions, false, 6));
			add ("</td>");
			add ("</tr>")};
		
		if defined (adrNewsSite^.accessControl.controlledPaths) { //form for plugin, etc paths
			for adrPath in @adrNewsSite^.accessControl.controlledPaths {
				namePath = nameOf (adrPath^);
				if defined (manilaData.accesscontrol.controlledPaths.[namePath]) { //did we do this already?
					continue};
				replTbl.path = adrPath^.path;
				add ("\r\t<tr>\r\t\t<td colspan=\"2\">&nbsp;</td></tr>"); //spacer row
				add ("<tr>");
				add ("<td align=\"left\" valign=\"top\">");
				add (manilaSuite.getString ("permissions.labelStatsPath", @replTbl, pta:pta));
				add ("</td>");
				add ("<td>");
				current = adrNewsSite^.accessControl.controlledPaths.[namePath].cohorts;
				exceptions = {};
				if adrPath^.flRequiresMember {
					exceptions = {"Everyone"}};
				add (manilaSuite.accessControl.cohortsPopup (pta, namePath, current, exceptions, false, 6));
				add ("</td>");
				add ("</tr>")}};
		
		add ("\r\t<tr>");
		add ("\r\t\t<td align=\"right\" colspan=\"2\">");
		add ("<input type=\"submit\" name=\"changepaths\" value=\"" + manilaSuite.getString ("permissions.buttonChange", pta:pta) + "\">");
		add ("</td>");
		add ("\r\t</tr>");
		
		add ("\r\t</table>");
		add ("\r</form>")};
	
	return htmltext}