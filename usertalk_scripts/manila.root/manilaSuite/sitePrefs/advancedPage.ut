on advancedPage (pta=nil) {
	«Changes:
		«3/25/06; 2:13:04 AM by JES
			«When calling handlers, replace all left-curly-brace characters with HTML entities. Prevents pseudo-macros which are replaced in Manila's filters from being inadvertently lost.
		«12/13/05; 2:11:07 AM by JES
			«If an advanced page handler has a sub-item named url, use [siteUrl] + url for the link in the advanced prefs menu. This allows handlers to link to pages outside of advanced prefs (like Download My Site).
		«12/13/05; 2:00:59 AM by JES
			«If an advanced page handler has a sub-item named condition, use it to determine whether or not to display the link. Conditions can be booleans, strings (which are evaluated) or scripts (which are called).
			«Needed for the Download My Site link, which only appears if site downloads are enabled on the server.
		«3/1/05; 1:07:31 AM by JES
			«Fixed issue where titles on prefs pages would be rendered twice at the top of the page -- once by the template, and once in this script.
			«For the page title, include the name of the object being edited.
		«2/16/05; 5:03:09 AM by JES
			«Handlers now have the abiity to override the default height by applying a multipler named iFrameHeight in their table. This is multiplied by the default height to get the actual height used in the iframe tag.
		«05/13/04, 16:46:15 by DAB
			«Created. This is the dispatch procedure for the advanced prefs. We build the links across the top here, but call handlers for each. Messages at manilaData.localization.languages.english.strings.admin.
	if pta == nil {pta = html.getPageTableAddress()};
	local (adrSite= manilaSuite.getManilaSiteAddress(pta));
	local (flContentEditor = false);
	if not pta^.flManagingEditor {
		flContentEditor = pta^.flContentEditor;
		if not flContentEditor {
			scriptError (manilaSuite.getString ("admin.cantDisplayPageNoPermission", pta: pta))}};
	
	local (htmlText = "");
	on add (s) {
		htmlText = htmlText + s;};
	
	manilaSuite.sitePrefs.setTemplate ();
	
	local (pagename = string.lower(string.nthField(pta^.pathArgs, "_", 2)));
	
	if flContentEditor { //validate page requested against access privilages
		case pagename { //add exceptions for CEs here
			"navigation" {
				}}
		else { //no other options for content editors
			pagename = ""}};
	
	bundle { //set title and navigation according to access privilages
		pta^.title = manilaSuite.getString ("admin.advancedPageTitle", pta: pta);
		if pagename != "" { //set title based on the object we're editing
			case pagename {
				"legaltags" {
					pta^.title = pta^.title + ": " + manilaSuite.getString ("admin." + pagename + "PageTitle", pta:pta)}}
			else {
				pta^.title = pta^.title + ": " + manilaSuite.getString ("admin." + pagename + "SectionName", pta:pta)}};
		«PBS 12/03/01: get localized Navigation page title
		if flContentEditor {
			pta^. title = manilaSuite.getString ("admin.NavigationSectionName", pta: pta);
			pta^.navigator = @pta^.adrSiteRootTable^.["#navigator"]}; //use site navigator
		«add ("\r<h2>" + pta^.title + "</h2>")
		if not flContentEditor {
			add (manilaSuite.getString ("admin.advancedPageDescription", pta: pta) );
			add("\r<p>");
			«build the navigation links
			local (adrnav = @manilaSuite.sitePrefs.advancedPageMenu);
			local (i, adr, lastNum=1, nme, sectionName, delim="", url, sizenav = sizeOf (adrnav^));
			for i = 1 to sizenav {
				adr = @adrnav^[i];
				if defined (adr^^.condition) {
					local (flConditionMet = false);
					try {
						case typeOf (adr^^.condition) {
							stringType {
								flConditionMet = evaluate (adr^^.condition)};
							scriptType {
								flConditionMet = adr^^.condition ()};
							booleanType {
								flConditionMet = adr^^.condition}}};
					if not flConditionMet {
						continue}};
				nme = nameOf(adr^^);
				sectionName = adr^^.sectionName;
				try {sectionName =  manilaSuite.getString ("admin." + string.innerCaseName (nme) + "SectionName", pta: pta) };
				if lastNum != number (nameOf (adr^)) / 1000 {
					add ("<br>");
					delim = ""};
				if string.lower(nme) != pagename {
					if defined (adr^^.url) { //allow handlers to be somewhere else in the site
						url = manilaSuite.getSiteUrl (adrsite) + adr^^.url}
					else { //default: an advanced prefs page
						url =  pta^.uri + "$advanced_" + string.lower(string.dropNonAlphas (nme))};
					add(delim + html.getLink(string.replaceAll(sectionName, " ", "&nbsp;"), url))}
				else {
					add(delim + string.replaceAll(sectionName, " ", "&nbsp;"))};
				lastNum = number(nameOf(adr^)) / 1000;
				delim = "&nbsp;- "};
			add("\r</p>")}};
	
	bundle { //add a meta tag
		«This page should expire immediately, it should never be cached. For this to work, the template should include the {meta} safe macro.4
		
		local (s = "<meta http-equiv='Expires' content='Mon, 01 Jan 1990 01:00:00 GMT'>");
		s = s + "\r<meta http-equiv='cache-control' content='no-cache'>";
		s = s + "\r<meta http-equiv='pragma' content='no-cache'>";
		
		if defined (pta^.meta) {
			pta^.meta = pta^.meta + "\r" + s} //add to existing meta info
		else {
			pta^.meta = s}}; //create new meta info in the page table
	
	local (replacementTable);
	bundle { //build replaced items
		new (tableType, @replacementTable);
		replacementTable.displayName = manilaSuite.sitePrefs.utility.getDisplayName (pta, pagename)};
	
	if pagename != "" {
		«check the item out now
		local (adrObject = manilaSuite.custody.getAdvancedItemAddress(pagename, adrSite));
		if not manilaSuite.custody.checkOut(adrObject, pta^.adrMemberInfo, pta^.adrSiteRootTable, false) {
			add(manilaSuite.sitePrefs.utility.errorMessage("cantEditCheckedOutItemError", @replacementTable));
			return htmltext};
		«undo checkouts for any other advanced items this user owns in this site
		manilaSuite.custody.undoCheckOutAdvancedExcept(adrObject, pta^.adrMemberInfo, pta^.adrSiteRootTable);
		
		case true {
			pta^.searchargs contains "iframe=yes";
			(pta^.method == "POST") {
				local (actionURL = "http://" + pta^.host + pta^.uri + "$advanced_" + pagename ); //05/02/12, 13:27:49 by DAB
				local (undoForm = manilaSuite.versioning.objectUndoForm(pta, adrObject, actionURL));
				htmltext =  manilaSuite.sitePrefs.handlers.[pagename].handler(pta, adrObject);
				htmltext = string.replaceAll (htmltext, "{", "&#123;"); //3/25/06; 2:12:52 AM by JES
				return (undoForm + htmltext)}}
		else {
			local (url = "http://" + pta^.host + pta^.uri + "$advanced_" + pagename + "?iframe=yes");
			if pta^.searchargs != "" {
				url = url + "&" + pta^.searchargs};
			local (height = manilaSuite.sitePrefs.data.iFrameHeight);
			if defined (manilaSuite.sitePrefs.handlers.[pagename].iFrameHeight) {
				height = number (double (manilaSuite.sitePrefs.handlers.[pagename].iFrameHeight) * number (height))};
			add("\r<iframe src='" + url + "'  frameborder='0' width='" + manilaSuite.sitePrefs.data.iFrameWidth + "' height = '" + height + "' title='" + pagename + "'>")
				«add("\r<iframe src='" + url + "'  frameborder='0' width='" + manilaSuite.sitePrefs.data.iFrameWidth + "' height = '" + manilaSuite.sitePrefs.data.iFrameHeight + "' scrolling='" + manilaSuite.sitePrefs.data.iFrameScrolling + "' title='" + pagename + "'>");;
			add (manilaSuite.getString ("admin.advancedNeedsIframes", pta: pta) );
			add("\r</iframe>")}}
	else {
		«undo checkouts for ALL advanced items this user owns in this site
		manilaSuite.custody.undoCheckOutAdvancedExcept(nil, pta^.adrMemberInfo, pta^.adrSiteRootTable);
		
		add (manilaSuite.getString ("admin.advancedClickToStart", pta: pta) )};
	
	return htmlText}