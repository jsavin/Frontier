on applySubTemplate (pta, templ) {
	«manilaSuite.sitePrefs.auxtemplates.applySubTemplate : 04/05/16, 18:45:58 by DAB
		«see if template string identified by templ is complete
		«manilaFixer.templates.applySubTemplate : 02/09/22, 22:23:06 by DAB
	local (adrSite = manilaSuite.getmanilaSiteAddress(pta));
	local (s = string (adrSite^.["#templates"].[templ]));
	if not (string.lower(s) contains "<html>") {
		«msg("Applying subtemplate " + templ)
		pta^.bodyText = string.replace(s, "{bodytext}", pta^.bodytext);
		return true};
	return false};
«bundle
	«local (tbl=temp.pta.["123"].pagefilter)
	«html.setpageTabladdress(@tbl)
	«applySubTemplate (@tbl, "docControl")