	on locateCategory(adrParent, nme) {
		local (lowernme = string.lower(nme));
		local (adr, adrCategory = nil, pathnameAtt);
		for adr in adrParent {
			if manilaSuite.sitePrefs.siteStructure.isXMLInternal(adr) {
				continue};
			pathnameAtt = string.lower(xml.getAttributevalue(adr, "pathname"));
			if (pathnameAtt == lowernme) {
				adrCategory = adr;
				break}};
		case true {
			(not adrCategory) {
				if not flCreatePath {
					return false};
				«add category
				adrCategory = xml.addTable(adrParent, "category");
				adr = @adrCategory^.["/atts"];
				new(tabletype, adr);
				adr^.name = nme;
				adr^.pathname = nme};
			not manilaSuite.sitePrefs.siteStructure.isXMLCategory(adrCategory) { //02/04/15, 15:37:18 by DAB
				«found, but not a category
				adr = parentof(adrCategory^); //01/10/24, 19:16:01 by DAB
				try {delete(@adrCategory^.["/pcdata"])};
