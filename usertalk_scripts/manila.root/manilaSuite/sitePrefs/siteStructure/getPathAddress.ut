				table.rename(adrCategory, lowernme); //01/10/24, 19:16:01 by DAB
				adrCategory = @adr^.[lowernme]}}; //01/10/24, 19:16:01 by DAB
		return adrCategory};
	
	local (adrParent= adrHierarchy, nodeName, adr); //01/10/24, 19:06:29 by DAB
	«look for location of path
	path = string.popLeading(path, "/"); //02/09/05, 10:28:24 by DAB
	local (nodes = string.countFields(path, "/"));
	local (ix);
	if nodes > 1 {
		for ix = 1 to nodes-1 {
			adrParent = locateCategory(adrParent, string.nthField(path, "/", ix));
			if adrParent == nil {
				return false}}};
	«look for last level
	nodeName = string.nthField(path, "/", nodes);
	for adr in adrParent {
		if manilaSuite.sitePrefs.siteStructure.isXMLInternal(adr) {
			continue};
		if string.lower(xml.getAttributeValue(adr, "pathname")) == string.lower(nodeName) {
			return adr}};
	
	if flCreatePath {
		local (s = "story");
		if path endsWith "/" {
			s = "category"};
		adr = xml.addTable(adrParent, s);
