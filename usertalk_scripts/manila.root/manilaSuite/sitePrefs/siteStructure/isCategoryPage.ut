on isCategoryPage (pta) {
	«manilaSuite.sitePrefs.siteStructure.isCategoryPage : 05/05/04, 17:45:36 by DAB
		«returns true if the current page is a category in the site structure
	manilaSuite.sitePrefs.siteStructure.minimiseSiteStructure(pta);
	
	if not defined(pta^.minimalSiteStructureCurrentLocation) {
		return  false};
	
	local (nme = xml.convertToDisplayName(nameOf(pta^.minimalSiteStructureCurrentLocation^)));
	return string.lower(nme) == "category"}