on getPathAttValue (attName, defaultAttValue = "", flInherit=true, flDebug = false) {
	«manilaSuite.sitePrefs.siteStructure.getPathAttValue : 04/05/16, 17:04:29 by DAB
		«02/07/22, 20:08:10 by DAB
			«rewrite to use manilaFixer.siteStructure.minimiseSiteStructure
		«00/05/13, 18:04:41 by DAB
			«Exit gracefully if no value set for pta^.heirarchyLoc
		«manilaextras.pathAtt : 00/04/25, 15:04:45 by DAB
			«given an attribute name, do a walk up the hierarchy from the current page
			«looking for a story/category with  a value for that attribute.  Use thatvalue
			«to identify a picture (from the picture list) and return the current url.
	local (pta = html.getPageTableAddress());
	
	manilaSuite.sitePrefs.siteStructure.minimiseSiteStructure(pta);
	
	if not defined(pta^.minimalSiteStructureCurrentLocation) {
		return ""};
	
	local (attValue = "");
	local (adr = pta^.minimalSiteStructureCurrentLocation);
	if flInherit { //walk up the hierarchy, stopping at first node which has the desired attribute
		loop {
			try {
				attValue= xml.getAttributeValue(adr, attname);
				break};
			adr = parentof(adr^);
			if not adr {
				break}}}
	else { //just look at this node
		try {attValue = xml.getAttributeValue(adr, attName)}};
	
	if attValue == "" {
		attValue =defaultAttValue};
	
	return attValue};
«bundle
	«local (tbl = temp.pta.["853"].pageFilter)
	«html.setPageTableAddress(@tbl)
	«msg(pathAtt("hue", "white", flDebug:true))