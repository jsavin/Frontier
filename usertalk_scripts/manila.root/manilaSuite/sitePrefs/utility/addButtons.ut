on addButtons (pta, adrObject, sectionName, flPikeButton=true, optButtonName="", optButtonValue="") {
	«manilaSuite.sitePrefs.utility.addButtons : 04/05/13, 21:29:04 by DAB
		«factored from manilaSuite.sitePrefs.advancedPage
	«messages at manilaData.localization.languages.english.strings.admin
	local (htmlText = "");
	on add (s) {
		htmlText = htmlText + s;};
	
	add("\r\t<tr>");
	
	add("\r\t<td valign='top' align='left'>");
	if flPikeButton {
		add("&nbsp;&nbsp;" + manilaSuite.sitePrefs.utility.PikeButton (pta, adrObject, sectionName))}
	else {
		add("&nbsp;")};
	add("\r\t</td>");
	
	add("\r\t\t<td valign='top' align='right'>");
	add("<input type='submit' name='restoreToDefault' value='" + manilaSuite.getString ("admin.restoreDefaultButton", pta: pta) + "'>");
	if optButtonName {
		add("&nbsp;");
		add("<input type='submit' name='" + optButtonName + "' value='&nbsp;" + manilaSuite.getString (optButtonValue, pta: pta) + "&nbsp;'>")};
	add("&nbsp;");
	add("<input type='submit' value='&nbsp;" + manilaSuite.getString ("common.submitButton", pta: pta) + "&nbsp;'>");
	add("&nbsp;&nbsp;");
	add ("\r\t\t</td>");
	
	add ("\r\t</tr>");
	
	return htmltext}