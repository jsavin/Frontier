on errorMessage (messageText, adrReplTbl=nil, flLocalised= true) {
	//manilaSuite.sitePrefs.utility.errorMessage : 04/05/14, 20:47:30 by DAB
	local (htmlText = "");
	on add (s) {
		htmlText = htmlText + s;};
	
	if flLocalised {
		if not (messageText contains ".") {
			messageText = "admin." + messageText};
		messageText=  manilaSuite.getString (messageText, adrReplTbl)};
	
	add("<p style='color:red'>");
	add(messageText);
	add("</p>");
	
	return htmltext}