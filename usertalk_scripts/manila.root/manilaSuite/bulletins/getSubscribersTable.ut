on getSubscribersTable (adrSubscribersTable, pta=nil, adrMembers=nil, cohorts={}) {
	«Changes:
		«09/15/06; 3:06:13 PM by LL
			«Initialized local variable adrUser.
		«10/15/05; 4:40:08 AM by JES
			«Add optional param, cohorts.
				«Change by DAB.
		«2000
			«1/16/00; 9:59:53 AM by DW
				«If there's a callback defined, use it to fill in the subscribers table.
			«07/16/00; 4:41:27 PM by PBS
				«If the site has a bulletins pref name, look in that subtable. In other words, the pref may be at adrMemberInfo^.bulletins.[prefName] instead of adrMemberInfo^.bulletins.
				«The idea is to allow sites that share a membership group to have separate membership prefs for bulletins.
			«?/?/00 by PBS
				«Get a table containing two subtables, HTML and plain.
					«The HTML table contains the memberKey/name pairs for HTML bulletins subscribers.
					«The plain table contains the memberKey/name pairs for plain text bulletins subscribers.
					«Names are empty when the name is empty or isn't specified in the member record.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	bundle { //If there's a callback defined, use it to fill in the subscribers table and return
		local (adrPrefs = @pta^.newsSite^.bulletins); //the bulletins sub-table of #newsSite
		if defined (adrPrefs^.getRecipientsCallback) {
			local (plainRecipients = {}, htmlRecipients = {}, item);
			adrPrefs^.getRecipientsCallback (@plainRecipients, @htmlRecipients);
			new (tableType, @adrSubscribersTable^.html);
			new (tableType, @adrSubscribersTable^.plain);
			for item in plainRecipients {
				adrSubscribersTable^.plain.[item] = ""};
			for item in htmlRecipients {
				adrSubscribersTable^.html.[item] = ""};
			return (true)}};
	
	if adrMembers == nil { //get the address of the users table if not provided
		local (adrGroup = mainResponder.members.getMembershipTable (pta^.responderAttributes.defaultMembershipGroup));
		adrMembers = @adrGroup^.users};
	
	«Make sure the HTML and plain tables exist.
	if not defined (adrSubscribersTable^.html) {
		new (tableType, @adrSubscribersTable^.html)};
	if not defined (adrSubscribersTable^.plain) {
		new (tableType, @adrSubscribersTable^.plain)};
	
	adrSubscribersTable^.adrMembers = adrMembers; //it might be useful to store this here
	
	local (adrUser, memberKey, name);
	local (flPrefsSubTable = false, subtableName);
	if defined (pta^.newsSite^.bulletinsPrefName) { //PBS 07/16/00: if using subtables, get the name of the subtable
		subtableName = string (pta^.newsSite^.bulletinsPrefName);
		subtableName = string.trimWhiteSpace (subtableName);
		if subtableName != "" {
			flPrefsSubtable = true}};
	
	local (cohortsTest); «05/10/09, 13:42:17 by DAB
	manilaSuite.accessControl.bulkTest.setup (pta, cohorts, @cohortsTest); //05/10/09, 14:13:37 by DAB
	
	for i = 1 to sizeof (adrMembers^) { //loop through the table building the subscribers table
		name = "";
		
		adrUser = @adrMembers^ [i];
		if not defined (adrUser^.bulletins) {
			continue};
		
		if not manilaSuite.accessControl.bulkTest.testOne (@cohortsTest, adrUser) { //05/10/09, 14:13:42 by DAB
			continue};
		
		memberKey = nameof (adrUser^);
		
		if defined (adrUser^.personalInfo.name) { //set name
			«1/13/00; 6:53:18 PM by DW
				«It's possible for personalInfo.name to be a table, containing a Content-Type and data. 
				«We only want the data part. 
			case typeof (adrUser^.personalInfo.name) {
				tabletype {
					name = string (adrUser^.personalInfo.name.data)};
				stringtype {
					name = adrUser^.personalInfo.name}}};
		
		try { //add this member to the appropriate table, HTML or plain
			local (adrBulletinPrefs = @adrUser^.bulletins);
			if flPrefsSubTable { //PBS 07/16/00: might be a subtable
				adrBulletinPrefs = @adrUser^.bulletins.[subtableName]};
			if not defined (adrBulletinPrefs^) {
				continue};
			if adrBulletinPrefs^.enabled {
				if adrBulletinPrefs^.inHtml {
					adrSubscribersTable^.html.[memberKey] = name}
				else {
					adrSubscribersTable^.plain.[memberKey] = name}}}};
	
	return (true)}