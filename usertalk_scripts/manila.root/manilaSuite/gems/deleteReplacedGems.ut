on deleteReplacedGems (f, adrSite) {
	//Check for old Gems with the same file name. Those Gems should be marked as deleted, as the new Gem over-writes them. Return the number of Gems marked as deleted.
		//07/02/00; 5:52:10 PM by PBS
	
	local (adrGems = manilaSuite.gems.getSiteDataAddress (adrSite));
	local (adrItem);
	local (lowerFilePath = string.lower (f));
	local (ctDeletes = 0);
	for adrItem in adrGems {
		if defined (adrItem^.flDeleted) {
			if adrItem^.flDeleted {
				continue}};
		if defined (adrItem^.f) {
			if string.lower (adrItem^.f) == lowerFilePath {
				adrItem^.flDeleted = true; //mark this Gem as deleted
				ctDeletes++}}};
	
	return (ctDeletes)}