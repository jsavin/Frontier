on preflightLimit (adrSite, adrDataTable) {
	«Changes
		«3/13/05; 6:42:20 PM by JES
			«The size of the gem is now stored in the data table for the gem. Don't re-calculate here.
		«04/14/00; 4:11:24 PM by PBS
			«Created. Check, before accepting a gem, that the folder size limit won't be reached. Return true if it's okay to post, false if the limit will be exceeded.
	
	local (currentSize = manilaSuite.gems.getCurrentSiteFolderSize (adrSite));
	local (limit = manilaSuite.gems.getSiteLimit (adrSite));
	if currentSize + adrDataTable^.sizeBytes >= limit { //will the limit be exceeded?
		return (false)};
	
	return (true)}