on postEditedGemPage (pta=nil) {
	//manilaSuite.gems.postEditedGemPage : 04/06/30, 15:23:14 by DAB
		//Post changes to a gem. Sicne Manila itself doesn't edit gems, we only see if there's
		//an override in force for this URLTable entry.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	pta^.title = manilaSuite.getString ("gems.postEditedGemPageTitle", pta: pta);
	
	bundle {
		manilaSuite.referer.checkEditGem ("gemEditinBrowser", "gemPostEditedMessage")};
	
	bundle { //see if any pre post validation is requested,
		local (adrValidator, htmltext);
		if manilaSuite.plugins.ETPoverride.getScriptAddress("gemPostEditedMessage", @adrValidator) {
			if not adrValidator^(@htmltext) { //validator saw error, so returns whatever it says (repeat form)
				return htmltext}}};
	
	local(gemNum = pta^.postargs.gemNumber);
	//Create the new gem: write to disk, store info in site, possibly create shortcut.
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	local (adrGemTable=manilaSuite.gems.getGemAddress(adrSite, gemNum));
	try { // edit the gem
		
		bundle { //call new gem callbacks, if any exist 04.06.30, 15:21:43 by DAB
			local (t);
			bundle { //build context data for callback
				new(tabletype, @t);
				t.adrSite = adrSite;
				t.adrGemTable = adrGemTable;
				t.adrMember = pta^.adrMemberInfo};
			
			manilaSuite.callbacks.changedGemCallback(@t)}}
	else {
		local (htmlText = tryError);
		htmlText = manilaSuite.unTaint (htmlText);
		pta^.title = manilaSuite.getString ("gems.itDidntWorkPageTitle", pta: pta); // 4/20/00 JES: localized
		return (htmlText)};
	
	if defined (pta^.postArgs.redirect) {
		mainResponder.redirect (pta^.postArgs.redirect)};
	
	return ("")}