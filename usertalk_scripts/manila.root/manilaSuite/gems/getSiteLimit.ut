on getSiteLimit (adrSite) {
	//Changes
		//10/11/05; 5:07:01 AM by JES
			//Change default storage limit to 100MB.
		//04/13/00; 9:15:42 PM by PBS
			//Created. Return the number of bytes a site is allowed in hard drive space for gems.
	
	bundle { //check site first
		local (adrPrefs = manilaSuite.gems.getSitePrefsAddress (adrSite));
		if defined (adrPrefs^.limit) {
			return (adrPrefs^.limit)}};
	
	if not defined (config.manila.prefs.gemsLimit) {
		config.manila.prefs.gemsLimit = 100.0 * 1024 * 1024}; //1MB is default - JES changed to 100MB
	
	return (config.manila.prefs.gemsLimit)}