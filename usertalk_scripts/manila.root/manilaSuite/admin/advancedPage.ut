	bundle { //replace the navlist with the list of items on this page
		local (i, navText = "", sep = " - ", sizeList = sizeOf (navList));
		for i = 1 to sizeList {
			local (item = navList [i]);
			local (url = "#" + string.lower (string.dropNonAlphas (item)));
			try {
				item = manilaSuite.getString ("admin." + string.innerCaseName (item) + "SectionName", pta: pta)};
			local (link = html.getLink (item, url));
			navText = navText + " " + link;
			if i != sizeList {
				navText = navText + sep}};
		htmlText = string.replaceAll (htmlText, "[navText]", navText)};
	
	return (htmlText)}