on promoteToHomePage (msgNum, adrSite=nil) {
	//Changes:
		//3/2/07; 1:29:57 PM by LL
			//Ping the Google BlogSearch server if the homepage updates. Also, ping the RCS if it's running locally.
			//Don't ping for members only or editors only sites.
		//2003 and earlier
			//7/24/03; 2:05:33 PM by DW
				//Call weblogUpdates.ping in a thread so the user doesn't have to wait for it.
			//10/09/00; 10:17:37 PM by PBS
				//Make sure indexes get updated -- pass adrSite parameter to add-category script.
			//11/9/01; 9:42:35 AM by PBS
				//Ping Weblogs.Com if the pref is set.
			//10/19/99; 3:19:16 PM by PBS
				//Make this story the home page.
					//Link it into the calendar.
					//Set alsoListedIn to [siteName]HomePages.
					//This script can be called from outside the page rendering context if adrSite is not nil.
	
	local (adrMsgTable = manilaSuite.discuss.getMessageTable (msgNum, adrSite));
	local (homePagesCategory, lowerCategoryName, adrStory);
	
	//Get home pages category
	homePagesCategory = manilaSuite.discuss.getHomePagesCategory (adrSite);
	
	//Set the alsoListedIn field for this story
	manilaSuite.discuss.addCategoryToMessage (adrMsgTable, homePagesCategory, adrSite); //PBS 10/09/00: pass adrSite parameter
	
	//Set the discuss link for the home page.
	local (adrDiscussLinks = manilaSuite.getDiscussLinksAddress (adrSite));
	adrDiscussLinks^.homePageMsgNum = msgNum;
	
	//Add the page to the calendar structure for this site.
		//It will be available at a path like: /2000/05/14/innerCaseAlphaNumericName
	bundle {
		local (postTime = adrMsgTable^.postTime);
		local (adrCal = adrSite);
		
		local (adrDay);
		adrDay = mainResponder.calendar.getDayAddress (adrCal, postTime, true);
		
		local (fname = string.dropNonAlphas (string.innerCaseName (adrMsgTable^.subject)));
		
		adrStory = @adrDay^.[fname];
		new (tableType, adrStory);
		
		local (discussRoot = manilaSuite.discuss.getRootName (adrSite));
		adrStory^.discussionRoot = discussRoot;
		adrStory^.msgNum = msgNum;
		
		if not defined (adrDay^.discussionRoot) {
			adrDay^.discussionRoot = discussRoot};
		if not defined (adrDay^.msgNum) {
			adrDay^.msgNum = msgNum}};
	
	local (flAddToChangesTable = true);
	if defined (adrSite^.["#newsSite"].flEditorsOnlyAccessToSite) { //PBS 05/12/00: don't add private sites to changes table
		if (adrSite^.["#newsSite"].flEditorsOnlyAccessToSite) {
			flAddToChangesTable = false}};
	if defined (adrSite^.["#newsSite"].flMembersOnlyAccessToSite) { //Don't add members only sites
		if (adrSite^.["#newsSite"].flMembersOnlyAccessToSite) {
			flAddToChangesTable = false}};
	if flAddToChangesTable {
		try { //ping Weblogs.Com and Google BlogSearch
			if defined (config.manila.prefs.flSendUpdateNoticesToUserLand) {
				if config.manila.prefs.flSendUpdateNoticesToUserLand {
					if (not defined (adrNewsSite^.flSendUpdateNoticesToUserLand)) or (adrNewsSite^.flSendUpdateNoticesToUserLand) {
						local (siteName = "Untitled", url);
						if defined (adrSite^.["#newsSite"].siteName) {
							siteName = string (adrSite^.["#newsSite"].siteName)};
						url = adrSite^.["#ftpSite"].url;
						thread.callscript (@weblogUpdates.ping, {siteName, url});
						
						local (flSyndicate = manilaSuite.getNewsSitePref ("flSyndicate", adrSite));
						if flSyndicate {
							local (rssLink= url + "xml/rss.xml");
							thread.callscript (@googleBlogSearch.ping, {siteName, url, url, rssLink})}}}}};
		bundle { //if RCS is running locally, ping there as well
			if defined (radioCommunityServerSuite.weblogUpdates.ping) {
				if defined (config.manila.prefs.flRcsUpdatesListsManilaSites) {
					if config.manila.prefs.flRcsUpdatesListsManilaSites {
						local (siteName = "Untitled", url);
						if defined (adrSite^.["#newsSite"].siteName) {
							siteName = string (adrSite^.["#newsSite"].siteName)};
						url = adrSite^.["#ftpSite"].url;
						radioCommunityServerSuite.weblogUpdates.ping (siteName, url)}}}}};
	
	return (adrStory)} //return the address of the story in the calendar structure