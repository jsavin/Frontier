on getSitePrefsWizardAddress (pta=nil) {
	//5/12/00; 3:47:01 PM by JES
		//Gets the address of the (localized) site prefs wizard
			//Note: The wizard and the navigator must have the same names for panels, or prefsSuite.browser won't work.
		//Changes:
			//05/29/00; 1:24:24 AM by JES
				//This script is now a wrapper for manilaSuite.getWizardAddress()
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	return (manilaSuite.getWizardAddress ("sitePrefs", @manilaData.sitePrefs.wizard, pta: pta))}