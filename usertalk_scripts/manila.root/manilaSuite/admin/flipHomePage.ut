	//local (adrsite = @testManilaWebsite)
	//local (siteName = manilaSuite.getCanonicalSiteName (adrSite))
	//local (adrMemberInfo = @testManilaWebsite.["#membershipGroup"].users.["jake@userland.com"])
	//flipHomePage (adrSite, siteName, adrMemberInfo)