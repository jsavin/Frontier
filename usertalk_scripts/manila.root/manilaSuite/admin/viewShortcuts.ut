on viewShortcuts (pta=nil) {
	«Display the shortcuts page.
		«The shortcuts page allows the managing editor to view and edit the glossary.
	«Changes:
		«2/18/05; 5:18:26 AM by JES
			«Moved the alphabetical links to more shortcut pages from below the shortcuts list to above it.
		«11/7/2004; 12:32:47 by DAB
			«Added support for link targets.
		«8/12/04; 2:54:38 AM by JES
			«Removed 200 character restriction on length of URLs for shortcuts.
		«9/23/03; 4:48:54 PM by JES
			«Content editors can create/delete shortcuts, in addition to managing editors.
		«1/25/02; 6:17:38 PM by PBS
			«Performance enhancements in the local "add" routine -- add a trailing semicolon; use parentheses to get the expression in x = x + y form (which is optimized by the kernel).
		«9/6/01; 4:00:04 PM by PBS
			«Add the alphabet links to the bottom of the list, so you can jump straight to any letter of the alphabet. This makes large shortcuts lists more usable. http://discuss.2020hindsight.org/pictures/viewer$2240
		«05/30/01; 2:27:25 PM by JES
			«Bug fix: when there are no shortcuts, the script was calling mainResponder.getString, instead of manilaSuite.getString, which resulted in an error page.
			«Bug and fix reported by Steve Hooker.
		«05/11/00; 7:14:21 PM by JES
			«merged in Brent's security fix for the client side trojan horse attack.
		«05/09/00; 10:35:30 PM by PBS
			«Check the referer to defeat the client side trojan horse.
		«05/01/00; 4:09:14 PM by JES
			«Changed getString calls to use a replacement table address instead of a lists
		«04/18/00; 4:32:36 PM by JES
			«localized
		«04/16/00; 11:36:56 AM by PBS
			«Support for Gems. Gems have a special type of shortcut.
		«10/31/99; 1:29:47 PM by PBS
			«Minor cleanups, enhanced security.
		«9/4/99; 5:23:14 PM by PBS
			«Save the gdb containing the glossary when changes are made.
	
	if pta == nil {
		pta = html.getPageTableAddress ()};
	
	local (flManagingEditor = false, flContributingEditor = false, flContentEditor = false);
	
	bundle { //find out if this person is an editor, and if so, what type
		if manilaSuite.editors.managingEditorTest (pta) { //is this the managing editor?
			flManagingEditor = true}; //the managing editor has read/write privileges
		if manilaSuite.editors.contributingEditorTest (pta) { //is this a contributing editor?
			flContributingEditor = true}; //contributing editors can view shortcuts but not change them
		if manilaSuite.editors.contentEditorTest (pta) { //is this a contributing editor?
			flContentEditor = true}; //contributing editors can view shortcuts but not change them
		
		if not flManagingEditor and not flContributingEditor and not flContentEditor { //the shortcuts page is open to editors only
			scriptError (manilaSuite.getString ("admin.cantDisplayPageNoPermission"))}}; // 4/18/00 JES: localized
	
	local (adrGlossary = pta^.glossary);
	local (htmlText = "", indentLevel = 0);
	local (flNeedNextLink = false, flNeedPrevLink = false);
	local (adrSite = pta^.adrSiteRootTable);
	local (argTable);
	new (tableType, @argTable);
	local (letterToJumpTo = "");
	
	local (maxPerPage = 25, ixStart = 1); //PBS 8/21/99: these determine how many to list on a single page
	local (ctAdded = 0);
	
	local (actionUrl = pta^.URI);
	if defined (pta^.searchArgs) and pta^.searchArgs != "" {
		actionUrl = actionUrl + "?" + pta^.searchArgs;
		actionUrl = manilaSuite.unTaint (actionUrl)}; //PBS 10/30/99: security
	
	on add (s) {
		htmlText = htmlText + (string.filledString ("\t", indentLevel) + s + "\r");};
	
	pta^.title = manilaSuite.getString ("admin.shortcutsPageTitle", pta: pta); // 4/18/00 JES: localized
	pta^.activeUrls = false; //keep it from hotting up email addresses in Urls
	pta^.autoParagraphs = false;
	
	if pta^.method == "POST" and defined (pta^.postArgs) {
		manilaSuite.referer.checkSelf (); //PBS 05/09/00: check referer to defeat client side trojan horse
		manilaSuite.unTaintPostArgs (); //PBS 10/31/99: security
		
		case pta^.postArgs.cmd {
			"add" {
				«local (name, url)
				local (name, url, linkTarget); //04/11/07, 12:30:14 by DAB
				name = string.trimWhiteSpace (pta^.postArgs.name);
				url = string.trimWhiteSpace (pta^.postArgs.url);
				linkTarget = string.trimWhiteSpace (pta^.postArgs.target); //04/11/07, 12:30:36 by DAB
				if linkTarget != "" { //04/11/07, 12:06:24 by DAB
					linkTarget = " target='" + linkTarget + "'"};
				if string.lower (url) beginswith "local:" {
					url = string.trimWhiteSpace (string.delete (url, 1, 6));
					new (tableType, @adrGlossary^.[name]);
					adrGlossary^.[name].linetext = name;
					adrGlossary^.[name].path = url}
				else {
					if defined (adrGlossary^.[name]) {
						delete (@adrGlossary^.[name])};
					«adrGlossary^.[name] = "<a href=\"" + url + "\">" + name + "</a>"
					adrGlossary^.[name] = "<a href=\"" + url + "\"" + linkTarget + ">" + name + "</a>"}}; //04/11/07, 12:06:19 by DAB
			"delete" {
				«delete items that were checked off when the button was clicked
				if defined (pta^.postArgs) {
					local (i, ct = sizeOf (pta^.postArgs), adrArg);
					for i = ct downto 1 {
						adrArg = @pta^.postArgs [i];
						if nameOf (adrArg^) beginsWith "delete" {
							local (itemName = string.delete (nameof (adrArg^), 1, sizeof ("delete")));
							itemName = base64.decode (itemName);
							try {delete (@adrGlossary^.[itemName])}}}}}};
		
		fileMenu.saveMyRoot (adrGlossary)}; //PBS 9/4/99: save the gdb containing the glossary when changes are made
	
	bundle { //introductory text
		if flManagingEditor or flContentEditor {
			add (manilaSuite.getString ("admin.shortcutsPageInstructions", pta: pta) + "<p>")} // 4/18/00 JES: localized
		else { //this is a contributing editor: read-only access
			add (manilaSuite.getString ("admin.shortcutsPageDescription", pta: pta) + "<p>")}}; // 4/18/00 JES: localized
	
	if flManagingEditor or flContentEditor { //add or replace a glossary entry
		add ("<table><tr><td valign=\"top\">"); indentLevel++;
		
		bundle { //form: Add Glossary Item
			«local (defaultUrl = "http://", defaultTitle = "")
			local (defaultUrl = "http://", defaultTitle = "", defaultTarget = ""); //04/11/07, 12:32:47 by DAB
			
			if defined (pta^.requestHeaders.referer) { //added check: Wed, 26 May 1999 21:50:54 GMT by AR
				if not (string.lower (pta^.requestHeaders.referer) beginsWith string.lower (pta^.urls^.editorialShortcuts)) {
					if defined (pta^.requestHeaders.referer) and pta^.requestHeaders.referer != "" {
						defaultUrl = pta^.requestHeaders.referer};
					if defined (pta^.pathArgs) and pta^.pathArgs != "" {
						defaultTitle = string.urlDecode (pta^.pathArgs);
						defaultTitle = string.replaceAll (defaultTitle, "\"", "&quot;")}
					else {
						defaultUrl = "http://"}}};
			
			defaultTitle = manilaSuite.unTaint (defaultTitle); //PBS 10/30/99: security
			defaultUrl = manilaSuite.unTaint (defaultUrl); //PBS 10/30/99: security
			
			add ("<form method=\"POST\" action=\"" + actionUrl + "\">"); indentLevel++;
			add ("<input type=\"hidden\" name=\"cmd\" value=\"add\">");
			add ("<b>" + manilaSuite.getString ("admin.addShortcutPrompt", pta: pta) + "</b><p>"); // 4/18/00 JES: localized
			add ("<table cellspacing=\"3\" cellpadding = \"0\">"); indentLevel++;
			add ("<tr><td>" + manilaSuite.getString ("admin.shortcutNamePrompt", pta: pta) + "&nbsp;</td>");
			add ("<td><input size=\"40\" maxlength=\"200\" name=\"name\" value=\"" + defaultTitle + "\"></td></tr>");
			add ("<tr><td>" + manilaSuite.getString ("admin.shortcutUrlPrompt", pta: pta) + "&nbsp;</td>");
			«add ("<td><input size=\"40\" maxlength=\"200\" name=\"url\" value=\"" + defaultUrl + "\"></td></tr>")
			add ("<td><input size=\"40\" name=\"url\" value=\"" + defaultUrl + "\"></td></tr>"); //JES 8/12/04: don't restrict length of URL for shortcut
			add ("<tr><td>Target:&nbsp;</td>"); //04/11/07, 12:08:06 by DAB
			add ("<td><input size=\"40\"  name=\"target\" value=\"" + defaultTarget + "\"></td></tr>"); //04/11/07, 12:04:20 by DAB
			add ("<tr><td align=\"right\" colspan=\"2\"><input type=\"submit\" value=\"" + manilaSuite.getString ("admin.addShortcutButton", pta: pta) + "\"></td></tr>");
			add ("</table>"); indentLevel--;
			add ("</form>"); indentLevel--};
		
		add ("</td><td>&nbsp;&nbsp;&nbsp;</td><td valign=\"top\">");
		add ("</td></tr></table>"); indentLevel--};
	
	bundle { //list the current glossary elements, allow the user to delete them
		local (i, adrItem, ix = 0, flRemainder = false, flCheckingForRemainder = false);
		local (flStarted = false);
		
		if defined (pta^.searchArgs) and pta^.searchArgs != "" { //try to get maxPerPage and ixStart from the search args
			
			webserver.parseArgs (pta^.searchArgs, @argTable); //parse the args into a local table
			
			if defined (argTable.m) {
				try {
					maxPerPage = number (argTable.m)}};
			
			if defined (argTable.s) {
				try {
					ixStart = number (argTable.s)}};
			
			if defined (argTable.letter) { //PBS 09/16/01: the chosen letter has preference; go to nearest match
				letterToJumpTo = string.trimWhiteSpace (string.lower (argTable.letter));
				ixStart = infinity}};
		
		add ("[thelistofshortcuts]<p>[displayingitemsxthroughy]");
		
		if flManagingEditor or flContentEditor { //it's a form if this is the managing editor
			add ("<form method=\"POST\" action=\"" + actionUrl + "\">"); indentLevel++;
			add ("<input type=\"hidden\" name=\"cmd\" value=\"delete\">")};
		
		add ("<table>"); indentLevel++;
		
		for i = 1 to sizeOf (adrGlossary^) {
			adrItem = @adrGlossary^ [i];
			
			local (s);
			local (itemType = typeOf (adrItem^));
			local (itemName = nameOf (adrItem^));
			local (flLink = false, flImage = false, flGem = false);
			
			bundle { //make sure this is actually a link or an image, not something else in the glossary table
				if itemType == stringType {
					s = string (adrItem^);
					if string.lower (s) beginsWith "<a href" {
						flLink = true};
					if string.lower (s) beginsWith "<img src" {
						flImage = true};
					if string.lower (s) beginsWith "{manilasuite.gems.includegem (" {
						flGem = true}};
				if not flLink and not flImage and not flGem { //must be link, image, or gem
					continue}};
			
			ix++;
			
			if flCheckingForRemainder { //don't display, just break: this means we need a Next link
				flNeedNextLink = true;
				break};
			
			if letterToJumpTo != "" { //PBS 09/06/01: support for alphabet links
				if not flStarted {
					if sizeOf (itemName) > 0 {
						local (lowerItemName = string.lower (itemName));
						local (ch = lowerItemName [1]);
						if char (ch) >= char (letterToJumpTo) {
							ixStart = ix}};
					if i == sizeOf (adrGlossary^) { //display at least one shortcut
						ixStart = ix}}};
			if ix >= ixStart { //do we display this one?
				flStarted = true;
				add ("<tr>"); indentLevel++;
				
				bundle { //add checkbox for deleting
					add ("<td>"); indentLevel++;
					
					if flManagingEditor or flContentEditor { //add the checkbox for deleting this entry
						add ("<input type=\"checkbox\" name=\"delete" + base64.encode (itemName, 0) + "\" value=\"0\">")}
					else { //just add a non-breaking space for contributing editors
						add ("&nbsp;")};
					
					add ("</td>"); indentLevel--};
				
				on addType (typeString) {
					add ("<td>&nbsp;&nbsp;&nbsp;&nbsp;</td>");
					add ("<td>" + typeString + "</td>")};
				
				case itemType {
					stringType {
						if flImage {
							local (url);
							url = string.nthField (s, '"', 2);
							add ("<td>" + html.getLink (itemName, url) + "</td>");
							addType (manilaSuite.getString ("common.picture", pta: pta))}; // 4/18/00 JES: localized
						if flLink {
							add ("<td>" + s + "</td>");
							addType (manilaSuite.getString ("common.page", pta: pta))} // 4/18/00 JES: localized
						else {
							if flGem {
								try {
									local (num = manilaSuite.gems.getNumFromGlossaryMacro (s));
									local (adrGemTable = manilaSuite.gems.getGemAddress (adrSite, num));
									local (link = manilaSuite.gems.linkToGem (adrSite, adrGemTable));
									add ("<td>" + link + "</td>");
									addType (manilaSuite.getString ("common.gem", pta: pta))}}}}; // 4/18/00 JES: localized
					tableType {
						add ("<td>" + html.refGlossary (nameOf (adrItem^)) + "</td>");
						addType (manilaSuite.getString ("common.page", pta: pta))}}; // 4/18/00 JES: localized
				
				add ("</tr>"); indentLevel--;
				
				ctAdded++} //increment the number that are actually displayed on this page
			else { //don't display, it's too early
				flNeedPrevLink = true};
			
			if ix == ixStart + (maxPerPage - 1) {
				flCheckingForRemainder = true}};
		
		if flManagingEditor or flContentEditor { //add the Delete button
			add ("<tr><td colspan=\"2\" align=\"left\"><br><input type=\"submit\" value=\"" + manilaSuite.getString ("common.deleteButton", pta: pta) + "\"></td></tr>")}; // 4/18/00 JES: localized
		
		add ("</table>"); indentLevel--;
		
		if flManagingEditor or flContentEditor { //close the form
			add ("</form>"); indentLevel--}};
	
	local (alphaLinks = "");
	bundle { //PBS 09/06/01: add alphabet links
		if flNeedPrevLink or flNeedNextLink { //skip if there is just one page
			
			local (i);
			local (letterToBold = "");
			if defined (argTable.letter) {
				try {letterToBold = argTable.letter [1]}};
			on addAlphaLink (ch) {
				if ch == letterToBold { //bolden current letter
					alphaLinks = alphaLinks + "<b>" + ch + "</b>" + " "}
				else {
					local (url = pta^.URI + "?letter=" + ch);
					alphaLinks = alphaLinks + "<a href=\"" + url + "\">" + ch + "</a> "}};
			for i = 'A' to 'Z' {
				addAlphaLink (char (i))}}};
	
	if flNeedPrevLink or flNeedNextLink { //buildNext and Previous Links
		local (pathArgsLink = "");
		if defined (pta^.pathArgs) and pta^.pathArgs != "" {
			pathArgsLink = "$" + pta^.pathArgs};
		
		local (previousStart = ixStart - maxPerPage);
		
		if flNeedPrevLink {
			
			if previousStart < 1 {
				previousStart = 1};
			
			add ("<a href=\"" + pta^.URI + pathArgsLink + "?s=" + previousStart + "&m=" + maxPerPage +"\">Previous</a>")}
		else {
			add (manilaSuite.getString ("common.previous", pta: pta))}; // 4/18/00 JES: localized
		
		add (" | ");
		
		if flNeedNextLink {
			add ("<a href=\"" + pta^.URI + pathArgsLink + "?s=" + (ixStart + maxPerPage) + "&m=" + maxPerPage +"\">Next</a>")}
		else {
			add (manilaSuite.getString ("common.next", pta: pta))}; // 4/18/00 JES: localized
		
		local (replacementTable); new (tableType, @replacementTable); // 05/01/00 JES: use replacement table instead of a list
		replacementTable.start = ixStart;
		replacementTable.end = ((ixStart - 1) + ctAdded);
		local (s = manilaSuite.getString ("admin.displayingShortcutsNThroughN2", @replacementTable, pta: pta)); // 4/18/00 JES: localized
		s = s + "\r<p><font size=\"-1\">More: " + alphaLinks + "</font>";
		htmlText = string.replaceAll (htmlText, "[displayingitemsxthroughy]", s + "<p>");
		}
	else {
		htmlText = string.replaceAll (htmlText, "[displayingitemsxthroughy]", "")};
	
	if ctAdded < 1 {
		htmlText = string.replaceAll (htmlText, "[thelistofshortcuts]", manilaSuite.getString ("admin.thereAreNoShortcuts", pta: pta))} // 4/18/00 JES: localized
	else {
		htmlText = string.replaceAll (htmlText, "[thelistofshortcuts]", "<b>" + manilaSuite.getString ("admin.shortcutListHeader", pta: pta) + "</b>")}; // 4/18/00 JES: localized
	htmlText = manilaSuite.unTaint (htmlText); //ensure that no macros are run
	
	return (htmlText)}