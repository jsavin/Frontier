on changeSiteUrl (oldUrl, newUrl, adrSite) {
	«Recalculate all URLs used by this site since we've just switched the base URL.
		«Changes:
			«10/30/99; 5:01:28 PM by PBS
				«Untaint URLs, they may have come from anywhere.
			«12/17/99; 1:13:56 AM by PBS
				«Use string.replaceAll rather than searchEngine.replaceAll to avoid infinite loops, now that string.replaceAll can do case-inensitive replacements.
				«Delete the stories and pictures caches from the discuss group.
				«Fixed the cowskull link and rssInfo tables.
			«10/31/00; 7:28:47 PM by JES
				«Fix urls in the ["#discussionGroup"].prefs table.
	
	on replace (s) {
		s = string.replaceAll (s, oldUrl, newUrl, false); //PBS 12/17/99: use string.replaceAll
		return (s)};
	
	on doTable (adrTable) {
		local (i);
		for i = 1 to sizeOf (adrTable^) {
			if typeOf (adrTable^ [i]) == stringType {
				adrTable^ [i] = replace (adrTable^ [i])}}};
	
	oldUrl = manilaSuite.unTaint (oldUrl);
	newUrl = manilaSuite.unTaint (newUrl);
	
	doTable (@adrSite^.["#urls"]);
	doTable (@adrSite^.["#glossary"]);
	
	adrSite^.["#ftpSite"].url = replace (adrSite^.["#ftpSite"].url);
	
	«Discussion group -- 10/31/00 JES: fix DG urls
	local (adrDg = @adrSite^.["#discussionGroup"]);
	if defined (adrDg^) {
		adrDg^.prefs.msgReaderUrl = adrSite^.["#urls"].discussMsgReader;
		adrDg^.prefs.url = adrSite^.["#urls"].storyReader};
	
	«Navigator.
	local (s = string (adrSite^.["#navigator"].outline));
	s = replace (s);
	wp.newTextObject (s, @adrSite^.["#navigator"].outline);
	
	«Template.
	s = string (adrSite^.["#template"]);
	s = replace (s);
	wp.newTextObject (s, @adrSite^.["#template"]);
	
	«Cowskull link.
	if defined (adrSite^.["#newsSite"].cowSkullImage) {
		adrSite^.["#newsSite"].cowSkullImage = replace (adrSite^.["#newsSite"].cowSkullImage)};
	
	local (adrDiscuss = @[system.temp.mainResponder.discussRootFile].[adrSite^.["#newsSite"].discussionRoot]);
	if typeOf (adrDiscuss^) == stringType or typeOf (adrDiscuss^) == addressType {
		adrDiscuss = adrDiscuss^};
	
	doTable (@adrDiscuss^.prefs);
	doTable (@adrDiscuss^.messages);
	if defined (adrSite^.["#newsSite"].rssInfo) { //PBS 12/17/99
		doTable (@adrSite^.["#newsSite"].rssInfo)};
	
	bundle { //PBS 12/17/99: delete the story and picture list caches
		local (adrMessageTable);
		for adrMessageTable in @adrDiscuss^.messages {
			local (adrItem);
			local (i);
			for i = sizeOf (adrMessageTable^) downTo 1 {
				adrItem = @adrMessageTable^ [i];
				local (itemName = nameOf (adrItem^));
				itemName = string.lower (itemName);
				if itemName endsWith "picturescache" or itemName endsWith "storiescache" {
					delete (adrItem)}}}};
	
	try { //JES 6/9/02: Clear the site list cache
		delete (@system.temp.mainResponder.siteListCache)};
	
	return (true)}