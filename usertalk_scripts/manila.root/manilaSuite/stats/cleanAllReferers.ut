on cleanAllReferers () {
	//5/16/07; 11:32:06 AM by LL
		//Created. Cleans the referers tables for all sites on the server.
	local (adrTable = @config.manila.stats.referers);
	if defined (adrTable^) {
		local (i);
		local (lastMonth = date.prevMonth (clock.now ()));
		for i = sizeOf (adrTable^) downTo 1 {
			local (adr = @adrTable^ [i]);
			local (siteName = nameOf (adr^));
			local (adrSite = config.manila.sites.[siteName]);
			manilaSuite.stats.cleanReferersTable (adrSite)}}}