on addReferer (pta=nil) {
	//Changes:
		//11/22/06; 3:03:50 PM by LL
			//Support for new server-level preference to disable referer logging. The site-level preference can only be used to turn off logging for a site when the server level preference is enabled for referers logging.
		//12/13/05; 4:26:03 AM by JES
			//Skip referers on port 5336 and on this server's admin port (most likely also 5336).
		//5/8/03; 1:25:51 PM by JES
			//Call callbacks in config.manila.callbacks.addReferer. Each script in this table gets an opportunity to block the referer logging.
			//Callbacks take one parameter, pta -- the page table address.
			//If any callback script returns false, the referer is blocked.
		//7/20/02; 1:41:50 AM by JES
			//If a newsSite pref named flLogReferers is defined and false, then don't log the referers at all. Added to accomodate scaling issues with very high-traffic sites.
		//11/02/00; 2:46:11 PM by WM
			//Add a referer to the referers table.
	if pta == nil {
		pta = html.getPageTableAddress ()};
	if not defined (pta^.requestHeaders.referer) {
		return (true)};
	local (referer = pta^.requestHeaders.referer);
	if string.trimWhiteSpace (referer) == "" {
		return (true)};
	local (siteUrl = pta^.ftpSite^.url);
	if string.lower (referer) beginsWith string.lower (siteUrl) { //ignore in-site referers
		return (true)};
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	if not defined (config.manila.prefs.flLogReferersEnabled) {
		config.manila.prefs.flLogReferersEnabled = true};
	local (flLogReferers = config.manila.prefs.flLogReferersEnabled);
	if flLogReferers { //LL 11/22/06: Allow for the definition of a server and site-level pref which prevents referer logging
		flLogReferers = manilaSuite.getNewsSitePref ("flLogReferers", adrSite, true)};
	if not flLogReferers {
		return (true)};
	if referer contains ":5336/" {
		return (true)};
	if defined (user.inetd.config.http2) {
		if referer contains ":" + user.inetd.config.http2.port + "/" {
			return (true)}};
	bundle { //call callbacks at config.manila.callbacks.addReferer
		if defined (config.manila.callbacks.addReferer) {
			local (adr);
			for adr in @config.manila.callbacks.addReferer {
				try {
					while typeOf (adr^) == addressType {
						adr = adr^};
					if not adr^ (pta) { //if any callback returns false, reject the referer
						return (true)}}}}};
	local (adrTable = manilaSuite.stats.getReferersTableAddress (adrSite));
	local (adrReferer = @adrTable^.[referer]);
	if not defined (adrReferer^) {
		new (tableType, adrReferer)};
	adrReferer^.[clock.now ()] = true;
	return (true)}