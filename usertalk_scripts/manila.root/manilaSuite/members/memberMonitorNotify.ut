on memberMonitorNotify (adrSite, adrGroup, adrMember, language) {
	//Changes
		//11/2/05; 4:39:11 AM by JES
			//Call through manilaSuite.members.getMemberEmail to get members' email addresses.
		//10/11/05, 16:03:02 by DAB
			//An example membership group callback that handles any and all of the callback types, by emailing to notify email address.
	local (recipients);
	local (sender);
	bundle { //get the recipients list
		local (adrNewsSite = @adrSite^.["#newsSite"]);
		if not defined (adrNewsSite^.notifyList) {
			return (true)};
		recipients = adrNewsSite^.notifyList;
		if typeOf (recipients) != listType {
			recipients = manilaSuite.admin.stringToList (recipients)};
		
		sender = "webmaster@userland.com";
		if defined (adrNewsSite^.notifySender) {
			sender = adrNewsSite^.notifySender}};
	
	local (emailMessage = "");
	on add (s) {
		emailMessage = emailMessage + s;};
	
	local (sitename = manilaSuite.getShortSitename (nameOf (adrSite^)));
	add (date.netStandardString (clock.now ()) + "\t" + sitename + "\t" + nameOf (adrMember^) + "\t" + membershipOperation);
	
	local (emailSubject = "Manila Membership " + sitename + " " + membershipOperation);
	
	bundle { //send the email
		local (adrUsers = @AdrGroup^.users);
		local (oneRecipient, adrUser);
		for oneRecipient in recipients {
			adrUser = @adrUser^.[oneRecipient];
			//bundle //old code
				//case true //05/10/13, 16:39:22 by DAB
					//not defined (adrUser^)
						//continue
					//not defined (adrUser^.personalinfo) 
					//not defined (adrUser^.personalinfo.email) 
					//adrUser^.personalinfo.email != ""
						//
				//else
					//oneRecipient = adrUser^.personalinfo.email
			try {
				oneRecipient = manilaSuite.members.getMemberEmail (adrUser);
				manilaSuite.sendMail (oneRecipient, emailSubject, emailMessage, sender)}}};
	
	return (true)}