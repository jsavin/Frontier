on addMultipleMembers (memberlist, adrsite=nil, membertype="member", flSendWelcomeEmail=true, flBulletins=nil, flHtmlBulletins=false) {
	//Changes
		//2/22/06; 7:12:19 PM by JES
			//New optional params, flBulletins and flHtmlBulletins. If flBulletins is non-nil, we set up bulletin prefs for the new members accordingly.
		//3/28/05; 2:17:02 PM by JES
			//Call new manilaSuite.passwords.generate to get passwords for new members. Call callbacks when members are added.
		//5/19/04; 12:46:54 AM by JES
			//Simplified (but lengthened) the auto-generated passwords to make them easier to copy/paste from confirmation emails into the login page.
		//9/10/02; 9:35:07 PM by JES
			//Created. Take a list, or a whitespace-delimited string of email addresses and create new members in a Manila site.
				//If called with adrsite supplied, then this script can be called outside of the website framework context.
				//membertype can be one of the following: (case-insensitive)
					//member
					//contributingEditor
					//contentEditor
					//managingEditor
	
	local (pwdchars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890");
	local (ctchars = sizeOf (pwdchars));
	
	if adrsite == nil { //get the site from the pagetable
		adrsite = manilaSuite.getSiteAddress ()};
	local (adrnewssite = manilaSuite.getNewsSiteAddress (adrsite));
	local (membershipGroupName = adrsite^.["#prefs"].defaultMembershipGroup);
	local (sitename = manilaSuite.getCanonicalSiteName (adrsite));
	
	on sureBulletinPrefs (adrMember) {
		if not defined (adrMember^.bulletins) {
			new (tabletype, @adrMember^.bulletins)};
		local (adrBulletinPrefs = @adrMember^.bulletins.[sitename]);
		if not defined (adrBulletinPrefs^) {
			new (tabletype, adrBulletinPrefs)};
		return (adrBulletinPrefs)};
	
	on editorsListToString (adr) {
		local (s = string (adr^));
		if s beginsWith "{" {
			s = string.delete (s, 1, 1)}; //pop off left curly brace
		if s endsWith "}" {
			s = string.delete (s, sizeof (s), 1)};
		s = string.replaceall (s, "\"", "");
		s = string.replaceall (s, " ", "");
		return (s)};
	on stringToMemberList (s) {
		s = string.replaceAll (s, "\r", " ");
		s = string.replaceAll (s, "\r\n", " ");
		s = string.replaceAll (s, "\t", " ");
		s = string.replaceAll (s, ",", " ");
		while s contains "  " {
			s = string.replaceAll (s, "  ", " ")};
		local (ct = string.countFields (s, " "), i, l = {});
		for i = 1 to ct {
			l = l + string.nthField (s, " ", i)};
		return (l)};
	//on getRandomPassword (n)    //commented out 05/03/25, 11:23:06 by DAB
		//local (s = "")
		//local (i)
		//for i = 1 to n
			//s = s + pwdchars[random (1, ctchars)]
		//return (s)
	
	if typeOf (memberlist) == stringType {
		memberlist = stringToMemberlist (memberlist)};
	
	on getMemberTable (memberKey) {
		return (mainResponder.members.getMemberTable (membershipGroupName, memberKey))};
	
	local (email);
	for email in memberlist { //create the new members
		local (adrMember = getMemberTable (email));
		//local (password = getRandomPassword (8))
		local (password = manilaSuite.passwords.generate()); //05/03/25, 11:22:56 by DAB
		if not defined (adrMember^) { //create the member table
			new (tableType, adrMember);
			adrMember^.password = binary (password);
			if typeOf (flBulletins) != unknownType { //either true or false, not nil
				local (adrBulletinPrefs = sureBulletinPrefs (adrMember));
				adrBulletinPrefs^.enabled = flBulletins;
				adrBulletinPrefs^.inhtml = flHtmlBulletins};
			
			manilaSuite.members.callbacks(adrSite, adrMember, "signup"); //05/03/24, 22:55:47 by DAB
			};
		case string.lower (membertype) { //add as a managing-, contributing- or content- editor.
			"contributingeditor" {
				local (theList = editorsListToString (@adrnewssite^.contributingEditors));
				if not (string.lower (theList) contains string.lower (email)) {
					theList = theList + "," + email;
					manilaSuite.admin.setContributingEditorList (theList, adrnewssite)}};
			"contenteditor" { //PBS 12/10/01: support for Content Editors
				local (theList = editorsListToString (@adrnewssite^.contentEditors));
				if not (string.lower (theList) contains string.lower (email)) {
					theList = theList + "," + email;
					manilaSuite.admin.setContentEditorList (theList, adrnewssite)}};
			"managingeditor" {
				local (theList = editorsListToString (@adrnewssite^.sysopMail));
				if not (string.lower (theList) contains string.lower (email)) {
					theList = theList + "," + email;
					manilaSuite.admin.setManagingEditorList (theList, adrnewssite, false)}}};
		manilaSuite.members.sendMemberSignupMail (adrMember, adrsite)};
	
	return (true)};
//bundle //test code
	//addMultipleMembers ("foo@braincase.net bar@braincase.net baz@braincase.net", @testManilaWebsite, "managingEditor")