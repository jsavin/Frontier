on changePasswordPage () {
	«Changes
		«9/3/02; 2:07:29 AM by JES
			«Created. Render a page that a logged in member can use to change their password.
				«If the member is not logged in, present a message saying so, with a link to the login page.
	local (pta = html.getPageTableAddress ());
	local (adrSite = manilasuite.getManilaSiteAddress(pta)); «05/04/02, 17:02:58 by DAB
	pta^.title = manilaSuite.getString ("members.changePasswordPageTitle");
	local (htmltext);
	on add (s) {
		htmltext = htmltext + (s + "\r");};
	if pta^.method == "POST" {
		manilaSuite.referer.checkSelf ();
		local (adrmember = pta^.adrMemberInfo);
		local (originalPassword = string (adrmember^.password));
		local (adrargs = @pta^.postArgs);
		if defined (adrargs^.changePassword) {
			bundle { //handle bogus input
				if originalPassword != adrargs^.originalPassword {
					return (manilaSuite.getString ("members.changePasswordIncorrectError"))};
				if adrargs^.newPassword != adrargs^.repeatNewPassword {
					return (manilaSuite.getString ("members.changePasswordDontMatchError"))};
				if sizeOf (adrargs^.newPassword) == 0 {
					return (manilaSuite.getString ("members.changePasswordNoNewPassError"))}};
			adrmember^.password = binary (adrargs^.newPassword);
			manilaSuite.members.callbacks(adrSite, adrMember, "modify");
			bundle { //reset the cookie on the client
				local (groupName = pta^.defaultMembershipGroup);
				local (adrMembers = mainResponder.members.getMembershipTable (groupName));
				local (flExpireAtEndOfSession);
				bundle { //PBS 09/12/01: get pref for cookie expiration
					if not defined (pta^.newsSite^.flCookiesExpireAtEndOfSession) {
						pta^.newsSite^.flCookiesExpireAtEndOfSession = false};
					flExpireAtEndOfSession = pta^.newsSite^.flCookiesExpireAtEndOfSession};
				mainResponder.members.setCookie (nameOf (adrmember^), adrargs^.newPassword, adrMembers, pta, groupName, flExpireAtEndOfSession)}; //PBS 09/12/01: send flExpireAtEndOfSession parameter
			return (manilaSuite.getString ("members.changePasswordSuccess"))}};
	if defined (pta^.adrMemberInfo) { //logged in member -- show the form
		add ("<p>" + manilaSuite.getString ("members.changePasswordExplanation") + "</p>");
		add ("<form action=\"" + pta^.url + "\" method=\"POST\">");
		add ("<table cellpadding=\"10\" cellspacing=\"0\" border=\"0\">");
		add ("<tr><td>" + manilaSuite.getString ("members.passwordPrompt") + "</td><td><input type=\"password\" name=\"originalPassword\"></td></tr>");
		add ("<tr><td>" + manilaSuite.getString ("members.newPasswordPrompt") + "</td><td><input type=\"password\" name=\"newPassword\"></td></tr>");
		add ("<tr><td>" + manilaSuite.getString ("members.repeatPasswordPrompt") + "</td><td><input type=\"password\" name=\"repeatNewPassword\"></td></tr>");
		add ("<tr><td></td><td><br><input type=\"submit\" name=\"changePassword\" value=\"" + manilaSuite.getString ("members.changePasswordButton") + "\"></td></tr>");
		add ("</table>");
		add ("</form>")}
	else { //not logged in -- show an error, with a link to the login page
		local (t); new (tableType, @t);
		t.loginUrl = manilaSuite.getUrl ("memberLogOn", pta) + "?http://" + pta^.host + pta^.uri;
		return (manilaSuite.getString ("members.changePasswordNotLoggedIn", @t))};
	return (htmltext)}