on stripMarkup (s) {
	«Changes
		«11/14/2000; 12:44:13 PM by DW
			«Created. Removes all HTML <tags> from the string.
		«05/1/01; 3:19:00 AM by JES
			«Fixed infinite looping bug, which would occur for any string which contains a > character before a < character.
	local (ixopen, ixclose);
	loop {
		ixopen = string.patternmatch ("<", s);
		if ixopen == 0 {
			break};
		ixclose = string.patternmatch (">", s);
		if ixopen > ixclose {
			s = string.delete (s, ixclose, 1);
			continue};
		if ixclose == 0 {
			break};
		s = string.delete (s, ixopen, ixclose - ixopen + 1)};
	return (s)};
«bundle //test code
	«dialog.alert (stripMarkup ("O<u>h</u> <b>the</b> buzzing of the bees and the sycamore <i>trees.</i>"))