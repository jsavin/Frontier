on checkSelf () {
	«Changes
		«7/14/05; 3:30:50 PM by JES
			«Add support for referer checking pref.
		«08/10/02; 7:31:20 PM by JES
			«Added support for hierarchy pages.
		«05/09/00; 6:40:41 PM by PBS
			«Created. The referer must be the page itself. In this case, checking searchArgs and pathArgs isn't necessary.
	
	if not manilaSuite.referer.checkIsEnabled () {
		return (true)};
	manilaSuite.referer.mustNotBeEmpty ();
	local (pta = html.getPageTableAddress ());
	local (lowerReferer = string.lower (pta^.requestHeaders.referer));
	local (lowerExpectedReferer = string.lower (pta^.url));
	if lowerExpectedReferer endsWith "/#objectnotfoundhandler" {
		local (urlparts = string.urlSplit (lowerExpectedReferer));
		lowerExpectedReferer = urlparts[1] + urlparts[2] + string.lower (pta^.uri)};
	if lowerExpectedReferer endsWith "/default" {
		lowerExpectedReferer = string.popSuffix (lowerExpectedReferer, '/') + "/"};
	if not (lowerReferer beginsWith lowerExpectedReferer) {
		scriptError (manilaSuite.getString ("admin.refererDoesntMatchForEditError"))};
	return (true)}