on storyListPage () {
	«05/22/00; 5:31:38 PM by JES -- the localized version of the list Stories page
		«Changes:
			«9/12/01; 2:44:57 PM by PBS
				«The story list may have access privileges. Call the bottleneck script at manilaSuite.editors.editorialPageAccess.
	
	local (htmltext, indentlevel = 0, pta = html.getPageTableAddress ());
	
	pta^.title = manilaSuite.getString ("discuss.listStoriesPageTitle");
	
	on add (s) {
		htmltext = htmltext + s + "\r"};
	
	bundle { //PBS 09/12/01: check access privileges for stories page
		if not (manilaSuite.editors.editorialPageAccess ("stories", pta)) {
			return ("Can't display the Stories page because you don't have sufficient access privileges.")}};
	
	if pta^.method == "POST" { //04/05/27, 17:05:51 by DAB
		local (adrSite = manilaSuite.getManilaSiteAddress(pta));
		local (storiesCategory = manilaSuite.discuss.getStoriesCategory (adrSite));
		manilaSuite.referer.checkSelf (); //PBS 05/09/00: check referer to defeat client side trojan horse
		manilaSuite.unTaintPostArgs (); //PBS 10/30/99
		case true {
			defined(pta^.postargs.promoteStory) {
				if defined (pta^.postArgs.promoteStory) {
					local (msgNum = string.popLeading (pta^.postArgs.msgNumStory, '0'));
					local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
					manilaSuite.discuss.addCategoryToMessage (adrMsgTable, pta^.newsSite^.storiesListedIn, adrSite)}}; //10/09/00: pass adrSite parameter
			defined(pta^.postargs.demoteStory) {
				local (ix);
				for ix = 1 to sizeOf (pta^.postArgs) {
					local (oneArg = nameOf (pta^.postArgs [ix]));
					local (msgNum);
					oneArg = string.lower (oneArg);
					if oneArg beginsWith "delete" { //delete from the stories list
						msgNum = string.popLeading (oneArg - "delete", '0');
						local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
						manilaSuite.discuss.removeCategoryFromMessage (adrMsgTable, storiesCategory, adrSite)}}}; //PBS 10/09/00: update indexes
			defined(pta^.postargs.deleteMessage) {
				delete(@pta^.postargs.deleteMessage); //04.08.21, 12:01:00 by DAB
				local (ix);
				for ix = 1 to sizeOf (pta^.postArgs) {
					local (oneArg = nameOf (pta^.postArgs [ix]));
					local (msgNum);
					oneArg = string.lower (oneArg);
					if oneArg beginsWith "delete" { //delete from the stories list
						msgNum = string.popLeading (oneArg - "delete", '0');
						mainResponder.discuss.deleteMessage (msgNum);
						local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
						manilaSuite.discuss.removeCategoryFromMessage (adrMsgTable, storiesCategory, adrSite)}}}}}; //PBS 10/09/00: update indexes
	
	local (replacementTable); //04/05/28, 07:51:44 by DAB
	bundle { //replacement table 04/05/28, 07:51:37 by DAB
		new (tableType, @replacementTable);
		replacementTable.editorialPrefs= string.popSuffix(pta^.urls^.editorialPrefs, "$")};
	add (manilaSuite.getString ("discuss.listStoriesPageDescription", @replacementTable, pta:pta) + "\r");
	
	«add (manilaSuite.storyList ("stories", flUseSiteStructurePaths:true)) //PBS 09/06/01: use site structure paths, when available, when linking to stories
	add ("<form method='POST' action='" + manilaSuite.getUrl ("editorialStories", pta) + "'>");
	add (manilaSuite.storyList("stories", true,  20, flIncludeCheckBox:true,  boxPrefix:"delete", flUseSiteStructurePaths:true)); //04/05/27, 16:35:45 by DAB
	if pta^.flEditor { //add to pictures list form 04/05/28, 07:58:39 by DAB //add to stories list form
		«add ("<b>" + manilaSuite.getString ("admin.addDGMessageToStoriesList") + "</b><p>") // 4/17/00 JES: localized
		add (manilaSuite.getString ("admin.addDGMessageNumber")); // 4/17/00 JES: localized
		add ("<input name='msgNumStory' value='' size='10'>");
		add ("<input type='submit' name = 'promoteStory' value='" + manilaSuite.getString ("admin.addDGMessageToStoriesList") + "'>")}; // 4/17/00 JES: localized
	add ("</form>"); //04/05/27, 16:54:42 by DAB
	
	return htmltext}