on cleanObjectForExport (adrObject) {
	//Sunday, November 21, 1999 at 12:06:52 AM by AR
		//Make sure the object can be encoded as an XML-RPC response.
	on cleanObject (adrObject) {
		case typeOf (adrObject^) {
			binaryType;
			booleanType;
			dateType;
			doubleType;
			longType;
			stringType;
			shortType {
				return (true)};
			listType {
				local (ix, item, theList);
				for ix = 1 to sizeOf (adrObject^) {
					theList = adrObject^[ix];
					cleanObject (@theList);
					adrObject^[ix] = theList}};
			tableType {
				local (adrItem);
				for adrItem in adrObject {
					cleanObject (adrItem)}}}
		else {
			table.assign (adrObject, string (adrObject^))};
		return (true)};
	return (cleanObject (adrObject))}