on managingEditorOrContentEditorCheck (sitename, username, password, beginningErrorString) {
	//Make sure this person is a managing editor or a content editor. If not, generate the appropriate script error.
		//beginningErrorString should be a string like "Can't do xxx because " -- this script fills in the reason, then calls scriptError.
		//This way we avoid generic error messages such as "Can't complete this operation because..." which are no good.
		//11/26/01; 10:54:02 AM by PBS
	
	if not (manilaSuite.rpcUtils.isMember (siteName, username)) {
		scriptError (beginningErrorString + "\"" + username + "\" is not a member.")};
	
	if not (manilaSuite.rpcUtils.authenticateMember (siteName, username, password)) {
		scriptError (beginningErrorString + "\"" + username + "\" has not supplied a valid password.")};
	
	if not (manilaSuite.rpcUtils.isManagingEditor (siteName, username)) {
		if not (manilaSuite.rpcUtils.isContentEditor (siteName, username)) {
			scriptError (beginningErrorString + "\"" + username + "\" is not a managing editor or content editor of this site.")}};
	
	return (true)}