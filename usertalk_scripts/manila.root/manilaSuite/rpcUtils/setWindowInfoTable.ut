on setWindowInfoTable (windowInfoTable, itemName, adrSite) {
	//Save the window info table for later.
		//02/06/00; 9:04:05 PM by PBS
	//Changes:
		//Use table.assign to set the windowInfoTable, since it might not always be a table. Promotes interop with other environments.
	
	local (adrNewsSite = @adrSite^.["#newsSite"]);
	local (adrPikePrefs = @adrNewsSite^.pike);
	if not defined (adrPikePrefs^) {
		new (tableType, adrPikePrefs)};
	local (adrWindowInfoPrefs = @adrPikePrefs^.windowInfoTables);
	if not defined (adrWindowInfoPrefs^) {
		new (tableType, adrWindowInfoPrefs)};
	local (adrWindowInfoForThisItem = @adrWindowInfoPrefs^.[itemName]);
	if not (defined (adrWindowInfoForThisItem^)) {
		new (tableType, adrWindowInfoForThisItem)};
	table.assign (adrWindowInfoForThisItem, windowInfoTable);
	
	return (true)}