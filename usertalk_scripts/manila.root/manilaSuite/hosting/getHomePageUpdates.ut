on getHomePageUpdates (min, max) {
	//Return a structure containing info about home page updates that took place between min and max times.
		//It's a table with subtables for each site.
		//Each subtable contains:
			//time
			//URL
		//05/06/00; 8:26:02 PM by PBS
	//Changes:
		//04/21/01; 11:41:26 PM by JES
			//Rewritten to get update data from the flat table at config.manila.updatedHomePages.
	
	local (t);
	new (tableType, @t);
	local (ct);
	if defined (config.manila.updatedHomePages) {
		local (adrTable = @config.manila.updatedHomePages);
		for i = sizeOf (adrTable^) downTo 1 {
			local (adrItem);
			adrItem = @adrTable^ [i];
			if adrItem^.timeModified > max {
				continue};
			if adrItem^.timeModified < min {
				break};
			local (siteName = adrItem^.siteName);
			if string.trimWhiteSpace (siteName) == "" {
				siteName = "Untitled"};
			t.[siteName] = adrItem^;
			delete (@t.[siteName].siteName)}};
	
	return (t)}