on displayLastUpdatedHomePages (n) {
	«Display the n last updated home pages on this server. This is called from a macro.
		«05/11/00; 6:02:44 PM by PBS
		«Changes:
		«1/25/02; 6:24:23 PM by PBS
			«Performance enhancements in the local "add" routine -- add a trailing semicolon; use parentheses to get the expression in x = x + y form (which is optimized by the kernel).
	
	local (htmlText = "", indentLevel = 0);
	on add (s) {
		htmlText = htmlText + (string.filledString ("\t", indentLevel) + s + "\r");};
	
	add ("<table cellspacing=\"0\" cellpadding=\"1\" border=\"0\">"); indentLevel++;
	local (t = manilaSuite.hosting.getLastNChangedHomePages (n));
	local (adrItem);
	for adrItem in @t {
		add ("<tr>"); indentLevel++;
		add ("<td><a href=\"" + adrItem^.url + "\">" + adrItem^.sitename + "</a></td>");
		add ("<td align=\"right\" valign=\"top\">&nbsp;&nbsp;<font size=\"-1\">" + date.timeString (adrItem^.timeModified) + "</font></td>");
		add ("</tr>"); indentLevel--};
	add ("</table>"); indentLevel--;
	
	return (manilaSuite.unTaint (htmlText))}