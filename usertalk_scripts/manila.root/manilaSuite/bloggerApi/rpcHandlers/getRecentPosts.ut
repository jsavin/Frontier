on getRecentPosts (appkey, blogid, username, password, numberOfPosts) {
	//8/24/01; 12:30:09 AM by JES
		//Return an array of structs (array of tables) with information about the last n posts.
			//http://groups.yahoo.com/group/bloggerDev/message/225
	//Changes:
		//8/28/01; 2:03:21 AM by JES
			//Make sure username corresponds to a member of the site.
	local (sitename = manilaSuite.rpcHandlers.getSiteName (blogid));
	manilaSuite.rpcUtils.memberCheck (siteName, username, password, "Can't get recent posts because ");
	local (adrsite = manilaSuite.rpcUtils.getSiteAddress (sitename));
	local (messages = manilaSuite.news.getLastNMessageNumbers (numberOfPosts, adrSite:adrsite));
	local (adrdiscuss = manilaSuite.rpcUtils.getDiscussAddress (sitename));
	
	on getPost (adrmsg) {
		local (t); new (tableType, @t);
		t.userid = adrmsg^.member;
		t.dateCreated = adrmsg^.postTime;
		t.content = adrmsg^.newsItem.description;
		t.postid = siteName + "#" + adrmsg^.msgnum;
		return (t)};
	
	local (msgnum, returnArray = {});
	for msgnum in messages {
		local (adrmsg = mainResponder.discuss.getMessageTable (msgnum, adrRoot:adrdiscuss));
		returnArray = returnArray + {getPost (adrmsg)}};
	
	return (returnArray)};
//bundle //test code
	//local (array = getRecentPosts ("xxx", "http://127.0.0.1/", "jake@userland.com", user.prefs.manilaPassword, 10))
	//local (post1 = array[1])
	//dialog.alert (post1.postid)