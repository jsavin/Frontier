on createNewsDayTemplate (adrSiteInfo) {
	«Create the default news day template.
		«12/9/99; 11:59:49 PM by PBS
	
	local (adrSite = adrSiteInfo^.adrSite);
	local (adrNewsSite = @adrSite^.["#newsSite"]);
	local (adrTemplate = @adrNewsSite^.newsDayTemplate);
	
	local (defaultText = "<b>{newsPostTime}</b>\r<p>\r{newsContent}\r<p>");
	wp.newTextObject (defaultText, adrTemplate);
	
	return (true)}