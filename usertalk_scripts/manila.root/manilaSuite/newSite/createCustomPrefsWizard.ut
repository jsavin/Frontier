on createCustomPrefsWizard (adrSiteInfo) {
	«Create the custom prefs wizard for this site. Get the default version from manilaData.prefs.wizard.
		«11/1/99; 12:26:18 PM by PBS
		«Changes:
			«07/13/00; 9:27:11 PM by PBS
				«The address of the bulletins pref is now bulletins.[siteName] instead of just bulletins. This is to allow multiple sites to share a membership group, but still have independent bulletins subscription lists.
			«10/31/00; 5:57:00 PM by JES
				«Create the prefs in the language specified by adrSiteInfo^.manilaLanguageTableAddress, instead of English.
	
	local (adrSite = adrSiteInfo^.adrSite);
	local (adrNewsSite = @adrSite^.["#newsSite"]);
	local (adrWizard = @adrNewsSite^.prefsWizard);
	local (adrDefaultWizard);
	bundle { // 10/31/00 JES: get the default wizard address
		if defined (adrSiteInfo^.manilaLanguageTableAddress) {
			adrSiteInfo^.language = nameOf (adrSiteInfo^.manilaLanguageTableAddress)}
		else {
			if defined (config.mainResponder.globals.language) {
				adrSiteInfo^.language = config.mainResponder.globals.language}
			else {
				if defined (user.prefs.language) {
					adrSiteInfo^.language = user.prefs.language}
				else {
					adrSiteInfo^.language = "English"}}};
		adrDefaultWizard = manilaSuite.getWizardAddress ("prefs", @manilaData.prefs.wizard, adrSiteInfo)};
	
	if not defined (adrWizard^) {
		new (tableType, adrWizard)};
	
	bundle { //copy the outline, but first change the address of the bulletins pref
		local (s = string (adrDefaultWizard^.outline));
		local (subtableName, adrSite);
		adrSite = adrSiteInfo^.adrSite;
		if defined (adrSiteInfo^.shortSiteName) { //new site
			subtableName = adrSiteInfo^.shortSiteName;
			adrSite^.["#newsSite"].bulletinsPrefName = subtableName}
		else {
			if defined (adrSite^.["#newsSite"].bulletinsPrefName) { //existing site -- doing a restore-to-default
				subtableName = adrSite^.["#newsSite"].bulletinsPrefName}};
		if subtableName != nil { //if an old site, and we're doing restore-to-default, don't use the subtable name
			s = string.replace (s, "bulletins.enabled", "bulletins." + subtableName + ".enabled");
			s = string.replace (s, "bulletins.inHtml", "bulletins." + subtableName + ".inHtml")};
		op.newOutlineObject (s, @adrWizard^.outline);
		};«adrWizard^.outline = manilaData.prefs.wizard.outline
	«adrWizard^.structure = manilaData.prefs.wizard.structure //PBS 07/13/00: since we're altering the outline programatically, the default structure isn't wanted. Compile it instead.
	xml.compile (string (adrWizard^.outline), @adrWizard^.structure); //PBS 07/13/00: compile the structure
	adrWizard^.prefs = adrDefaultWizard^.prefs;
	
	if not defined (adrWizard^.callbacks) { //PBS 12/14/01: set up callbacks glue
		adrWizard^.callbacks = manilaData.prefs.wizard.callbacksGlue};
	
	return (true)}