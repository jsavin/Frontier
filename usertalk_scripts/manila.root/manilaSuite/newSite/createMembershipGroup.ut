on createMembershipGroup (adrSiteInfo) {
	«Changes
		«9/30/03; 12:26:42 PM by JES
			«Store passwords as binary values in the membership group.
		«10/21/99; 12:48:49 PM by PBS
			«Created: Create the membership group for a site, if it doesn't already exist.
	
	local (groupName = adrSiteInfo^.membershipGroupName);
	local (adrGroup);
	local (adrSite = adrSiteInfo^.adrSite); //save typing
	
	try { //check to see if it's already defined
		adrGroup = mainResponder.members.getMembershipTable (groupName);
		«It exists. Don't create it.
		adrSiteInfo^.adrMembershipGroup = adrGroup;
		return (true)};
	
	adrGroup = @adrSiteInfo^.adrSite^.["#membershipGroup"];
	adrSiteInfo^.adrMembershipGroup = adrGroup;
	
	adrGroup^.cookieName = adrSiteInfo^.siteName;
	adrGroup^.mailReturnAddress = adrSiteInfo^.sysopEmail;
	
	bundle { //create the sysop as a user
		local (adrMember);
		adrMember = @adrGroup^.users.[adrSiteInfo^.sysopEmail];
		new (tableType, adrMember);
		adrMember^.password = binary (adrSiteInfo^.sysopPassword);
		new (tableType, @adrMember^.personalInfo);
		adrMember^.personalInfo.name = adrSiteInfo^.sysopName};
	
	bundle { //add the address of the group to members.root
		[system.temp.mainResponder.membersRootFile].[groupName] = adrGroup};
	
	return (true)}