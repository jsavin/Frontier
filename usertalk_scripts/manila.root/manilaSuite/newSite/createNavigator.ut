on createNavigator (adrSiteInfo) {
	//Create the navigator, the left-side links.
		//10/21/99; 2:17:40 PM by PBS
	
	local (adrNavigator = @adrSiteInfo^.adrSite^.["#navigator"]);
	local (adrXml = @adrNavigator^.outline);
	local (adrXmlCompiled = @adrNavigator^.structure);
	
	if defined (adrXmlCompiled^) {
		delete (adrXmlCompiled)};
	
	local (xmlText = "<navigator>\r");
	
	on addItem (name, pageName) {
		xmlText = xmlText + "   <item name=\"" + name + "\" pagename=\"" + pageName + "\"/>\r"};
	
	local (baseUrl = adrSiteInfo^.adrSite^.["#ftpSite"].url);
	local (urlParts = string.urlSplit (baseUrl));
	local (baseRelativeUrl);
	baseRelativeUrl = "/" + urlParts [3];
	
	addItem ("Home", baseRelativeUrl); //home page
	//addItem ("FAQ", baseRelativeUrl + "faq") //FAQ page
	//addItem ("Feedback", baseRelativeUrl + "feedback") //Feedback Page
	
	xmlText = xmlText + "   </navigator>";
	
	wp.newTextObject (xmlText, adrXml); //replace the navigator wp-text object
	
	xml.compile (xmlText, adrXmlCompiled); //compile the navigator
	
	return (true)}