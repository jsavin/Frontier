on createSiteCalendar (adrSiteInfo) {
	//Changes:
		//4/13/06; 12:44:07 AM by JES
			//Don't overwrite any tables or sub-items which already exist.
		//01/29/00; 12:31:07 PM by PBS
			//Create the home page in the calendar for the day before the site was created, so the Flip Home Page button shows up when the site is created.
		//10/21/99; 3:11:05 PM by PBS
			//Created: Create the calendar in the site shell. At this point, it has just one item, the current home page.
	
	local (adrSite = adrSiteInfo^.adrSite);
	local (discussRoot = adrSite^.["#prefs"].discussionRoot);
	local (homePageMsgNum = adrSite^.["#newsSite"].discussLinks.homePageMsgNum);
	
	local (day, month, year, hour, minute, second);
	date.get (date.yesterday (clock.now ()), @day, @month, @year, @hour, @minute, @second);
	
	if not defined (adrSite^.[year]) {
		new (tableType, @adrSite^.[year])};
	local (monthName = string.padWithZeros (month, 2));
	if not defined (adrSite^.[year].[monthName]) {
		new (tableType, @adrSite^.[year].[monthName])};
	local (dayName = string.padWithZeros (day, 2));
	if not defined (adrSite^.[year].[monthName].[dayName]) {
		new (tableType, @adrSite^.[year].[monthName].[dayName])};
	local (adrDay = @adrSite^.[year].[monthName].[dayName]);
	if not defined (adrDay^) {
		adrDay^.discussionRoot = discussRoot;
		adrDay^.msgNum = homePageMsgNum};
	
	return (true)}