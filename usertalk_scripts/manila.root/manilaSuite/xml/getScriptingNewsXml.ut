on getScriptingNewsXml () {
	//Build a scriptingNews syndication file.
		//Changes:
			//12/10/06; 2:09:10 PM by LL
				//Removed channel-level <webMaster> and <managingEditor> elements because they include email addresses which could be mined by spammers.
			//2002 and earlier
				//10/24/02; 12:05:28 PM by JES
					//Implement ETag support.
				//1/25/02; 6:32:22 PM by PBS
					//Performance enhancements in the local "add" routine -- add a trailing semicolon; use parentheses to get the expression in x = x + y form (which is optimized by the kernel).
				//12/26/01; 9:38:47 PM by PBS
					//When building the links and lines parallel lists, make sure, before adding to the lists, that the added items are non-empty. This ensures that the lists are indeed parallel, and you don't get a situation where one is longer than the other.
				//12/13/01; 5:19:15 PM by PBS
					//Fixed case-sensitivity issues.
				//02/27/01; 9:10:29 PM by JES
					//Fixed a bug where the <postTime> header always specified May 24, 2000.
				//11/08/00; 11:24:11 AM by PBS
					//Fixed a bug in picking up the membership group name.
				//11/01/00; 12:21:44 PM by PBS
					//Properly handle links with attributes -- for example, if you're using the internalLink rule as on Scripting News, you get links with title attributes.
				//10/29/00; 9:49:54 PM by JES
					//Fixed bug where the copyright message was always "Copyright 1007-[year] UserLand Software, Inc."
				//05/01/00; 5:18:34 PM by PBS
					//Support for news items. Each news item is stored in a separate dg message.
				//03/27/00; 10:04:53 PM by PBS
					//Two new patterns to items break on: \r\r and <br><br>\r -- both are needed for Pike support.
				//12/28/99; 2:35:57 PM by PBS
					//Problems with shortcuts and macros fixed -- the links weren't being extracted properly, and unencoded angle brackets were showing up in the XML file.
				//12/13/99; 10:28:59 PM by PBS
					//Get the site URL from the #ftpSite table. This is the the canonical location in a given site for this piece of data. Side effect: this fixes a syndication bug for ETP sites -- the URLs in their #rssInfo tables are sometimes wrong.
	
	local (pta = html.getPageTableAddress ());
	local (adrSite = manilaSuite.getManilaSiteAddress (pta));
	
	pta^.responseHeaders.["Content-Type"] = "text/xml";
	pta^.autoParagraphs = false;
	pta^.clayCompatibility = false;
	pta^.activeUrls = false;
	wp.newTextObject ("{bodytext}", @pta^.template);
	
	on error (errorMessage) {
		return ("<?xml version=\"1.0\"?>\r<error>" + errorMessage + "</error>\r")};
	
	local (flSyndicate = manilaSuite.getNewsSitePref ("flSyndicate", default:true, flCreate:true));
	if not flSyndicate {
		return (error ("This site does not support syndication."))};
	
	try { //build the XML response
		on getXmlText (adr) {
			local (xmlText = "", indent = 0);
			on add (s) {
				xmlText = xmlText + (string.filledString ("\t", indent) + s + "\r\n");};
			on encodeWithAmpersands (s) {
				s = string.replaceAll (s, "&", "&amp;");
				s = string.replaceAll (s, "<", "&lt;");
				s = string.replaceAll (s, ">", "&gt;");
				s = string.replaceAll (s, "{", "&#123;");
				s = string.replaceAll (s, "}", "&#125;");
				return (s)};
			on extractLinks (s, adrLinks, adrLines) {
				local (links = {}, lines = {}, pat = "<a href=\"", ix, leftHalf);
				s = html.processMacros (s, true, pta);
				loop {
					ix = string.patternMatch (pat, string.lower (s)); //PBS 12/13/01: string.lower, case sensitivity fix
					if ix == 0 {
						break};
					leftHalf = string.mid (s, 1, ix - 1);
					s = string.delete (s, 1, ix + sizeOf (pat) - 1);
					ix = string.patternMatch ("\"", s); //the end of the url
					url = string.mid (s, 1, ix - 1);
					s = string.delete (s, 1, ix);
					ix = string.patternMatch (">", s); //PBS 11/1/00: find end of opening a tag
					s = string.delete (s, 1, ix);
					if s [1] == ">" {
						s = string.delete (s, 1, 1)};
					ix = string.patternMatch ("</a>", string.lower (s)); //PBS 12/13/01: string.lower, case sensitivity fix
					lineText = string.mid (s, 1, ix - 1);
					s = s - "</a>";
					s = s - "</A>"; //PBS 12/13/01: case sensitivity fix; it may have been capitalized
					s = leftHalf + s;
					if url != "" and lineText != "" { //PBS 12/26/01: both need to be non-empty
						links = links + url;
						lines = lines + lineText}};
				adrLinks^ = links;
				adrLines^ = lines;
				return (s)};
			on chewOneBit (s) {
				if s != "" { //skip blank lines
					local (links, lines, i); //parallel lists
					s = extractLinks (s, @links, @lines);
					add ("<item>"); indent++;
					add ("<text>" + encodeWithAmpersands (s) + "</text>");
					for i = 1 to sizeOf (links) {
						add ("<link>"); indent++;
						add ("<url>" + encodeWithAmpersands (links [i]) + "</url>");
						add ("<linetext>" + encodeWithAmpersands (lines [i]) + "</linetext>");
						add ("</link>"); indent--};
					add ("</item>"); indent--}};
			on outlineToXML (adrOutline) {
				local (oldTarget = target.set (adrOutline));
				local (oldCursor = op.getcursor ());
				op.firstSummit ();
				op.fullExpand ();
				on getLineText () { //get the text of the cursor and all its subheads
					local (lineText = op.getLineText ());
					local (s = "");
					s = s + lineText;
					if op.go (right, 1) {
						loop {
							s = s + " " + getLineText (); //recurse
							if not op.go (down, 1) {
								break}};
						op.go (left, 1)};
					s = string.popTrailing (s, ' ');
					return (s)};
				loop {
					local (s = getLineText ());
					chewOneBit (s);
					if not op.go (down, 1) {
						break}};
				op.setCursor (oldCursor);
				target.set (oldTarget)};
			on stringToXML (s) {
				s = string.replaceAll (s, "\r\n", "\r");
				local (ix, lineString);
				while sizeOf (s) > 0 {
					local (sizePattern);
					on tryPattern (pattern) { //PBS 03/27/00: routine for looking for a pattern
						sizePattern = sizeOf (pattern);
						ix = string.patternMatch (pattern, s);
						return (ix > 0)};
					//if not (tryPattern ("\r\n\r\n"))
					if not (tryPattern ("\r\r")) {
						tryPattern ("<br><br>\r")};
					if ix == 0 {
						lineString = s;
						s = ""};
					if ix > 0 {
						lineString = string.mid (s, 1, ix - 1);
						s = string.delete (s, 1, ix + (sizePattern - 1))};
					chewOneBit (lineString)}};
			on addHeader () {
				add ("<?xml version=\"1.0\"?>");
				add ("<scriptingNews>"); indent++;
				bundle { //add the <header> info
					local (firstYear, copyrightOwner);
					bundle { // get the first year in the calendar, and the copyrightOwner
						local (adrData = mainResponder.discuss.openRoot (pta));
						local (adrCal = @adrData^.calendar);
						firstYear = date.year (mainResponder.calendar.getFirstDay (adrCal));
						
						//if defined (pta^.newsSite^.rssInfo.userLandExtensions.copyrightOwner)
							//copyrightOwner = pta^.newsSite^.rssInfo.userLandExtensions.copyrightOwner
						//else // base copyright info on site info
							//local (numEditors = 1, sysopMail)
							//if typeOf (pta^.newsSite^.sysopMail) == listType
								//numEditors = sizeOf (pta^.newsSite^.sysopMail)
								//sysopMail = pta^.newsSite^.sysopMail[1]
							//else
								//sysopMail = pta^.newsSite^.sysopMail
							//if numEditors == 1 // copyright owner is the managing editor
								//copyrightOwner = mainResponder.members.getMemberName (pta^.defaultMembershipGroup, sysopMail)
							//else // copyright owner is based on the site name
								//copyrightOwner = pta^.newsSite^.siteName
								//copyrightOwner = string.replaceAll (copyrightOwner, "&", "&amp;")
								//copyrightOwner = string.replaceAll (copyrightOwner, "<", "&lt;")
								//copyrightOwner = string.replaceAll (copyrightOwner, ">", "&gt;")};
					add ("<header>"); indent++;
					local (s = "Copyright " + firstYear);
					local (day, month, year, hour, minute, second);
					date.get (clock.now (), @day, @month, @year, @hour, @minute, @second);
					if year > firstYear {
						s = s + "-" + year};
					//add ("<copyright>" + s + " " + copyrightOwner + "</copyright>")
					add ("<scriptingNewsVersion>2.0b1</scriptingNewsVersion>");
					local (pubDate);
					bundle { //derive the publication date from posttime
						local (day, month, year, hour, minute, second);
						date.get (pta^.posttime, @day, @month, @year, @hour, @minute, @second);
						pubDate = date.set (day, month, year, 0, 0, 0)};
					add ("<pubDate>" + date.netStandardString (pubDate) + "</pubDate>");
					//add ("<lastBuildDate>" + date.netStandardString (clock.now ()) + "</lastBuildDate>")
					add ("<lastBuildDate>" + date.netStandardString (pta^.postTime) + "</lastBuildDate>");
					add ("<docs>" + "http://my.userland.com/stories/storyReader$11" + "</docs>");
					add ("<channelDescription>" + pta^.rssInfo^.channelDescription + "</channelDescription>");
					//add ("<channelLink>" + pta^.rssInfo^.channelLink + "</channelLink>")
					add ("<channelLink>" + pta^.ftpSite^.url + "</channelLink>"); //PBS 12/13/99: use URL of site for channel link
					add ("<channelTitle>" + pta^.rssInfo^.channelTitle + "</channelTitle>");
					try { //image is optional
						//add ("<imageLink>" + pta^.rssInfo^.imageLink + "</imageLink>")
						add ("<imageLink>" + pta^.ftpSite^.url + "</imageLink>"); //PBS 12/13/99: use URL of site for image link
						add ("<imageTitle>" + pta^.rssInfo^.imageTitle + "</imageTitle>");
						add ("<imageUrl>" + pta^.rssInfo^.imageUrl + "</imageUrl>");
						add ("<imageHeight>" + pta^.rssInfo^.userLandExtensions.imageHeight + "</imageHeight>");
						add ("<imageWidth>" + pta^.rssInfo^.userLandExtensions.imageWidth + "</imageWidth>");
						add ("<imageCaption>" + pta^.rssInfo^.userLandExtensions.imageCaption + "</imageCaption>")};
					//add ("<managingEditor>" + pta^.rssInfo^.userLandExtensions.managingEditor + "</managingEditor>")
					//add ("<webmaster>" + pta^.rssInfo^.userLandExtensions.webmaster + "</webmaster>")
					add ("<language>" + pta^.rssInfo^.userLandExtensions.language + "</language>");
					if defined (pta^.rssInfo^.userLandExtensions.skipHours) { //skipHours is optional
						local (item);
						add ("<skipHours>"); indent++;
						for item in pta^.rssInfo^.userLandExtensions.skipHours {
							add ("<hour>" + item + "</hour>")};
						add ("</skipHours>"); indent--};
					if defined (pta^.rssInfo^.userLandExtensions.skipDays) { //skipHours is optional
						add ("<skipDays>"); indent++;
						for item in pta^.rssInfo^.userLandExtensions.skipDays {
							add ("<day>" + item + "</day>")};
						add ("</skipDays>"); indent--};
					add ("</header>"); indent--}};
			on newsItemsToXml () {
				//Concatenate the news items, then call stringToXml.
				local (n = manilaSuite.news.getItemsPerPagePref (adrSite));
				local (msgList = manilaSuite.news.getLastNMessageNumbers (n));
				local (s = "");
				local (msgNum);
				for msgNum in msgList {
					local (adrMsgTable = mainResponder.discuss.getMessageTable (msgNum));
					local (title = adrMsgTable^.subject);
					local (xmlTable = manilaSuite.news.xmlToTable (string (adrMsgTable^.body)));
					local (url = xmlTable.url);
					local (description = xmlTable.description);
					local (body = html.getLink (title, url) + ". " + description);
					s = s + body + "\r\r"};
				s = manilaSuite.unTaint (s);
				stringToXml (s)};
			if manilaSuite.news.newsItemsEnabled (adrSite) {
				try { //02/27/2001 JES: set pta^.postTime
					local (msgNumList = manilaSuite.news.getLastNMessageNumbers (1));
					local (adrLastMsg = mainResponder.discuss.getMessageTable (msgNumList[1]));
					pta^.postTime = adrLastMsg^.lastUpdate};
				addHeader ();
				newsItemsToXml ()}
			else {
				case typeOf (adr^) {
					outlineType {
						addHeader ();
						outlineToXML (adr)};
					tableType {
						local (adrMsg = mainResponder.news.getMessageTable (adr^.discussionRoot, adr^.msgNum));
						pta^.postTime = adrMsg^.lastUpdate;
						addHeader ();
						case typeOf (adrMsg^.body) {
							outlineType {
								outlineToXML (@adrMsg^.body)}}
						else {
							stringToXML (string (adrMsg^.body))}}}
				else {
					addHeader ();
					stringToXML (string (adr^))}};
			add ("</scriptingNews>"); indent--;
			return (xmlText)};
		
		bundle { //ETag and Last-Modified support
			local (etag = "");
			if manilaSuite.news.newsItemsEnabled (adrSite) {
				local (msgNumList = manilaSuite.news.getLastNMessageNumbers (1));
				local (adrLastMsg = mainResponder.discuss.getMessageTable (msgNumList[1]));
				etag = "e" + abs (number (adrLastMsg^.lastUpdate));
				pta^.responseHeaders.["Last-Modified"] = date.netStandardString (adrLastMsg^.lastUpdate)}
			else {
				local (homePageMsgNum = pta^.newsSite^.discussLinks.homePageMsgNum);
				local (adrMsgTable = mainResponder.discuss.getMessageTable (homePageMsgNum, pta));
				etag = "e" + abs (number (adrMsgTable^.lastUpdate));
				pta^.responseHeaders.["Last-Modified"] = date.netStandardString (adrMsgTable^.lastUpdate)};
			if sizeOf (etag) > 0 {
				pta^.responseHeaders.["ETag"] = "\"" + etag + "\"";
				if defined (pta^.requestHeaders.["If-None-Match"] ) {
					local (ifNoneMatch = pta^.requestHeaders.["If-None-Match"] );
					if etag == ifNoneMatch { //304 Not Modified
						pta^.code = 304;
						pta^.responseHeaders.["Content-Length"] = 0;
						delete (@pta^.responseHeaders.["Content-Type"]);
						return ("")}}}};
		
		local (adr);
		
		if defined (pta^.adrChannelText) {
			adr = pta^.adrChannelText}
		else {
			local (adrSite = manilaSuite.getSiteAddress (pta));
			adr = mainResponder.calendar.getMostRecentAddress (adrSite)};
		local (xmlText = getXmlText (adr));
		
		//PBS 12/28/99: turn off macros and glossary lookups -- otherwise a second round of processing would happen.
		pta^.processMacros = false;
		pta^.expandGlossaryItems = false;
		
		return (xmlText)}
	else {
		return (manilaSuite.unTaint (error (tryError)))}}