on getRssPrefsAddress () {
	«Get the address of the #rssInfo table.
		«It may be in a top-level #rssInfo table or at #newsSite.rssInfo.
		«If it doesn't exist, create it.
		«10/27/99; 10:04:23 PM by PBS
	
	local (pta = html.getPageTableAddress ());
	
	if defined (pta^.rssInfo) {
		return (pta^.rssInfo)};
	
	if defined (pta^.newsSite^.rssInfo) {
		return (@pta^.newsSite^.rssInfo)};
	
	local (adrPrefs = @pta^.newsSite^.rssInfo);
	
	«Copy in the default rssInfo table from the new site template.
	adrPrefs^ = manilaData.newSiteTemplate.["#newsSite"].rssInfo;
	
	«Call the manilaSuite.newSite.createRssInfo script to initialize the table.
	local (siteInfo);
	new (tableType, @siteInfo);
	siteInfo.adrSite = pta^.adrSiteRootTable;
	siteInfo.sysopEmail = manilaSuite.editors.getOneManagingEditor ();
	manilaSuite.members.getMemberName (siteInfo.sysopEmail, @siteInfo.sysopName);
	manilaSuite.newSite.createRssInfo (@siteInfo);
	
	return (adrPrefs)}