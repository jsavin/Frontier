on objectNotFoundHandler (pta=nil) {
	//If this is the right page, [themeName].fttb, then return the theme.
		//If not, just redirect to the right page, because we're nice, why display an error.
		//06/05/00; 7:19:19 PM by PBS
		//10/27/00; 2:16:43 AM by JES -- cribbed from manilaSuite.themes.objectNotFoundHandler
	
	if pta == nil {
		pta = parentOf (code)}; //not in website framework context. If in website framework context, supply pta parameter.
	local (adrNewsSite, adrSite);
	adrNewsSite = pta^.responderAttributes.newsSite;
	adrSite = parentOf (adrNewsSite^);
	local (flCloneable = false);
	if defined (adrNewsSite^.discussTheme.flCloneable) {
		if adrNewsSite^.discussTheme.flCloneable {
			local (themeName = adrNewsSite^.discussTheme.name);
			themeName = string.dropNonAlphas (string.innerCaseName (themeName));
			local (fname = string.nthField (pta^.path, '/', string.countFields (pta^.path, '/')));
			if string.lower (fname) == string.lower (themeName) + ".fttb" {
				local (s = manilaSuite.discussThemes.downloadPage (adrSite));
				return (s)}
			else {
				scriptError ("!redirect " + themeName + ".fttb")}}};
	
	scriptError (manilaSuite.getString ("themes.siteNotCloneableError", pta: pta))}