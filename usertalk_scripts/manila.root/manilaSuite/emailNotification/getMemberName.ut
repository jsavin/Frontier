on getMemberName (adrMember) {
	//Return a formatted string containing the member's name and email address. Return just the email address if the name is not present. Return either "Bull Mancuso (bull@mancuso.com)" or "bull@mancuso.com."
		//04/04/00; 10:58:07 PM by PBS
	
	local (memberKey = nameOf (adrMember^));
	local (name);
	
	if defined (adrMember^.personalInfo.name) and string.trimWhiteSpace (adrMember^.personalInfo.name) != "" {
		name = adrMember^.personalInfo.name + " (" + memberKey + ")"}
	else {
		name = memberKey};
	
	return (name)}