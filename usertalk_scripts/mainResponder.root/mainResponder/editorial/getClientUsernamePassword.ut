on getClientUsernamePassword (discussRoot) {
	
	local (pta = html.getPageTableAddress ());
	local (adrdiscuss = mainResponder.editorial.getDiscussTableAddress (discussRoot));
	local (adrmembers = mainResponder.members.getMembershipTable (adrdiscuss^.editorialprefs.membershipgroup));
	
	local (adrcookies = @pta^.requestHeaders.cookies);
	if not defined (adrcookies^) {
		scripterror ("Can't parse cookie because no cookie was send with the request headers.")};
	
	local (myCookieName = adrmembers^.cookieName);
	local (innerCaseCookieName = string.innerCaseName (myCookieName));
	if defined (adrcookies^.[innerCaseCookieName]) { //we prefer the innerCased name
		myCookieName = innerCaseCookieName}
	else {
		if not defined (adrcookies^.[myCookieName]) {
			scripterror ("Can't parse cookie because the specified cookie was not send with the request headers.")}};
	local (s = string.urlDecode (adrcookies^.[myCookieName]));
	local (username = string.nthField (s, "\t", 1));
	local (password = string.nthField (s, "\t", 2));
	
	return ({username, password})}