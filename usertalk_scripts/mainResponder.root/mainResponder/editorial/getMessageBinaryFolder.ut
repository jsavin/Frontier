on getMessageBinaryFolder (discussRoot, msgnum) {
	local (adrdiscuss = mainResponder.editorial.getDiscussTableAddress (discussRoot));
	local (adrmsg = mainResponder.editorial.getMessageTable (discussRoot, msgnum));
	local (membergroup = adrdiscuss^.editorialprefs.membershipgroup);
	//local (url = adrdiscuss^.editorialprefs.binaryServerFolder)
	local (url = adrdiscuss^.prefs.binaryServerFolder);
	local (pc = file.getPathChar ());
	on add (s) {
		url = url + s + pc};
	add (membergroup);
	add (adrmsg^.member);
	add (discussRoot);
	add (msgnum);
	return (url)}