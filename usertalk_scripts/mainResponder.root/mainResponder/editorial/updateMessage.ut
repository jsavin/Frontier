on updateMessage (msgNum, discussRoot, userName, password, body, subject) {
	
	if not mainResponder.editorial.authenticateMember (username, password, discussRoot) {
		scriptError ("Can't update this document because " + userName + " does not have editorial privileges.")};
	
	local (adrmsg = mainResponder.editorial.getMessageTable (discussRoot, msgnum));
	if string.lower (adrmsg^.member) != string.lower (userName) {
		scriptError ("Can't update this document because " + userName + " does not have editorial privileges.")};
	
	table.assign (@adrmsg^.body, mainResponder.neuterText (body, flNeuterMacros:true, flNeuterTags:true));
	table.assign (@adrmsg^.subject, mainResponder.neuterText (subject, flNeuterMacros:true, flNeuterTags:true));
	adrmsg^.lastupdate = clock.now ();
	
	filemenu.saveMyRoot (adrmsg);
	
	return (true)}