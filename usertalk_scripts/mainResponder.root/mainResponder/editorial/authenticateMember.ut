on authenticateMember (username, password, discussRoot) {
	«Determine whether the user has access to the DG
	local (adrdiscuss = mainResponder.editorial.getDiscussTableAddress (discussRoot));
	local (membergroup = adrdiscuss^.editorialprefs.membershipgroup);
	try {
		mainResponder.members.getMemberTableWithPassword (membergroup, username, password)}
	else {
		return (false)};
	return (true)}