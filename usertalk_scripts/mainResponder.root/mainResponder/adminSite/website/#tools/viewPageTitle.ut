on viewPageTitle (flAlwaysViewTitle=false) {
	«Changes
		«9/26/05; 6:00:34 PM by JES
			«If pta^.headTitle is defined, return it instead of pta^.title. Optional parameter, flAlwaysViewTitle.
	local (pta = html.getpagetableaddress (), flTitleOnPage = true);
	if defined (pta^.flTitleOnPage) {
		flTitleOnPage = pta^.flTitleOnPage};
	if flTitleOnPage or flAlwaysViewTitle {
		if defined (pta^.headTitle) {
			return (pta^.headTitle)};
		return (pta^.title)}
	else {
		return ("")}}