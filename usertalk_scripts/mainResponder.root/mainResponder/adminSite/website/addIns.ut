on addIns () {
	//Changes
		//9/27/05; 1:45:56 AM by JES
			//Use the name of the entry in config.mainResponder.controlPanel.wizards for the page name, instead of the outline (when using radio.prefs.browser style outlines).
		//9/27/05; 1:09:20 AM by JES
			//Add support for radio.prefs.browser-style outlines as control panel add-ins. Change URL scheme to use pathArgs instead of searchArgs for links to add-ins.
		//02/09/16, 12:42:35 by DAB
			//Created. Support conrol panel add-ins as extra menu in admin website.
	local (pta = html.getPageTableAddress ());
	pta^.title = "Add-ins";
	local (bgcolor1 = pta^.trbg1, bgcolor2 = pta^.trbg2, ctitems);
	
	local (htmltext = "", indentlevel = 0);
	on add (s) {
		htmltext = htmltext + (string.filledString ("\t", indentlevel) + s + "\r\n");};
	on addRow (itemname, itemvalue, linktext="", linkurl="") {
		local (widthstring = "");
		if ctitems == 0 {
			widthstring = " width=\"200\""};
		if (ctitems++ % 2) == 0 {
			bgcolor = bgcolor1}
		else {
			bgcolor = bgcolor2};
		add ("<tr bgcolor=\"" + bgcolor + "\">"); indentlevel++;
		add ("<td valign=\"top\" style=\"padding-right: 15px;\"" + widthstring + ">" + itemname + "</td>");
		add ("<td valign=\"top\">" + itemvalue + "</td>");
		if sizeOf (linktext) > 0 {
			local (link = linktext);
			if sizeOf (linkurl) > 0 {
				link = html.getlink (linktext, linkurl)};
			add ("<td valign=\"top\" align=\"right\">" + link + "&nbsp;&nbsp;</td>")}
		else {
			add ("<td></td>")};
		add ("</tr>"); indentlevel--};
	on addHeader (s) {
		add ("<h4>" + s + "</h4>");
		add ("<table cellpadding=\"3\" cellspacing=\"0\" border=\"0\" width=\"100%\">"); indentlevel++;
		ctitems = 0}; //reset the bgcolor
	on addFooter () {
		add ("</table>"); indentlevel--};
	
	local (adrWizard);
	local (command = "view", message = "");
	//if defined (pta^.searchArgTable.command)
		//command = pta^.searchArgTable.command
	if defined (pta^.pathArgs) {
		command = pta^.pathArgs};
	if defined (pta^.postArgs.command) {
		command = pta^.postArgs.command};
	case command { //handle admin commands
		"view" {
			if sizeof (config.mainresponder.controlPanel.wizards) > 0 {
				addHeader ("The following Add-ins are installed on this server:");
				for adrWizard in @config.mainresponder.controlPanel.wizards {
					//while typeOf (adrWizard^) == addressType //de-reference, possibly
						//adrWizard = adrWizard^
					//addRow (html.getLink (nameOf (adrWizard^), "addIns"  + "?command=" + nameOf (adrWizard^)), "")
					addRow (html.getLink (nameOf (adrWizard^), "addIns"  + "$" + nameOf (adrWizard^)), "")};
				on addFooter () {
					add ("</table>"); indentlevel--}}
			else {
				add ("There are no add-ins on this server. Add-ins are configured in config.root, in config.mainresponder.controlPanel.wizards.")}};
		"" { //list add-ins if none is specified
			return (mainResponder.adminSite.prefs.addins ())}}
	else { //run an add-in
		webserver.util.setCookie (pta, "wizard", command);
		
		adrWizard = @config.mainresponder.controlPanel.wizards.[command];
		while typeOf (adrWizard^) == addressType { //de-reference, possibly
			adrWizard = adrWizard^};
		pta^.wizard = adrWizard;
		
		bundle { //set up a dummy navigator so afterCompile callbacks don't overwrite the real navigator
			local (dummyNavigator);
			new (tableType, @dummyNavigator);
			dummyNavigator.outline = "";
			pta^.navigator = @dummyNavigator};
		
		local (htext);
		case typeOf (adrWizard^) {
			tableType { //prefsSuite.browser-style XML Wizard
				local (actionUrl = "http://" + pta^.host + pta^.uri + "$" + command);
				htext = prefsSuite.browser (flIncludeTitle:false, inputPanel:1, action:actionUrl, separatorColor:gainsboro, separatorTextColor:black);
				htext = string.replaceAll (htext, "popupWindow$", "popupWindow$" + command + ",")};
			outlineType { //radio.prefs.browser-style outline
				local (wizardTitle = string.upper (command[1]) + string.mid (command, 2, infinity));
				htext = radio.prefs.browser (adrWizard, wizardTitle)}};
		return (htext)};
	return (htmltext)}