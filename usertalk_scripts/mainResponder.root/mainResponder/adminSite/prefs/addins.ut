on addins () {
	«Changes
		«9/27/05; 1:21:58 AM by JES
			«Bug fix: If config.mainResponder.controlPanel.wizards is defined but empty, we weren't returning text saying that there are no add-ins installed on the server.
		«9/27/05; 1:08:07 AM by JES
			«Change URL scheme to use pathArgs instead of searchArgs for links to add-ins.
		«05/04/05, 21:43:37 by DAB
			«Created. Support legacy control panel add-ins, in the admin website.
	local (pta = html.getPageTableAddress ());
	local (htmltext);
	on add (s) {
		htmltext = htmltext + (s + "\r");};
	
	add ("<tr>");
	add ("<td colspan='2'>");
	
	local (ctAddins = 0);
	
	if defined (config.mainResponder.controlPanel.wizards) {
		
		ctAddins = sizeOf (config.mainResponder.controlPanel.wizards);
		
		local (adr);
		for adr in @config.mainResponder.controlPanel.wizards {
			local (addinlink);
			«addinlink = html.getLink (nameOf (adr^) , "addIns"  + "?command=" + nameOf (adr^))
			local (name = nameOf (adr^));
			name = string.upper (name[1]) + string.mid (name, 2, infinity);
			addinlink = html.getLink (name , "addIns"  + "$" + nameOf (adr^));
			add ("<table cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td class=\"small\" style=\"padding-bottom:5px;\"><b>" + addinlink + "</b></td></tr></table>")}};
	
	if ctAddins == 0 {
		add ("No add-ins have been installed on this server.")};
	add ("</td>");
	add("</tr>");
	
	pta^.flAddSubmitButton = false; //suppress the default submit button
	
	return (htmltext)}