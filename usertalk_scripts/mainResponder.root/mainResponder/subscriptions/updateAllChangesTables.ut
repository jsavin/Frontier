on updateAllChangesTables () {
	«Changes
		«6/17/05; 7:56:17 PM by JES
			«Created. Called in its own thread from mainResponder.init (which itself is called once a minute), our job is to loop over all open databases and make sure that their changes tables are up-to-date.
	local (adrdb, i, sizetable = sizeOf (user.databases));
	for i = 1 to sizetable {
		try {
			if defined (user.databases[i].supportsSubscribe) {
				if user.databases[i].supportsSubscribe {
					adrdb = @[user.databases[i].f];
					if defined (adrdb^.["#changes"]) {
						mainResponder.subscriptions.updateChangesTable (@adrdb^.["#changes"], true)}}}}};
	return};
«bundle //test code
	«updateAllChangesTables ()