# Frontier Minimal Build Makefile
# Phase 0.5.1: Minimal Viable Compilation

CC = clang
CFLAGS = -std=c17 -Wall -Wextra -fPIC -arch arm64 -arch x86_64
TARGET = Frontier_minimal

# Source files
SOURCES = main_minimal.c

# Default target
all: $(TARGET)

# Compile the minimal executable
$(TARGET): $(SOURCES)
	$(CC) $(CFLAGS) $(SOURCES) -o $(TARGET)

# Clean
clean:
	rm -f $(TARGET)

# Test compilation
test: $(TARGET)
	@echo "=== Minimal Compilation Test ==="
	@echo "Target: $(TARGET)"
	@echo "Architectures:"
	@file $(TARGET)
	@echo ""
	@echo "=== Running Minimal Test ==="
	@./$(TARGET)

# Test individual architectures
test_arm64:
	clang -std=c17 -Wall -Wextra -fPIC -arch arm64 main_minimal.c -o Frontier_arm64
	@echo "ARM64 compilation successful"
	@file Frontier_arm64

test_x86_64:
	clang -std=c17 -Wall -Wextra -fPIC -arch x86_64 main_minimal.c -o Frontier_x86_64
	@echo "x86_64 compilation successful"
	@file Frontier_x86_64

# Test both architectures
test_architectures: test_arm64 test_x86_64
	@echo "Both architectures compiled successfully"

.PHONY: all clean test test_arm64 test_x86_64 test_architectures
