# Frontier Test Framework Makefile
# Phase 0.5.3: Testing Strategy Implementation

CC = clang
CFLAGS = -std=c17 -Wall -Wextra -fPIC -arch arm64 -arch x86_64
TEST_TARGET = Frontier_test
EXAMPLE_TARGET = test_example

# Test framework source files (updated for new structure)
TEST_SOURCES = tests/framework/test_framework.c
EXAMPLE_SOURCES = tests/examples/test_example.c
DATABASE_SOURCES = tests/components/test_database.c

# Default target
all: $(TEST_TARGET) $(EXAMPLE_TARGET) test_database

# Compile test framework library
test_framework.o: $(TEST_SOURCES)
	$(CC) $(CFLAGS) -c $(TEST_SOURCES) -o test_framework.o

# Compile example test suite
$(EXAMPLE_TARGET): $(EXAMPLE_SOURCES) test_framework.o
	$(CC) $(CFLAGS) $(EXAMPLE_SOURCES) test_framework.o -o $(EXAMPLE_TARGET)

# Compile database test suite
test_database: $(DATABASE_SOURCES) test_framework.o
	$(CC) $(CFLAGS) $(DATABASE_SOURCES) test_framework.o -o test_database

# Run tests
test: $(EXAMPLE_TARGET)
	@echo "=== Running Frontier Test Suite ==="
	@./$(EXAMPLE_TARGET)

# Run database tests
test_db: test_database
	@echo "=== Running Database Component Test Suite ==="
	@./test_database

# Run all tests
test_all: test test_db
	@echo "=== All Test Suites Completed ==="

# Test individual architectures
test_arm64:
	clang -std=c17 -Wall -Wextra -fPIC -arch arm64 tests/examples/test_example.c tests/framework/test_framework.c -o test_example_arm64
	@echo "ARM64 test compilation successful"
	@./test_example_arm64

test_x86_64:
	clang -std=c17 -Wall -Wextra -fPIC -arch x86_64 tests/examples/test_example.c tests/framework/test_framework.c -o test_example_x86_64
	@echo "x86_64 test compilation successful"
	@./test_example_x86_64

# Test both architectures
test_architectures: test_arm64 test_x86_64
	@echo "Both architecture test suites compiled and ran successfully"

# Clean
clean:
	rm -f $(TEST_TARGET) $(EXAMPLE_TARGET) test_database test_framework.o
	rm -f test_example_arm64 test_example_x86_64

# Documentation
docs:
	@echo "=== Frontier Test Framework Documentation ==="
	@echo "Phase 0.5.3: Testing Strategy Implementation"
	@echo ""
	@echo "Files:"
	@echo "  test_framework.h - Test framework header"
	@echo "  test_framework.c - Test framework implementation"
	@echo "  test_example.c  - Example test suite"
	@echo "  Makefile_test   - Test build system"
	@echo ""
	@echo "Usage:"
	@echo "  make test              - Run example test suite"
	@echo "  make test_architectures - Test both ARM64 and x86_64"
	@echo "  make clean             - Clean build artifacts"

.PHONY: all test test_arm64 test_x86_64 test_architectures clean docs
